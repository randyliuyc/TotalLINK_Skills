  <SQLNew>--LINKAUTOREPLACEEMPTYCOLUMNS
--LINKUPLOAD_PATHASSIGN:D:\TotalLINK\LINKDEV\Files\Upload\STKLOTLST
--LINKUPLOAD_FILETYPE:
--LINKUPLOAD_KEEPFILENAME:1

MERGE INTO STKLOTLST WITH (ROWLOCK) AS target
USING (SELECT Trim([Mill Bale #])       TAGNO,
              Trim([Mill Bale #])       CTR,
              Trim([Category])          SUBLOT,
              [Mic]                     [MIC],
              [Len]                     [LEN],
              [Str]                     [STR],
              [Unif]                    [UNIF],
              [PlusB]                   [PLUSB],
              [Rd]                      [RD],
              Trim([Contract])          [CONTRACT],
              Trim([Mark])              LOT,
              ''                        INVOICE,
              0                         RECWT,
              0                         NETREWT,
              0                         SHIPWT,
              0                         NETSHWT,
              0                         TAREWT,
              1                         SUBSTA,
              'CTR'                     TAGTYP,
              'PRC'                     DOCTYP,
              'IMP'                     DOCGRP,
              'NEW-PRCIMP-#LOGIN_USER#' BATCHID,
              '#LINKUPLOADFILENAME#'    FILENAM,
              Getdate()                 CRETIM,
              '#LOGIN_USER#'            CREUSR
       FROM   OPENROWSET('Microsoft.ACE.OLEDB.12.0',
                         'Excel 12.0;Database=D:\TotalLINK\LINKDEV\Files\Upload\STKLOTLST\#LINKUPLOADFILENAME#;HDR=YES',
                         'SELECT *
                          FROM   [Sheet1$]')) AS source
ON -- target.FILENAM COLLATE Chinese_PRC_CI_AS = source.FILENAM COLLATE Chinese_PRC_CI_AS AND 
   target.TAGNO COLLATE Chinese_PRC_CI_AS = source.TAGNO COLLATE Chinese_PRC_CI_AS
   AND target.TAGTYP = 'CTR'
   AND target.DOCTYP = 'PRC'
   AND target.DOCGRP = 'IMP'
   AND target.FILENAM &lt;&gt; ''
--   AND target.FILENAM IS NOT NULL
WHEN MATCHED THEN
  UPDATE SET -- target.TAGNO = source.TAGNO,
             target.CTR = source.CTR,
             target.SUBLOT = source.SUBLOT,
             target.MIC = source.MIC,
             target.LEN = source.LEN,
             target.STR = source.STR,
             target.UNIF = source.UNIF,
             target.PLUSB = source.PLUSB,
             target.RD = source.RD,
             target.CONTRACT = source.CONTRACT,
             target.LOT = source.LOT,
             target.INVOICE = source.INVOICE,
             target.RECWT = source.RECWT,
             target.NETREWT = source.NETREWT,
             target.SHIPWT = source.SHIPWT,
             target.NETSHWT = source.NETSHWT,
             target.TAREWT = source.TAREWT,
             target.SUBSTA = source.SUBSTA,
             target.TAGTYP = source.TAGTYP,
             target.DOCTYP = source.DOCTYP,
             target.DOCGRP = source.DOCGRP,
             target.BATCHID = source.BATCHID,
             target.FILENAM = source.FILENAM,
             target.UPDTIM = Getdate(),
             target.UPDUSR = '#LOGIN_USER#'
WHEN NOT MATCHED THEN
  -- 如果没有匹配到，执行插入
  INSERT (TAGNO,
          CTR,
          SUBLOT,
          [MIC],
          [LEN],
          [STR],
          [UNIF],
          [PLUSB],
          [RD],
          [CONTRACT],
          LOT,
          INVOICE,
          RECWT,
          NETREWT,
          SHIPWT,
          NETSHWT,
          TAREWT,
          SUBSTA,
          TAGTYP,
          DOCTYP,
          DOCGRP,
          BATCHID,
          FILENAM,
          CRETIM,
          CREUSR)
  VALUES(source.TAGNO,
         source.CTR,
         source.SUBLOT,
         source.[MIC],
         source.[LEN],
         source.[STR],
         source.[UNIF],
         source.[PLUSB],
         source.[RD],
         source.[CONTRACT],
         source.LOT,
         source.INVOICE,
         source.RECWT,
         source.NETREWT,
         source.SHIPWT,
         source.NETSHWT,
         source.TAREWT,
         source.SUBSTA,
         source.TAGTYP,
         source.DOCTYP,
         source.DOCGRP,
         source.BATCHID,
         source.FILENAM,
	 source.CRETIM,
	 source.CREUSR);




UPDATE A
SET    A.ITMNO = B.ITMNO,
       A.ITMVER = B.ITMVER,
       A.SITE = H.SITE,
       A.SRCTYP = B.SRCTYP,
       A.SRCDOC = B.SRCDOC,
       A.SRCLIN = B.SRCLIN,
       A.ORITYP = B.DOCTYP,
       A.ORIDOC = B.DOCNUM,
       A.ORILIN = B.DOCLIN,
       A.UOM = B.UOM,
       A.UOMCOE = B.UOMCOE,
       A.QTY = 1,
       A.QTYSTU = B.UOMCOE,
       A.STU = B.STU
FROM   STKLOTLST A WITH (ROWLOCK)
       LEFT JOIN PBOLD B
              ON A.LOT = B.LOT
       LEFT JOIN PBOLH H
              ON H.DOCNUM = B.DOCNUM
WHERE  -- A.SUBSTA = 1
       -- AND A.DOCTYP = 'PRC'
       -- AND A.TAGTYP = 'CTR'
       -- AND A.DOCGRP = 'IMP'
       -- AND A.CREUSR = '#LOGIN_USER#'
       -- AND A.FILENAM = '#LINKUPLOADFILENAME#'
       -- AND 
       A.BATCHID = 'NEW-PRCIMP-#LOGIN_USER#'</SQLNew>
  <SQLRemove />
  <SQLClear>DELETE FROM STKLOTLST
