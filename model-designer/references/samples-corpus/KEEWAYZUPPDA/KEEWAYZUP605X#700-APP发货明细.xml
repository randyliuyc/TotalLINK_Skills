  <SQLRemove>--DELETE FROM XWSSDH WHERE PK_0='{0}'AND RPFLG_0&lt;&gt;3 AND USERID_0='#LOGIN_USER#'
DELETE FROM XWSSDH 
WHERE USERID_0 = '#LOGIN_USER#'AND
 PK_0 = '{0}'
  AND (
      (RPFLG_0 &lt;&gt; 3 )
      OR 
      (
          RPFLG_0 = 3 
          AND NOT EXISTS (
              SELECT 1 
              FROM SDELIVERYD Y
			  WHERE Y.SDHNUM_0 = XWSSDH.RPNUM_0
                AND Y.SDDLIN_0 = XWSSDH.RPLIN_0
          )
      )
  )</SQLRemove>
