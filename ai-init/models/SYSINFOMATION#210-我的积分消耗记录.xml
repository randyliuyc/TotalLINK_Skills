  <SQLScript>DECLARE @USR VARCHAR(30) = '#LOGIN_USER#';
DECLARE @DATSTR DATE = '{0}';
DECLARE @DATEND DATE = '{1}';

SELECT LOGDATE
  , DMCODE
  , DMNUM
  , SCRIPT
  , COST
  , TOKEN
FROM LINKAILOG
WHERE USR = @USR
  AND LOGDATE &gt;= @DATSTR
  AND LOGDATE &lt; DATEADD(DAY, 1, @DATEND);</SQLScript>
