  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>--监管产品交易明细
DECLARE @STRDAT DATE = '{0}';
DECLARE @ENDDAT DATE = '{1}';

SELECT L.ZOLLLOT_0
  , L.ITMREF_0
  , L.IPTDAT_0
  , L.TRSTYP_0
  , L.TRSDES_0
  , L.TRSFAM_0
  , L.BPRNUM_0
  , L.VCRTYP_0
  , L.VCRDES_0
  , L.VCRNUM_0
  , L.VCRLIN_0
  , L.VCRNUMORI_0 LINKSUB10_MFGNUM
  , CAST(L.QTYSTU_0 AS INT) AS QTYSTU_0
  , SUM(CAST(L.QTYSTU_0 AS INT)) OVER (
    PARTITION BY L.ZOLLLOT_0, L.ITMREF_0 ORDER BY L.ZOLLLOT_0
      , L.ITMREF_0
      , L.IPTDAT_0
      , L.VCRTYP_0
      , L.VCRNUM_0
      , L.VCRLIN_0 ROWS UNBOUNDED PRECEDING
    ) AS QTYRT_0
  , CAST(IIF(RECFLAG_0 = 1, QTYSTU_0, NULL) AS INT) RECQTYSTU_0
  , CAST(IIF(RECFLAG_0 = 0, - QTYSTU_0, NULL) AS INT) ISSQTYSTU_0
  , L.STU_0
  , L.MVTDES_0
  , L.YZUPATS_0 
  , L.ZOLLLOT_0 + L.ITMREF_0 LINKROWIDL3
FROM YZUPZOLL L
WHERE ZOLLSTRDAT_0 &lt;= @STRDAT -- 当前监管期间之前的数据都需要显示
  -- AND ZOLLENDDAT_0 = @ENDDAT
ORDER BY L.ZOLLLOT_0
  , L.ITMREF_0
  , L.IPTDAT_0
  , L.VCRTYP_0
  , L.VCRNUM_0
  , L.VCRLIN_0;</SQLScript>
