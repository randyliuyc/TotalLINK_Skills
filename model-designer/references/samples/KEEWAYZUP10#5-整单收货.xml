  <SQLScript>--LINKMYROWDATA
DECLARE @RCTDAT DATE='{0}'
DECLARE @SDHNUM VARCHAR(50)='{1}'
DECLARE @USER VARCHAR(10)='#LOGIN_USER#'
DECLARE @MACHINEID VARCHAR(50)='#LOGIN_ID#'
DECLARE @RPTSTA INT
DECLARE @RPTMSG NVARCHAR(100)

--整单插入，整单删除
EXECUTE [ZUP_PTH_FROM_GOCCIA]
  @SDHNUM
  ,@RCTDAT
  ,@USER
  ,@MACHINEID
  ,@RPTSTA OUTPUT
  ,@RPTMSG OUTPUT
DECLARE @LANX3 VARCHAR(30) = '#LINKFUNC.GETLANX3#';

SELECT XWS.ITMREF_0                      产品编码
       ,ISNULL(L1.ITMDES, ITM.ITMDES1_0) AS 产品描述1
       ,ISNULL(L2.ITMDES, ITM.ITMDES2_0) AS 产品描述2
       ,Cast(QTYWEU_0 AS REAL)           发货数量
       ,Cast(QTYSTU_0 AS REAL)           收货数量
       ,XWS.STU_0                        单位
       ,XWS.LOC_0                        库位 --可修改
       ,XWS.LOT_0                        批次 --可修改
       ,XWS.POHNUM_0                     采购订单
       ,XWS.POPLIN_0                     采购行
       ,XWS.RPNUM_0                      收货单
       ,XWS.RPLIN_0                      收货行
       ,XWS.PK_0                         LINKROWID
       ,CASE
          WHEN XWS.POHNUM_0 = '' THEN 'D03'
          WHEN XWS.LOC_0 = '' THEN 'D03'
          WHEN ITM.LOTMGTCOD_0 = 3
               AND YLOTCAN_0 &lt;&gt; 2 THEN 'D03'
          WHEN XWS.RPNUM_0 &lt;&gt; '' THEN 'H03'
          ELSE ''
        END                              LINKAPPRROW
       ,CASE
          WHEN ITM.LOTMGTCOD_0 &gt; 1 AND ITF.YLOTCAN_0&lt;&gt;2 THEN N'lang:{zh:批次号管理,en:Batch Management,de:Chargenverwaltung}'
          ELSE ''
        END                              LOTFLG
	   ,CASE
          WHEN SERMGTCOD_0 =3 THEN N'lang:{zh:序列号管理,en:Serial Number Management,de:Seriennummernverwaltung}'
          ELSE ''
        END                              SERFLG
       ,CASE
          WHEN RPFLG_0 = 3 THEN 'mui-hidden'
          ELSE ''
        END                              TJFLG
       ,CASE WHEN ITF.YLOTCAN_0&lt;&gt;2 AND ITM.LOTMGTCOD_0&gt;1 THEN '*' ELSE '' END LOTMGT  
FROM   XWSPTH XWS
      -- INNER JOIN ITMMASTER ITM
       LEFT JOIN ITMMASTER ITM
               ON XWS.ITMREF_0 = ITM.ITMREF_0
       INNER JOIN ITMFACILIT ITF
               ON XWS.ITMREF_0 = ITF.ITMREF_0
                  AND XWS.PRHFCY_0 = ITF.STOFCY_0
       LEFT JOIN ITMLAN1 L1
              ON L1.ITMREF = ITM.ITMREF_0
                 AND L1.LANX3 = @LANX3
       LEFT JOIN ITMLAN2 L2
              ON L2.ITMREF = ITM.ITMREF_0
                 AND L2.LANX3 = @LANX3
WHERE  XWS.SDHNUM_0 = @SDHNUM
       AND @SDHNUM &lt;&gt; ''
ORDER  BY LINKAPPRROW DESC
          ,XWS.SDDLIN_0</SQLScript>
  <SQLUpdateScript>--LINKEDITMODE
--LINKSAVEONENTERKEY
--LINKDATAAUTOSAVE 

UPDATE XWSPTH
SET     QTYUOM_0 = '0#收货数量#'
       ,QTYSTU_0 = '0#收货数量#'
       ,QTYPCU_0 = '0#收货数量#'
       ,LOC_0 = N'#库位#'
       ,LOT_0 = N'#批次#'
       ,UPDUSR_0 = LEFT('#LOGIN_USER#',5)
       ,UPDDATTIM_0 = Getdate()
       ,PRTFLG_0 = 1
       ,USERID_0 = LEFT('#LOGIN_USER#',5)
       ,SUBDATIM_0 = Getdate()
WHERE  PK_0 = '#LINKROWID#' AND RPFLG_0&lt;&gt;3</SQLUpdateScript>
