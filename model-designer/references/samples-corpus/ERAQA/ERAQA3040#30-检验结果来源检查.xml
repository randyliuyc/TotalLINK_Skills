  <FunctionCode />
  <ChartType />
  <SQLScript>DECLARE @ITMNO VARCHAR(30)='%{0}%';
DECLARE @CUSCOD VARCHAR(30)='%{1}%';
DECLARE @ROUDES VARCHAR(30)='%{2}%';
DECLARE @MFGNUM VARCHAR(30)='%{3}%';
DECLARE @STRDAT DATE = '{4}';
DECLARE @ENDDAT DATE = '{5}';

SELECT MH.MFGNUM_0    MFGNUM
      ,QA.QAResult
      ,H.DOCNUM
      ,MH.ROUALT_0    ROUALT
      ,MO.OPENUM_0    ROUOPE 
      ,MO.ROODES_0    ROUDES
      ,MH.ROUNUM_0    ITMNO
      ,MI.BPCNUM_0    CUSCOD
      ,MI.INTSPE_0    INTSPEC 
      ,MI.VCRNUMORI_0 ORIVCR
      ,U.ROUCOD ROUCODCK
FROM   #LC.X3DATA#MFGOPE MO
       INNER JOIN #LC.X3DATA#MFGHEAD MH
               ON MH.MFGNUM_0 = MO.MFGNUM_0
       INNER JOIN #LC.X3DATA#MFGITM MI
               ON MI.MFGNUM_0 = MO.MFGNUM_0
                  AND MI.ITMTYP_0 = 1
       LEFT JOIN QAINSPH H
              ON H.MFGNUM #LC.X3COLLATE# = MH.MFGNUM_0
                 AND H.ROUOPE #LC.X3COLLATE# = MO.OPENUM_0
       LEFT JOIN QAROU U
              ON U.ROUCOD #LC.X3COLLATE# = CONCAT_WS('-', MH.ROUNUM_0, MH.ROUALT_0, MO.OPENUM_0)
		LEFT JOIN (SELECT MFGNUM_0, OPENUM_0, 'QA' QAResult 
			FROM #LC.X3DATA#XWSMKOES K 
			WHERE MACHINEID_0 = 'QARESULT'
			GROUP BY MFGNUM_0, OPENUM_0) QA
			ON QA.MFGNUM_0 = MO.MFGNUM_0
			AND QA.OPENUM_0 = MO.OPENUM_0
WHERE   MO.STDOPENUM_0 BETWEEN 690 AND 699
       AND MH.ROUNUM_0 LIKE @ITMNO
       AND MI.BPCNUM_0 LIKE @CUSCOD
       AND MO.ROODES_0 LIKE @ROUDES
       AND MH.MFGNUM_0 LIKE @MFGNUM
       AND CAST(MH.CREDAT_0 AS DATE) BETWEEN @STRDAT AND @ENDDAT
ORDER  BY MH.MFGNUM_0</SQLScript>
