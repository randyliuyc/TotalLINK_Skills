  <ModelDesc>选择工单</ModelDesc>
  <KeyWords />
  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>--LINKLOADDATAIMMEDIATE
--LINKREFRESH
DECLARE @LANX3 VARCHAR(30) = '#LINKFUNC.GETLANX3#';
DECLARE @FCY VARCHAR(30) = '{0}'
DECLARE @XMH VARCHAR(30) = '{1}'
DECLARE @CUTDAT DATE = '{2}'

SELECT CAST(0 AS BIT) 选择
  , H.YMFGTYP_0 类型
  , M.MFGNUM_0 工单号
  , M.MFGLIN_0 工单行
  , M.ITMREF_0 产品编号
  , ISNULL(L1.ITMDES, ITM.ITMDES1_0) 产品描述1
  , ISNULL(L2.ITMDES, ITM.ITMDES2_0) 产品描述2
  , CAST(M.EXTQTY_0 AS REAL) 数量
  , M.UOM_0 单位
  , CONVERT(VARCHAR, M.STRDAT_0, 23) 开始日期
  , CONVERT(VARCHAR, M.ENDDAT_0, 23) 结束日期
  , CONVERT(VARCHAR(16), M.CREDATTIM_0, 21) 创建时间
FROM MFGITM M
INNER JOIN MFGHEAD H
  ON M.MFGNUM_0 = H.MFGNUM_0
INNER JOIN ITMMASTER ITM
  ON ITM.ITMREF_0 = M.ITMREF_0
LEFT JOIN XWSSCHSRC XWS
  ON XWS.SRCNUM_0 = M.MFGNUM_0
    AND XWS.SRCLIN_0 = M.MFGLIN_0
LEFT JOIN ITMLAN1 L1
  ON L1.ITMREF = ITM.ITMREF_0
    AND L1.LANX3 = @LANX3
LEFT JOIN ITMLAN2 L2
  ON L2.ITMREF = ITM.ITMREF_0
    AND L2.LANX3 = @LANX3
WHERE M.MFGFCY_0 = @FCY
  AND H.MFGSTA_0 = 1
  AND M.ITMTYP_0 = 1  --仅选择主产品，不考虑副产品 
  -- 截止日期之前开始的工单，仅选择半成品工单
  AND H.STRDAT_0 &lt;= @CUTDAT
  -- 2026年2月28日，去掉 SEMI限制，因为有些产品是单层 BOM
  -- AND M.ITMREF_0 LIKE '%-SEMI'
  AND XWS.SRCNUM_0 IS NULL
ORDER BY M.MFGNUM_0</SQLScript>
  <SQLUpdateScript>--LINKEDITMODE
INSERT INTO XWSSCHSRC
            (MACHINEID_0,
             USERID_0,
             SCHTYP_0,
             XMHNUM_0,
             PK_0,
             STOFCY_0,
             SRCTYP_0,
             SRCNUM_0,
             SRCLIN_0,
             BPCORD_0,
             STRDAT_0,
             ENDDAT_0,
             ITMREF_0,
             STU_0,
             QTY_0,
             PJT_0,
             CREDATTIM_0,
             UPDDATTIM_0,
             AUUID_0,
             CREUSR_0,
             UPDUSR_0)
--主计划内容
SELECT '#LOGIN_ID#'   MACHINEID_0
      ,'#LOGIN_USER#' USERID_0
      ,'BATCH'        SCHTYP_0
      ,'{1}'          XMHNUM_0
      ,NEWID()        PK_0
      ,M.MFGFCY_0     STOFCY_0
      ,'MFG'          SRCTYP_0
      ,M.MFGNUM_0     SRCNUM_0
      ,M.MFGLIN_0     SRCLIN_0
      ,''             BPCORD_0
      ,M.STRDAT_0     STRDAT_0
      ,M.ENDDAT_0     ENDDAT_0
      ,M.ITMREF_0     ITMREF_0
      ,M.UOM_0        STU_0
      ,M.EXTQTY_0
      ,M.PJT_0
      ,GETDATE()      CREDATTIM_0
      ,GETDATE()      UPDDATTIM_
      ,NEWID()        AUUID_0
      ,'#LOGIN_USER#' CREUSR_0
      ,''             UPDUSR_0
FROM   MFGITM M
       LEFT JOIN XWSSCHSRC XWS
              ON XWS.SRCNUM_0 = M.MFGNUM_0
                 AND XWS.SRCLIN_0 = M.MFGLIN_0
WHERE  M.MFGNUM_0 = '#工单号#'
       AND M.MFGLIN_0 = 0#工单行#
       AND XWS.SRCNUM_0 IS NULL 
       AND '@选择@'='True'</SQLUpdateScript>
