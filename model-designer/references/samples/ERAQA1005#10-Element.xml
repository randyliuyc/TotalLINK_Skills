  <SQLNew>--LINKADDNEWROWS
INSERT INTO [QAELE]
           ([ELECOD]
           ,[ELENAM]
           ,[ELEUNT]
           ,[ELESEQ]
           ,[CREUSR]
           ,[UPDUSR]
           ,[CRETIM]
           ,[UPDTIM])
     VALUES
           (
	   '#ELECOD#'--&lt;ELECOD, varchar(30),&gt;
           ,'#ELENAM#'--&lt;ELENAM, varchar(30),&gt;
           ,'#ELEUNT#'--&lt;ELEUNT, varchar(30),&gt;
           ,0#ELESEQ#
           ,'#LOGIN_USER#'--&lt;CREUSR, varchar(30),&gt;
           ,''--&lt;UPDUSR, varchar(30),&gt;
           ,GETDATE()--&lt;CRETIM, datetime,&gt;
           ,''--&lt;UPDTIM, datetime,&gt;
		  );</SQLNew>
