  <SQLScript>SELECT 
    XPRTCOD_0,
    XPRTNAM_0,
STOFCY_0,
    REMARK_0,
    CREDATTIM_0,
    UPDDATTIM_0,
    CREUSR_0,
    UPDUSR_0,
ROWID
FROM XWSPRSET 
WHERE STOFCY_0 LIKE '%{0}%'
ORDER BY STOFCY_0</SQLScript>
