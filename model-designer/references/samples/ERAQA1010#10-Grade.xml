  <SQLScript>--LINKDATAMINELAYOUT:55,45
DECLARE @GRDCOD VARCHAR(30)='%{0}%';
DECLARE @GRDNAM VARCHAR(100)='%{1}%';
DECLARE @STA VARCHAR(30)='%{2}%';
DECLARE @CUSCOD VARCHAR(30)='%{3}%';

SELECT S.GRDCOD
      ,S.GRDNAM
      ,S.EUSTD
      ,S.ENSTD
      ,S.DENSITY
      ,S.DENUNIT
      ,CAST(S.HDANNEAL AS REAL) HDANNEAL
      ,S.HDUNIT1
      --,CAST(S.HDDRAWN AS REAL) HDDRAWN
      ,S.HDDRAWN
      ,S.HDUNIT2
      ,CAST(S.TENSILE AS REAL) TENSILE
      ,S.TENUNIT
      ,S.COMMENT
      ,S.STD1
      ,S.STD2
      ,S.SUPCOD
      ,S.CUSCOD
      ,S.STA
      ,CASE WHEN S.STA='Draft' THEN 'A02'
            WHEN S.STA='Frozen' THEN 'C02'
        ELSE '' END LINKAPPRSTA
      ,S.CREUSR
      ,S.UPDUSR
      ,CONVERT(VARCHAR(16), S.CRETIM, 21) CRETIM
      ,CONVERT(VARCHAR(16), S.UPDTIM, 21) UPDTIM
      ,S.ID LINKROWID
FROM   QAGRADE S
WHERE  S.GRDCOD LIKE @GRDCOD
       AND S.GRDNAM LIKE @GRDNAM
       AND S.STA LIKE @STA
       AND S.CUSCOD LIKE @CUSCOD
ORDER BY S.GRDCOD</SQLScript>
  <SQLUpdateScript>--LINKSAVEONENTERKEY
