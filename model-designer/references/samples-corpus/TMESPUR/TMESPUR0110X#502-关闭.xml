  <SQLClear>UPDATE PREQUH SET DOCSTA='4',CLOREA='#CLOREA#',UPDUSR='#LOGIN_USER#',UPDTIM=GETDATE()
WHERE DOCNUM='#DOCNUM#';
UPDATE PREQUL SET DOCSTA='4',UPDUSR='#LOGIN_USER#',UPDTIM=GETDATE()
WHERE DOCNUM='#DOCNUM#';

UPDATE PREQAL
SET    PRQNUM = ''
       ,PRQQTY = A.QTY
       ,PRQQTYSTU = A.QTYSTU
FROM   PREQAL A
       INNER JOIN PREQUL D
               ON D.ITMNO = A.ITMNO
                  AND D.ITMVER = A.ITMVER
                  AND A.PRQNUM = D.DOCNUM
WHERE  D.DOCNUM = '#DOCNUM#'
       AND D.DOCSTA = '4';</SQLClear>
