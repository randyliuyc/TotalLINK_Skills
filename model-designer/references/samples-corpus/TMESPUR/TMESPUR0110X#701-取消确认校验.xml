  <SQLScript>#LINKSCRIPTGET@LINK01:
SELECT CASE
         WHEN EXISTS(SELECT 1
                     FROM   PREQUL
                     WHERE  DOCNUM = '{0}'
                            AND Isnull(PINNUM, '') &lt;&gt; '') THEN 'LINKPREVENT:lang:{{zh:该申请已经询价，不可取消确认}}'
         WHEN EXISTS(SELECT 1
                     FROM   PORDLIN
                     WHERE  SRCDOC = '{0}'
                            AND SRCTYP = 'PRQ') THEN 'LINKPREVENT:lang:{{zh:该申请已经下单，不可取消确认}}'
        --WHEN EXISTS(SELECT 1 FROM PREQUH  WHERE DOCNUM='{0}' AND WFLSTA='APPROVED') THEN 'LINKPREVENT:lang:{{zh:该申请已经审批通过，不可取消确认}}'
         ELSE ''
       END 
#</SQLScript>
