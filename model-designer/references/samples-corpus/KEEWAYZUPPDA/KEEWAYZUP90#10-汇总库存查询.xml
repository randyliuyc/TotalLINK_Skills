  <KeyWords />
  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>DECLARE @LANX3 VARCHAR(30) = '#LINKFUNC.GETLANX3#';
DECLARE @FCY VARCHAR(10)='{0}';
DECLARE @ITMREF VARCHAR(50)=N'%{1}%';
DECLARE @ITMDES NVARCHAR(100)=N'%{2}%';
DECLARE @YITMORI NVARCHAR(100)=N'%{3}%';

SELECT S.STOFCY_0                      地点
       ,S.ITMREF_0                     产品编码
       ,ISNULL(L1.ITMDES, I.ITMDES1_0) 产品描述1
       ,ISNULL(L2.ITMDES, I.ITMDES2_0) 产品描述2
       ,I.YITMORI_0 旧产品编码
       ,Cast(Sum(S.QTYSTU_0) AS REAL)  库存数量
       ,S.PCU_0                        单位
FROM   STOCK S
       INNER JOIN ITMMASTER I
               ON S.ITMREF_0 = I.ITMREF_0
       LEFT JOIN ITMLAN1 L1
              ON L1.ITMREF = I.ITMREF_0
                 AND L1.LANX3 = @LANX3
       LEFT JOIN ITMLAN2 L2
              ON L2.ITMREF = I.ITMREF_0
                 AND L2.LANX3 = @LANX3
WHERE  S.STOFCY_0 = @FCY
       AND S.ITMREF_0 LIKE @ITMREF
       AND UPPER(ISNULL(L1.ITMDES, I.ITMDES1_0)
                 + ISNULL(L2.ITMDES, I.ITMDES2_0)) LIKE @ITMDES
       AND I.YITMORI_0 LIKE @YITMORI 
GROUP  BY S.ITMREF_0
          ,ISNULL(L1.ITMDES, I.ITMDES1_0)
          ,ISNULL(L2.ITMDES, I.ITMDES2_0)
          ,I.YITMORI_0
          ,S.PCU_0
          ,S.STOFCY_0</SQLScript>
