  <SQLScript>#LINKSCRIPTGET@LINK01:
SELECT CASE
         WHEN Min(NEDQTY) &gt; 0 THEN N'LINKPREVENT:领料数量超出申请数量'
         ELSE ''
       END
FROM   (SELECT S.QTY - Isnull(WIP.SUBQTY, 0) AS NEDQTY
        FROM   MFGPKL S
               LEFT JOIN MFGPKH H
                      ON H.DOCNUM = S.DOCNUM
               LEFT JOIN ITM M
                      ON S.CPNITMNO = M.ITMNO
               LEFT JOIN(SELECT Sum(QTY) SUBQTY
                                ,SRCDOC
                                ,SRCLIN
                         FROM   STKCHG
                         WHERE  SRCDOC = '{1}'
                         GROUP  BY SRCDOC
                                   ,SRCLIN)WIP
                      ON WIP.SRCDOC = S.DOCNUM
                         AND WIP.SRCLIN = S.DOCLIN
        WHERE  H.SITE = '{0}'
               AND S.DOCNUM = '{1}'
               AND S.DOCSTA = '2'
			   AND S.CLOSTA &lt;&gt; 1) A
#</SQLScript>
