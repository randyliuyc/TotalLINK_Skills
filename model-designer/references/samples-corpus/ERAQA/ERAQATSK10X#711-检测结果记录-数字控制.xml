DECLARE @DOCNUM VARCHAR(30) = '{0}';
DECLARE @OPENUM VARCHAR(30) = '{1}';
DECLARE @VALLIN INT = 0#LINKROWIDVALLIN#;
DECLARE @TRXLIN INT = 0#TRXLIN#;

UPDATE QAINSPVAL
SET N1 = 0#N1#
    , N2 = 0#N2#
    , N3 = 0#N3#
    , N4 = 0#N4#
    , N5 = 0#N5#
    , N6 = 0#N6#
    , N7 = 0#N7#
    , N8 = 0#N8#
    , SPOOL = '#SPOOL#'
    , COIL = '#COIL#'
    , SAMP = '#SAMP#'
    , REMARK=N'#REMARK#'
    , UPDUSR = N'#LOGIN_USER#'
    , UPDTIM = GETDATE()
WHERE DOCNUM = @DOCNUM
  AND OPENUM = @OPENUM
  AND VALLIN = @VALLIN
  AND TRXLIN = @TRXLIN

-- 行计算值
EXECUTE [SP_INSPVAL_NCHECK] 
   @DOCNUM
  ,@OPENUM
  ,@VALLIN
  ,@TRXLIN;</SQLUpdateScript>
