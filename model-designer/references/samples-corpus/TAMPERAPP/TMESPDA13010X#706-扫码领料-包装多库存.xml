  <FunctionCode />
  <ChartType />
  <SQLScript>DECLARE @SCANNED_QTY   DECIMAL(18, 2)
        ,@REQ_QTY      DECIMAL(18, 6) = 0-- 需求包数
        ,@CAN_PICK_QTY DECIMAL(18, 6) = 0 -- 本次可领数量

SELECT @REQ_QTY = Isnull(QTY, 0)
FROM   MFGPKL
WHERE  DOCNUM = '{6}'
       AND DOCLIN = '{7}';

SELECT @SCANNED_QTY = Isnull(Sum(QTY), 0)
FROM   STKCHG
WHERE  SRCDOC = '{6}'
       AND SRCLIN = '{7}';

-- 本次还需领取数量
SET @CAN_PICK_QTY = @REQ_QTY - @SCANNED_QTY;
SELECT N'lang:{zh:产品编码}：' + K.ITMNO
       + N'&lt;br&gt;lang:{zh:产品名称}：' + ITM.ITMNAM
       + N'&lt;br&gt;lang:{zh:批号}：' + K.LOT
       + N'&lt;br&gt;lang:{zh:仓库}：' + WH.WHNAM
       + N'&lt;br&gt;lang:{zh:库位}：' + K.LOC
       + N'&lt;br&gt;lang:{zh:库存数量,}：'
       + Cast(Cast(K.QTY AS REAL) AS VARCHAR)
       + UOM                             ITM1
       ,K.WH
       ,K.LOC
       ,K.STU
       ,K.UOM
       ,Cast(K.UOMCOE AS DECIMAL(18, 2)) UOMCOE
       ,K.ITMNO
       ,K.ITMVER
       ,K.LOT
       ,K.SUBLOT
       ,Cast(K.QTY AS REAL)              STKQTY
       ,CASE
          WHEN @CAN_PICK_QTY &gt; K.QTY THEN Cast(K.QTY AS DECIMAL(18, 2))
          ELSE @CAN_PICK_QTY
        END                              QTY
       ,WH.WHGRP
       ,K.PK
       ,'OK'                             DATACK
FROM   STK K
       INNER JOIN ITM
               ON K.ITMNO = ITM.ITMNO
       LEFT JOIN ENTWH WH
              ON K.WH = WH.WH
WHERE  WH.WHGRP = 'STK'
       AND K.SITE = '{0}'
       AND K.ITMNO = '{1}'
       AND K.LOT = '{2}'
       AND K.SUBLOT = '{3}'
       AND K.BPSLOT = '{4}'
       AND K.UOM = '{5}'</SQLScript>
