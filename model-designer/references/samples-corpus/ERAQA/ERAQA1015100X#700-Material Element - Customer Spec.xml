  <SQLScript>DECLARE @DOCNUM VARCHAR(30)='{0}';
DECLARE @CUSCOD VARCHAR(30)='{1}';

DECLARE @GRDCOD VARCHAR(30)='';
SELECT @GRDCOD = GRDCOD FROM QAMAT WHERE DOCNUM = @DOCNUM;

SELECT S.ELECOD
      ,CAST(S.ELEVAL AS DECIMAL(18,3))    ELEVAL
      ,E.ELEUNT
      ,CAST(E.ELEMIN AS DECIMAL(18,3))             ELEMIN
      ,CAST(E.ELEMAX AS DECIMAL(18,3))             ELEMAX
      ,S.CREUSR
      ,S.UPDUSR
      ,CONVERT(VARCHAR(16), S.CRETIM, 21) CRETIM
      ,CONVERT(VARCHAR(16), S.UPDTIM, 21) UPDTIM
      ,S.ID                               LINKROWID
      ,CASE WHEN ISNULL(S.ELEVAL,0)&gt;=E.ELEMIN AND ISNULL(S.ELEVAL,0)&lt;=E.ELEMAX THEN ''
       ELSE 'D03' END LINKAPPRROW
FROM  QAMATELE S
   INNER JOIN QAGRADEELE E
   ON S.ELECOD = E.ELECOD 
     AND E.GRDCOD = @GRDCOD
	 AND E.CUSCOD = @CUSCOD
   LEFT JOIN QAELE A
   ON S.ELECOD = A.ELECOD
WHERE S.DOCNUM=@DOCNUM

ORDER  BY A.ELESEQ</SQLScript>
  <SQLUpdateScript>--LINKEDITMODE
--LINKSAVEONENTERKEY
UPDATE QAMATELE
SET    ELEVAL = 0#ELEVAL#
      ,UPDTIM = GETDATE()
      ,UPDUSR = '#LOGIN_USER#'
WHERE  ID=0#LINKROWID#</SQLUpdateScript>
