  <SQLScript>--LINKDATAMINEOVERVIEW,VERTICAL,75,AUTOREFRESH
DECLARE @INSTCAT VARCHAR(30)='%{0}%';
DECLARE @INSTCOD VARCHAR(30)='%{1}%';
DECLARE @INSTDES VARCHAR(100)='%{2}%';
DECLARE @BRAND VARCHAR(30)='%{3}%';
DECLARE @SERNUM VARCHAR(30)='%{4}%';

SELECT S.[INSTCOD]
      ,S.[INSTCAT]    LINKDROPVALIDINSTCAT
      ,S.[INSTNAM]
      ,S.[BRAND]
      ,S.[MODEL]
      ,S.[SERNUM]
      ,S.[LOC]
      ,S.[INSTDES]
      ,S.[SCALEDIV]
      ,S.[INSTRNG]
      ,S.[RESPONS]
      ,S.[MANUSR]
      ,IIF(S.[CREDAT]='1900-01-01','#LINK_TODAY#',S.[CREDAT]) CREDAT
      ,S.[PURINF]
      ,S.[CONRPT]
      ,S.[INTCTLPRD] 
      ,IIF(S.[INTCTLFROM]='1900-01-01',NULL,S.[INTCTLFROM]) INTCTLFROM
      ,IIF(S.[INTCTLTO]='1900-01-01',NULL,S.[INTCTLTO]) INTCTLTO
      ,S.[INTCTLDAYS]
      ,S.[INTCTLSTD]
      ,S.[CLBPRD]  
      ,S.[CLBSTD]
      ,IIF(S.[CLBCTLFROM]='1900-01-01',NULL,S.[CLBCTLFROM]) CLBCTLFROM
      ,IIF(S.[CLBCTLTO]='1900-01-01',NULL,S.[CLBCTLTO]) CLBCTLTO
      ,S.[CLBDAYS]
      ,S.[COST]
      ,ISNULL(X.TCOST,0)+ISNULL(S.[COST],0) TCOST
      ,S.[INSTSTA] LINKDROPVALIDINSTSTA
      ,S.[CREUSR]
      ,CONVERT(VARCHAR(16),S.[CRETIM],21) CRETIM
      ,S.[UPDUSR]
      ,CONVERT(VARCHAR(16),S.[UPDTIM],21) UPDTIM
      ,S.[ID]         LINKROWID
  FROM [QAINSTLST] S
LEFT JOIN 
(SELECT INSTCOD
       ,SUM(COST) TCOST
   FROM QAINSTTRX
GROUP BY INSTCOD) X
ON X.INSTCOD=S.INSTCOD
WHERE S.INSTCAT LIKE @INSTCAT
  AND S.INSTCOD LIKE @INSTCOD
  AND S.INSTDES LIKE @INSTDES
  AND S.BRAND LIKE @BRAND
  AND S.SERNUM LIKE @SERNUM
ORDER BY S.INSTCOD</SQLScript>
