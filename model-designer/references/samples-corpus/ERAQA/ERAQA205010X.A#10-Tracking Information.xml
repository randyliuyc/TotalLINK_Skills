  <ChartType />
  <SQLScript>--LINKREFRESH
--LINKLOADDATAIMMEDIATE
DECLARE @INSTCOD VARCHAR(30)='{0}';

SELECT S.[DOCNUM]
      ,T.OPTDES                             TRXTYP
      ,CONVERT(VARCHAR(16), S.[TRXDAT], 23) TRXDAT
      ,S.[TRXDES]
      ,S.[RPTREF]
    --  ,'#LINKSERVER#' AA
      ,'&lt;a href="' + '#LINKSERVER#' + F.[FILURL] + '"&gt;'
        + F.FILNAM + '&lt;/a&gt;'                 LINKLABELFILENAME
      ,S.[COST]
      ,S.[INSTSTA]
      ,S.[REMARK]
      ,S.[CREUSR]
      ,CONVERT(VARCHAR(16), S.[CRETIM], 21) CRETIM
      ,S.[ID]                               LINKROWID
      ,S.TRXTYP                             LINKROWIDTRXTYP
FROM   [QAINSTTRX] S
       INNER JOIN QAOPT T
               ON T.OPTTYP = 'ROUTYP'
                  AND T.OPTID = S.TRXTYP
       LEFT JOIN (SELECT SRCDOC
                        ,SRCTYP
                        ,FILURL
                        ,FILNAM
                  FROM   (SELECT SRCDOC
                                ,SRCTYP
                                ,FILURL
                                ,FILNAM
                                ,Row_Number()
                                    OVER (
                                      partition BY SRCDOC, SRCTYP
                                      ORDER BY CRETIM DESC) rank
                          FROM   LINKDOCFIL) A
                  WHERE  rank = 1) F
              ON F.SRCDOC = S.DOCNUM
                 AND F.SRCTYP = S.TRXTYP
WHERE  S.INSTCOD = @INSTCOD
ORDER  BY S.CRETIM DESC</SQLScript>
