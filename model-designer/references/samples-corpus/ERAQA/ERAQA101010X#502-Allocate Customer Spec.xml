  <SQLClear>--LINKREFRESH
DECLARE @SRCGRDCOD VARCHAR(30)='#GRDCOD#';
DECLARE @SRCCUSCOD VARCHAR(30)='#CUSCOD#';
DECLARE @DESCUSCOD VARCHAR(30)='{4}';

INSERT INTO [QAGRADE]
            ([GRDCOD],
             [CUSCOD],
             [GRDNAM],
             [DENSITY],
             [DENUNIT],
             [HDANNEAL],
             [HDUNIT1],
             [HDDRAWN],
             [HDUNIT2],
             [TENSILE],
             [TENUNIT],
             [COMMENT],
             [EUSTD],
             [ENSTD],
             [STD1],
             [STD2],
             [SUPCOD],
             [STA],
             [CREUSR],
             [UPDUSR],
             [CRETIM],
             [UPDTIM])
SELECT S.GRDCOD--&lt;GRDCOD, varchar(30),&gt;
      ,@DESCUSCOD--&lt;CUSCOD, varchar(30),&gt;
      ,S.GRDNAM--&lt;GRDNAM, nvarchar(100),&gt;
      ,S.DENSITY--&lt;DENSITY, varchar(30),&gt;
      ,S.DENUNIT--&lt;DENUNIT, varchar(30),&gt;
      ,S.HDANNEAL--&lt;HDANNEAL, decimal(18,6),&gt;
      ,S.HDUNIT1--&lt;HDUNIT1, varchar(30),&gt;
      ,S.HDDRAWN--&lt;HDDRAWN, decimal(18,6),&gt;
      ,S.HDUNIT2--&lt;HDUNIT2, varchar(30),&gt;
      ,S.TENSILE--&lt;TENSILE, decimal(18,6),&gt;
      ,S.TENUNIT--&lt;TENUNIT, varchar(30),&gt;
      ,S.COMMENT--&lt;COMMENT, varchar(30),&gt;
      ,S.EUSTD--&lt;EUSTD, varchar(30),&gt;
      ,S.ENSTD--&lt;ENSTD, varchar(30),&gt;
      ,S.STD1--&lt;STD1, varchar(30),&gt;
      ,S.STD2--&lt;STD2, varchar(30),&gt;
      ,S.SUPCOD--&lt;SUPCOD, varchar(30),&gt;
      ,'Draft'--&lt;STA, varchar(30),&gt;
      ,'#LOGIN_USER#'--&lt;CREUSR, varchar(30),&gt;
      ,''--&lt;UPDUSR, varchar(30),&gt;
      ,GETDATE()--&lt;CRETIM, datetime,&gt;
      ,''--&lt;UPDTIM, datetime,&gt;
FROM   QAGRADE S
WHERE  GRDCOD = @SRCGRDCOD
       AND CUSCOD = @SRCCUSCOD;

INSERT INTO [QAGRADEELE]
            ([GRDCOD],
             [CUSCOD],
             [ELECOD],
             [ELEMAX],
             [ELEMIN],
             [ELEUNT],
             [CREUSR],
             [UPDUSR],
             [CRETIM],
             [UPDTIM])
SELECT S.GRDCOD --&lt;GRDCOD, varchar(30),&gt;
      ,@DESCUSCOD--&lt;CUSCOD, varchar(30),&gt;
      ,S.ELECOD--&lt;ELECOD, varchar(30),&gt;
      ,S.ELEMAX--&lt;ELEMAX, decimal(18,6),&gt;
      ,S.ELEMIN--&lt;ELEMIN, decimal(18,6),&gt;
      ,S.ELEUNT--&lt;ELEUNT, varchar(30),&gt;
      ,'#LOGIN_USER#'--&lt;CREUSR, varchar(30),&gt;
      ,''----&lt;UPDUSR, varchar(30),&gt;
      ,GETDATE()--&lt;CRETIM, datetime,&gt;
      ,''--&lt;UPDTIM, datetime,&gt;
FROM   QAGRADEELE S
WHERE  GRDCOD = @SRCGRDCOD
       AND CUSCOD = @SRCCUSCOD
ORDER  BY S.ID</SQLClear>
