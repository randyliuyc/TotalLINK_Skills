  <SQLScript>--LINKMYROWDATA
--LINKDATAMINEOVERVIEW,,50,AUTOREFRESH
DECLARE @LANX3 VARCHAR(30) = '#LINKFUNC.GETLANX3#';
DECLARE @FCY VARCHAR(10)='{0}';
DECLARE @X3HNUM VARCHAR(30)='{1}';

SELECT H.X3HNUM_0                                                      AS 通知单号
       ,D.X3DLIN_0                                                     AS 行号
       ,D.SOHNUM_0                                                     AS 销售订单号
       ,D.SOPLIN_0                                                     AS 销售订单行
       ,SOH.CUSORDREF_0                                                AS 客户订单号
       ,H.X3HDAT_0                                                     AS 日期
       ,BPC.BPCNAM_0                                                   AS 客户
       ,D.ITMREF_0                                                     AS 产品编码
       ,ISNULL(L1.ITMDES, ITM.ITMDES1_0)                               AS 产品描述1
       ,ISNULL(L2.ITMDES, ITM.ITMDES2_0)                               AS 产品描述2
       ,ITM.ITMDES2_0                                                  产品描述
       ,CAST(D.QTY_0 AS REAL)                                          数量
       ,D.SAU_0                                                        单位
       ,CAST(ISNULL(SH.QTYPCU_0, 0) AS REAL)                           已备数量
       ,CAST(D.X3DSDDQTY_0 AS REAL)                                    已发数量
       ,CAST(D.QTY_0 - ISNULL(SH.QTYPCU_0, 0) - D.X3DSDDQTY_0 AS REAL) 剩余数量
       ,CASE
          WHEN ISNULL(SH.QTYPCU_0, 0) &gt; 0 THEN 'E02'
          WHEN D.QTY_0 - D.X3DSDDQTY_0 &gt; 0
               AND ISNULL(D.X3DSDDQTY_0, 0) &lt;&gt; 0THEN 'A02'
          WHEN D.QTY_0 - D.X3DSDDQTY_0 = 0 THEN N'H02'
          ELSE 'C01'
        END                                                            AS LINKAPPRROW
       ,H.SALFCY_0                                                     AS 地点
       ,H.STOFCY_0                                                     AS 装运地点
       ,'{4}'                                                          过账日期
       ,'{3}'                                                          打印机编码
			 ,CASE
          WHEN ITM.LOTMGTCOD_0 &gt; 1 THEN N'lang:{zh:批次号管理,en:Batch Management,de:Chargenverwaltung}'
          ELSE ''
        END                              LOTFLG
	   ,CASE
          WHEN SERMGTCOD_0 &gt;1 THEN N'required'
          ELSE ''
        END                              SERFLG
       ,SH.RPNUM_0  发货单号
       ,CASE WHEN SH.RPNUM_0=''OR SH.RPNUM_0 IS NULL THEN 'mui-hidden'
       ELSE '' END WLFLG
	   ,D.LOC_0 库位
FROM   XCN03SODD D
       INNER JOIN XCN03SODH H
               ON H.X3HNUM_0 = D.X3HNUM_0
       INNER JOIN ITMMASTER ITM
               ON ITM.ITMREF_0 = D.ITMREF_0
       LEFT JOIN ITMLAN1 L1
              ON L1.ITMREF = ITM.ITMREF_0
                 AND L1.LANX3 = @LANX3
       LEFT JOIN ITMLAN2 L2
              ON L2.ITMREF = ITM.ITMREF_0
                 AND L2.LANX3 = @LANX3
       LEFT JOIN BPCUSTOMER BPC
              ON H.BPCORD_0 = BPC.BPCNUM_0
       LEFT JOIN (SELECT SDH.X3HNUM_0
                         ,SDH.ITMREF_0
                         ,SUM(CASE WHEN SDH.RPFLG_0 &lt;&gt; 3 THEN SDH.QTYPCU_0 ELSE 0 END) AS QTYPCU_0
                         ,X3DLIN_0,RPNUM_0
                  FROM   XWSSDH SDH
                  WHERE  X3HNUM_0 LIKE @X3HNUM
                         --AND RPFLG_0 &lt;&gt; 3
                  GROUP  BY SDH.X3HNUM_0
                            ,SDH.X3DLIN_0
                            ,SDH.ITMREF_0,RPNUM_0)SH
              ON D.X3HNUM_0 = SH.X3HNUM_0
                 AND D.X3DLIN_0 = SH.X3DLIN_0
       LEFT JOIN SORDER SOH
              ON D.SOHNUM_0 = SOH.SOHNUM_0
WHERE  H.SALFCY_0 = @FCY
       AND UPPER(H.X3HNUM_0) = UPPER(@X3HNUM)
       AND H.X3HSTA_0 = 2
ORDER  BY H.X3HNUM_0
          ,D.X3DLIN_0</SQLScript>
  <SQLUpdateScript>INSERT INTO XWSSDH
  (MACHINEID_0,
   USERID_0,
   CUSERID_0,
   VCRTYP_0,
   PK_0,
   BATCHID_0,
   PKORI_0,
   CREDATIM_0,
   STAT_0,
   SUBDATIM_0,
   RPFLG_0,
   RPNUM_0,
   RPLIN_0,
   RPNOTE_0,
   RPDATE_0,
   RPDATIM_0,
   SALFCY_0,
   STOFCY_0,
   SDHNUM_0,
   BPCORD_0,
   BPAADD_0,
   CUR_0,
   SHIDAT_0,
   DLVDAT_0,
   CFMFLG_0,
   ZPAK_0,
   PJT_0,
   SOHNUM_0,
   SOPLIN_0,
   X3HNUM_0,
   X3DLIN_0,
   ITMREF_0,
   PCK_0,
   ITMDES_0,
   SAU_0,
   QTY_0,
   STA_0,
   PCU_0,
   QTYPCU_0,
   LOC_0,
   LOT_0,
   SERNUM_0,
   PALNUM_0,
   CTRNUM_0
   ,STOCOU_0
   ,CREDATTIM_0,UPDDATTIM_0,AUUID_0,CREUSR_0,UPDUSR_0,  
             [YINVQTY_0],
             [YBONQTY_0],
             [XDCB_0],
             [XDCB_1],
             [XDCB_2],
             [XTXT_0],
             [XTXT_1],
             [XTXT_2],
             [XDAT_0],
             [XDAT_1],
             [XDAT_2])
SELECT '#LOGIN_ID#' MACHINEID_0
      ,'#LOGIN_USER#' USERID_0
	  ,'#LOGIN_USER#' CUSERID_0
      ,110 VCRTYP_0
      ,NEWID() PK_0
      ,' ' BATCHID_0
      ,K.ZSTOFLD3_0 PKORI_0
      ,GETDATE() CREDATIM_0
      ,1 STAT_0
      ,'1900-01-01' SUBDATIM_0
      ,1 RPFLG_0
      ,' ' RPNUM_0
      ,0 RPLIN_0
      ,' ' RPNOTE_0
      ,'1900-01-01' RPDATE_0
      ,' ' RPDATIM_0
      ,SOH.SALFCY_0
      ,SOH.STOFCY_0
      ,' ' SDHNUM_0
      ,SOH.BPCORD_0
      ,SOH.BPAADD_0 BPAADD_0
      ,SOH.CUR_0 CUR_0
      ,'#过账日期#' SHIDAT_0
      ,'#过账日期#' DLVDAT_0
      ,1 CFMFLG_0
      ,'' ZPAK_0
      ,' ' PJT_0
      ,SOQ.SOHNUM_0
      ,SOQ.SOPLIN_0
      ,'#通知单号#'
      ,0#行号#
      ,SOQ.ITMREF_0 ITMREF_0
	  ,'' PCK_0
      ,I.ITMDES1_0
      ,I.STU_0 SAU_0
      ,0#发货数量#  QTY_0
      ,K.STA_0 STA_0
      ,I.STU_0 PCU_0
      ,0#发货数量#  QTYPCU_0
      ,K.LOC_0 LOC_0
      ,K.LOT_0 LOT_0
      ,'#序列号#' SERNUM_0 --K.SERNUM_0 SERNUM_0
      ,K.PALNUM_0 PALNUM
      ,K.CTRNUM_0 CTRNUM
	  ,K.STOCOU_0 STOCOU_0
      ,GETDATE(),GETDATE(),NEWID(),' ',' '
      ,0                         [YINVQTY_0]
      ,0                         [YBONQTY_0]
      ,0                         [XDCB_0]
      ,0                         [XDCB_1]
      ,0                         [XDCB_2]
      ,K.STOFLD1_0                        [XTXT_0]
      ,K.STOFLD2_0                      [XTXT_1]
      ,K.ZSTOFLD3_0                        [XTXT_2]
      ,''                        [XDAT_0]
      ,''                        [XDAT_1]
      ,''                        [XDAT_2]
FROM  STOCK K 
    INNER JOIN SORDERQ SOQ
	ON SOQ.ITMREF_0=K.ITMREF_0 AND SOQ.SOHNUM_0='#销售订单号#' and SOQ.SOPLIN_0=0#销售订单行#
       Left JOIN SORDER SOH
               ON SOQ.SOHNUM_0 = SOH.SOHNUM_0
       Left JOIN ITMMASTER I
               ON I.ITMREF_0 =K.ITMREF_0
WHERE K.STOCOU_0=0#STOCOU#
 AND 0#发货数量#&lt;&gt;0
-- AND K.SERNUM_0 NOT IN (SELECT SERNUM_0 FROM XWSSDH WHERE SERNUM_0&lt;&gt;''GROUP BY SERNUM_0 );</SQLUpdateScript>
