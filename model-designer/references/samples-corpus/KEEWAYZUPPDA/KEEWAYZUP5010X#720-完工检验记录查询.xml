  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>--LINKLOADDATAIMMEDIATE
DECLARE @STOFCY VARCHAR(30)=N'{0}';
DECLARE @MFGNUM VARCHAR(30)=N'%{1}%';
DECLARE @SERNUM VARCHAR(30)=N'%{2}%';
DECLARE @DCM VARCHAR(30)=N'%{3}%';
DECLARE @DJM VARCHAR(30)=N'%{4}%';
SELECT TOP 1000
 XWS.SERNUM_0 车架码
,XWS.XTXT_0 电池码  
,XWS.XTXT_1 电机码
,XWS.MFGNUM_0 工单号
,XWS.ITMREF_0 产品编码
,ITM.ITMDES1_0 产品名称
,ITM.ITMDES2_0+ITM.ITMDES3_0 产品描述
,ITM.YMDDES_0 产品说明
,CAST(XWS.QTYPCU_0 AS REAL) 数量
,XWS.LOC_0 库位
,XWS.CUSERID_0 操作人
,CONVERT(VARCHAR(16),XWS.CREDATIM_0,21) 操作时间
,XWS.RPNUM_0 入库单号
,XWS.USERID_0 入库人
,CASE WHEN CONVERT(VARCHAR(16),XWS.RPDATIM_0,21)='1900-01-01'  THEN '' ELSE CONVERT(VARCHAR(16),XWS.RPDATIM_0,21) END 入库时间
,XWS.ROWID LINKROWID
,CAST(XWS.XDCB_0 AS REAL)   汇总数
FROM XWSMKI XWS
INNER JOIN ITMMASTER ITM
ON XWS.ITMREF_0=ITM.ITMREF_0
WHERE XWS.MFGFCY_0=@STOFCY
  AND XWS.MFGNUM_0 LIKE @MFGNUM
  AND XWS.SERNUM_0 LIKE @SERNUM
  AND XWS.XTXT_0 LIKE @DCM
  AND XWS.XTXT_1 LIKE @DJM
ORDER BY XWS.ROWID DESC</SQLScript>
