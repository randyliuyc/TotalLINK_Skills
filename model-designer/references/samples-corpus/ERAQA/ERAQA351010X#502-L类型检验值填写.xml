  <SQLClear>--LINKAUTOREPLACEEMPTYCOLUMNS
DECLARE @DOCNUM VARCHAR(30) = '#DOCNUM#';
DECLARE @OPENUM VARCHAR(30) = '#OPENUM#';
DECLARE @VALLIN INT = 0#VALLIN#;
DECLARE @TRXLIN INT = 0#TRXLIN#;

UPDATE QAINSPVAL SET L1=IIF('#L1#'='True',1,0)
                    ,L2=IIF('#L2#'='True',1,0)
		    ,REMARK = '#REMARK#'
                    ,DEFECTS = N'#DEFECTS#'
                    ,UPDTIM = GETDATE()
                    ,UPDUSR = '#LOGIN_USER#'
WHERE DOCNUM = @DOCNUM
  AND OPENUM = @OPENUM
  AND VALLIN = @VALLIN
  AND TRXLIN = @TRXLIN

-- 行计算值
EXECUTE [SP_INSPVAL_LCHECK] 
   @DOCNUM
  ,@OPENUM
  ,@VALLIN
  ,@TRXLIN;</SQLClear>
