}, 150);
    }
};







editWebs=function(){
	var max=$("#需发数量").val()*1
	var val=$("#发货数量").val()*1
	if(val==max){
             //两者相等直接返回
		showModelData(null);
	}else{
           //重新计算需发数量
          $("#需发数量").val(max-val);
          $("#库位").val("");
          $("#发货数量").val("");
          $("#序列号").val("");
          $("#选择库存").val("");
           //需要手动刷新详情界面
           var con = plus.webview.getWebviewById('contentlist');
	   mui.fire(con,'contentlist_local',{});
	}
};


