  <SQLClear>--LINKREFRESH
DECLARE @ROUTYP VARCHAR(30) = 'INC'
DECLARE @ITMNO VARCHAR(30) = '{0}'
DECLARE @DATE VARCHAR(30) = '#LINKDATE(0,0,0,yyyyMMdd)#'
DECLARE @USER VARCHAR(30) = '#LOGIN_USER#'
DECLARE @DUDAT DATE = '{2}'
DECLARE @TRXDAT DATE = '{3}'
DECLARE @TRXUSR VARCHAR(30)='{4}'
DECLARE @TRXDES VARCHAR(100)=N'{5}'
DECLARE @RPTREF VARCHAR(100)=N'{6}'
DECLARE @COST DECIMAL(18,6)=0{7}
DECLARE @REMARK VARCHAR(100)=N'{8}'
DECLARE @INSTSTA VARCHAR(30)=IIF('{9}'='','Invalid','{9}')
DECLARE @CLBPRD INT;

SELECT @CLBPRD = CLBPRD
FROM   QAINSTLST
WHERE  INSTCOD = @ITMNO

INSERT INTO [QAINSTTRX]
           ([DOCNUM]
           ,[INSTCOD]
           ,[TRXTYP]
           ,[TRXDAT]
	   ,[TRXUSR]
           ,[TRXDES]
           ,[RPTREF]
           ,[COST]
           ,[INSTSTA]
           ,[REMARK]
           ,[CREUSR]
           ,[CRETIM])
     VALUES
           (
	   CONCAT_WS('-',@ROUTYP,@ITMNO,@DATE) --&lt;DOCNUM, varchar(30),&gt;
           ,@ITMNO--&lt;INSTCOD, varchar(30),&gt;
           ,@ROUTYP--&lt;TRXTYP, varchar(30),&gt;
           ,@TRXDAT--&lt;TRXDAT, date,&gt;
	   ,@TRXUSR--&lt;TRXUSR, varchar(30),&gt;
           ,@TRXDES--&lt;TRXDES, nvarchar(100),&gt;
           ,@RPTREF--&lt;RPTREF, nvarchar(100),&gt;
           ,@COST--&lt;COST, decimal(18,6),&gt;
           ,@INSTSTA--&lt;INSTSTA, varchar(30),&gt;
           ,@REMARK--&lt;REMARK, nvarchar(100),&gt;
           ,@USER--&lt;CREUSR, varchar(30),&gt;
           ,GETDATE()--&lt;CRETIM, datetime,&gt;
		   )
UPDATE QAINSTLST
SET    CLBCTLFROM = DATEADD(MONTH, -@CLBPRD, @DUDAT),
       CLBCTLTO = @DUDAT,
       INSTSTA = @INSTSTA
WHERE  INSTCOD = @ITMNO;</SQLClear>
