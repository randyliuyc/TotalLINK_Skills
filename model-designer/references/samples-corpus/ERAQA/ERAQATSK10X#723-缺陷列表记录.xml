  <SQLScript>--LINKNOGROUP
--LINKNOFILTER

DECLARE @DOCNUM VARCHAR(30) = '{0}'
DECLARE @OPENUM INT = 0{1}
DECLARE @VALLINID INT = 0{2}

DECLARE @OPESTD VARCHAR(30)

SELECT @OPESTD = OPESTD
FROM   QAINSPL
WHERE  DOCNUM = @DOCNUM
       AND OPENUM = @OPENUM

SELECT CAST(IIF(SA.SCACOD IS NULL, 0, 1) AS BIT) GXFLG
      ,S.[SCACOD]
      ,S.[SCADES1]
      ,S.[SCADES2]
      ,SA.REMARK 
      ,SA.[ID]                                   LINKROWID
FROM   [QAOPESTDSCA] S
       LEFT JOIN QAINSPVAL VL
              ON VL.ID = @VALLINID
       LEFT JOIN QAINSPVALSCA SA
              ON SA.VALLINID = VL.ID
	     AND SA.SCACOD = S.SCACOD
WHERE  S.OPESTD = @OPESTD 
   AND @VALLINID &lt;&gt; 0
ORDER  BY S.SCACOD</SQLScript>
  <SQLUpdateScript>--LINKEDITMODE
--LINKSAVEONENTERKEY

DECLARE @DOCNUM VARCHAR(30) = '{0}'
DECLARE @OPENUM INT = 0{1}
DECLARE @VALLINID INT = 0{2}

IF NOT EXISTS(SELECT VALLINID FROM QAINSPVALSCA WHERE VALLINID=@VALLINID AND SCACOD='#SCACOD#') AND '#GXFLG#'='True'
BEGIN
INSERT INTO [QAINSPVALSCA]
           ([VALLINID]
           ,[SCACOD]
           ,[SCAFLT]
           ,[REMARK]
           ,[CREUSR]
           ,[CRETIM])
    SELECT
	    @VALLINID--&lt;VALLINID, bigint,&gt;
           ,'#SCACOD#'--&lt;SCACOD, varchar(30),&gt;
           ,0--&lt;SCAFLT, bit,&gt;
           ,'#REMARK#'--&lt;REMARK, nvarchar(100),&gt;
           ,'#LOGIN_USER#'--&lt;CREUSR, varchar(30),&gt;
           ,GETDATE()--&lt;CRETIM, datetime,&gt;
END;

ELSE 

BEGIN

UPDATE QAINSPVALSCA SET REMARK='#REMARK#' WHERE ID=0#LINKROWID#;

DELETE FROM QAINSPVALSCA WHERE ID=0#LINKROWID# AND '#GXFLG#'='False';

END</SQLUpdateScript>
