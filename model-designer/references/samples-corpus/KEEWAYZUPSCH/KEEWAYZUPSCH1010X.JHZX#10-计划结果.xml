  <SQLScript>--LINKDATAMINEOVERVIEW,,55,NOAUTOREFRESH
--LINKLOADDATAIMMEDIATE
DECLARE @FCY VARCHAR(10) = '{0}';
DECLARE @XMH VARCHAR(50) = '{1}';

DECLARE @LANX3 VARCHAR(30) = '#LINKFUNC.GETLANX3#';

WITH CTE_DATA
AS (
  SELECT ITMREF_0
    , STOFCY_0
    , SUM(IIF(VCRREF_0 = N'1-STK', 1, 0) * QTYREF_0) STKQTY --当前库存
    , SUM(IIF(VCRREF_0 = N'2-SAF', - 1, 0) * QTYREF_0) SAFQTY --安全库存
    , SUM(IIF(VCRREF_0 = N'3-ORD', 1, 0) * QTYREF_0) ORDQTY --在途
    , SUM(IIF(VCRREF_0 = N'4-FIM', - 1, 0) * QTYREF_0) FIMQTY --确认需求
    , SUM(IIF(VCRREF_0 = N'4-BOM', - 1, 0) * QTYREF_0) BOMQTY --展开需求
    , SUM(IIF(VCRREF_0 = N'4-REL', - 1, 0) * QTYREF_0) RELQTY --相关需求
    , SUM(IIF(VCRREF_0 = N'4-BAT', - 1, 0) * QTYREF_0) BATQTY --初始需求     
    , SUM(IIF(VCRREF_0 = N'5-ADS'
        AND PLNNOTE_0 = 'ADSCUT', 1, 0) * QTYREF_0) ADSCUTQTY --截止日期前的建议数量     
    , SUM(IIF(VCRREF_0 = N'5-ADS'
        AND PLNNOTE_0 &lt;&gt; 'ADSCUT', 1, 0) * QTYREF_0) ADSOTHQTY --截止日期后的建议数量     
  FROM XWSSCHRES
  WHERE XMHNUM_0 = @XMH
  GROUP BY ITMREF_0
    , STOFCY_0
  )
SELECT CAST(0 AS BIT) 勾选
  , CAST(IIF(XWS.PK_0 IS NULL, 0, 1) AS BIT) 已确认
  , S.ITMREF_0 产品编码
  , ISNULL(L1.ITMDES, ITM.ITMDES1_0) AS 产品描述1
  , ISNULL(L2.ITMDES, ITM.ITMDES2_0) AS 产品描述2
  -- randy，2026年6月11日，下单数量转为采购单位
  , CAST(S.QTY_0 / ITM.PUUSTUCOE_0 AS DECIMAL(18, 2)) 下单数量
  , S.ENDDAT_0 要求到货日期
  , S.BPSNUM_0 供应商编码
  , BPS.BPSNAM_0 供应商名称
  , CAST(X.BATQTY AS DECIMAL(18, 2)) 初始需求
  , CAST(X.RELQTY AS DECIMAL(18, 2)) 相关需求
  , CAST(X.FIMQTY AS DECIMAL(18, 2)) 确认需求
  , CAST(X.SAFQTY AS DECIMAL(18, 2)) 安全库存
  , CAST(X.ORDQTY AS DECIMAL(18, 2)) 在途
  , CAST(X.STKQTY AS DECIMAL(18, 2)) 当前库存
  , CAST(X.ADSCUTQTY AS DECIMAL(18, 2)) 截止日期前建议
  , CAST(X.ADSOTHQTY AS DECIMAL(18, 2)) 后续建议
  , ITM.PUU_0 单位
  -- randy, 增加显示换算比率
  , ITM.STU_0 库存单位
  , ITM.PUUSTUCOE_0 采购换算比率
  , XWS.RPNUM_0 ERP单号
  , L250.LANMES_0 建议类型
  , S.PK_0 LINKROWID
  , CONVERT(VARCHAR(16), S.CREDATTIM_0, 21) MRP运行时间
  , IIF(XWS.RPNUM_0 &lt;&gt; '', 'A02', '') LINKAPPRROW
FROM XWSSCHRES S
INNER JOIN CTE_DATA X
  ON X.ITMREF_0 = S.ITMREF_0
    AND X.STOFCY_0 = S.STOFCY_0
INNER JOIN ITMMASTER ITM
  ON ITM.ITMREF_0 = S.ITMREF_0
LEFT JOIN ITMFACILIT ITF
  ON ITF.ITMREF_0 = S.ITMREF_0
    AND ITF.STOFCY_0 = S.STOFCY_0
LEFT JOIN APLSTD L250
  ON L250.LANCHP_0 = '250'
    AND L250.LAN_0 = @LANX3
    AND L250.LANNUM_0 = ITF.REOCOD_0
LEFT JOIN ITMLAN1 L1
  ON L1.ITMREF = ITM.ITMREF_0
    AND L1.LANX3 = @LANX3
LEFT JOIN ITMLAN2 L2
  ON L2.ITMREF = ITM.ITMREF_0
    AND L2.LANX3 = @LANX3
LEFT JOIN BPSUPPLIER BPS
  ON BPS.BPSNUM_0 = S.BPSNUM_0
LEFT JOIN XWSPOH XWS
  ON XWS.PK_0 = S.PK_0
WHERE S.XMHNUM_0 = @XMH
  AND S.VCRREF_0 = N'5-ADS'
  AND S.PLNNOTE_0 = 'ADSCUT'
ORDER BY S.ITMREF_0;</SQLScript>
  <SQLUpdateScript>--LINKEDITMODE
UPDATE XWSSCHRES
SET QTY_0 = 0#下单数量# * 0#采购换算比率# -- randy, 2026年6月11日，换算为库存单位保存建议数量
  , STRDAT_0 = '#要求到货日期#'
  , BPSNUM_0 = '#供应商编码#'
WHERE PK_0 = '#LINKROWID#'
  AND '#ERP单号#' = '';

--未确认勾选时插入中间表数据
IF '#勾选#' = 'True'
  AND '#已确认#' = 'False'
  AND '#ERP单号#' = ''
BEGIN
  INSERT INTO [XWSPOH] (
    [MACHINEID_0]
    , [USERID_0]
    , [VCRTYP_0]
    , [PK_0]
    , [BATCHID_0]
    , [PKORI_0]
    , [CREDATIM_0]
    , [STAT_0]
    , [SUBDATIM_0]
    , [RPFLG_0]
    , [RPNUM_0]
    , [RPLIN_0]
    , [RPNOTE_0]
    , [RPDATE_0]
    , [RPDATIM_0]
    , [POHNUM_0]
    , [POHFCY_0]
    , [ORDDAT_0]
    , [BPSNUM_0]
    , [ORDREF_0]
    , [CUR_0]
    , [ITMREF_0]
    , [PRHFCY_0]
    , [UOM_0]
    , [QTYUOM_0]
    , [EXTRCPDAT_0]
    , [GROPRI_0]
    , [DISCRGVAL1_0]
    , [DISCRGVAL2_0]
    , [DISCRGVAL3_0]
    , [PJT_0]
    , [CREDATTIM_0]
    , [UPDDATTIM_0]
    , [AUUID_0]
    , [CREUSR_0]
    , [UPDUSR_0]
    , [XMHNUM_0]
    , [YPLNQTY_0]
    , [XSPRRAT_0]
    , [YSPRQTY_0]
    , [TRSFAM_0]
    , XSTLNUM_0
    , YRMK_0
    , YRMK2_0
    , YCONDAT_0
    , SOHNUM_0
    , SOPLIN_0
    , SOQSEQ_0
    )
  SELECT '#LOGIN_ID#' MACHINEID_0
    , '#LOGIN_USER#' USERID_0
    , 14 VCRTYP_0
    , S.PK_0 PK_0
    , '' BATCHID_0
    , S.PK_0 PKORI_0
    , GETDATE() CREDATIM_0
    , 1 STAT_0
    , GETDATE() SUBDATIM_0
    , 1 RPFLG_0
    , '' RPNUM_0
    , 0 RPLIN_0
    , '' RPNOTE_0
    , '' RPDATE_0
    , '' RPDATIM_0
    , '' POHNUM_0
    , S.STOFCY_0 POHFCY_0
    , CONVERT(VARCHAR(16), GETDATE(), 23) ORDDAT_0
    , S.BPSNUM_0 BPSNUM_0
    , '' ORDREF_0
    , '' CUR_0
    , S.ITMREF_0 ITMREF_0
    , S.STOFCY_0 PRHFCY_0
    , ITM.PUU_0 UOM_0
    -- randy, 2026年6月11日，下单时转换为采购单位
    , S.QTY_0/ITM.PUUSTUCOE_0 QTYUOM_0
    , S.ENDDAT_0 EXTRCPDAT_0
    , 0 GROPRI_0
    , 0 DISCRGVAL1_0
    , 0 DISCRGVAL2_0
    , 0 DISCRGVAL3_0
    , '' PJT_0
    , GETDATE() CREDATTIM_0
    , '' UPDDATTIM_0
    , NEWID() AUUID_0
    , 'TTLNK' CREUSR_0
    , '' UPDUSR_0
    , S.XMHNUM_0 XMHNUM_0
    , 0 YPLNQTY_0
    , 0 XSPRRAT_0
    , 0 YSPRQTY_0
    , N'' TRSFAM_0
    , N'' XSTLNUM_0
    , N'' YRMK_0
    , N'' YRMK2_0
    , '' YCONDAT_0
    , '' SOHNUM_0
    , 0 SOPLIN_0
    , 0 SOQSEQ_0
  FROM XWSSCHRES S
  INNER JOIN ITMMASTER ITM
    ON S.ITMREF_0 = ITM.ITMREF_0
  WHERE S.PK_0 = '#LINKROWID#'
END

--已经确认还未生成ERP单号时，勾选可删除中间表数据
IF '#勾选#' = 'True'
  AND '#已确认#' = 'True'
  AND '#ERP单号#' = ''
BEGIN
  DELETE
  FROM XWSPOH
  WHERE PK_0 = '#LINKROWID#'
    AND RPFLG_0 &lt;&gt; 3;
END

--已经确认还未生成ERP单号时，修改内容更新中间表数据
IF '#勾选#' = 'False'
  AND '#已确认#' = 'True'
  AND '#ERP单号#' = ''
BEGIN
  UPDATE XWSPOH
  SET QTYUOM_0 = 0#下单数量#
    , EXTRCPDAT_0 = '#要求到货日期#'
    , BPSNUM_0 = '#供应商编码#'
  WHERE PK_0 = '#LINKROWID#'
    AND RPFLG_0 &lt;&gt; 3;
END</SQLUpdateScript>
