  <SQLScript>DECLARE @ITMREF VARCHAR(30) = '{0}';
DECLARE @BOMALT INT=0{1};

SELECT CAST(IIF(X.ITMREF_0 IS NULL, 0, 1) AS BIT) 选择
      ,T.BOMALT_0                                 BOM代码
      ,CASE
          WHEN T.BOMALTTYP_0 = 1 THEN N'销售（套件）'
          WHEN T.BOMALTTYP_0 = 2 THEN N'生产'
          WHEN T.BOMALTTYP_0 = 3 THEN N'外协'
          ELSE ''
        END                                       BOM类型
      ,T.FCY_0                                    地点
      ,IIF(F.ITMREF_0 IS NULL, '', 'OK')           产品地点检查
      ,IIF(B.ITMREF_0 IS NULL, '', 'OK')           BOM存在检查
      ,''                                          LINKAPPR选择
FROM   TABBOMALT T
       LEFT JOIN ITMFACILIT F
              ON T.FCY_0 = F.STOFCY_0
                 AND F.ITMREF_0 = @ITMREF
       LEFT JOIN (SELECT ITMREF_0
                        ,BOMALT_0
                        ,BOMALTTYP_0
                  FROM   BOM
                  WHERE  ITMREF_0 = @ITMREF)B
              ON B.ITMREF_0 = @ITMREF
                 AND B.BOMALT_0 = T.BOMALT_0
                 AND B.BOMALTTYP_0 = T.BOMALTTYP_0
       LEFT JOIN (SELECT ITMREF_0
                        ,BOMALT_0
                        ,2 BOMALTTYP_0
                  FROM   XWSBOM
                  WHERE  ITMREF_0 = @ITMREF
                         AND RPFLG_0 &lt;&gt; 3
                  GROUP  BY ITMREF_0
                            ,BOMALT_0)X
              ON X.BOMALT_0 = T.BOMALT_0
                 AND X.BOMALTTYP_0 = T.BOMALTTYP_0
                 AND X.ITMREF_0 = @ITMREF
WHERE  FCY_0 &lt;&gt; '' AND T.BOMALTTYP_0 = 2
ORDER  BY 选择 DESC
          ,T.FCY_0</SQLScript>
  <SQLUpdateScript>--LINKEDITMODE
--LINKSAVEONENTERKEY
DECLARE @ITMREF VARCHAR(30) = '{0}';
DECLARE @BOMALT INT = 0{1};
DECLARE @NEWBOMALT INT = 0#BOM代码#;

IF '#选择#' = 'True'
BEGIN
    -- 从BOM表复制
    IF EXISTS (SELECT 1 FROM BOM WHERE ITMREF_0 = @ITMREF AND BOMALT_0 = @BOMALT AND BOMALTTYP_0 = 2)
    BEGIN
        INSERT INTO [XWSBOM] (
            [MACHINEID_0], [USERID_0], [VCRTYP_0], [PK_0], [BATCHID_0], [PKORI_0],
            [CREDATIM_0], [STAT_0], [SUBDATIM_0], [RPFLG_0], [RPNUM_0], [RPLIN_0],
            [RPNOTE_0], [RPDATE_0], [RPDATIM_0], [XITMREF_0], [ITMREF_0], [BOMALT_0],
            [CPNITMREF_0], [BOMSEQ_0], [BOMQTY_0], [CREDATTIM_0], [UPDDATTIM_0],
            [AUUID_0], [CREUSR_0], [UPDUSR_0], [BOMDES_0], [BASQTY_0], [USESTA_0],
            [CPNOPE_0], [BOMUOM_0], [BOMSHO_0]
        )
        SELECT
            '#LOGIN_ID#',                    -- MACHINEID_0
            '#LOGIN_USER#',                   -- USERID_0
            103,                               -- VCRTYP_0
            NEWID(),                           -- PK_0
            '',                                -- BATCHID_0
            N'',                               -- PKORI_0
            GETDATE(),                         -- CREDATIM_0
            1,                                 -- STAT_0
            '',                                -- SUBDATIM_0
            1,                                 -- RPFLG_0
            '',                                -- RPNUM_0
            0,                                 -- RPLIN_0
            '',                                -- RPNOTE_0
            '',                                -- RPDATE_0
            '',                                -- RPDATIM_0
            @ITMREF,                           -- XITMREF_0
            @ITMREF,                           -- ITMREF_0
            @NEWBOMALT,                        -- BOMALT_0
            D.CPNITMREF_0,                     -- CPNITMREF_0
            D.BOMSEQ_0,                        -- BOMSEQ_0
            D.BOMQTY_0,                        -- BOMQTY_0
            GETDATE(),                         -- CREDATTIM_0
            '',                                -- UPDDATTIM_0
            NEWID(),                            -- AUUID_0
            '#LOGIN_USER#',                     -- CREUSR_0
            '',                                 -- UPDUSR_0
            '',                                 -- BOMDES_0
            H.BASQTY_0,                         -- BASQTY_0
            H.USESTA_0,                          -- USESTA_0
            D.CPNOPE_0,                          -- CPNOPE_0
            D.BOMUOM_0,                          -- BOMUOM_0
            ''                                   -- BOMSHO_0
        FROM BOM H
        INNER JOIN BOMD D ON H.ITMREF_0 = D.ITMREF_0 AND H.BOMALT_0 = D.BOMALT_0 AND H.BOMALTTYP_0 = D.BOMALTTYP_0
        WHERE H.ITMREF_0 = @ITMREF AND H.BOMALT_0 = @BOMALT AND H.BOMALTTYP_0 = 2;
    END

    -- 从XWSBOM表复制
    IF EXISTS (SELECT 1 FROM XWSBOM WHERE ITMREF_0 = @ITMREF AND BOMALT_0 = @BOMALT AND RPFLG_0 &lt;&gt; 3)
    BEGIN
        INSERT INTO [XWSBOM] (
            [MACHINEID_0], [USERID_0], [VCRTYP_0], [PK_0], [BATCHID_0], [PKORI_0],
            [CREDATIM_0], [STAT_0], [SUBDATIM_0], [RPFLG_0], [RPNUM_0], [RPLIN_0],
            [RPNOTE_0], [RPDATE_0], [RPDATIM_0], [XITMREF_0], [ITMREF_0], [BOMALT_0],
            [CPNITMREF_0], [BOMSEQ_0], [BOMQTY_0], [CREDATTIM_0], [UPDDATTIM_0],
            [AUUID_0], [CREUSR_0], [UPDUSR_0], [BOMDES_0], [BASQTY_0], [USESTA_0],
            [CPNOPE_0], [BOMUOM_0], [BOMSHO_0]
        )
        SELECT
            '#LOGIN_ID#',                       -- MACHINEID_0
            '#LOGIN_USER#',                      -- USERID_0
            103,                                 -- VCRTYP_0
            NEWID(),                             -- PK_0
            '',                                  -- BATCHID_0
            N'',                                 -- PKORI_0
            GETDATE(),                           -- CREDATIM_0
            1,                                   -- STAT_0
            '',                                  -- SUBDATIM_0
            1,                                   -- RPFLG_0
            '',                                  -- RPNUM_0
            0,                                   -- RPLIN_0
            '',                                  -- RPNOTE_0
            '',                                  -- RPDATE_0
            '',                                  -- RPDATIM_0
            XWS.XITMREF_0,                       -- XITMREF_0
            @ITMREF,                             -- ITMREF_0
            @NEWBOMALT,                          -- BOMALT_0
            XWS.CPNITMREF_0,                     -- CPNITMREF_0
            XWS.BOMSEQ_0,                        -- BOMSEQ_0
            XWS.BOMQTY_0,                        -- BOMQTY_0
            GETDATE(),                           -- CREDATTIM_0
            '',                                  -- UPDDATTIM_0
            NEWID(),                             -- AUUID_0
            '#LOGIN_USER#',                       -- CREUSR_0
            '',                                   -- UPDUSR_0
            XWS.BOMDES_0,                         -- BOMDES_0
            XWS.BASQTY_0,                         -- BASQTY_0
            XWS.USESTA_0,                          -- USESTA_0
            XWS.CPNOPE_0,                          -- CPNOPE_0
            XWS.BOMUOM_0,                          -- BOMUOM_0
            ''                                     -- BOMSHO_0
        FROM XWSBOM XWS
        WHERE XWS.ITMREF_0 = @ITMREF AND XWS.BOMALT_0 = @BOMALT AND XWS.RPFLG_0 &lt;&gt; 3;
    END
END</SQLUpdateScript>
