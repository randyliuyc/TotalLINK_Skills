  <ChartType />
  <SQLScript>DECLARE @SITE VARCHAR(30)=N'{0}'
DECLARE @ITMNO VARCHAR(30)=N'{1}'
DECLARE @NEDQTYSTU DECIMAL(18,2)=0{2}

SELECT N'lang:{zh:产品编码}：' + K.ITMNO
       + N'&lt;br&gt;lang:{zh:产品名称}：' + K.ITMVER
       + N'&lt;br&gt;lang:{zh:批号}：' + K.LOT
       + N'&lt;br&gt;lang:{zh:仓库}：' + K.WH
       + N'&lt;br&gt;lang:{zh:库位}：' + K.LOC
       + N'&lt;br&gt;lang:{zh:库存数量}：'
       + Cast(Cast(K.QTYSTU AS DECIMAL(18, 2)) AS VARCHAR)
       + K.STU   ITM1
       ,K.WH
       ,K.LOC
       ,K.STU
       ,K.ITMNO
       ,K.ITMVER
       ,K.LOT
       ,K.SUBLOT
       ,K.QTYSTU STKQTYSTU
       ,CASE WHEN @NEDQTYSTU&gt;K.QTYSTU THEN CAST(K.QTYSTU AS DECIMAL(18,2)) ELSE @NEDQTYSTU END QTYSTU
       ,K.PK
FROM   STK K
       LEFT JOIN ITM
              ON K.ITMNO = ITM.ITMNO
       LEFT JOIN ENTWH WH
              ON K.WH = WH.WH
WHERE  ITM.TCLCOD = 'RW'
       AND WH.WHGRP = 'STK'
       AND K.STU = 'KG'
       AND K.[SITE] = @SITE
       AND K.ITMNO = @ITMNO</SQLScript>
