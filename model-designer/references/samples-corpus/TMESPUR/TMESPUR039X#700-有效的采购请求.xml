  <SQLScript>SELECT H.DOCNUM + '-' + CAST(S.DOCLIN AS CHAR)       DOCKEY
      ,'PRE'                                          SRCTYP
      ,H.DOCNUM                                       SRCDOC
      ,S.DOCLIN                                       SRCLIN
      ,CONVERT(VARCHAR(16), H.DOCDAT, 23)             DOCDAT
      ,DE.DEPTNAM + '-' + GR.GRPNAM + '-' + RE.RESNAM  RESNO
      ,H.DOCDES
      ,H.PRJNUM
      ,S.ITMNO
      ,ITM.ITMNAM
      ,CONVERT(VARCHAR(16), S.REQDAT, 23)             REQDAT
      ,S.STU
      ,S.PUU
      ,S.PUUCOE
      ,(S.QTYPUU - S.ORDQTYPUU)                      QTYPUU
      ,(S.QTYSTU - S.ORDQTYSTU)                      QTYSTU
      ,S.QTYPUU                                       PREQTYPUU
      ,S.QTYSTU                                       PREQTYSTU
      ,S.REMARK                            LREMARK
FROM   PREQUH H
       INNER JOIN PREQUL S
               ON H.DOCNUM = S.DOCNUM
       INNER JOIN ITM
               ON ITM.ITMNO = S.ITMNO
       LEFT JOIN ENTDEPT DE
              ON DE.DEPT = H.DEPT
       LEFT JOIN ENTGRP GR
              ON GR.GRP = H.GRP
       LEFT JOIN ENTRES RE
              ON RE.RESNO = H.RESNO
WHERE  H.SITE = '{0}'
       AND S.DOCSTA = 2
       AND H.DOCNUM + H.DOCDES + H.PRJNUM + S.ITMNO
           + ITM.ITMNAM + H.REMARK + S.REMARK + ISNULL(DE.DEPTNAM,'')
           + ISNULL(GR.GRPNAM,'') + ISNULL(RE.RESNAM,'') LIKE '%{1}%'</SQLScript>
