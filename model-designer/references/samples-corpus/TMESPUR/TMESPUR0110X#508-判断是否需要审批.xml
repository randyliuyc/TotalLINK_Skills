  <SQLScript>--LINKMULTIROWS

SELECT PUH.DOCNUM
       ,PUH.DEPT
       ,PUH.DOCDES
       ,CASE
          WHEN Count(*) = Sum(CASE
                                WHEN ITM.TCLCOD = 'PACK'
                                     AND ITM.TSICOD1 IN ( '201', '202' ) THEN 1
                                ELSE 0
                              END) THEN 1
          ELSE 0
        END AS APRSKIP-- 全部符合才为 1，否则 0
       ,CASE
          WHEN Count(*) = Sum(CASE
                                WHEN ITM.TCLCOD = 'PACK'
                                     AND ITM.TSICOD1 IN ( '201', '202' ) THEN 1
                                ELSE 0
                              END) THEN 0
          ELSE 1
        END AS NOAPRSKIP -- 有一条不符合就是 1
       --,1   APRSKIP
       --,0   NOAPRSKIP
FROM   PREQUL PUL
       LEFT JOIN PREQUH PUH
              ON PUH.DOCNUM = PUL.DOCNUM
       LEFT JOIN ITM
              ON PUL.ITMNO = ITM.ITMNO
WHERE  PUL.DOCNUM = '#DOCNUM#'
GROUP  BY PUH.DOCNUM
          ,PUH.DEPT
          ,PUH.DOCDES;</SQLScript>
