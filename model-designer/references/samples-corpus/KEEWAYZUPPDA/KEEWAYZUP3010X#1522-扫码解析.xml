  <FunctionCode />
  <ChartType />
  <SQLScript>DECLARE @ITMREF VARCHAR(30)='#产品编码#';
DECLARE @FCY VARCHAR(30)='#地点#';
DECLARE @REMINQTY DECIMAL(16, 2)='#需领数量#';
DECLARE @TAG VARCHAR(30)='{0}';

IF ISNULL((SELECT COUNT(*)
           FROM   STOCK
           WHERE  ( ITMREF_0 = @TAG
                     OR SERNUM_0 = @TAG )
                  AND ITMREF_0 = @ITMREF), 0) = 0
  SELECT N'扫描产品错误或无库存:'+@TAG 数据检查
ELSE IF ISNULL((SELECT COUNT(*)
           FROM   STOCK
           WHERE  ITMREF_0 = @TAG
                   OR SERNUM_0 = @TAG), 0) &gt; 1
  SELECT N'多个存库行，请选择' 数据检查
ELSE
  SELECT K.ITMREF_0         产品编码
        ,CAST(CASE
                 WHEN K.SERNUM_0 &lt;&gt; '' THEN 1
                 WHEN K.QTYSTU_0 - ISNULL(XWS.QTY, 0)-CUMALLQTY_0 &gt; @REMINQTY
                      AND K.SERNUM_0 = '' THEN @REMINQTY
                 ELSE K.QTYSTU_0 - ISNULL(XWS.QTY, 0)-CUMALLQTY_0
               END AS REAL) 领料数量
        ,K.LOC_0            库位
        ,K.SERNUM_0         序列号
        ,CASE
            WHEN K.QTYSTU_0 - ISNULL(XWS.QTY, 0)-CUMALLQTY_0 = 0 THEN N'可用库存为0'
            ELSE 'OK'
          END               数据检查
        ,K.PALNUM_0         生产计划号
		,K.STOCOU_0         STOCOU
  FROM   STOCK K
          LEFT JOIN (SELECT STOCOU_0
                        ,SUM(QTYSTU_0) QTY
                  FROM   XWSSCS
                  WHERE  RPFLG_0 &lt;&gt; 3
                  GROUP  BY STOCOU_0
                            ,SERNUM_0)XWS
              ON XWS.STOCOU_0 = K.STOCOU_0
  WHERE  K.STOFCY_0 = @FCY
         AND ( K.ITMREF_0 = @TAG
                OR K.SERNUM_0 = @TAG )</SQLScript>
