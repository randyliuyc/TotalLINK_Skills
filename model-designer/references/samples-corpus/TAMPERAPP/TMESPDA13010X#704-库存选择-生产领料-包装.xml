  <FunctionCode />
  <ChartType />
  <SQLScript>DECLARE @SITE VARCHAR(30)=N'{0}';
DECLARE @ITMNO VARCHAR(30)=N'{1}';
DECLARE @UOM VARCHAR(30)=N'{2}';
DECLARE @NEDQTY DECIMAL(18,2)=0{3};

SELECT N'lang:{zh:产品编码}：'+ K.ITMNO
       + N'&lt;br&gt;lang:{zh:产品名称}：'+ ITM.ITMNAM 
       + N'&lt;br&gt;lang:{zh:批号}：'+ K.LOT 
       + N'&lt;br&gt;lang:{zh:仓库}：' + WH.WHNAM
       + N'&lt;br&gt;lang:{zh:库位}：' + K.LOC
       + N'&lt;br&gt;lang:{zh:库存数量,}：'+ Cast(Cast(K.QTY AS REAL) AS VARCHAR)+ UOM   ITM1
       ,K.WH
       ,K.LOC
       ,K.STU
       ,K.UOM
       ,Cast(K.UOMCOE AS DECIMAL(18, 2)) UOMCOE
       ,K.ITMNO
       ,K.ITMVER
       ,K.LOT
       ,K.SUBLOT
       ,Cast(K.QTY AS REAL)              STKQTY
       ,CASE WHEN @NEDQTY&gt; K.QTY THEN  Cast(K.QTY AS DECIMAL(18,2)) ELSE  @NEDQTY END   QTY
       ,WH.WHGRP
       ,K.PK
FROM   STK K
       INNER JOIN ITM  ON K.ITMNO=ITM.ITMNO
       LEFT JOIN ENTWH WH
              ON K.WH = WH.WH
WHERE  WH.WHGRP = 'STK'
       AND K.SITE = @SITE
       AND K.ITMNO = @ITMNO
       AND K.UOM = @UOM</SQLScript>
