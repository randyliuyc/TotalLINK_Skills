  <SQLScript>DECLARE @SITE VARCHAR(30)='{0}';
DECLARE @SRCDOC VARCHAR(30)='{1}';
DECLARE @SRCLIN INT='{2}';

SELECT Row_number()
         OVER (
           PARTITION BY S.SRCDOC, S.SRCLIN
           ORDER BY S.UPDTIM )               SEQ
       ,S.TAGNO
       ,Cast(S.QTY AS REAL)               QTY
       ,S.UOM
       ,S.PK
       ,S.WH
       ,S.LOC
       ,S.CRETIM
       ,S.CREUSR
       ,Iif(S.DOCSTA = 2, 'mui-hidden', '')  DELFLG
FROM   STKCHG S
WHERE  S.SITE = @SITE
       AND S.SRCDOC = @SRCDOC
       AND SRCLIN = @SRCLIN</SQLScript>
