  <SQLScript>--退货
SELECT S.DOCNUM + '-'
       + CAST(S.SRCLIN AS VARCHAR(16))    DOCKEY
      ,S.DOCNUM                           SRCDOC
      ,S.DOCLIN                           SRCLIN
      ,S.DOCTYP                           SRCTYP
      ,CONVERT(VARCHAR(16), S.DOCDAT, 23) DOCDAT
      ,S.BPSNO
      ,BPS.BPSNAM
      ,S.PRJNUM
      ,S.SITE
      ,S.REMARK
      ,S.ITMNO --产品编码
      ,ITM.ITMNAM --中文名称
      ,ITM.ITMNAM1 --越文名称
      ,S.ITMVER --品名
      ,ITM.ITMSIZE
      ,ITM.ITMSPEC
      ,ITM.IVATTYP
      ,BPS.BVATTYP
      ,VAT.TAXRT
      ,S.QTY                              PRTQTY --退货数量
      ,S.UOM --退货单位
      ,S.NETPRI --单价
      ,S.UOMCOE --换算系数
      ,S.QTYSTU --库存数量
      ,S.STU --库存单位
      ,CAST(S.PIVQTY AS REAL)             PIVQTY --已开票数量
      ,CAST(S.QTY - S.PIVQTY AS REAL)     QTY --剩余开票数量
FROM   PRETLIN S
       INNER JOIN ITM
               ON ITM.ITMNO = S.ITMNO
       LEFT JOIN BPSUP BPS
              ON BPS.BPSNO = S.BPSNO
       LEFT JOIN VAT
              ON VAT.IVATTYP = ITM.IVATTYP
                 AND VAT.BVATTYP = BPS.BVATTYP
WHERE  S.DOCSTA = 2
       AND S.QTY - S.PIVQTY&gt;0
       AND S.SITE = '{0}'
       AND S.BPSNO = '{1}'
       AND S.DOCNUM + S.ITMNO + ITM.ITMNAM + S.ITMVER LIKE '%{2}%'
ORDER  BY S.DOCNUM DESC</SQLScript>
