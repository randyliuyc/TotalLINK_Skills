  <SQLScript>DECLARE @TAG VARCHAR(200) = '{0}';
DECLARE @CTRFLG BIT = 0;

--对标签内容进行处理，兼容原标签
SELECT @TAG = CASE 
        WHEN CHARINDEX('|', @TAG) &gt; 0
            THEN LEFT(@TAG, CHARINDEX('|', @TAG) - 1)
        ELSE @TAG
        END

SET @CTRFLG = IIF(CHARINDEX('/', @TAG) &gt; 0, 1, 0)
IF @CTRFLG = 0
BEGIN
SELECT @TAG  发货单号
END
ELSE
SELECT 
TOP 1 VCRNUM_0 发货单号
FROM STOJOU 
WHERE  PALNUM_0 + '-' + CTRNUM_0+ '/' = @TAG
AND STOFCY_0='ZJKC'
AND VCRTYP_0=4</SQLScript>
