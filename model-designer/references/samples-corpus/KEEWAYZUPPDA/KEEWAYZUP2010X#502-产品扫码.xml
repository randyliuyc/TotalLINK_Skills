  <JavaScript>// 扫描解析
scan_if = function () {
    return 2;
}

// 扫描参数处理
scan_para = function (id, r) {
    scan_impl(id, "#" + r + "#");
}

//扫码返回刷新
Save_Data = function() {
   if($("#序列号").length){
    var index = plus.webview.getWebviewById("contentlist");
    mui.fire(index, "contentlist_local", {
        para: index.modelParams
    });}
}

//扫描后自动保存
scanAfterAction = function(r) {
  var dataCheck = $("#数据检查").val();
  var dataSumitScriptType = 1;
  // 数据检查
  if (dataCheck &amp;&amp; dataCheck.trim() !== "") {
    alert(dataCheck);
    keep_focus("linkinput");
    return;
  } else {
    // 数据检查通过，执行自动保存
    recSave(globleServer, globleDmCode, globleDmNum, dataSumitScriptType, "","autoSave","autoSave");
  }
}

afterFunction = function (sta, id) {
    if (id == "autoSave" &amp;&amp; sta == "autoSave"){    
setTimeout(function () {
            keep_focus("linkinput");
        }, 100);
}
var a=$("#printFlag").val() //扫码保存后触发自动打印

if(a==1){
$("#print").trigger("tap")
}
};

beforeFunction = function(sta,id){
    var a = $("#数量").val() * 1;
    var b = $("#可移数量").attr("value") * 1;
    var c = $("#原库位").val();
    var d = $("#新库位").val();
    
    if (a === 0) {
        alert("lang:{zh:移库数量不能为零,en:Transfer quantity cannot be zero,de:Umlagerungsmenge darf nicht null sein}");
        return true;  
    }
    
    if (a &gt; b) {
        alert("lang:{zh:输入的数量过大，已超出可移数量,en:Quantity exceeds transferable amount,de:Eingegebene Menge überschreitet die umlagerungsfähige Menge}");
        return true;
    }
    
    if (c == d ) {
        alert("lang:{zh:原库位和新库位相同，请检查,en:Source and destination locations are the same, please check,de:Quell- und Ziellagerort sind identisch, bitte überprüfen}");
        return true;
    }

    var a=$("#数据检查").val();
    if(a!=""&amp;&amp;( sta=="new"||sta=="autoSave")){
        alert(a);
        return true;
    }
    return false;
};</JavaScript>
