            globleDmNum,
            dataSumitScriptType,
            "",
            "autoSave",
            "autoSave"
        );            keep_focus("linkinput");
        return;
    }

    // modelpara 页面逻辑
    if (currWebid.indexOf("modelpara") !== -1) {
        if (dataCheck) {
            alert(dataCheck);
