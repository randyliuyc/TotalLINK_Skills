  <SQLScript>--LINKLOADDATAIMMEDIATE
SELECT S.[INSTCOD]  
      ,S.[INSTNAM]
      ,S.[BRAND]
      ,H.DOCNUM
      ,DATEDIFF(dd,GETDATE(),S.[INTCTLTO]) LIMITDAYS
      ,S.[INTCTLPRD] 
      ,IIF(S.[INTCTLFROM]='1900-01-01',NULL,S.[INTCTLFROM]) INTCTLFROM
      ,IIF(S.[INTCTLTO]='1900-01-01',NULL,S.[INTCTLTO]) INTCTLTO
      ,S.[INTCTLDAYS]
      ,S.[INTCTLSTD]
      ,S.[MODEL]
      ,S.[SERNUM]
      ,S.[LOC]
      ,S.[INSTDES]
      ,S.[INSTRNG]
      ,S.[RESPONS]
      ,S.[MANUSR]
      ,S.[CREDAT]
      ,S.[PURINF]
      ,U.ROUCOD ROUCODCK
      ,CASE WHEN DATEDIFF(dd,GETDATE(),S.[INTCTLTO])&lt;0 THEN 'D04'
            WHEN DATEDIFF(dd,GETDATE(),S.[INTCTLTO])&lt;=S.[INTCTLDAYS] THEN 'E04'
            ELSE 'H03' END LINKAPPRROW
FROM [QAINSTLST] S
   LEFT JOIN QAINSPH H
              ON H.ITMNO=S.INSTCOD
             AND H.ROUTYP = 'INE'
   LEFT JOIN QAROU U
              ON U.ROUCOD = CONCAT_WS('-','INE',S.INSTCOD)
WHERE S.[INTCTLPRD]&lt;&gt;0 AND S.[INTCTLTO]&lt;&gt;'1900-01-01'
ORDER BY DATEDIFF(dd,GETDATE(),S.[INTCTLTO])</SQLScript>
