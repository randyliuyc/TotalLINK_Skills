<SysDataModelXML xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ModelCode>TMESPUR20</ModelCode>
  <ModelNum>10</ModelNum>
  <ModelDesc>采购提单标签打印</ModelDesc>
  <KeyWords />
  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>--LINKAPPMENUHIDE
DECLARE @SITE VARCHAR(30)='{0}';
DECLARE @STADAT DATE='{1}';
DECLARE @ENDDAT DATE='{2}';
DECLARE @BPSNO VARCHAR(30)='%{3}%';
DECLARE @DOCNUM VARCHAR(30)='%{4}%'; 

SELECT D.[CTRNUM] - Isnull(A.NUM, 0) NPTNUM --需要打印包数
       ,Isnull(A.NUM, 0)  CPTNUM--已打印包数
       ,D.[CTRNUM] --包数
       ,D.[ITMNO]
       ,D.[ITMVER]
       ,D.[LOT]
       ,ISNULL(B.BPSNAM,H.BPSNO)  [BPSNO]
       ,ISNULL(P.OPTDES,H.[PLACEORI])  [PLACEORI]
       ,H.[BLNO]
       ,ISNULL(S.SITENAM,H.SITE)  [SITE]
       ,D.[FAC]
       ,H.[DEPT]
       ,D.[REQDAT]
       ,D.[QTYSTU]
       ,D.[STU]
       ,D.[UOMCOE]
       ,D.[QTY]
       ,D.[UOM]
       ,D.[CTRQTY]
       ,D.[DOCNUM]
       ,D.[DOCLIN]
       ,D.[SRCTYP]
       ,D.[SRCDOC]
       ,D.[SRCLIN]
       ,D.[DOCSTA]
       ,D.[CLOREA]
       ,D.[CREUSR]
       ,D.[UPDUSR]
       ,D.[CRETIM]
       ,D.[UPDTIM]
FROM   [PBOLH] H
       INNER JOIN [PBOLD] D
               ON H.DOCNUM = D.DOCNUM
       LEFT JOIN (SELECT Count(*) NUM
                         ,ITMNO
                         ,ITMVER
                         --,LOT
                         --,SUBLOT
                         ,ORIDOC
                         ,ORILIN
                  FROM   STKLOTLST WITH(NOLOCK)
                  WHERE  DOCTYP = 'PRC'
                         AND DOCGRP = ''
                         AND ORIDOC &lt;&gt; '' --提单收货
                  GROUP  BY ITMNO
                            ,ITMVER
                            --,LOT
                            --,SUBLOT
                            ,ORIDOC
                            ,ORILIN) A
              ON D.DOCNUM = A.ORIDOC
                 AND D.DOCLIN = A.ORILIN
			LEFT JOIN LINKOPT P ON P.OPTID=H.PLACEORI AND P.OPTTYP='PLACEORI'
			LEFT JOIN ENTSITE S ON H.SITE=S.SITE
			LEFT JOIN BPSUP   B ON H.BPSNO=B.BPSNO
WHERE  H.SITE = @SITE
/*
       AND ( D.REQDAT BETWEEN @STADAT AND @ENDDAT
              OR @STADAT = '' )
*/
    AND H.BPSNO LIKE @BPSNO
    AND H.DOCNUM+H.BLNO  LIKE @DOCNUM
    AND H.DOCSTA = '2'
ORDER BY H.CRETIM DESC</SQLScript>
