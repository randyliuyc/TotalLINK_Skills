  <SQLScript>DECLARE @GRDCOD VARCHAR(30)='%{0}%';
DECLARE @LOT VARCHAR(30)='%{1}%';
DECLARE @TV VARCHAR(30)='%{2}%';

SELECT M.[LOT]
      ,M.[TV]
      ,R.GRDNAM 
      ,M.[GRDCOD] 
      ,M.QAMATDOC
      ,CAST(E.[C] AS DECIMAL(18, 3))         [C]
      ,CAST(E.[Si] AS DECIMAL(18, 3))        [Si]
      ,CAST(E.[Mn] AS DECIMAL(18, 3))        [Mn]
      ,CAST(E.[P] AS DECIMAL(18, 3))         [P]
      ,CAST(E.[S] AS DECIMAL(18, 3))         [S]
      ,CAST(E.[Cr] AS DECIMAL(18, 3))        [Cr]
      ,CAST(E.[Ni] AS DECIMAL(18, 3))        [Ni]
      ,CAST(E.[Mo] AS DECIMAL(18, 3))        [Mo]
      ,CAST(E.[W] AS DECIMAL(18, 3))         [W]
      ,CAST(E.[Co] AS DECIMAL(18, 3))        [Co]
      ,CAST(E.[V] AS DECIMAL(18, 3))         [V]
      ,CAST(E.[Ti] AS DECIMAL(18, 3))        [Ti]
      ,CAST(E.[Cu] AS DECIMAL(18, 3))        [Cu]
      ,CAST(E.[Pb] AS DECIMAL(18, 3))        [Pb]
      ,CAST(E.[Sn] AS DECIMAL(18, 3))        [Sn]
      ,CAST(E.[Al] AS DECIMAL(18, 3))        [Al]
      ,CAST(E.[Nb] AS DECIMAL(18, 3))        [Nb]
      ,CAST(E.[N] AS DECIMAL(18, 3))         [N]
      ,CAST(E.[O] AS DECIMAL(18, 3))         [O]
      ,CAST(E.[B] AS DECIMAL(18, 3))         [B]
      ,CAST(E.[Bi] AS DECIMAL(18, 3))        [Bi]
      ,CAST(E.[Sb] AS DECIMAL(18, 3))        [Sb]
      ,CAST(E.[H] AS DECIMAL(18, 3))         [H]
      ,CAST(M.[DECARB] AS DECIMAL(18, 3))    [DECARB]
      ,CAST(M.[HARDNESS] AS DECIMAL(18, 3))  [HARDNESS]
      ,CAST(M.[GRAINSIZE] AS DECIMAL(18, 3)) [GRAINSIZE]
      ,CAST(M.[TENSILE]AS DECIMAL(18, 3))    [TENSILE]
      ,S.[SUPCOD]
      ,S.[COILREF]
      ,CAST(M.[DIA_WID] AS DECIMAL(18, 3))   [DIA_WID]
      ,CAST(M.[THICK] AS DECIMAL(18, 3))     [THICK]
      ,CAST(M.[LEN] AS DECIMAL(18, 3))       [LEN]
      ,CAST(S.[QTY] AS DECIMAL(18, 3))       [WEIGHT]
      ,M.[DLVINFO]
      ,S.[LOC]
      ,M.[STA]
      ,M.[CREUSR]
      ,M.[UPDUSR]
      ,CONVERT(VARCHAR(16),M.[CRETIM],21) [CRETIM]
      ,CONVERT(VARCHAR(16),M.[UPDTIM],21) [UPDTIM]
FROM   [QAMAT] M
       LEFT JOIN QAGRADE R
	   ON M.GRDCOD=R.GRDCOD AND CUSCOD=''
       LEFT JOIN (SELECT DOCNUM
                        ,[Al]
                        ,[B]
                        ,[Bi]
                        ,[C]
                        ,[Co]
                        ,[Cr]
                        ,[Cu]
                        ,[H]
                        ,[Mn]
                        ,[Mo]
                        ,[N]
                        ,[Nb]
                        ,[Ni]
                        ,[O]
                        ,[P]
                        ,[Pb]
                        ,[S]
                        ,[Sb]
                        ,[Si]
                        ,[Sn]
                        ,[Ti]
                        ,[V]
                        ,[W]
                  FROM   (SELECT DOCNUM
                                ,ELECOD
                                ,ELEVAL
                          FROM   [QAMATELE] E) AS SourceTable
                         PIVOT ( SUM(ELEVAL)
                               FOR ELECOD IN ([Al],
                                              [B],
                                              [Bi],
                                              [C],
                                              [Co],
                                              [Cr],
                                              [Cu],
                                              [H],
                                              [Mn],
                                              [Mo],
                                              [N],
                                              [Nb],
                                              [Ni],
                                              [O],
                                              [P],
                                              [Pb],
                                              [S],
                                              [Sb],
                                              [Si],
                                              [Sn],
                                              [Ti],
                                              [V],
                                              [W]) ) AS PivotTable) E
              ON M.[DOCNUM] = E.DOCNUM
       LEFT JOIN (SELECT MAX(BPRNUM_0)  SUPCOD
                        ,LOT_0          LOT
                        ,LEFT(SLO_0, 4) TV
                        ,MAX(LOC_0)     LOC
                        ,COUNT(*)       COILREF
                        ,SUM(QTYSTU_0)  QTY
                  FROM  #LC.X3DATA#STOJOU
                  WHERE  VCRTYP_0 = 6
                  GROUP  BY LOT_0
                            ,LEFT(SLO_0, 4)) S
              ON S.LOT = M.LOT #LC.X3COLLATE#
                 AND S.TV = M.TV #LC.X3COLLATE#
WHERE  M.GRDCOD LIKE @GRDCOD
       AND M.LOT LIKE @LOT
       AND M.TV LIKE @TV
ORDER BY M.LOT DESC</SQLScript>
