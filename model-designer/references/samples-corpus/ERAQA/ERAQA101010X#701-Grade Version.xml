  <SQLScript>--LINKNOGROUP
DECLARE @GRDCOD VARCHAR(30)='{0}';
DECLARE @CUSCOD VARCHAR(30)='{1}';

SELECT S.VER
      ,S.VERDESC LINKTEXTVERDESC
      ,S.VERDAT
      ,S.VERBY
      ,S.ID                               LINKROWID
FROM   QAGRADEVER S
WHERE  S.GRDCOD = @GRDCOD
       AND S.CUSCOD = @CUSCOD</SQLScript>
  <SQLUpdateScript>--LINKEDITMODE
