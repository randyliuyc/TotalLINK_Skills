  <SQLScript>DECLARE @DOCNUM VARCHAR(30) = '{0}';
DECLARE @DOCSTA VARCHAR(1);
DECLARE @CLOSTA BIT;

SELECT @DOCSTA = DOCSTA
       ,@CLOSTA = CLOSTA
FROM   MFGPKH H
WHERE  H.DOCNUM = @DOCNUM
       AND DOCTYP = 'MPH'
       AND H.DOCGRP = 'MPM';

IF @DOCSTA IS NULL
  BEGIN
      SELECT '领料单不存在！' 提示
      RETURN;
  END
IF @CLOSTA = 1
  BEGIN
      SELECT '领料单已关闭！' 提示
      RETURN;
  END
IF @DOCSTA = 4
  BEGIN
      SELECT '领料单已完成！' 提示
      RETURN;
  END
IF @DOCSTA &lt;&gt; 2
  BEGIN
      SELECT '领料单未确认！' 提示
      RETURN;
  END
SELECT @DOCNUM DOCNUM
       ,'OK'   提示</SQLScript>
