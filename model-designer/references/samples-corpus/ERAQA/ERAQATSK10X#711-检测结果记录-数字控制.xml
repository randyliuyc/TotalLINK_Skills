  <SQLNew>--LINKAUTOREPLACEEMPTYCOLUMNS
DECLARE @DOCNUM VARCHAR(30) = '{0}';
DECLARE @OPENUM VARCHAR(30) = '{1}';

-- 生成行号
DECLARE @VALLIN INT

SELECT @VALLIN = ISNULL(MAX(VALLIN), 0) + 10
FROM QAINSPVAL
WHERE DOCNUM = @DOCNUM
    AND OPENUM = @OPENUM

INSERT INTO QAINSPVAL (
    DOCNUM
    , OPENUM
    , VALLIN
    , TRXLIN
    , SPOOL
    , COIL
    , SAMP
    , N1
    , N2
    , N3
    , N4
    , N5
    , N6
    , N7
    , N8
    , CREUSR
    , CRETIM
    )
VALUES (
    @DOCNUM --DOCNUM
    , @OPENUM --OPENUM
    , @VALLIN --VALLIN
    , 0 --TRXLIN
    , '#SPOOL#'
    , '#COIL#'
    , '#SAMP#'
    , 0#N1# --N1
    , 0#N2# --N2
    , 0#N3# --N3
    , 0#N4# --N4
    , 0#N5# --N5
    , 0#N6# --N6
    , 0#N7# --N7
    , 0#N8# --N8
    , N'#LOGIN_USER#' --CREUSR
    , getdate() --CRETIM
    );

-- 行计算值
EXECUTE [SP_INSPVAL_NCHECK] 
   @DOCNUM
  ,@OPENUM
  ,@VALLIN
  ,0;</SQLNew>
