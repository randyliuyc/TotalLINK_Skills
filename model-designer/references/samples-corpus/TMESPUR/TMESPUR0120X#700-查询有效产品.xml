  <ModelDesc>查询有效产品</ModelDesc>
  <KeyWords />
  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>DECLARE @TCLCOD VARCHAR(30) = '{0}';
DECLARE @TSICOD1 VARCHAR(30) = '{1}';
DECLARE @TSICOD2 VARCHAR(30) = '{2}';
DECLARE @TSICOD3 VARCHAR(30) = '{3}';  
DECLARE @ITMSIZE NVARCHAR(100) = N'%{4}%';  
DECLARE @ITMSPEC NVARCHAR(100) = N'%{5}%';  
DECLARE @ITM VARCHAR(30) = '%{6}%';  

SELECT X.ITMKey
       ,X.ITMDES
       ,X.ITMNO
       ,X.ITMNOORI
       ,T1.OPTDES OPTDES1
       ,T2.OPTDES OPTDES2
       ,X.ITMNAM
       ,X.ITMNAM1
       ,X.ITMNAM2
       ,X.ITMSIZE
       ,X.ITMSPEC
       ,X.REQDAT
       ,X.ITMSHO
       ,X.TCLCOD
       ,X.TSICOD1
       ,X.TSICOD2
       ,X.TSICOD3
       ,X.TSICOD4
       ,X.TSICOD5
       ,X.SITE
       ,X.SEAKEY
       ,X.ITMSTA
       ,X.STU --库存单位
       ,X.UOM --采购单位
       ,X.SAU
       ,X.UOMCOE --采购单位系数
       ,X.SAUCOE
       ,X.WEU
       ,X.ITMWEI
       ,X.PCU
       ,X.PCUCOE
       ,X.SIZEU
       ,X.SIZELONG
       ,X.SIZEWIDTH
       ,X.SIZEHIGH
       ,X.CBU
       ,X.ITMCUB
       ,X.STKQTY
       ,X.PORQTY
       ,X.ITMVERFLG
FROM   (SELECT TOP 500 S.ITMNO  ITMKey
                       ,S.ITMNO+S.ITMNAM          ITMDES
                       ,S.ITMNO
                       ,S.ITMNOORI
                       ,S.ITMNAM --中文描述
                       ,S.ITMNAM1 --越南描述 
                       ,S.ITMNAM2 --英文描述
                       ,S.ITMSIZE
                       ,S.ITMSPEC
                       ,'#LINKDATE(0,0,0,yyyy-MM-dd)#'           REQDAT
                       ,S.ITMSHO
                       ,S.TCLCOD
                       ,S.TSICOD1
                       ,S.TSICOD2
                       ,S.TSICOD3
                       ,S.TSICOD4
                       ,S.TSICOD5
                       ,ITMSITE.SITE
                       ,S.SEAKEY
                       ,S.ITMSTA
                       ,S.STU --库存单位
                       ,S.PUU                                    UOM --采购单位
                       ,S.SAU
                       ,S.PUUCOE                                 UOMCOE --采购单位系数
                       ,S.SAUCOE
                       ,S.WEU
                       ,S.ITMWEI
                       ,S.PCU
                       ,S.PCUCOE
                       ,S.SIZEU
                       ,S.SIZELONG
                       ,S.SIZEWIDTH
                       ,S.SIZEHIGH
                       ,S.CBU
                       ,S.ITMCUB
                       ,STK.STKQTY
                       ,POR.PORQTY
                       ,S.ITMVERFLG
        FROM   ITM S
               LEFT JOIN ITMSITE
                      ON S.ITMNO = ITMSITE.ITMNO --地点
               LEFT JOIN (SELECT ITMNO
                                 ,Sum(K.QTY) STKQTY
                          FROM   STK  K
                          INNER JOIN ENTWH WH
                         ON WH.WH = K.WH
                         AND WH.WHGRP = 'STO'
              -- 2026年10月19日，XXK，限制仅存储仓库
    
                          GROUP  BY ITMNO) STK
                      ON STK.ITMNO = S.ITMNO
               LEFT JOIN (
                         -- 采购在途
                         SELECT L.ITMNO
                                ,Sum(L.QTY - L.PRCQTY + L.PRTQTY) PORQTY
                          FROM   PORDLIN L
                                 INNER JOIN PORDER H
                                         ON H.DOCNUM = L.DOCNUM
                          WHERE  H.DOCSTA = 2
                                 AND L.DOCSTA = 2
                          GROUP  BY L.ITMNO) POR
                      ON POR.ITMNO = S.ITMNO
        WHERE  S.ITMSTA = '1' --激活的
               AND ( S.TCLCOD = @TCLCOD
                      OR @TCLCOD = '' ) --产品种类
               AND ( S.TSICOD1 = @TSICOD1
                      OR @TSICOD1 = '' )
               AND ( S.TSICOD2 = @TSICOD2
                      OR @TSICOD2 = '' )
               AND ( S.TSICOD3 = @TSICOD3
                      OR @TSICOD3 = '' )
               AND S.ITMSIZE LIKE @ITMSIZE
               AND S.ITMSPEC LIKE @ITMSPEC
               AND S.ITMNO + S.ITMNAM + S.ITMNAM1 + S.ITMNAM2
                   + S.ITMSPEC + S.ITMSIZE LIKE @ITM
        ORDER  BY S.ITMNO ASC) X
       LEFT JOIN LINKOPT T1
              ON T1.OPTTYP = 'TSICOD1'
                 AND T1.OPTID = X.TSICOD1
                 AND T1.OPTTYP = 'TSICOD1'
       LEFT JOIN LINKOPT T2
              ON T2.OPTTYP = 'TSICOD2'
                 AND T2.OPTID = X.TSICOD2
ORDER  BY X.ITMNO ASC</SQLScript>
