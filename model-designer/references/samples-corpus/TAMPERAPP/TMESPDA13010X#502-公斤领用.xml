  <SQLClear>INSERT INTO STKCHG
            ([DOCNUM]
             ,[DOCLIN]
             ,[DOCTYP]
             ,[DOCGRP]
             ,DOCDAT
             ,SITE
             ,[ITMNO]
             ,ITMVER
             ,[WH]
             ,[LOC]
             ,[PAL]
             ,[CTR]
             ,[LOT]
             ,[SUBLOT]
             ,[BPSLOT]
             ,[SER]
             ,[STA]
             ,[STU]
             ,[UOM]
             ,[UOMCOE]
             ,[TAGTYP]
             ,[TAGNO]
             ,CTRNUM
             ,CTRQTY
             ,[QTYSTU]
             ,[QTY]
             ,[ITMNO1]
             ,[ITMVER1]
             ,[WH1]
             ,[LOC1]
             ,[PAL1]
             ,[CTR1]
             ,[LOT1]
             ,[SUBLOT1]
             ,[BPSLOT1]
             ,[PRJNUM1]
             ,[SER1]
             ,[STA1]
             ,[STU1]
             ,[QTYSTU1]
             ,[UOM1]
             ,[QTY1]
             ,[UOMCOE1]
             ,[REMARK]
             ,[PRJNUM]
             ,[SUBSTA]
             ,[SUBTIM]
             ,[PK]
             ,XWSPK
             ,[BATCHID]
             ,[SRCTYP]
             ,[SRCDOC]
             ,[SRCLIN]
             ,[ORITYP]
             ,[ORIDOC]
             ,[ORILIN]
             ,[DOCSTA]
             ,[CREUSR]
             ,[UPDUSR]
             ,[CRETIM]
             ,[UPDTIM]
             ,[CLOREA])
SELECT ''              AS DOCNUM
       ,1              AS DOCLIN
       ,'CHG'          AS DOCTYP
       ,'MPM'          AS DOCGRP --库位变动
       ,Getdate()      AS DOCDAT
       ,H.SITE         AS SITE
       ,L.CPNITMNO     AS ITMNO
       ,L.CPNITMVER    AS ITMVER
       ,STK.WH         AS WH
       ,STK.LOC        AS LOC
       ,STK.PAL        AS PAL
       ,STK.CTR        AS CTR
       ,STK.LOT        AS LOT
       ,STK.SUBLOT     AS SUBLOT
       ,STK.BPSLOT     AS BPSLOT
       ,STK.SER        AS SER
       ,STK.STA        AS STA
       ,STK.STU        AS STU
       ,STK.STU        AS UOM
       ,1              AS UOMCOE
       ,''             AS TAGTYP
       ,''             AS TAGNO
       ,STK.CTRNUM     AS CTRNUM
       ,STK.CTRQTY     AS CTRQTY
       ,0#QTYSTU#      AS QTYSTU
       ,0#QTYSTU#      AS QTY
       ,STK.ITMNO      AS ITMNO1
       ,STK.ITMVER     AS ITMVER1
       ,H.DESTWH       AS WH
       ,H.DESTLOC      AS LOC1
       ,STK.PAL        AS PAL1
       ,STK.CTR        AS CTR1
       ,STK.LOT        AS LOT1
       ,STK.SUBLOT     AS SUBLOT1
       ,STK.BPSLOT     AS BPSLOT1
       ,STK.PRJNUM     AS PRJNUM1
       ,STK.SER        AS SER1
       ,STK.STA        AS STA1
       ,STK.STU        AS STU1
       ,0#QTYSTU#      AS QTYSTU1
       ,STK.STU        AS UOM1
       ,0#QTYSTU#      AS QTY1
       ,1              AS UOMCOE1
       ,''             AS REMARK
       ,STK.PRJNUM     AS PRJNUM
       ,1              AS SUBSTA
       ,Getdate()      AS SUBTIM
       ,Newid()        AS PK
       ,STK.PK         AS XWSPK
       ,''             AS BATCHID
       ,L.DOCTYP       AS SRCTYP
       ,L.DOCNUM       AS SRCDOC
       ,L.DOCLIN       AS SRCLIN
       ,''             AS ORITYP
       ,''             AS ORIDOC
       ,0              AS ORILIN
       ,1              AS DOCSTA
       ,'#LOGIN_USER#' AS CREUSR
       ,''             AS UPDUSR
       ,Getdate()      AS CRETIM
       ,''             AS UPDTIM
       ,''             AS CLOREA
FROM   MFGPKL L
       LEFT JOIN MFGPKH H
              ON H.DOCNUM = L.DOCNUM
       INNER JOIN STK
               ON L.CPNITMNO = STK.ITMNO
WHERE  L.DOCNUM = '#SRCDOC#'
       AND L.DOCLIN = 0#SRCLIN#
       AND STK.PK = '#PK#'</SQLClear>
