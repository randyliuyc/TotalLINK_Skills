  <SQLScript>--LINKNOGROUP
DECLARE @ROUCOD VARCHAR(30) = '{0}';
SELECT S.[OPENUM]
      ,S.[OPESTD]
      ,S.[OPEGRP]
      ,D.[OPEDES1]
      ,D.[OPEDES2]
      ,D.[INSTRUCTION]
      ,S.[OPEUNT]
      ,S.[CTLTYP] LINKDROPVALIDCTLTYP
      ,S.[MEAFRQ] LINKDROPVALIDMEAFRQ
      ,S.[INSTCAT] LINKDROPVALIDINSTCAT
      ,S.[INSTCOD]
      ,CAST(E.XESMMDWMM_0 AS DECIMAL(18,3)) XESMMDWMM
      ,CAST(S.[VALNOR] AS DECIMAL(18,3)) VALNOR
      ,CAST(S.[VALMIN] AS DECIMAL(18,3)) VALMIN
      ,CAST(S.[VALMAX] AS DECIMAL(18,3)) VALMAX
      ,S.[USERFLG]
      ,S.[DATEFLG]
      ,S.[INSTFLG]
      ,S.[QTYOKFLG]
      ,S.[QTYSCFLG]
      ,S.[REASCFLG]
      ,S.[CREUSR]
      ,S.[UPDUSR]
      ,CONVERT(VARCHAR(16),S.[CRETIM],21) CRETIM
      ,CONVERT(VARCHAR(16),S.[UPDTIM],21) UPDTIM
      ,S.ID LINKROWID
  FROM [QAROULIN] S
  LEFT JOIN #LC.X3DATA#ROUOPE E
  ON S.ROUCOD=CONCAT_WS('-',ITMREF_0,ROUALT_0,OPENUM_0) COLLATE Chinese_PRC_CI_AI
  LEFT JOIN QAOPESTD D
  ON S.OPESTD=D.OPESTD
  WHERE S.ROUCOD=@ROUCOD
  ORDER BY S.[OPENUM]</SQLScript>
  <SQLUpdateScript>--LINKSAVEONENTERKEY
--LINKEDITMODE
UPDATE QAROULIN SET
  OPEGRP = N'#OPEGRP#'
, OPEUNT = N'#OPEUNT#'
, CTLTYP = N'#LINKDROPVALIDCTLTYP#'
, MEAFRQ = N'#LINKDROPVALIDMEAFRQ#'
, INSTCOD=N'#INSTCOD#'
, INSTCAT=N'#LINKDROPVALIDINSTCAT#'
, VALNOR=N'#VALNOR#'
, VALMIN=0#VALMIN#
, VALMAX=0#VALMAX#
, USERFLG=IIF('#USERFLG#'='true',1,0)
, DATEFLG=IIF('#DATEFLG#'='true',1,0)
, INSTFLG=IIF('#INSTFLG#'='true',1,0)
, QTYOKFLG=IIF('#QTYOKFLG#'='true',1,0)
, QTYSCFLG=IIF('#QTYSCFLG#'='true',1,0)
, REASCFLG=IIF('#REASCFLG#'='true',1,0)
, UPDUSR = N'#LOGIN_USER#'
, UPDTIM = GETDATE()
WHERE ID=0#LINKROWID#</SQLUpdateScript>
