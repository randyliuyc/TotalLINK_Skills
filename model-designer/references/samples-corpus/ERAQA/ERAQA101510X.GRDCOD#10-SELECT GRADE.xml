  <SQLScript>SELECT S.GRDCOD
      ,S.GRDNAM
      ,S.EUSTD
      ,S.ENSTD
      ,S.DENSITY
      ,S.DENUNIT
      ,CAST(S.HDANNEAL AS REAL) HDANNEAL
      ,S.HDUNIT1
      --,CAST(S.HDDRAWN AS REAL) HDDRAWN
      ,S.HDDRAWN
      ,S.HDUNIT2
      ,CAST(S.TENSILE AS REAL) TENSILE
      ,S.TENUNIT
      ,S.COMMENT
      ,S.STD1
      ,S.STD2
      ,S.SUPCOD
FROM   QAGRADE S
WHERE  S.STA='Release'
    AND S.CUSCOD=''
ORDER BY S.GRDCOD</SQLScript>
