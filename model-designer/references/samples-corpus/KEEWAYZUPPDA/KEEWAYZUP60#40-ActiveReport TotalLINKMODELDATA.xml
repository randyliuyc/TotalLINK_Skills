  <SQLScript>SELECT S.ITMREF_0  产品编码
      ,LEFT(S.PKORI_0, NULLIF(PATINDEX('%[- ]%', S.PKORI_0), 0) - 1)  工单号
      ,ISNULL(B.ITMDES, ITMDES1_0) 产成品描述
      ,ITM.YMDDES_0 产品备注 
      ,ITM.EANCOD_0 
      ,LEFT(S.PKORI_0, NULLIF(PATINDEX('%[- ]%', S.PKORI_0), 0) - 1) 
        + '-' + S.ITMREF_0 + '-' 
        + REVERSE(LEFT(REVERSE(S.PKORI_0), NULLIF(PATINDEX('%[- ]%', REVERSE(S.PKORI_0)), 0) - 1)) 条形码
FROM   XWSSDH S
LEFT  JOIN ITMMASTER ITM
    ON ITM.ITMREF_0 = S.ITMREF_0
LEFT JOIN (SELECT B.IDENT1_0 ITMREF_0
                , B.TEXTE_0 ITMDES 
           FROM ATEXTRA B
           WHERE B.CODFIC_0 = 'ITMMASTER'
             AND B.LANGUE_0 = 'GER'
             AND B.ZONE_0 = 'DES1AXX') B
         ON B.ITMREF_0 = ITM.ITMREF_0
WHERE  (S.PK_0 ='{0}' OR S.SERNUM_0 ='{0}') AND '{0}'&lt;&gt;''
ORDER  BY S.CREDATIM_0</SQLScript>
