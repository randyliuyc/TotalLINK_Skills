  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>--LINKDATAMINEOVERVIEW,,60,AUTOREFRESH
DECLARE @DEPT VARCHAR(30)='%{0}%';
DECLARE @PCPSTA VARCHAR(30)='%{1}%';

SELECT S.[DOCNUM]
      ,[DEPT].OPTDES                        DEPT
      ,[PCPSTA].OPTDES                      PCPSTA
      ,CAST(IIF(H.CLOSTA=1,1,0) AS BIT)     CLOSTA
      ,S.[DEMANDER]
      ,S.[INSPREA]
      ,S.[GRADE]
      ,S.[SIZE]
      ,S.[LOT]
      ,S.[CREUSR]
      ,S.[UPDUSR]
      ,CONVERT(VARCHAR(16), S.[CRETIM], 21) CRETIM
      ,CONVERT(VARCHAR(16), S.[UPDTIM], 21) UPDTIM
FROM   [QAINSPREQ] S
       LEFT JOIN QAINSPH H
              ON S.DOCNUM = H.DOCNUM
       LEFT JOIN QAOPT PCPSTA
              ON PCPSTA.OPTTYP = 'PCPSTA'
                 AND PCPSTA.OPTID = S.PCPSTA
       LEFT JOIN QAOPT DEPT
              ON DEPT.OPTTYP = 'DEPT'
                 AND DEPT.OPTID = S.DEPT
WHERE  S.DEPT LIKE @DEPT
       AND S.PCPSTA LIKE @PCPSTA
ORDER BY DOCNUM DESC</SQLScript>
