  <SQLScript>DECLARE @LAN VARCHAR(30) = '#LOGIN_LAN#';
DECLARE @LANX3 VARCHAR(30) = (
    SELECT #LC.X3ERP#GETLANX3(@LAN)
    );
DECLARE @SITE VARCHAR(10)='{0}'; --收货地点
DECLARE @PTHNUM VARCHAR(50)='%{1}%'; --收货单号
DECLARE @BATCHID VARCHAR(50)=N'{2}';

SELECT D.POHNUM_0                             采购订单号
      ,D.ITMREF_0                             存货编码
      ,ISNULL(L1.ITMDES, ITM.ITMDES1_0)       产品描述1
      ,ISNULL(L2.ITMDES, ITM.ITMDES2_0)       产品描述2
      ,D.UOM_0                                单位
      ,cast(D.QTYUOM_0 AS REAL)               数量
      ,F.DEFLOC_0                             收货库位
      ,R.ORDREF_0                             备注
      ,D.PTHNUM_0                             pid
      ,D.UPDUSR_0                             操作人员
      ,CONVERT(VARCHAR(16), D.UPDDATTIM_0, 21)操作时间
FROM   PRECEIPTD D
       INNER JOIN ITMFACILIT F
               ON D.POHFCY_0 = F.STOFCY_0
                  AND D.ITMREF_0 = F.ITMREF_0
       INNER JOIN PORDER R
               ON D.POHNUM_0 = R.POHNUM_0
       LEFT JOIN (SELECT MAX(BATCHID_0) BATCHID_0
                        ,RPNUM_0
                  FROM   XWSPTH
                  WHERE  RPFLG_0 = 3
                  GROUP  BY RPNUM_0)XWS
              ON XWS.RPNUM_0 = D.PTHNUM_0
       INNER JOIN ITMMASTER ITM
               ON ITM.ITMREF_0 = D.ITMREF_0
          LEFT JOIN ITMLAN1 L1
              ON L1.ITMREF = ITM.ITMREF_0
                 AND L1.LANX3 = @LANX3
       LEFT JOIN ITMLAN2 L2
              ON L2.ITMREF = ITM.ITMREF_0
                 AND L2.LANX3 = @LANX3
WHERE  D.PRHFCY_0 = @SITE
       AND D.PTHNUM_0 LIKE @PTHNUM
       AND ( ISNULL(XWS.BATCHID_0, '') = @BATCHID
              OR @BATCHID = '' )
ORDER  BY D.PTDLIN_0</SQLScript>
