  <SQLScript>--LINKLOADDATAIMMEDIATE
SELECT G.GRDCOD
      ,G.CUSCOD
      ,G.GRDNAM
      ,G.DENSITY
      ,G.DENUNIT
      ,CAST(G.HDANNEAL AS DECIMAL(18, 2)) HDANNEAL
      ,G.HDUNIT1
      ,G.HDDRAWN
      ,G.HDUNIT2
      ,CAST(G.TENSILE AS DECIMAL(18, 2))  TENSILE
      ,G.TENUNIT
      ,G.COMMENT
      ,G.EUSTD
      ,G.ENSTD
      ,G.STD1
      ,G.STD2
      ,G.SUPCOD
      ,G.STA
      ,[C_Min]
      ,[C_Max]
      ,[Si_Min]
      ,[Si_Max]
      ,[Mn_Min]
      ,[Mn_Max]
      ,[P_Min]
      ,[P_Max]
      ,[S_Min]
      ,[S_Max]
      ,[Cr_Min]
      ,[Cr_Max]
      ,[Ni_Min]
      ,[Ni_Max]
      ,[Mo_Min]
      ,[Mo_Max]
      ,[W_Min]
      ,[W_Max]
      ,[Co_Min]
      ,[Co_Max]
      ,[V_Min]
      ,[V_Max]
      ,[Ti_Min]
      ,[Ti_Max]
      ,[Cu_Min]
      ,[Cu_Max]
      ,[Pb_Min]
      ,[Pb_Max]
      ,[Sn_Min]
      ,[Sn_Max]
      ,[Al_Min]
      ,[Al_Max]
      ,[Nb_Min]
      ,[Nb_Max]
      ,[N_Min]
      ,[N_Max]
      ,[O_Min]
      ,[O_Max]
      ,[B_Min]
      ,[B_Max]
      ,[Bi_Min]
      ,[Bi_Max]
      ,[Sb_Min]
      ,[Sb_Max]
      ,[H_Min]
      ,[H_Max]
      ,G.CREUSR
      ,G.UPDUSR
      ,G.CRETIM
      ,G.UPDTIM
FROM   QAGRADE G
       INNER JOIN (SELECT GRDCOD
                         ,[C_MIN]
                         ,[C_MAX]
                         ,[Si_MIN]
                         ,[Si_MAX]
                         ,[Mn_MIN]
                         ,[Mn_MAX]
                         ,[P_MIN]
                         ,[P_MAX]
                         ,[S_MIN]
                         ,[S_MAX]
                         ,[Cr_MIN]
                         ,[Cr_MAX]
                         ,[Ni_MIN]
                         ,[Ni_MAX]
                         ,[Mo_MIN]
                         ,[Mo_MAX]
                         ,[W_MIN]
                         ,[W_MAX]
                         ,[Co_MIN]
                         ,[Co_MAX]
                         ,[V_MIN]
                         ,[V_MAX]
                         ,[Ti_MIN]
                         ,[Ti_MAX]
                         ,[Cu_MIN]
                         ,[Cu_MAX]
                         ,[Pb_MIN]
                         ,[Pb_MAX]
                         ,[Sn_MIN]
                         ,[Sn_MAX]
                         ,[Al_MIN]
                         ,[Al_MAX]
                         ,[Nb_MIN]
                         ,[Nb_MAX]
                         ,[N_MIN]
                         ,[N_MAX]
                         ,[O_MIN]
                         ,[O_MAX]
                         ,[B_MIN]
                         ,[B_MAX]
                         ,[Bi_MIN]
                         ,[Bi_MAX]
                         ,[Sb_MIN]
                         ,[Sb_MAX]
                         ,[H_MIN]
                         ,[H_MAX]
                   FROM   (SELECT GRDCOD
                                 ,ELECOD + '_MIN'                AS ElementType
                                 ,CAST(ELEMIN AS DECIMAL(18, 3)) AS ElementValue
                           FROM   QAGRADEELE
                           UNION ALL
                           SELECT GRDCOD
                                 ,ELECOD + '_MAX' AS ElementType
                                 ,CAST(ELEMAX AS DECIMAL(18, 3))         AS ElementValue
                           FROM   QAGRADEELE) AS SourceTable
                          PIVOT(MAX(ElementValue)
                               FOR ElementType IN ( [C_MIN],
                                                    [C_MAX],--
                                                    [Si_MIN],
                                                    [Si_MAX],--
                                                    [Mn_MIN],
                                                    [Mn_MAX],--
                                                    [P_MIN],
                                                    [P_MAX],--
                                                    [S_MIN],
                                                    [S_MAX],--
                                                    [Cr_MIN],
                                                    [Cr_MAX],--
                                                    [Ni_MIN],
                                                    [Ni_MAX],--
                                                    [Mo_MIN],
                                                    [Mo_MAX],--
                                                    [W_MIN],
                                                    [W_MAX],--
                                                    [Co_MIN],
                                                    [Co_MAX],--
                                                    [V_MIN],
                                                    [V_MAX],--
                                                    [Ti_MIN],
                                                    [Ti_MAX],--
                                                    [Cu_MIN],
                                                    [Cu_MAX],--
                                                    [Pb_MIN],
                                                    [Pb_MAX],--
                                                    [Sn_MIN],
                                                    [Sn_MAX],--
                                                    [Al_MIN],
                                                    [Al_MAX],--
                                                    [Nb_MIN],
                                                    [Nb_MAX],--
                                                    [N_MIN],
                                                    [N_MAX],--
                                                    [O_MIN],
                                                    [O_MAX],--
                                                    [B_MIN],
                                                    [B_MAX],--
                                                    [Bi_MIN],
                                                    [Bi_MAX],--
                                                    [Sb_MIN],
                                                    [Sb_MAX],--
                                                    [H_MIN],
                                                    [H_MAX] --
                          )) AS PivotTable) E
               ON E.GRDCOD = G.GRDCOD</SQLScript>
