  <SQLScript>--LINKNOGROUP
DECLARE @STOFCY VARCHAR(50)='{0}'
DECLARE @X3HNUM VARCHAR(50)='{1}';
DECLARE @X3DLIN BIGINT=0{2};


SELECT S.PK_0                                 LINKROWID
      ,S.SERNUM_0                             序列号
      ,S.PKORI_0                              工单序号
      ,CAST(S.QTY_0 AS REAL)                  发货数量
      ,S.LOC_0                                发货库位
      ,S.LOT_0                                批次
      ,CASE
	      WHEN S.STAT_0=2 AND S.RPFLG_0=3 AND ISNULL(Y.SDHNUM_0,'')='' THEN N'lang:{zh:ERP删除发货单，请删除该条数据,en:Delete delivery note, please delete this record,de:Lieferschein löschen, bitte Datensatz löschen}'
		  ELSE S.RPNUM_0     END                         发货单号
     ,Y.YZUPLGCNO_0                           物流单号
      ,CONVERT(VARCHAR(16), S.CREDATTIM_0, 21) 操作时间
      ,S.USERID_0                             操作人员
      ,'{3}'  打印机
      ,S.STOFCY_0 地点
      ,CASE
          WHEN S.STAT_0=2 AND S.RPFLG_0=3 AND ISNULL(Y.SDHNUM_0,'')='' THEN N''
          WHEN ISNULL(S.RPFLG_0, 3) = 3 THEN 'mui-hidden'
          ELSE ''
        END                                   LINKROWIDBTNFLG
	  ,CASE 
	     WHEN  S.STAT_0=2 AND S.RPFLG_0=3 AND ISNULL(Y.SDHNUM_0,'')='' OR S.RPFLG_0 IN(1,2) THEN 'E02'
		 ELSE '' END AS       ROW_BACKCOLOR
FROM   XWSSDH S
LEFT JOIN SDELIVERY Y
ON S.RPNUM_0=Y.SDHNUM_0 
WHERE  S.STOFCY_0 = @STOFCY
       AND S.X3HNUM_0 = @X3HNUM
       AND S.X3DLIN_0 = @X3DLIN
ORDER  BY S.CREDATIM_0 DESC</SQLScript>
