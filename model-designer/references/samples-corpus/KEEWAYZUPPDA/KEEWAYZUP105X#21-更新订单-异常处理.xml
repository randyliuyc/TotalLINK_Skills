  <SQLClear>--LINKREFRESH

DECLARE @SDHNUM VARCHAR(30)='{1}';

--当ERP删除收货单时，可更新订单重新收货
UPDATE XWSPTH SET RPFLG_0=1
                 ,STAT_0=1
                 ,RPNUM_0=''
     FROM XWSPTH XWS
     LEFT JOIN PRECEIPT S
    ON XWS.RPNUM_0=S.PTHNUM_0
WHERE XWS.SDHNUM_0=@SDHNUM
   AND S.PTHNUM_0 IS NULL
   AND XWS.RPFLG_0=3
        
--订单匹配不上时，调整匹配逻辑后可更新订单号和行号
UPDATE XWSPTH
SET    POHNUM_0 = P.POHNUM_0,
       POPLIN_0 = P.POPLIN_0,
       STAT_0=1 --考虑webservice异常情况下也可处理
FROM   SDELIVERYD D
       INNER JOIN PORDERQ P
               ON P.XREFSOH_0 = D.SOHNUM_0
                  AND P.XREFSLIN_0 = D.SOPLIN_0
                  AND P.ITMREF_0 = D.ITMREF_0
       INNER JOIN XWSPTH XWS
               ON XWS.SDHNUM_0 = D.SDHNUM_0
                  AND XWS.SDDLIN_0 = D.SDDLIN_0
WHERE  D.SDHNUM_0 = @SDHNUM
       AND XWS.RPFLG_0&lt;&gt;3</SQLClear>
