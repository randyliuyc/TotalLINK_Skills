  <SQLScript>DECLARE @OPESTD VARCHAR(30)='{0}';

SELECT S.VALDES
      ,S.VALCTL LINKDROPVALIDVALCTL
      ,S.VALTYP
      ,S.CREUSR
      ,S.UPDUSR
      ,CONVERT(VARCHAR(16), S.CRETIM, 21) CRETIM
      ,CONVERT(VARCHAR(16), S.UPDTIM, 21) UPDTIM
      ,S.ID                               LINKROWID
FROM   QAOPESTDCTL S
WHERE  S.OPESTD = @OPESTD
ORDER  BY S.VALTYP, S.VALLIN</SQLScript>
  <SQLUpdateScript>--LINKEDITMODE
--LINKSAVEONENTERKEY
UPDATE QAOPESTDCTL SET
  VALDES = N'#VALDES#'
, VALCTL = N'#LINKDROPVALIDVALCTL#'
, UPDUSR = N'#LOGIN_USER#'
, UPDTIM = GETDATE()
WHERE ID=0#LINKROWID#</SQLUpdateScript>
