  <ChartType />
  <SQLScript>SELECT S.[INSTCOD]
      ,S.[INSTCAT]    
      ,S.[INSTNAM]
      ,S.[BRAND]
      ,S.[MODEL]
      ,S.[SERNUM]
      ,S.[LOC]
      ,S.[INSTDES]
      ,S.[INSTRNG]
      ,S.[RESPONS]
      ,S.[MANUSR]
      ,IIF(S.[CREDAT]='1900-01-01','#LINK_TODAY#',S.[CREDAT]) CREDAT
      ,S.[PURINF]
      ,S.[CONRPT]
      ,S.[INTCTLPRD] LINKDROPVALIDINTCTLPRD
      ,IIF(S.[INTCTLFROM]='1900-01-01',NULL,S.[INTCTLFROM]) INTCTLFROM
      ,IIF(S.[INTCTLTO]='1900-01-01',NULL,S.[INTCTLTO]) INTCTLTO
      ,S.[INSTSTA] LINKDROPVALIDINSTSTA
      ,S.[INTCTLDAYS]
      ,S.[INTCTLSTD]
      ,S.[CLBPRD]  
      ,S.[CLBSTD]
      ,IIF(S.[CLBCTLFROM]='1900-01-01',NULL,S.[CLBCTLFROM]) CLBCTLFROM
      ,IIF(S.[CLBCTLTO]='1900-01-01',NULL,S.[CLBCTLTO]) CLBCTLTO
      ,S.[CLBDAYS]
      ,S.[COST]
      ,S.[CREUSR]
      ,S.[CRETIM]
      ,S.[UPDUSR]
      ,S.[UPDTIM]
  FROM [QAINSTLST] S
ORDER BY S.INSTCOD</SQLScript>
