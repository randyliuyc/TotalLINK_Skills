  <SQLScript>SELECT PRE.ITMNO
       ,H.DOCNUM
       ,CONVERT(VARCHAR(10), H.DOCDAT, 21)    DOCDAT
       ,H.DEPT
       ,D.DEPTNAM
       ,H.CREUSR
       ,S1.NAME                               RNAME
       ,Cast(PRE.QTY AS REAL)                 QTY
       ,CONVERT(VARCHAR(10), PRE.REQDAT, 21)  REQDAT
       ,PRE.REMARK
       ,Isnull((SELECT TOP 1 [FILURL]
                FROM   [LINKDOCFIL]
                WHERE  SRCDOC = H.DOCNUM
                ORDER  BY [CRETIM] DESC), '') NAME
       ,Isnull((SELECT TOP 1 [FILNAM]
                FROM   [LINKDOCFIL]
                WHERE  SRCDOC = H.DOCNUM
                ORDER  BY [CRETIM] DESC), '') text
FROM   PINQUL PIN
       LEFT JOIN PREQUL PRE
              ON PRE.PINNUM = PIN.DOCNUM
                 AND PRE.ITMNO = PIN.ITMNO
       LEFT JOIN PREQUH H
              ON H.DOCNUM = PRE.DOCNUM
       LEFT JOIN LINK.DBO.SysUser S1
              ON H.CREUSR = S1.LoginUser
       LEFT JOIN [ENTDEPT] D
              ON H.[DEPT] = D.DEPT
WHERE  PRE.PINNUM = '{0}'
       AND PRE.ITMNO = '{1}'</SQLScript>
