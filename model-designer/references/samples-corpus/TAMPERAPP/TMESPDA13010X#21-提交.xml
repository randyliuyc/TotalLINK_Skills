  <SQLClear>--LINKREFRESH
--LINKEXECOUTPUT 
DECLARE @RC INT
DECLARE @DOCTYP VARCHAR(3) = 'CHG'
DECLARE @BATCHID VARCHAR(50) = '#LINKID_ACTION#'
DECLARE @USER VARCHAR(30) = '#LOGIN_USER#'
DECLARE @LAN VARCHAR(30) = '#LOGIN_LAN#'
DECLARE @RPTSTA INT
DECLARE @RPTMSG NVARCHAR(max)


DECLARE @DOCNUM VARCHAR(30) = '{1}'

UPDATE STKCHG
SET    BATCHID = @BATCHID
       ,SUBTIM = Getdate()
WHERE  CREUSR = @USER
       AND DOCTYP = @DOCTYP
	   AND DOCGRP = 'MPM'
       AND SUBSTA &lt; 3
       AND SRCDOC = @DOCNUM

--执行提交处理
EXECUTE @RC = [dbo].[Stksubmit_CHG]
  @BATCHID
  ,@USER
  ,@LAN
  ,@RPTSTA OUTPUT
  ,@RPTMSG OUTPUT


SELECT @RPTSTA  AS RPTSTA
       ,@RPTMSG AS RPTMSG;</SQLClear>
