  <SQLScript>SELECT S.DOCNUM
      ,S.SITE
      ,DOCGRP.OPTDES                           DOCGRP
      ,S.DOCTYP
      ,CONVERT(VARCHAR(20), S.DOCDAT, 23)      DOCDAT
      ,S.BPSNO
      ,BPS.BPSNAM
      ,S.REMARK
      ,S.PRJNUM
      ,DOCSTA.OPTDES                           DOCSTA
      ,MAX(S.CREUSR)                           CREUSR
      ,MAX(S.UPDUSR)                           CREUSR
      ,CONVERT(VARCHAR(16), MAX(S.CRETIM), 21) CRETIM
      ,CONVERT(VARCHAR(16), MAX(S.UPDTIM), 21) UPDTIM
FROM   PRETLIN S
       LEFT JOIN BPSUP BPS
              ON S.BPSNO = BPS.BPSNO
       LEFT JOIN LINKOPT DOCSTA
              ON DOCSTA.OPTID = S.DOCSTA
                 AND DOCSTA.OPTTYP = 'DOCSTA'
       LEFT JOIN LINKOPT DOCGRP
              ON DOCGRP.OPTID = S.DOCGRP
                 AND DOCGRP.OPTTYP = 'DOCGRP'
                 AND DOCGRP.LINKOPTID = 'PRT'
WHERE  S.DOCNUM + S.PRJNUM LIKE '%{0}%'
       AND S.DOCDAT BETWEEN '{1}' AND '{2}'
       AND S.DOCSTA LIKE '%{3}%'
GROUP  BY S.DOCNUM
          ,S.SITE
          ,DOCGRP.OPTDES
          ,S.DOCTYP
          ,CONVERT(VARCHAR(20), S.DOCDAT, 23)
          ,S.BPSNO
          ,BPS.BPSNAM
          ,S.REMARK
          ,S.PRJNUM
          ,DOCSTA.OPTDES
ORDER  BY S.DOCNUM DESC</SQLScript>
