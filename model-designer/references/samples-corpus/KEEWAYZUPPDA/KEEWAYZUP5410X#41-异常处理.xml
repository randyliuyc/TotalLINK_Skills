  <SQLClear>--LINKREFRESH

DECLARE @MFGNUM VARCHAR(30)='{1}';
--当ERP删除生产追踪单时，更新状态重新入库
UPDATE XWSMKI SET RPFLG_0=1
                 ,STAT_0=1
                 ,RPNUM_0=''
     FROM XWSMKI XWS
     LEFT JOIN MFGITMTRK S
    ON XWS.RPNUM_0=S.MFGTRKNUM_0
WHERE XWS.MFGNUM_0=@MFGNUM
   AND S.MFGNUM_0 IS NULL
   AND XWS.RPFLG_0=3
        
--webservice异常情况下更新状态
UPDATE XWSMKI SET STAT_0=1
WHERE STAT_0=2 
AND RPFLG_0&lt;&gt;3 
AND SUBDATIM_0 &lt; DATEADD(MINUTE, -1, GETDATE()) 
AND USERID_0='#LOGIN_USER#';</SQLClear>
