  <JavaScript>$("#linkreset").remove() //,#linkok

$(document).on("input", "#QTYSTU", function () {

    var QTYSTU = parseFloat($("#QTYSTU").val()) || 0;         // 输入包装数量
    var STKQTYSTU = parseFloat($("#STKQTYSTU").val()) || 0;   // 库位包装数
    var NEDQTYSTU = parseFloat($("#NEDQTYSTU").val()) || 0; // 需领数量

    if (STKQTYSTU &lt;= 0) {
        $("#QTYSTU").val("");
        alert("请先选择库存");
        return;
    }

    if (QTYSTU &gt; STKQTYSTU) {
        $("#QTYSTU").val("");
        alert("数量不能大于库位数量");
        return;
    }

    if (QTYSTU &gt; NEDQTYSTU) {
        $("#QTYSTU").val("");
        alert("数量不能大于剩余需领数量");
        return;
    }

});


linkDMFuncBackImpl = function () {
    var NEDQTYSTU = parseFloat($("#NEDQTYSTU").val()) || 0;
    var QTYSTU = parseFloat($("#QTYSTU").val()) || 0;
    var retqtystu = NEDQTYSTU - QTYSTU

    if (retqtystu &lt;= 0) {
        showModelData(null);
        return;
    }

    $("#QTYSTU").val("");
    $("#NEDQTYSTU").val((retqtystu).toFixed(2));

    var con = plus.webview.getWebviewById('contentlist');
    mui.fire(con, 'contentlist_local', {});
}</JavaScript>
