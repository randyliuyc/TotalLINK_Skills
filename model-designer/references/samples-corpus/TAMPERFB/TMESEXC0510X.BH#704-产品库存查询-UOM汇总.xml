  <ModelDesc>产品库存查询-UOM汇总</ModelDesc>
  <KeyWords />
  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>SELECT 'UOM'                                 SRCTYP   
       ,S.[ITMNO]     CPNITMNO
       ,I.ITMNAM
       ,I.ITMNAM2
       ,I.ITMSIZE
       ,I.ITMSPEC
       ,I.TCLCOD
       ,S.[ITMVER]
       ,CAST(SUM(CASE
                   WHEN WH.[WHGRP] = 'STK' THEN S.[QTY]
                   ELSE 0
                 END) AS DECIMAL(18, 2))     AS STKQTY
       ,CAST(SUM(CASE
                   WHEN WH.[WHGRP] = 'MFG' THEN S.[QTY]
                   ELSE 0
                 END) AS DECIMAL(18, 2))     AS MFGQTY
       ,CAST(SUM(S.[QTY]) AS DECIMAL(18, 2)) AS TOTALQTY
       ,S.[UOM]
       ,S.[ITMNO]+'UOM'   ITMKEY
FROM   [STK] S
       INNER JOIN ITM I
              ON S.ITMNO = I.ITMNO
       LEFT JOIN ENTWH WH
              ON S.WH = WH.WH
WHERE  NOT ( I.TCLCOD = 'RW'
             AND S.UOM = 'KG' ) --排除KG
       AND S.[ITMNO] NOT IN (SELECT [CPNITMNO] FROM [MFGPKL] WHERE [DOCNUM]='{4}')
       AND (I.TCLCOD LIKE N'%{0}%'  OR '{0}'='')
       AND S.ITMNO LIKE N'%{1}%'  
       AND  I.ITMNAM  LIKE N'%{2}%'
       AND ( I.ITMSPEC + I.ITMSIZE ) LIKE N'%{3}%'
GROUP  BY S.[ITMNO]
          ,I.ITMNAM
          ,I.ITMNAM2
          ,I.ITMSIZE
          ,I.ITMSPEC
          ,I.TCLCOD
          ,S.[ITMVER]
          ,S.[UOM]
ORDER  BY S.[ITMNO];</SQLScript>
