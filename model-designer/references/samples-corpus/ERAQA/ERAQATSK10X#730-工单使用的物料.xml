  <FunctionCode />
  <ChartType />
  <SQLScript>--LINKNOGROUP
--LINKNOFILTER
DECLARE @DOCNUM VARCHAR(30) = '{0}';
DECLARE @MFGNUM VARCHAR(30) = '';

SELECT @MFGNUM = SPLITDATA
FROM   SplitStr(@DOCNUM, '-')
WHERE  ID = 1;

SELECT ITMREF_0                         ITMREF
      ,LOT_0                            LOT
      ,LEFT(SLO_0, 4)                   TV
      ,LOC_0                            LOC
      ,COUNT(*)                         QTY
      ,CAST(SUM(QTYSTU_0) * -1 AS REAL) QTYSTU
      ,STU_0                            STU
FROM   #LC.X3DATA#STOJOU
WHERE  VCRNUMORI_0 = @MFGNUM
       AND VCRTYP_0 = 12
GROUP  BY ITMREF_0
          ,LOT_0
          ,LEFT(SLO_0, 4)
          ,LOC_0
          ,STU_0</SQLScript>
