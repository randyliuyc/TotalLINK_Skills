  <SQLScript>--LINKNOGROUP
--LINKNOFILTER

DECLARE @DOCNUM VARCHAR(30) = '{0}'

SELECT CAST(IIF(Q.PLOPE IS NULL, 0, 1) AS BIT) GXFLG
      ,S.[OPTID]                               LINKROWIDOPTID
      ,S.[OPTDES]
      ,Q.[ID]                                  LINKROWID
FROM   [QAOPT] S
       LEFT JOIN (SELECT PLOPE
                        ,ID
                  FROM   QAINSPREQL 
                  WHERE  DOCNUM = @DOCNUM)Q
              ON Q.PLOPE = S.OPTID
WHERE  S.OPTTYP = 'INSPLST'
ORDER  BY S.OPTSEQ</SQLScript>
  <SQLUpdateScript>--LINKEDITMODE
--LINKSAVEONENTERKEY

DECLARE @DOCNUM VARCHAR(30) = '{0}'

IF NOT EXISTS(SELECT PLOPE  FROM QAINSPREQL WHERE DOCNUM=@DOCNUM AND PLOPE='#LINKROWIDOPTID#') AND '#GXFLG#'='True'
BEGIN
INSERT INTO [QAINSPREQL]
           ([DOCNUM]
           ,[PLOPE]
           ,[PLOPEDES]
           ,[CREUSR]
           ,[CRETIM])
    SELECT
	    @DOCNUM
           ,'#LINKROWIDOPTID#'
           ,N'#OPTDES#'
           ,'#LOGIN_USER#'--&lt;CREUSR, varchar(30),&gt;
           ,GETDATE()--&lt;CRETIM, datetime,&gt;
END;

ELSE 

BEGIN

DELETE FROM QAINSPREQL WHERE ID=0#LINKROWID# AND '#GXFLG#'='False';

END</SQLUpdateScript>
