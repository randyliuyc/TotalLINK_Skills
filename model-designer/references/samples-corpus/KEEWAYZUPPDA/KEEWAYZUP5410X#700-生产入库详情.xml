  <SQLScript>DECLARE @MFGNUM VARCHAR(50)='{0}';
DECLARE @MFGLIN INT=0{1};
SELECT XWS.PK_0                      LINKROWID
      ,CAST(XWS.QTYPCU_0 AS REAL)    入库数量
      ,XWS.LOC_0                     入库库位
      ,XWS.SERNUM_0                    车架序列号
      ,XWS.XTXT_0                    电池序列号
      ,XWS.XTXT_1                    电机序列号
      ,XWS.XTXT_2                    工单序号
      ,XWS.RPNUM_0                   入库单号
      ,CONVERT(VARCHAR(16),XWS.CREDATTIM_0,21)  操作时间
      ,XWS.USERID_0                  操作人员
      ,CASE
          WHEN XWS.RPFLG_0 = 3 THEN 'mui-hidden'
          ELSE ''
        END                          BTNFLG
FROM   XWSMKI XWS
WHERE  XWS.MFGNUM_0=@MFGNUM 
  AND  XWS.VCRLIN_0=@MFGLIN
ORDER  BY XWS.RPFLG_0,XWS.CREDATTIM_0 DESC</SQLScript>
