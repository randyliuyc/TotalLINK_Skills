  <SQLScript>SELECT     H.DOCNUM
          ,CONVERT(VARCHAR(16),VL.CRETIM,23) INSDAT
          ,H.MFGNUM
	  ,L.OPENUM
	  ,D.OPEDES1
	  ,D.OPEDES2
	  ,VL.SPOOL
	  ,VL.COIL
	  ,VL.SAMP
	  ,CAST(VL.N1 AS DECIMAL(18,3)) N1
	  ,CAST(VL.N2 AS DECIMAL(18,3)) N2
	  ,CAST(VL.N3 AS DECIMAL(18,3)) N3
	  ,CAST(VL.N4 AS DECIMAL(18,3)) N4
	  ,CAST(VL.N5 AS DECIMAL(18,3)) N5
	  ,CAST(VL.N6 AS DECIMAL(18,3)) N6
	  ,CAST(VL.N7 AS DECIMAL(18,3)) N7
	  ,CAST(VL.N8 AS DECIMAL(18,3)) N8
	  ,CAST(VL.VALMIN AS DECIMAL(18,3)) VALMIN
	  ,CAST(VL.VALAVG AS DECIMAL(18,3)) VALAVG
	  ,CAST(VL.VALMAX AS DECIMAL(18,3)) VALMAX
	  ,VL.L1
	  ,VL.L2
	  ,VL.STA
	  ,VL.REMARK
          ,VL.CREUSR
          ,CONVERT(VARCHAR(16),VL.CRETIM,21) CRETIM
          ,H.ROUTYP   --不可删除，挖掘传参
          ,H.ROUCOD ROUCODCK  --不可删除，挖掘传参
FROM QAINSPVAL VL
INNER JOIN QAINSPL L
ON VL.DOCNUM=L.DOCNUM AND VL.OPENUM=L.OPENUM
INNER JOIN QAINSPH H
ON VL.DOCNUM=H.DOCNUM
INNER JOIN QAOPESTD D
ON D.OPESTD=L.OPESTD
WHERE L.STA=1 AND ISNULL(VL.NCTYP,'')='' AND VL.STA=0 AND VL.STA IS NOT NULL 
ORDER BY VL.CRETIM DESC</SQLScript>
