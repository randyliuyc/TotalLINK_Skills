  <SQLClear>--LINKREFRESH
DECLARE @json NVARCHAR(MAX) = N'{3}';
DECLARE @DOCNUM VARCHAR(30)='#LINKDOCNUM.H#';
IF NOT EXISTS(SELECT TV
              FROM   QAMAT
              WHERE  TV = (SELECT JSON_VALUE(@json, '$.TVNO')))
  BEGIN
      INSERT INTO [dbo].[QAMAT]
                  ([DOCNUM],
                   [LOT],
                   [TV],
                   [GRDCOD],
                   [GRAINSIZE],
                   [DECARB],
                   [HARDNESS],
                   [QAMATDOC],
                   [STA],
                   [CREUSR],
                   [CRETIM])
      SELECT @DOCNUM
            ,JSON_VALUE(@json, '$.HeatNo')
            ,JSON_VALUE(@json, '$.TVNO')
            ,JSON_VALUE(@json, '$.GradeCode')
            ,IIF(JSON_VALUE(@json, '$.GrainSize') = '', 0, JSON_VALUE(@json, '$.GrainSize'))
            ,IIF(JSON_VALUE(@json, '$.Decar') = '', 0, JSON_VALUE(@json, '$.Decar'))
            ,IIF(JSON_VALUE(@json, '$.Hardness') = '', 0, JSON_VALUE(@json, '$.Hardness'))
            ,JSON_VALUE(@json, '$.Docnum')
            ,'Valid'
            ,'#LOGIN_USER#'
            ,GETDATE()

      INSERT INTO QAMATELE
                  (DOCNUM,
                   ELECOD,
                   ELEVAL,
                   CREUSR,
                   CRETIM)
      SELECT @DOCNUM
            ,[key]                               AS ELECOD
            ,TRY_CAST([value] AS DECIMAL(18, 3)) AS ELEVAL
            ,'#LOGIN_USER#'
            ,GETDATE()
      FROM   OPENJSON(@json, '$.ELE')
  END</SQLClear>
