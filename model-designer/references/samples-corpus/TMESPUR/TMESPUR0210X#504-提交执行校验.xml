  <SQLScript>{{ 
  "type":3,
  "message":"存在未询价行",
  "condition": "LINKSCRIPTGET@LINK01:SELECT CASE
         WHEN ( Count(*) &gt; Count(IIf(L.BPSNO = '', NULL, L.BPSNO)) ) THEN 0
         WHEN ( Count(*) &gt; Count(IIf(L.NETPRI = 0, NULL, L.NETPRI)) ) THEN 2
         ELSE 1
       END
FROM   PINQUL L
       LEFT JOIN ITM
              ON ITM.ITMNO = L.ITMNO
       LEFT JOIN BPSUP BPS
              ON BPS.BPSNO = L.BPSNO
WHERE  DOCNUM = '{0}' "
}}</SQLScript>
