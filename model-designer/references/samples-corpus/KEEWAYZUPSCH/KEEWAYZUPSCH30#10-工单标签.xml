  <SQLScript>DECLARE @LANX3 VARCHAR(30) = '#LINKFUNC.GETLANX3#';

SELECT C.CPYNAM_0                             公司名称
      ,ISNULL(B.BPAADDLIG_0, '')
        + ISNULL(B.BPAADDLIG_1, '')
        + ISNULL(B.BPAADDLIG_2, '')           公司地址
      ,MFG.MFGNUM_0                           工单号
      ,MFG.ITMREF_0                           产品编码
      ,ISNULL(L1.ITMDES, ITM.ITMDES1_0)       产品描述1
      ,ISNULL(L2.ITMDES, ITM.ITMDES2_0)       产品描述2
      ,CAST(MFG.EXTQTY_0 AS REAL)             计划数量
      ,CONVERT(VARCHAR(16), MFG.CREDAT_0, 23) 创建日期
FROM   MFGITM MFG
       LEFT JOIN COMPANY C
              ON C.CPY_0 = 'DE01'
       LEFT JOIN BPADDRESS B
              ON B.BPAADD_0 = C.BPAADD_0
                 AND B.BPANUM_0 = C.CPY_0
       INNER JOIN ITMMASTER ITM
               ON MFG.ITMREF_0 = ITM.ITMREF_0
       LEFT JOIN ITMLAN1 L1
              ON L1.ITMREF = ITM.ITMREF_0
                 AND L1.LANX3 = @LANX3
       LEFT JOIN ITMLAN2 L2
              ON L2.ITMREF = ITM.ITMREF_0
                 AND L2.LANX3 = @LANX3
WHERE  MFG.MFGFCY_0 = N'{0}'
       AND MFG.MFGNUM_0 LIKE N'%{1}%'
       AND MFG.ITMREF_0 LIKE N'%{2}%'
       AND MFG.STRDAT_0 BETWEEN '{6}' AND '{7}'</SQLScript>
