  <SQLScript>--LINKDETAILLIST(KEEWAYZUP5020X,700,{6})
--LINKMYROWDATA
DECLARE @LAN VARCHAR(30) = '#LOGIN_LAN#';
DECLARE @LANX3 VARCHAR(30) = (
    SELECT #LC.X3ERP#GETLANX3(@LAN)
    );
DECLARE @FCY VARCHAR(10)='{0}';
DECLARE @LOC VARCHAR(30)=N'{1}';

SELECT ''                      生产地点
       ,N'lang:{zh:添加,en:New,de:hinzufügen}' 工单编号
       ,''                     产品编码
       ,''                     产品名称
       ,0                      总数量
       ,''                     BTNFLG
       ,'mui-hidden'           HIDFLG
       ,''                     id
UNION ALL
SELECT XWS.MFGFCY_0   生产地点
       ,XWS.MFGNUM_0  工单编号
       ,XWS.ITMREF_0  产品编码
       ,ISNULL(B.ITMDES, ITM.ITMDES1_0) 产品名称
       ,Count(*)      总数量
       ,'mui-hidden'  BTNFLG
       ,''            HIDFLG
       ,XWS.MFGNUM_0  id
FROM   XWSMKI XWS
       INNER JOIN ITMMASTER ITM
               ON XWS.ITMREF_0 = ITM.ITMREF_0
       LEFT JOIN (
             SELECT 
                   B.IDENT1_0 AS ITMREF
                 , STRING_AGG(B.TEXTE_0, '') 
                     WITHIN GROUP (ORDER BY B.ZONE_0) AS ITMDES
             FROM ATEXTRA B
             WHERE B.CODFIC_0 = 'ITMMASTER'
               AND B.LANGUE_0 = @LANX3
             GROUP BY 
                   B.IDENT1_0
         ) B
               ON B.ITMREF = ITM.ITMREF_0
WHERE  XWS.RPFLG_0 &lt;&gt; 3
       AND XWS.STAT_0 = 9
       AND XWS.USERID_0 = '#LOGIN_USER#'
       AND XWS.MFGFCY_0 = @FCY
GROUP  BY XWS.MFGNUM_0
          ,XWS.MFGFCY_0
          ,XWS.ITMREF_0
          --,ITM.ITMDES1_0
          ,ISNULL(B.ITMDES, ITM.ITMDES1_0)</SQLScript>
