  <ChartType />
  <SQLScript>DECLARE @USER VARCHAR(30) = '#LOGIN_USER#';
DECLARE @TAG VARCHAR(200) = '{0}'; 
DECLARE @STOCK VARCHAR(50) = '';

-- 检查序列号是否存在库存表中
SELECT TOP 1 @STOCK = SERNUM_0
FROM STOCK
WHERE SERNUM_0 = @TAG;

IF ISNULL(@STOCK, '') = ''
BEGIN
    SELECT N'序列号不存在: ' + @TAG  AS 数据检查
    RETURN
END

-- 检查该序列号是否被扫描过
IF EXISTS (SELECT TOP 1 *
           FROM XWSSCS
           WHERE SERNUM_0 = @TAG AND RPFLG_0 &lt;&gt; 3)
BEGIN
    SELECT N'序列号已扫描过: ' + @TAG AS 数据检查
    RETURN;
END

-- 检查该序列号是否已入库
IF EXISTS (SELECT TOP 1 *
           FROM XWSSCS
           WHERE SERNUM_0 = @TAG AND RPFLG_0 = 3)
BEGIN
    SELECT N'序列号已入库: ' + @TAG AS 数据检查
    RETURN;
END

SELECT 
    S.SERNUM_0 AS 序列号,
    '' AS 数据检查,
	S.ITMREF_0 产品编码 ,
    ISNULL((SELECT COUNT(DISTINCT SERNUM_0+ITMREF_0) 
            FROM XWSSCS 
            WHERE RPFLG_0 &lt;&gt; 3 AND USERID_0 = @USER), 0) + 1 AS 已扫数量
FROM STOCK S
WHERE S.SERNUM_0 = @TAG</SQLScript>
