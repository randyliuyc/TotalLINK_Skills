  <SQLScript>DECLARE @DOCNUM VARCHAR(30) = REPLACE('{0}',',','-')  --IF SCANED THE OPERATION CODE (WITH ,), CHANGE TO -, TO MATCH THE QA DOCNUM
DECLARE @CODE VARCHAR(30) = '{1}'
DECLARE @MFGNUM VARCHAR(30) = ''
DECLARE @ROUALT VARCHAR(30) = ''
DECLARE @ROUOPE VARCHAR(30) = ''
DECLARE @ITMNO VARCHAR(30) = ''

SET @MFGNUM=LEFT(@DOCNUM, CHARINDEX('-', @DOCNUM) - 1);
SET @ROUOPE=RIGHT(@DOCNUM, LEN(@DOCNUM) - CHARINDEX('-', @DOCNUM));

--SELECT @ROUALT = H.ROUALT_0
--      ,@ITMNO = H.ROUNUM_0
--FROM   #LC.X3DATA#MFGHEAD H
--WHERE  H.MFGNUM_0 = @MFGNUM;

-- DEMO DATA, RANDY, 2026-10-17
SELECT @ROUALT = 11, @ITMNO = 'WR4080ED002.286'

-- 拼接形成 ROUCOD
DECLARE @ROUCOD VARCHAR(30)

SET @ROUCOD = CONCAT_WS('-', @ITMNO, @ROUALT, @ROUOPE)

SELECT QL.OPENUM                                                 CODE
      ,CASE WHEN D.OPEDES2 = '自行车 / 外观' THEN N'lang:{zh:自行车 / 外观,de:Fahrrad / Aussehen}'
	        WHEN D.OPEDES2 = '自行车 / 缺件检查' THEN N'lang:{zh:自行车 / 缺件检查,de:Fahrrad / Prüfung auf fehlende Teile}'
	        WHEN D.OPEDES2 = '自行车 / 损伤检查' THEN N'lang:{zh:自行车 / 损伤检查,de:Fahrrad / Schadensprüfung}'
	    END    DESP                                              
      ,QL.INSTCAT
      ,IIF(L.INSTCOD IS NULL, ISNULL(QL.INSTCOD, ''), L.INSTCOD) INSTCOD
      ,'#LOGIN_USER#'  检查人
      ,CONVERT(VARCHAR(16),GETDATE(),23) 检查日期
      ,@DOCNUM 工单编号
      ,@DOCNUM 退货单号
      ,'C20261016' 车架号
      ,' ' 车型
      ,' ' 整车编码
      ,IIF(QL.OPENUM &lt;&gt; '130','mui-hidden','') LINKHIDFLG130
      ,IIF(QL.OPENUM &lt;&gt; '140','mui-hidden','') LINKHIDFLG140
      ,IIF(QL.OPENUM &lt;&gt; '150','mui-hidden','') LINKHIDFLG150
FROM   QAROU H
       INNER JOIN QAROULIN QL
               ON QL.ROUCOD = H.ROUCOD
       INNER JOIN QAOPESTD D
               ON QL.OPESTD = D.OPESTD
       LEFT JOIN QAINSPL L
              ON L.DOCNUM = @DOCNUM
                 AND L.OPENUM = QL.OPENUM
WHERE  H.ROUCOD = @ROUCOD
AND (QL.OPENUM = @CODE OR @CODE = '')</SQLScript>
