  <ModelDesc>销售订单明细</ModelDesc>
  <KeyWords />
  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>DECLARE @SOHNUM VARCHAR(30) = '{0}';
DECLARE @LANX3 VARCHAR(30) = '#LINKFUNC.GETLANX3#';

WITH CTE_DEITM
AS (
  -- 海关监管产品对照编码，按ZJKC供应商产品编码对照
  SELECT ITMREFBPS_0 ITMREF_0
    , ITMREF_0 ITMREFBPC_0
  FROM ITMBPS
  WHERE BPSNUM_0 = 'ZJKC'
  )
  , CTE_GCSO
AS (
  SELECT Q.SOHNUM_0
    , Q.SOPLIN_0
    , Q.ITMREF_0 GC产品编码
    , ISNULL(DEITM.ITMREFBPC_0, Q.ITMREF_0) ZU产品编码
    , CAST(Q.QTY_0 AS REAL) 订单数量
    , P.SAU_0 单位
    , CONVERT(VARCHAR(16), Q.EXTDLVDAT_0, 23) 预计发货日期
  FROM SORDERQ Q
  INNER JOIN SORDER R
    ON Q.SOHNUM_0 = R.SOHNUM_0
  INNER JOIN SORDERP P
    ON Q.SOHNUM_0 = P.SOHNUM_0
      AND Q.SOPLIN_0 = P.SOPLIN_0
  LEFT JOIN CTE_DEITM DEITM
    ON Q.ITMREF_0 = DEITM.ITMREF_0
      -- 仅 SKT 的订单需要转换编码
      AND R.SOHTYP_0 = 'SKT'
  WHERE Q.SOHNUM_0 = @SOHNUM
    AND P.LINTYP_0 &lt;&gt; 6
  )
SELECT Q.GC产品编码
  , Q.ZU产品编码
  , ISNULL(L1.ITMDES, ITM.ITMDES1_0) 产品描述1
  , ISNULL(L2.ITMDES, ITM.ITMDES2_0) 产品描述2
  , Q.订单数量
  , Q.单位
  , Q.预计发货日期
  , CASE 
    WHEN ITF.ITMREF_0 IS NULL
      THEN N'lang:{zh:产品地点不存在,en:Product Site is missing.,de:Produktstandort fehlt.}'
    WHEN XPO.SOHNUM_0 IS NOT NULL
      THEN 
        N'lang:{zh:有转单遗留数据,en:There is carryover data from order transfers.,de:Es gibt übertragene Daten aus Auftragsumleitungen.}'
    ELSE ''
    END 数据检查
  , CASE 
    WHEN ITF.ITMREF_0 IS NULL
      THEN 'E02'
    WHEN XPO.SOHNUM_0 IS NOT NULL
      THEN 'D02'
    ELSE ''
    END LINKAPPRROW
FROM CTE_GCSO Q
LEFT JOIN XWSPOH XPO
  ON XPO.SOHNUM_0 = Q.SOHNUM_0
    AND XPO.SOPLIN_0 = Q.SOPLIN_0
INNER JOIN ITMMASTER ITM
  ON Q.ZU产品编码 = ITM.ITMREF_0
LEFT JOIN ITMFACILIT ITF
  ON Q.ZU产品编码 = ITF.ITMREF_0
    AND ITF.STOFCY_0 = 'ZUPK'
LEFT JOIN ITMLAN1 L1
  ON L1.ITMREF = ITM.ITMREF_0
    AND L1.LANX3 = @LANX3
LEFT JOIN ITMLAN2 L2
  ON L2.ITMREF = ITM.ITMREF_0
    AND L2.LANX3 = @LANX3
ORDER BY Q.SOPLIN_0;</SQLScript>
