  <SQLScript>--LINKNOGROUP
DECLARE @ROUCOD VARCHAR(30) = '{0}';
DECLARE @OPENUM INT = 0{1};

SELECT S.[ID] LINKROWID
      ,S.[VALDES]
      ,S.[VALCTL] LINKDROPVALIDVALCTL
      ,S.[VALTYP] + CAST(S.[VALLIN] AS VARCHAR) VALTYP
      ,S.[CREUSR]
      ,S.[UPDUSR]
      ,S.[CRETIM]
      ,S.[UPDTIM]
  FROM [QAROULINCTL] S
  WHERE S.ROUCOD = @ROUCOD
    AND S.OPENUM = @OPENUM
ORDER BY S.VALTYP, S.VALLIN</SQLScript>
  <SQLUpdateScript>--LINKEDITMODE
--LINKADDNEWROWS
--LINKSAVEONENTERKEY
UPDATE QAROULINCTL
SET VALDES = N'#VALDES#'
    , VALCTL ='#LINKDROPVALIDVALCTL#'
    , UPDUSR = N'#LOGIN_USER#'
    , UPDTIM = GETDATE()
WHERE ID = 0#LINKROWID#</SQLUpdateScript>
