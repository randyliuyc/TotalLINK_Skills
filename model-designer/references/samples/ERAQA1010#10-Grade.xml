           ,[DENSITY]
           ,[DENUNIT]
           ,[HDANNEAL]
           ,[HDUNIT1]
           ,[HDDRAWN]
           ,[HDUNIT2]
           ,[TENSILE]
           ,[TENUNIT]
           ,[COMMENT]
           ,[EUSTD]
           ,[ENSTD]
           ,[STD1]
           ,[STD2]
           ,[SUPCOD]
           ,[STA]
           ,[CREUSR]
           ,[UPDUSR]
           ,[CRETIM]
           ,[UPDTIM])
     VALUES
           (
	   '#GRDCOD#'--&lt;GRDCOD, varchar(30),&gt;
           ,''--&lt;CUSCOD, varchar(30),&gt;
           ,'#GRDNAM#'--&lt;GRDNAM, nvarchar(100),&gt;
           ,'#DENSITY#'--&lt;DENSITY, varchar(30),&gt;
           ,'#DENUNIT#'--&lt;DENUNIT, varchar(30),&gt;
           ,0#HDANNEAL#--&lt;HDANNEAL, decimal(18,6),&gt;
           ,'#HDUNIT1#'--&lt;HDUNIT1, varchar(30),&gt;
           ,'#HDDRAWN#' --&lt;HDDRAWN, decimal(18,6),&gt;
           ,'#HDUNIT2#'--&lt;HDUNIT2, varchar(30),&gt;
           ,0#TENSILE#--&lt;TENSILE, decimal(18,6),&gt;
           ,'#TENUNIT#'--&lt;TENUNIT, varchar(30),&gt;
           ,'#COMMENT#'--&lt;COMMENT, varchar(30),&gt;
           ,'#EUSTD#'--&lt;EUSTD, varchar(30),&gt;
           ,'#ENSTD#'--&lt;ENSTD, varchar(30),&gt;
           ,'#STD1#'--&lt;STD1, varchar(30),&gt;
           ,'#STD2#'--&lt;STD2, varchar(30),&gt;
           ,'#SUPCOD#'--&lt;SUPCOD, varchar(30),&gt;
           ,'Draft'--&lt;STA, varchar(30),&gt;
           ,'#LOGIN_USER#'--&lt;CREUSR, varchar(30),&gt;
           ,''--&lt;UPDUSR, varchar(30),&gt;
           ,GETDATE()--&lt;CRETIM, datetime,&gt;
           ,''--&lt;UPDTIM, datetime,&gt;
	  );

INSERT INTO [QAGRADEELE]
           ([GRDCOD]
           ,[CUSCOD]
           ,[ELECOD]
           ,[ELEUNT]
           ,[CREUSR]
           ,[UPDUSR]
           ,[CRETIM]
           ,[UPDTIM])
SELECT 
	   '#GRDCOD#'--&lt;GRDCOD, varchar(30),&gt;
           ,''--&lt;CUSCOD, varchar(30),&gt;
           ,S.ELECOD--&lt;ELECOD, varchar(30),&gt;
           ,S.ELEUNT--&lt;ELEUNT, varchar(30),&gt;
           ,'#LOGIN_USER#'--&lt;CREUSR, varchar(30),&gt;
           ,''--&lt;UPDUSR, varchar(30),&gt;
           ,GETDATE()--&lt;CRETIM, datetime,&gt;
           ,''--&lt;UPDTIM, datetime,&gt;
FROM QAELE S
ORDER BY S.ELESEQ</SQLNew>
