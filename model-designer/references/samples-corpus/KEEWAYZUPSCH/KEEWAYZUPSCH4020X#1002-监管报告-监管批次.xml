  <ModelDesc>监管报告-监管批次</ModelDesc>
  <KeyWords />
  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>--监管分类信息
DECLARE @CHKDATE DATE = GETDATE();
DECLARE @STRDAT DATE = '{0}';
DECLARE @ENDDAT DATE = '{1}';

SELECT H.ZOLLDAT_0
  , DATEDIFF(DAY, H.ZOLLDAT_0, @CHKDATE) AS ZOLLDAYS
  , H.ZOLLEXPDAT_0
  , DATEDIFF(DAY, @CHKDATE, H.ZOLLEXPDAT_0) AS ZOLLEXPDAYS
  , H.ZOLLLOT_0
  , H.INVNUM_0
  , H.INVDAT_0
  , H.BPSLOT_0
  , H.KNCODE_0
  , H.ITMDES_0
  , CAST(H.ZOLLQTY_0 AS INT) AS ZOLLQTY_0
  , CAST(H.ZOLLAMT_0 AS DECIMAL(18, 2)) AS ZOLLAMT_0
  , CAST(H.ZOLLPRI_0 AS DECIMAL(18, 4)) AS ZOLLPRI_0
  , H.ADRAT_0
  , H.SPRAT_0
  , H.ATSNO_0
  , CAST(H.RECQTY_0 AS INT) AS RECQTY_0
  , CAST(- H.USEQTY_0 AS INT) AS USEQTY_0
  , CAST(H.RMNQTY_0 AS INT) AS RMNQTY_0
  , CAST(H.RMNAMT_0 AS DECIMAL(18, 2)) AS RMNAMT_0
  , CAST(H.RMNADAMT_0 AS DECIMAL(18, 2)) RMNADAMT_0
  , CAST(H.RMNSPAMT_0 AS DECIMAL(18, 2)) RMNSPAMT_0
  -- 累计入库数量与申报数量不一致时，用红色显示
  , IIF(H.RECQTY_0 &lt;&gt; H.ZOLLQTY_0, 'D05', '') LINKAPPRZOLLQTY_0
  -- 即将到期，用红色显示
  , CASE 
    -- WHEN DATEDIFF(DAY, @CHKDATE, H.ZOLLEXPDAT_0) &lt;= 0
    --   THEN 'D05'
    WHEN DATEDIFF(DAY, @CHKDATE, H.ZOLLEXPDAT_0) &lt;= 30
      THEN 'D05'
    ELSE ''
    END AS LINKAPPRZOLLEXPDAT_0
  , 1 LINKROWIDL1
  , H.ZOLLLOT_0 LINKROWIDL2
FROM YZUPZOLLH H
WHERE H.ZOLLSTRDAT_0 = @STRDAT 
  AND H.ZOLLENDDAT_0 = @ENDDAT</SQLScript>
