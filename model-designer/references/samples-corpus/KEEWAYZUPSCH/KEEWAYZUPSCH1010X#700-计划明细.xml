  <FunctionCode />
  <ChartType />
  <SQLScript>--LINKNOGROUP
DECLARE @LANX3 VARCHAR(30) = '#LINKFUNC.GETLANX3#';
DECLARE @XMH VARCHAR(30) = '{0}';

SELECT S.SRCTYP_0 来源类型
  , S.SRCNUM_0 来源单号
  , S.ITMREF_0 产品编码
  , ISNULL(L1.ITMDES, ITM.ITMDES1_0) 产品描述1
  , ISNULL(L2.ITMDES, ITM.ITMDES2_0) 产品描述2
  , CAST(S.QTY_0 AS REAL) 数量
  , S.STU_0 单位
  , S.STRDAT_0 开始日期
  , 'GESMFG' LINKROWIDVCRTYP
  , S.SRCLIN_0 来源行号
  , S.ROWID LINKROWID
FROM XWSSCHSRC S
INNER JOIN ITMMASTER ITM
  ON ITM.ITMREF_0 = S.ITMREF_0
LEFT JOIN ITMLAN1 L1
  ON L1.ITMREF = ITM.ITMREF_0
    AND L1.LANX3 = @LANX3
LEFT JOIN ITMLAN2 L2
  ON L2.ITMREF = ITM.ITMREF_0
    AND L2.LANX3 = @LANX3
WHERE S.XMHNUM_0 = @XMH;</SQLScript>
