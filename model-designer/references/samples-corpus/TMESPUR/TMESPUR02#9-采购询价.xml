  <DataMineCode />
  <FunctionCode />
  <ChartType>AreaChart</ChartType>
  <SQLScript>SELECT H.ID                                                                                            LINKROWID
       ,H.DOCNUM --询价单号
       ,ISNULL(DOCGRP.OPTDES,'')                                                                                  DOCGRP --单据分组
       ,DOCSTA.OPTDES                                                                                  DOCSTA
       ,WFLSTA.OPTDES                                                                                  WFLSTA --工作流状态
       ,CONVERT(VARCHAR(16), H.DOCDAT, 23)                                                             DOCDAT --单据日期
       ,H.DOCDES --单据描述
       ,S3.Name                                                                                        NAME
       ,H.PRJNUM --项目编号
       ,SI.SITENAM                                                                                     [SITE] --地点
       ,H.REMARK --备注
       ,S1.NAME + '(' + H.CREUSR + ')'                                                                 CREUSR
       ,S2.NAME + '(' + H.UPDUSR + ')'                                                                 UPDUSR
       ,CONVERT(VARCHAR(16), H.CRETIM, 21)                                                             CRETIM --创建时间
       ,Iif(CONVERT(VARCHAR(16), H.UPDTIM, 23) = '1900-01-01', '', CONVERT(VARCHAR(16), H.UPDTIM, 21)) UPDTIM
       ,H.CLOREA --关闭原因
       ,H.PRNCNT --打印次数
       ,H.CMPFLG --完成状态
FROM   PINQUH H
       LEFT JOIN LINKOPT DOCSTA
              ON DOCSTA.OPTID = H.DOCSTA
                 AND DOCSTA.OPTTYP = 'DOCSTA'
       LEFT JOIN LINKOPT DOCGRP
              ON DOCGRP.OPTID = H.DOCGRP
                 AND DOCGRP.OPTTYP = 'DOCGRP'
                 AND DOCGRP.LINKOPTID = 'PIN'
       LEFT JOIN LINKOPT WFLSTA
              ON WFLSTA.OPTID = H.WFLSTA
                 AND WFLSTA.OPTTYP = 'WFLSTA'
       LEFT JOIN ENTSITE SI
              ON SI.SITE = H.SITE
       LEFT JOIN LINK.DBO.SysUser S1
              ON H.CREUSR = S1.LoginUser
       LEFT JOIN LINK.DBO.SysUser S2
              ON H.UPDUSR = S2.LoginUser
       LEFT JOIN LINK.DBO.SysUser S3
              ON H.RESNO = S3.LoginUser
WHERE  ( H.RESNO = N'#LOGIN_USER#' --用户自己
          OR '#LINKUSER(#LOGIN_USER#).DOCGRP#' = ''
          OR Charindex(S3.UDF001, '#LINKUSER(#LOGIN_USER#).DOCGRP#') &gt; 0 )
       AND H.DOCNUM + H.DOCGRP + H.DOCSTA + H.DOCDES + H.PRJNUM
       + H.SITE + H.REMARK + H.CREUSR + H.UPDUSR + H.CLOREA LIKE N'%{0}%'
       AND CONVERT(VARCHAR, H.CRETIM, 23) BETWEEN '{1}' AND '{2}'
       AND H.DOCSTA LIKE '%{3}%'
       AND ( H.RESNO = '{4}'
              OR '{4}' = '' )
ORDER  BY H.ID DESC</SQLScript>
