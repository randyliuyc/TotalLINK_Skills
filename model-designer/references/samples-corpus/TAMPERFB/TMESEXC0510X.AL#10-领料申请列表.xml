  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>DECLARE @SEARCH VARCHAR(200)='%{0}%';
DECLARE @STRDAT DATE='{1}';
DECLARE @ENDDAT DATE='{2}';
DECLARE @DOCSTA VARCHAR(5)='{3}';
DECLARE @PSITE VARCHAR(20)=N'{4}';
DECLARE @PDEPT VARCHAR(20)=N'{5}';
DECLARE @PITMNO VARCHAR(50)=N'{6}';
DECLARE @PITMNAM VARCHAR(100)=N'{7}';

SELECT H.[DOCTYP]
       ,H.[DOCNUM]
       ,H.[DOCGRP]
       ,DBO.Optdes('DOCGRP', H.DOCGRP)             DOCGRPDES
       ,H.[DOCSTA]
       ,DBO.Optdes('DOCSTA', H.DOCSTA)             DOCSTADES
       ,CONVERT(VARCHAR(16), H.[DOCDAT], 21)       [DOCDAT]
       ,H.[DOCDES]
       ,H.[DESTWH]
       ,H.[DESTWH] + '  ' + ISNULL(WH.[WHNAM], '') [WHNAM]
       ,H.[DESTLOC]
       ,H.[DESTLOC] + '  ' + ISNULL(LC.LOCDES, '') LOCDES
       ,L.CPNITMNO
       ,I.ITMNAM
       ,L.CPNITMVER
       ,I.ITMSPEC
       ,L.QTY
       ,L.UOM
       ,L.QTYSTU
       ,S1.NAME + '(' + H.CREUSR + ')'             CREUSR
       ,S2.NAME + '(' + H.UPDUSR + ')'             UPDUSR
       ,CONVERT(VARCHAR(16), H.CRETIM, 21)         CRETIM
       ,CONVERT(VARCHAR(16), H.UPDTIM, 21)         UPDTIM
       ,H.[MFGNUM]
	   ,L.CLOREA   LCLOREA
       ,IIF(L.CLOSTA = 1, '是', '否')                LCLOSTA
       ,L.[CLOUSR]
       ,L.[CLOTIM]
	   ,L.REMARK   LREMARK
FROM   [MFGPKH] H
       INNER JOIN [MFGPKL] L
               ON H.DOCNUM = L.DOCNUM
       INNER JOIN [ITM] I
               ON L.CPNITMNO = I.ITMNO
       LEFT JOIN [ENTWH] WH
              ON WH.WH = H.DESTWH
       LEFT JOIN [STKLOC] LC
              ON LC.WH = H.DESTWH
                 AND LC.LOC = H.DESTLOC
       LEFT JOIN LINKTAM.DBO.SysUser S1
              ON H.CREUSR = S1.LoginUser
       LEFT JOIN LINKTAM.DBO.SysUser S2
              ON H.UPDUSR = S2.LoginUser
WHERE  ( H.[DOCNUM] + H.[DOCDES] + ISNULL(I.ITMSPEC, '') LIKE @SEARCH
          OR @SEARCH = '' )
       AND H.DOCDAT BETWEEN @STRDAT AND @ENDDAT
       AND H.SITE = @PSITE
       AND ( H.DEPT = @PDEPT
              OR @PDEPT = '' )
       AND ( L.CPNITMNO = @PITMNO
              OR @PITMNO = '' )
       AND ( I.ITMNAM = @PITMNAM
              OR @PITMNAM = '' )
ORDER  BY H.ID DESC</SQLScript>
