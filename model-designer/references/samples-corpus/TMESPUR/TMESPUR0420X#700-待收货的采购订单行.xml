  <SQLScript>SELECT H.DOCNUM + '-' + CAST(S.DOCLIN AS CHAR) DOCKEY
      ,H.DOCNUM                                SRCDOC
      ,H.DOCGRP                                POHGRP
      ,H.DOCSTA
      ,CONVERT(VARCHAR(16), H.DOCDAT, 23)      DOCDAT
      ,H.DOCDES
      ,H.PRJNUM
      ,H.SITE
      ,H.BPSNO
      ,BPS.BPSNAM
      ,H.CUR
      ,S.REMARK                                LREMARK
      ,S.DOCLIN                                SRCLIN
      ,S.DOCTYP                                SRCTYP
      ,S.ITMNO
      ,ITM.ITMNAM
      ,S.ITMVER
      ,CONVERT(VARCHAR(16), S.REQDAT, 23)      REQDAT
      ,S.STU
      ,S.UOM
      ,S.UOMCOE
      ,( S.QTY - S.PRCQTY )                    QTY
      ,( S.QTYSTU - S.PRCQTYSTU )              QTYSTU
      ,S.QTY                                   ORDQTY
      ,S.QTYSTU                                ORDQTYSTU
      ,S.NETPRI
      ,S.PRCQTY
      ,S.PRCQTYSTU
FROM   PORDER H
       INNER JOIN PORDLIN S
               ON H.DOCNUM = S.DOCNUM
       INNER JOIN BPSUP BPS
               ON H.BPSNO = BPS.BPSNO
       INNER JOIN ITM
               ON ITM.ITMNO = S.ITMNO
WHERE  S.DOCSTA = 2
       AND S.QTY - S.PRCQTY &gt; 0
       AND H.SITE LIKE '%{0}%'
       AND H.BPSNO LIKE '%{1}%'
       AND S.ITMNO + ITM.ITMNAM +ISNULL(S.ITMVER,'')+ H.PRJNUM LIKE '%{2}%'</SQLScript>
