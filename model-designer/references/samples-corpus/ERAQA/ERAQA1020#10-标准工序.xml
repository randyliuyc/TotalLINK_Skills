  <SQLNew>--LINKADDNEWROWS
INSERT INTO QAOPESTD 
           ([OPESTD]
           ,[OPEDES1]
           ,[OPEDES2]
           ,[MATTYP]
           ,[RPTGRP1]
           ,[RPTTTL1]
           ,[RPTGRP2]
           ,[RPTTTL2]
           ,[INSTRUCTION]
           ,[OPEUNT]
           ,[CTLTYP]
           ,[NTYP]
           ,[MEAFRQ]
           ,[INSTCOD]
           ,[INSTCAT]
           ,[CREUSR]
           ,[UPDUSR]
           ,[CRETIM]
           ,[UPDTIM])
     VALUES
           (
            '#OPESTD#'--&lt;OPESTD, varchar(30),&gt;
           ,'#OPEDES1#'--&lt;OPEDES1, nvarchar(100),&gt;
           ,'#OPEDES2#'--&lt;OPEDES2, nvarchar(100),&gt;
           ,'#MATTYP#'
           ,'#RPTGRP1#'
           ,'#RPTTTL1#'
           ,'#RPTGRP2#'
           ,'#RPTTTL2#'
           ,'#INSTRUCTION#'--&lt;INSTRUCTION, nvarchar(100),&gt;
           ,'#OPEUNT#'--&lt;OPEUNT, varchar(30),&gt;
           ,'#LINKDROPVALIDCTLTYP#'--&lt;CTLTYP, varchar(30),&gt;
           ,'#LINKDROPVALIDNTYP#'
           ,'#LINKDROPVALIDMEAFRQ#'--&lt;MEAFRQ, varchar(30),&gt;
           ,'#INSTCOD#'--&lt;INSTCOD, varchar(30),&gt;
           ,'#LINKDROPVALIDINSTCAT#'--&lt;INSTCAT, varchar(30),&gt;
           ,'#LOGIN_USER#'--&lt;CREUSR, varchar(30),&gt;
           ,''--&lt;UPDUSR, varchar(30),&gt;
           ,GETDATE()--&lt;CRETIM, datetime,&gt;
           ,''--&lt;UPDTIM, datetime,&gt;
		   );
INSERT INTO QAOPESTDCTL 
           ([OPESTD]
           ,[VALTYP]
           ,[VALLIN]
           ,[VALDES]
           ,[VALCTL]
           ,[CREUSR]
           ,[UPDUSR]
           ,[CRETIM]
           ,[UPDTIM])
     SELECT 
	    '#OPESTD#'--&lt;OPESTD, varchar(30),&gt;
           ,S.VALTYP--&lt;VALTYP, varchar(30),&gt;
           ,S.VALLIN--&lt;VALLIN, int,&gt;
           ,S.VALDES--&lt;VALDES, nvarchar(100),&gt;
           ,S.VALCTL--&lt;VALCTL, varchar(1),&gt;
           ,'#LOGIN_USER#'--&lt;CREUSR, varchar(30),&gt;
           ,''--&lt;UPDUSR, varchar(30),&gt;
           ,GETDATE()--&lt;CRETIM, datetime,&gt;
           ,''--&lt;UPDTIM, datetime,&gt;
	FROM QAOPESTDCTL  S WHERE OPESTD='60010'
     ORDER BY S.ID</SQLNew>
