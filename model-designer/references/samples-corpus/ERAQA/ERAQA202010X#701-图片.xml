  <ChartType />
  <SQLScript>--LINKNOGROUP
--LINKNOFILTER
SELECT  '&lt;img src="'+ '#LINKSERVER#' + S.[FILURL] + '"/&gt;' LINKLABELPICTURE
    , S.ID LINKROWID
FROM [LINKDOCFIL] S
LEFT JOIN LINKERA.dbo.SysUser U
    ON S.[CREUSR] = U.LoginUser
WHERE S.SRCDOC = '{0}'
    AND (
        S.SRCLIN = 0{1}
        OR SRCLIN = 0
        )
    AND SRCTYP='{2}'
ORDER BY S.ID</SQLScript>
