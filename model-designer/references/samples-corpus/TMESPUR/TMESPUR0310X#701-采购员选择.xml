  <SQLScript>SELECT S.[ID]  LINKROWID
      ,S.RESNO
      ,S.RESNAM
      ,S.RESNAM1
      ,S.RESNAM2
      ,S.RESSHO
      ,S.RESSHO1
      ,S.RESSHO2
      ,S.RESTYP
	  ,ISNULL(ENTTYP.OPTDES,'') OPTDES
      ,S.RESROLE
      ,S.LINKUSER
      ,S.TEL
      ,S.WEB
      ,S.MOB
      ,S.MAIL
      ,S.SEX
      ,CASE  WHEN CONVERT(VARCHAR,S.BIRTH,23)='1900-01-01'  THEN ''
       ELSE   CONVERT(VARCHAR,S.BIRTH,23) END  BIRTH
      ,S.IDCARD
      ,S.REMARK
      ,S.SITE
      ,ES.SITENAM  SITEDES
      ,S.[CREUSR]
      ,S.[UPDUSR]
      ,CONVERT(VARCHAR(16), S.[CRETIM], 21) CRETIM
      ,CONVERT(VARCHAR(16), S.[UPDTIM], 21) UPDTIM
FROM   [ENTRES] S
LEFT JOIN ENTSITE ES ON ES.SITE=S.SITE
LEFT JOIN LINKOPT ENTTYP ON S.RESTYP = ENTTYP.OPTID AND ENTTYP.OPTTYP = 'ENTTYP'
WHERE S.RESTYP = 'ENT02'
AND S.RESNO+ S.RESNAM LIKE N'%{0}%'</SQLScript>
