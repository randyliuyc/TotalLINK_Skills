  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>--LINKLOADDATAIMMEDIATE
SELECT OPESTD
    , CONCAT (
        VALTYP
        , VALLIN
        ) CTLNAM
    , VALDES
    , VALCTL
INTO #TSTDCTL
FROM QAOPESTDCTL

-- Pivot for VALDES
SELECT OPESTD
    , [N1] AS N1_DES
    , [N2] AS N2_DES
    , [N3] AS N3_DES
    , [N4] AS N4_DES
    , [N5] AS N5_DES
    , [N6] AS N6_DES
    , [N7] AS N7_DES
    , [N8] AS N8_DES
    , [L1] AS L1_DES
    , [L2] AS L2_DES
    , [P1] AS P1_DES
    , [P2] AS P2_DES
    , [P3] AS P3_DES
    , [P4] AS P4_DES
    , [P5] AS P5_DES
INTO #VALDES_PIVOT
FROM (
    SELECT OPESTD
        , CTLNAM
        , VALDES
    FROM #TSTDCTL
    ) AS SourceTable
PIVOT(MAX(VALDES) FOR CTLNAM IN ([N1], [N2], [N3], [N4], [N5], [N6], [N7], [N8], [L1], [L2], [P1], [P2], [P3], [P4], [P5])) AS PivotTable;

-- Pivot for VALCTL
SELECT OPESTD
    , [N1] AS N1_CTL
    , [N2] AS N2_CTL
    , [N3] AS N3_CTL
    , [N4] AS N4_CTL
    , [N5] AS N5_CTL
    , [N6] AS N6_CTL
    , [N7] AS N7_CTL
    , [N8] AS N8_CTL
    , [L1] AS L1_CTL
    , [L2] AS L2_CTL
    , [P1] AS P1_CTL
    , [P2] AS P2_CTL
    , [P3] AS P3_CTL
    , [P4] AS P4_CTL
    , [P5] AS P5_CTL
INTO #VALCTL_PIVOT
FROM (
    SELECT OPESTD
        , CTLNAM
        , VALCTL
    FROM #TSTDCTL
    ) AS SourceTable
PIVOT(MAX(VALCTL) FOR CTLNAM IN ([N1], [N2], [N3], [N4], [N5], [N6], [N7], [N8], [L1], [L2], [P1], [P2], [P3], [P4], [P5])) AS PivotTable;

-- Join the two pivot tables
SELECT S.OPESTD
    , S.OPEDES1
    , S.OPEDES2
    ,S.MATTYP
    ,S.RPTGRP1
    ,S.RPTTTL1
    ,S.RPTGRP2
    ,S.RPTTTL2
    , S.INSTRUCTION
    , S.OPEUNT
    , S.CTLTYP
    , S.MEAFRQ
    , S.INSTCAT
    , S.INSTCOD
    -- , S.NTYP
    , vd.N1_DES
    , vc.N1_CTL
    , vd.N2_DES
    , vc.N2_CTL
    , vd.N3_DES
    , vc.N3_CTL
    , vd.N4_DES
    , vc.N4_CTL
    , vd.N5_DES
    , vc.N5_CTL
    , vd.N6_DES
    , vc.N6_CTL
    , vd.N7_DES
    , vc.N7_CTL
    , vd.N8_DES
    , vc.N8_CTL
    , vd.L1_DES
    , vc.L1_CTL
    , vd.L2_DES
    , vc.L2_CTL
    , vd.P1_DES
    , vc.P1_CTL
    , vd.P2_DES
    , vc.P2_CTL
    , vd.P3_DES
    , vc.P3_CTL
    , vd.P4_DES
    , vc.P4_CTL
    , vd.P5_DES
    , vc.P5_CTL
FROM QAOPESTD S
INNER JOIN #VALDES_PIVOT vd
    ON S.OPESTD = vd.OPESTD
INNER JOIN #VALCTL_PIVOT vc
    ON vd.OPESTD = vc.OPESTD
ORDER BY S.OPESTD;

-- Clean up temporary tables
DROP TABLE #TSTDCTL;

DROP TABLE #VALDES_PIVOT;

DROP TABLE #VALCTL_PIVOT;</SQLScript>
