  <SQLScript>DECLARE @STOFCY VARCHAR(50)='{0}'
DECLARE @ITMREF VARCHAR(50)='{1}';

SELECT K.STOCOU_0                                   LINKROWID
      ,CAST(ISNULL(XWS.QTYSTU, K.QTYSTU_0) AS REAL) 数量
      ,K.LOC_0                                      库位
	  ,XWS.LOC_1                                    新库位
      ,K.LOT_0                                      批次
     -- ,K.SERNUM_0                                   序列号
      ,ISNULL(K.ZSTOFLD3_0,K.SERNUM_0)                                 序列号
      ,'{2}' 打印机编码
      ,ISNULL(CONVERT(VARCHAR(16), XWS.CREDATIM, 21),CONVERT(VARCHAR(16),K.UPDDATTIM_0,21))      操作时间
      ,ISNULL(XWS.CREUSR,K.UPDUSR_0)                                 操作人员
      ,CASE
          WHEN XWS.STOCOU IS NULL THEN 'mui-hidden'
          ELSE ''
        END                                         LINKROWIDBTNFLG
      ,CASE
          WHEN XWS.STOCOU IS NOT NULL THEN 'E02'
          ELSE ''
        END                                         ROW_BACKCOLOR
,XWS.PK_0
FROM   STOCK K
       INNER JOIN ITMMASTER ITM
               ON K.ITMREF_0 = ITM.ITMREF_0
       LEFT JOIN (SELECT STOCOU_0        STOCOU
                        ,SUM(QTYSTU_0)   QTYSTU
                        ,MAX(CREDATIM_0) CREDATIM
                        ,MAX(USERID_0)   CREUSR,PK_0
						,LOC_1 
                  FROM   XWSSCS
                  WHERE  ITMREF_0 = @ITMREF
                         AND RPFLG_0 &lt;&gt; 3
                         AND TRSFAM_0 = 'CHG'
                  GROUP  BY STOCOU_0,PK_0,LOC_1) XWS
              ON XWS.STOCOU = K.STOCOU_0
WHERE  K.STOFCY_0 = @STOFCY
       AND K.ITMREF_0 = @ITMREF
ORDER  BY ISNULL(XWS.STOCOU, 0) DESC
          ,K.LOT_0</SQLScript>
