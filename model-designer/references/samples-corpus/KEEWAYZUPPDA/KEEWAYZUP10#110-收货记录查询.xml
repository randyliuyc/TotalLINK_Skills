  <SQLScript>--LINKDETAILLIST(KEEWAYZUP10110X,700,{0},{1},{5})

DECLARE @SITE VARCHAR(10)='{0}'; --收货地点
DECLARE @PTHNUM VARCHAR(50)=N'%{1}%'; --收货单号
DECLARE @BPSNUM NVARCHAR(100)=N'%{2}%'; --供应商
DECLARE @STATIM DATE='{3}'
DECLARE @ENDTIM DATE='{4}'
DECLARE @BATCHID VARCHAR(100)='{5}';  

SELECT T.BPSNDE_0                            送货单号
       ,T.PTHNUM_0                           单据号
       ,CONVERT(VARCHAR(10), T.RCPDAT_0, 21) 入库日期
       ,T.BPSNUM_0                           供应商编码
       ,T.BPONAM_0                           供应商
       ,BPS.BPSSHO_0                         供应商简称
       ,ISNULL(S.NOMUSR_0, T.CREUSR_0)       收货人
       ,T.ZRMK_0                             备注
       ,T.PTHNUM_0                           id
FROM   PRECEIPT T
       LEFT JOIN (SELECT MAX(BATCHID_0) BATCHID_0
                         ,RPNUM_0
                  FROM   XWSPTH
                  WHERE  RPFLG_0 = 3
                  GROUP  BY RPNUM_0)XWS
              ON XWS.RPNUM_0 = T.PTHNUM_0
       LEFT JOIN AUTILIS S
              ON T.CREUSR_0 = S.USR_0
       INNER JOIN BPSUPPLIER BPS 
              ON BPS.BPSNUM_0=T.BPSNUM_0
WHERE  T.PRHFCY_0 = @SITE
       AND T.PTHNUM_0 LIKE @PTHNUM
       AND ISNULL(BPS.BPSNUM_0,'')+ISNULL(BPS.BPSNAM_0,'')+ISNULL(BPS.BPSSHO_0,'') LIKE @BPSNUM
       AND ( CONVERT(VARCHAR(10), T.RCPDAT_0, 21) BETWEEN @STATIM AND @ENDTIM
              OR @STATIM = '' )
       AND (ISNULL(XWS.BATCHID_0, '') = @BATCHID OR @BATCHID ='')</SQLScript>
