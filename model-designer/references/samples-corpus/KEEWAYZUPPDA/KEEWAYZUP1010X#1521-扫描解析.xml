  <SQLScript>SELECT P.POHFCY_0 地点
       ,P.POHNUM_0 采购单号
	   ,BPS.BPSNAM_0 供应商
	   ,IIF(P.CLEFLG_0 =2,N'lang:{zh:关闭无需收货,en:Closed, no receiving needed,de:Geschlossen, kein Wareneingang nötig}',N'lang:{zh:可收货,en:Can receive,de:Wareneingang möglich}') 状态
FROM PORDER P
INNER JOIN BPSUPPLIER BPS ON P.BPSNUM_0=BPS.BPSNUM_0                 
WHERE  P.POHNUM_0='{0}'</SQLScript>
