  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>--LINKAPPMENUHIDE
DECLARE @DOCNUM VARCHAR(30)='MFG24100102-65';
DECLARE @OPENUM INT=0150;
DECLARE @INSTCOD VARCHAR(30)='';

DECLARE @ROUCOD VARCHAR(30);

SELECT @ROUCOD = ROUCOD
FROM QAINSPH
WHERE DOCNUM = @DOCNUM;;

UPDATE QAINSPL
SET INSTCOD = @INSTCOD
WHERE DOCNUM = @DOCNUM
    AND OPENUM = @OPENUM;

IF OBJECT_ID(N'tempdb..#TCC') IS NOT NULL
    DROP TABLE #TCC;

WITH CTE_TC
AS (
    SELECT CONCAT (
            'T'
            , VALTYP
            , VALLIN
            ) TC
        , VALDES
    FROM QAROULINCTL
    WHERE ROUCOD = @ROUCOD
        AND OPENUM = @OPENUM
        AND VALTYP IN ('L', 'N')
    
    UNION ALL
    
    SELECT CONCAT (
            'F'
            , VALTYP
            , VALLIN
            ) TC
        , IIF(VALDES = '', 'mui-hidden', '') VALDES
    FROM QAROULINCTL
    WHERE ROUCOD = @ROUCOD
        AND OPENUM = @OPENUM
        AND VALTYP IN ('L', 'N')
    )
SELECT *
INTO #TCC
FROM (
    SELECT *
    FROM CTE_TC
    ) AS SourceTable
PIVOT(MAX(VALDES) FOR TC IN (
            TN1, TN2, TN3, TN4, TN5, TN6, TN7, TN8, TL1, TL2, --
            FN1, FN2, FN3, FN4, FN5, FN6, FN7, FN8, FL1, FL2
            )) AS PivotTable;

SELECT CASE WHEN D.OPEDES2 = '自行车 / 损伤检查' THEN N'lang:{zh:自行车 / 损伤检查,de:Fahrrad / Schadensprüfung}' END OPEDES2
    , L.MEAFRQ
    , L.CTLTYP
    , L.INSTCOD
    , CASE WHEN S.SPOOL + S.COIL + S.SAMP = '车把/座舱' THEN 'lang:{zh:车把/座舱,de:Lenker/Cockpit}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '传动/变速' THEN 'lang:{zh:传动/变速,de:Antrieb/Schaltung}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '灯光/安全件' THEN 'lang:{zh:灯光/安全件,de:Beleuchtung/Sicherheitsteile}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '轮胎/轮组' THEN 'lang:{zh:轮胎/轮组,de:Reifen/Laufräder}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '配件安装' THEN 'lang:{zh:配件安装,de:Montage von Zubehör}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '刹车' THEN 'lang:{zh:刹车,de:Bremse}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '载货车' THEN 'lang:{zh:载货车,de:Lastenfahrrad}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '诊断/电控' THEN 'lang:{zh:诊断/电控,de:Diagnose/Elektronik}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '避震前叉' THEN 'lang:{zh:避震前叉,de:Federgabel}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '拨链变速/内变速' THEN 'lang:{zh:拨链变速/内变速,de:Kettenschaltung/Nabenschaltung}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '车把/把立' THEN 'lang:{zh:车把/把立,de:Lenker/Vorbau}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '车架' THEN 'lang:{zh:车架,de:Rahmen}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '车轮/轮胎' THEN 'lang:{zh:车轮/轮胎,de:Laufrad/Reifen}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '车座/座管' THEN 'lang:{zh:车座/座管,de:Sattel/Sattelstütze}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '碟刹' THEN 'lang:{zh:碟刹,de:Scheibenbremse}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '后轮花鼓' THEN 'lang:{zh:后轮花鼓,de:Hinterradnabe}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '后悬挂' THEN 'lang:{zh:后悬挂,de:Hinterradfederung}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '货架/挡泥板和链条护板' THEN 'lang:{zh:货架/挡泥板和链条护板,de:Gepäckträger/Schutzbleche und Kettenschutz}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '脚踏' THEN 'lang:{zh:脚踏,de:Pedale}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '接车受理/检查保养/服务/其他' THEN 'lang:{zh:接车受理/检查保养/服务/其他,de:Fahrzeugannahme/Inspektion/Wartung/Service/Sonstiges}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '链条' THEN 'lang:{zh:链条,de:Kette}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '皮带传动' THEN 'lang:{zh:皮带传动,de:Riemenantrieb}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '前叉/头管轴承' THEN 'lang:{zh:前叉/头管轴承,de:Gabel/Steuerkopflager}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '前轮花鼓' THEN 'lang:{zh:前轮花鼓,de:Vorderradnabe}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '软件/系统检查/故障诊断' THEN 'lang:{zh:软件/系统检查/故障诊断,de:Software/Systemprüfung/Fehlerdiagnose}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '刹车系统' THEN 'lang:{zh:刹车系统,de:Bremssystem}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '维修修复' THEN 'lang:{zh:维修修复,de:Reparatur/Instandsetzung}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '液压刹车' THEN 'lang:{zh:液压刹车,de:Hydraulische Bremse}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '照明系统/反光件' THEN 'lang:{zh:照明系统/反光件,de:Beleuchtungssystem/Reflektoren}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '中轴/脚踏/传动系统' THEN 'lang:{zh:中轴/脚踏/传动系统,de:Tretlager/Pedale/Antriebssystem}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '整车' THEN 'lang:{zh:整车,de:Komplettes Fahrrad}'
           END QAITM
    , CAST(S.N1 AS DECIMAL(18, 3)) N1
    , CAST(S.N2 AS DECIMAL(18, 3)) N2
    , CAST(S.N3 AS DECIMAL(18, 3)) N3
    , CAST(S.N4 AS DECIMAL(18, 3)) N4
    , CAST(S.N5 AS DECIMAL(18, 3)) N5
    , CAST(S.N6 AS DECIMAL(18, 3)) N6
    , CAST(S.N7 AS DECIMAL(18, 3)) N7
    , CAST(S.N8 AS DECIMAL(18, 3)) N8
    , IIF(S.L1=1,'True','False') L1
    , IIF(S.L2=1,'True','False') L2
    , S.REMARK
    , CASE 
        WHEN L.CTLTYP = 'N'
            THEN REPLACE(CONCAT_WS('/', CAST(S.N1 AS DECIMAL(18, 3)), CAST(S.N2 AS DECIMAL(18, 3)), --
                        CAST(S.N3 AS DECIMAL(18, 3)), CAST(S.N4 AS DECIMAL(18, 3)), --
                        CAST(S.N5 AS DECIMAL(18, 3)), CAST(S.N6 AS DECIMAL(18, 3)), --
                        CAST(S.N7 AS DECIMAL(18, 3)), CAST(S.N8 AS DECIMAL(18, 3))), '/0.000', '')
        ELSE (
                IIF(S.L1 = 1, 'OK', 'NOK') + CASE 
                    WHEN L.L2CHECK = 1
                        AND S.L2 = 1
                        THEN '/OK'
                    WHEN L.L2CHECK = 1
                        AND S.L2 = 0
                        THEN '/NOK'
                    ELSE ''
                    END
                )
        END QAVAL
    , S.ID QAID
    , IIF(L.CTLTYP = 'N', '501', '502') QABUT
    , S.DOCNUM
    , S.OPENUM
    , S.VALLIN
    , IIF(L.CTLTYP = 'N', CAST(CAST(L.NMIN AS DECIMAL(18, 3)) AS VARCHAR) + '~' --
        + CAST(CAST(L.NMAX AS DECIMAL(18, 3)) AS VARCHAR), '') MINMAX
    , C.*
    , CASE 
        WHEN S.STA = 1
            THEN 'H03'
        WHEN S.STA = 0
            AND S.N1 + CAST(S.L1 AS INT) &lt;&gt; 0
            THEN 'D03'
        ELSE 'C02'
        END LINKAPPRROW
    ,S.STA
FROM QAINSPVAL S
INNER JOIN QAINSPL L
    ON S.DOCNUM = L.DOCNUM
        AND S.OPENUM = L.OPENUM
INNER JOIN QAINSPH H
    ON H.DOCNUM = S.DOCNUM
INNER JOIN QAOPESTD D
    ON L.OPESTD = D.OPESTD
INNER JOIN #TCC C
    ON 1 = 1
WHERE S.DOCNUM = @DOCNUM
    AND S.OPENUM = @OPENUM
    AND S.TRXLIN = 0

IF OBJECT_ID(N'tempdb..#TCC') IS NOT NULL
    DROP TABLE #TCC;</SQLScript>
