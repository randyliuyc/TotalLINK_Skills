  <SQLScript>DECLARE @ITMREF VARCHAR(30) = '{0}';
DECLARE @BOMALT INT=0{1};
DECLARE @BOMTYP INT=0{2};
DECLARE @LAN VARCHAR(30) = '#LOGIN_LAN#';
DECLARE @LANX3 VARCHAR(30) = (SELECT #LC.X3ERP#GETLANX3(@LAN));

SELECT XWS.CPNITMREF_0 物料编码
      ,ISNULL(B.ITMDES,ITM.ITMDES1_0) 物料描述
	  ,XWS.BOMQTY_0 数量
          ,XWS.BOMUOM_0 单位
	--  ,XWS.CPNOPE_0 物料工序
	  ,XWS.BOMSEQ_0 物料顺序
          ,XWS.ROWID    LINKROWID
          ,IIF(XWS.BOMQTY_0=0,'E04','') LINKAPPRROW
          ,''  LINKROWIDHID
FROM XWSBOM XWS
       INNER JOIN ITMMASTER ITM
        ON XWS.CPNITMREF_0 = ITM.ITMREF_0
LEFT JOIN (
    SELECT
            B.IDENT1_0 AS ITMREF
          , B.TEXTE_0 AS ITMDES
           FROM ATEXTRA B
      WHERE B.CODFIC_0 = 'ITMMASTER'
        AND B.LANGUE_0 = @LAN
    AND B.IDENT1_0='ITMDES1_0'
  ) B
        ON B.ITMREF = XWS.CPNITMREF_0
WHERE XWS.ITMREF_0=@ITMREF
AND XWS.BOMALT_0=@BOMALT
AND RPFLG_0&lt;&gt;3
UNION ALL
SELECT D.CPNITMREF_0            物料编码
      ,ISNULL(B.ITMDES,ITM.ITMDES1_0) 物料描述
      ,CAST(D.BOMQTY_0 AS REAL) 数量
      ,D.BOMUOM_0               单位
    --  ,D.CPNOPE_0               物料工序
      ,D.BOMSEQ_0               物料顺序
      ,D.ROWID                  LINKROWID
      ,''                      LINKAPPRROW
      ,'X'  LINKROWIDHID
FROM   BOMD D
       INNER JOIN ITMMASTER ITM
               ON D.CPNITMREF_0 = ITM.ITMREF_0
LEFT JOIN (
      SELECT
            B.IDENT1_0 AS ITMREF
          , STRING_AGG(B.TEXTE_0, '')
              WITHIN GROUP (ORDER BY B.ZONE_0) AS ITMDES
      FROM ATEXTRA B
      WHERE B.CODFIC_0 = 'ITMMASTER'
        AND B.LANGUE_0 = @LANX3
      GROUP BY
            B.IDENT1_0
  ) B
        ON B.ITMREF = D.CPNITMREF_0
WHERE  D.ITMREF_0 = @ITMREF
       AND D.BOMALT_0 = @BOMALT
       AND D.BOMALTTYP_0=@BOMTYP
ORDER  BY 物料顺序</SQLScript>
  <SQLUpdateScript>--LINKEDITMODE
UPDATE XWSBOM
SET CPNITMREF_0='#物料编码#'
   ,BOMQTY_0=0#数量#
   ,BOMSEQ_0=0#物料顺序#
WHERE ROWID=0#LINKROWID# AND RPFLG_0&lt;&gt;3</SQLUpdateScript>
