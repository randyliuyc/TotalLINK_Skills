  <KeyWords />
  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>--LINKLOADDATAIMMEDIATE
DECLARE @STRDAT DATE='{0}';
DECLARE @ENDDAT DATE='{1}';
DECLARE @ROUTYP VARCHAR(30)='%{2}%';
DECLARE @ITMNO VARCHAR(30)='%{4}%';
DECLARE @VCRNUM VARCHAR(30)='%{5}%';

SELECT H.DOCNUM
      ,H.DOCDAT
      ,ROUTYP.OPTDES                       ROUTYP
      ,H.ITMNO
      ,ITM.ITMDES2_0 RANGE
      ,CASE WHEN Q.DOCNUM IS NULL THEN IIF(ITM.ZDIA_MM_0 = 0, CAST(CAST(ITM.ZWIDTH_MM_0 AS DECIMAL(18, 3)) AS VARCHAR(30)) --
        + ' * ' + CAST(CAST(ITM.ZTHICK_MM_0 AS DECIMAL(18, 3)) AS VARCHAR(30)), --
        CAST(CAST(ITM.ZDIA_MM_0 AS DECIMAL(18, 3)) AS VARCHAR(30)) + ' mm')
            ELSE Q.SIZE END PRODIM
      ,H.MFGNUM
      ,ISNULL(PRC.PRHFCY_0, MFG.MFGFCY_0) STOFCY_0
      ,ITM.ZGRADENO_0 GRDCOD
      ,IIF(Q.DOCNUM IS NULL,E.GRDNAM,Q.GRADE) GRDNAM
      ,IIF(Q.DOCNUM IS NULL,H.LOT,Q.LOT) LOT
      ,H.TV
      ,H.CUSCOD
      ,H.INTSPEC
      ,Q.DEMANDER
      ,Q.INSPREA
      ,CASE
          WHEN H.STA = 2 THEN '√'
          WHEN H.STA = 1 THEN '×'
          ELSE ''
        END                                HSTA
      ,H.CLOUSR
      ,CONVERT(VARCHAR(16), H.CLOTIM,21) CLOTIM
      ,H.CREUSR
      ,CONVERT(VARCHAR(16), H.CRETIM, 21) CRETIM
      ,H.UPDUSR
      ,CONVERT(VARCHAR(16), H.UPDTIM, 21) UPDTIM
      ,H.ROUTYP LINKROWIDROUTYP
      ,H.ROUCOD ROUCODCK
FROM  QAINSPH H
       LEFT JOIN QAOPT ROUTYP
              ON ROUTYP .OPTTYP = 'ROUTYP'
                 AND ROUTYP.OPTID = H.ROUTYP
       LEFT JOIN QAINSPREQ Q
              ON Q.DOCNUM=H.DOCNUM
       LEFT JOIN QAMAT M
              ON M.LOT = H.LOT
                 AND M.TV = H.TV
       LEFT JOIN #LC.X3DATA#PRECEIPT PRC
              ON PRC.PTHNUM_0 #LC.X3COLLATE# = H.MFGNUM
       LEFT JOIN #LC.X3DATA#MFGHEAD MFG
              ON MFG.MFGNUM_0 #LC.X3COLLATE# = H.MFGNUM
       LEFT JOIN #LC.X3DATA#ITMMASTER ITM
             ON ITM.ITMREF_0 #LC.X3COLLATE#=H.ITMNO
       LEFT JOIN QAGRADE E
              ON ITM.ZGRADENO_0 #LC.X3COLLATE# = E.GRDCOD
                 AND E.CUSCOD = ''
WHERE  ISNULL(H.CLOSTA,0)=1
       AND H.DOCDAT BETWEEN @STRDAT AND @ENDDAT
       AND H.ROUTYP LIKE @ROUTYP
       AND ISNULL(H.ITMNO,'') LIKE @ITMNO
       AND ISNULL(H.MFGNUM,'') LIKE @VCRNUM
ORDER  BY H.DOCDAT DESC
          ,H.DOCNUM DESC</SQLScript>
