  <SQLScript>SELECT TOP 500 S.ITMNO
               ,S.ITMNO
               ,S.ITMNAM --中文描述
               ,S.ITMNAM1 --越南描述 
               ,S.ITMNAM2 --英文描述
               ,S.ITMSIZE
               ,S.ITMSPEC
               ,S.PCU
               ,S.PCUCOE
               ,S.ITMVERFLG
FROM   ITM S
WHERE  S.ITMSTA = '1' --激活的
       AND S.TCLCOD = 'PACK'--产品种类
       AND S.TSICOD1 = '201'
       AND S.TSICOD2 = '20106'
       AND S.ITMSIZE + S.ITMSPEC + S.ITMNO + S.ITMNAM
           + S.ITMNAM1 + S.ITMNAM2 LIKE '%{0}%'
ORDER  BY S.ITMNO ASC</SQLScript>
