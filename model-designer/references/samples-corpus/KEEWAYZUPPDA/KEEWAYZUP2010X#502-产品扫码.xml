  <SQLClear>--LINKREFRESH
INSERT INTO XWSSCS
            (MACHINEID_0,
             USERID_0,
             CUSERID_0,
             VCRTYP_0,
             PK_0,
             BATCHID_0,
             PKORI_0,
             CREDATIM_0,
             STAT_0,
             SUBDATIM_0,
             RPFLG_0,
             RPNUM_0,
             RPLIN_0,
             RPNOTE_0,
             RPDATE_0,
             RPDATIM_0,
             VCRNUM_0,
             VCRLIN_0,
             STOFCY_0,
             IPTDAT_0,
             VCRDES_0,
             PJT_0,
             TRSFAM_0,
             ITMREF_0,
             STU_0,
             QTYSTU_0,
             LOT_0,
             SLO_0,
             SERNUM_0,
             STOCOU_0,
             STA_0,
             STA_1,
             LOCTYP_0,
             LOCTYP_1,
             LOC_0,
             LOC_1,
             PALNUM_0,
             PALNUM_1,
             CTRNUM_0,
             CTRNUM_1,
             NOTE_0,
             NOTE_1,
             NOTE_2,
             NOTE_3,
             NOTE_4,
             BPRNUM_0,
             CREDATTIM_0,
             UPDDATTIM_0,
             AUUID_0,
             CREUSR_0,
             UPDUSR_0,
             WRH_0,
             [STOFLD1_0],
             [STOFLD2_0])
SELECT '#LOGIN_ID#'            MACHINEID_0
      ,'#LOGIN_USER#'          USERID_0
      ,'#LOGIN_USER#'          CUSERID_0
      ,29                      VCRTYP_0
      ,NEWID()                 PK_0
      ,''                      BATCHID_0
      ,'SG'                    PKORI_0
      ,GETDATE()               CREDATIM_0
      ,1                       STAT_0
      ,'1999-01-01'            SUBDATIM_0
      ,1                       RPFLG_0
      ,''                      RPNUM_0
      ,0                       RPLIN_0
      ,''                      RPNOTE_0
      ,'1999-01-01'            RPDATE_0
      ,'1999-01-01'            RPDATIM_0
      ,''                      VCRNUM_0
      ,0                       VCRLIN_0
      ,STOFCY_0                STOFCY_0
      ,CONVERT(VARCHAR, GETDATE(), 23)               IPTDAT_0
      ,N'lang:{zh:存货移库,en:Inventory transfer,de:Lagerumschlag}'                   VCRDES_0
      ,''                      PJT_0
      ,'CHG'                   TRSFAM_0
      ,ITMREF_0                ITMREF_0
      ,PCU_0                   STU_0
      ,0#数量#                       QTYSTU_0
      ,LOT_0                   LOT_0
      ,SLO_0                   SLO_0
      ,SERNUM_0                SERNUM_0
      ,STOCOU_0                STOCOU_0
      ,STA_0                   STA_0
      ,STA_0                   STA_1
      ,''                      LOCTYP_0
      ,''                      LOCTYP_1
      ,LOC_0                   LOC_0
      ,N'#新库位#'               LOC_1
      ,PALNUM_0                PALNUM_0
      ,PALNUM_0                PALNUM_1
      ,CTRNUM_0                CTRNUM_0
      ,CTRNUM_0                CTRNUM_1
      ,''              NOTE_0   
      ,''                      NOTE_1
      ,''                      NOTE_2
      ,ZSTOFLD3_0                      NOTE_3 --序列号ZSTOFLD3_0
      ,''                      NOTE_4
      ,''                      BPRNUM_0
      ,GETDATE()               CREDATTIM_0
      ,''                      UPDDATTIM_0
      ,NEWID()                 AUUID_0
      ,LEFT('#LOGIN_USER#', 5) CREUSR_0
      ,''                      UPDUSR_0
      ,(SELECT WRH_0
         FROM   STOLOC
         WHERE  LOC_0 = '#原库位#'
                AND STOFCY_0 = '#地点#')
      ,STOFLD1_0
      ,STOFLD2_0
FROM   STOCK
WHERE STOCOU_0=0#STOCOU# 
AND STOCOU_0 NOT IN (SELECT STOCOU_0 FROM XWSSCS WHERE RPFLG_0&lt;&gt;3 AND TRSFAM_0='CHG' AND STOCOU_0=0#STOCOU# AND LOC_1='#新库位#')</SQLClear>
