  <SQLScript>#LINKSCRIPTGET@DATAQA:
SELECT CASE WHEN ISNULL(STA, 0)=0 THEN N'LINKPREVENT:The quality inspection is not completed and cannot be confirmed.
质检未完成，不可确认'
            WHEN ISNULL(CLOSTA,0)=1 THEN N'LINKPREVENT:The quality inspection has been completed.
已完成质检'
END
FROM QAINSPH WHERE DOCNUM='{0}'
