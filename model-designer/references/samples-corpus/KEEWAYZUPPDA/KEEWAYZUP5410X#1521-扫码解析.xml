  <SQLScript>DECLARE @TAG VARCHAR(100) = '{0}'; 
DECLARE @MFGNUM VARCHAR(50);

SET @MFGNUM = CASE
                WHEN CHARINDEX('-', @TAG) &gt; 0 THEN LEFT(@TAG, CHARINDEX('-', @TAG) - 1)
                WHEN CHARINDEX(' ', @TAG) &gt; 0 THEN LEFT(@TAG, CHARINDEX(' ', @TAG) - 1)
                ELSE @TAG
              END;

IF NOT EXISTS (SELECT 1
               FROM   MFGITM
               WHERE  MFGNUM_0 = @MFGNUM)
  BEGIN
      SELECT 'ZUPK'                        AS 生产地点
            ,''                            AS 工单号
            ,''                            AS 产品编码
            ,N'lang:{zh:无法查到工单记录,en:Cannot find work order record,de:Arbeitsauftrag nicht gefunden} [' + @TAG + N']' AS 数据检查;
  END
ELSE
  BEGIN
      SELECT MFGFCY_0 AS 生产地点
            ,MFGNUM_0 AS 工单号
            ,ITMREF_0 AS 产品编码
            ,CASE
                WHEN MFGSTA_0 &lt;&gt; 1 THEN N'lang:{zh:工单不是确认状态,en:Work order not confirmed,de:Arbeitsauftrag nicht bestätigt}'
                ELSE ''
              END     AS 数据检查
      FROM   MFGITM
      WHERE  MFGNUM_0 = @MFGNUM
      ORDER  BY MFGNUM_0;
  END</SQLScript>
