  <SQLNew />
  <SQLRemove>#LINKSCRIPTGET@LINK01:
-- 检查单据是否已确认（存在于采购订单表或生产订单表）
IF EXISTS (
    SELECT 1 FROM XWSPOH WHERE XMHNUM_0='#计划单号#'
    UNION ALL
    SELECT 1 FROM XWSMFG WHERE XMHNUM_0='#计划单号#'
)
BEGIN
    SELECT N'LINKPREVENT:lang:{zh:已确认，无法删除,en:This document has been confirmed and cannot be deleted.,de:Dieses Dokument wurde bereits bestätigt und kann nicht gelöscht werden.}'
    RETURN;
END
#</SQLRemove>
