  <KeyWords />
  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>--LINKLOADDATAIMMEDIATE 
--LINKNOGROUP
DECLARE @XMH VARCHAR(50) = '{0}';
DECLARE @ITMREF VARCHAR(30) = '{1}'
-- W-WEEK / M-MONTH 
DECLARE @PRDTYP CHAR(1) = 'W';
-- 是否将过期日期统一作为当前日期处理
DECLARE @DATTRSFLG BIT = 0;

WITH CTE_DOC
AS (
  SELECT VCRREF
    , [VCRDES#LOGIN_LAN#] VCRDES
    , TRXSIGN
    , VCRSEQ
    , GESFUN
    , VCRAPPR
  FROM XLINKMRPDOC
  )
, CTE_DATA
AS (
  SELECT XWS.VCRREF_0 VCRREF
    -- , M.OPTDES VCRDES
    , D.VCRDES
    , XWS.ABBFIL_0 DOCTYP
    , IIF(@PRDTYP = 'W', CONCAT (
        DATEPART(YEAR, IIF(XWS.ENDDAT_0 &lt; GETDATE()
            AND @DATTRSFLG = 1, GETDATE(), XWS.ENDDAT_0))
        , 'W'
        , RIGHT('00' + CAST(DATEPART(WEEK, IIF(XWS.ENDDAT_0 &lt; GETDATE()
                AND @DATTRSFLG = 1, GETDATE(), XWS.ENDDAT_0)) AS VARCHAR(2)), 2)
        ), FORMAT(IIF(XWS.ENDDAT_0 &lt; GETDATE()
          AND @DATTRSFLG = 1, GETDATE(), XWS.ENDDAT_0), 'yyyyMM')) AS PRD
    , CAST(XWS.QTY_0 AS DECIMAL(18,2)) QTY
  FROM XWSSCHRES XWS
  LEFT JOIN CTE_DOC D
    ON D.VCRREF = XWS.VCRREF_0
  WHERE XWS.XMHNUM_0 = @XMH
    AND XWS.ITMREF_0 = @ITMREF
  )
  , CTE_DATASUM
AS (
  SELECT VCRREF
    -- , VCRDES
    -- , DOCTYP
    , PRD
    , SUM(QTY) QTY
  -- INTO #TMRPRES
  FROM CTE_DATA
  GROUP BY VCRREF
    -- , VCRDES
    -- , DOCTYP
    , PRD
  )
SELECT *
INTO #TMRPRES
FROM CTE_DATASUM
ORDER BY PRD
  , VCRREF

SELECT PRD
  , SUM(QTY) OVER (
    ORDER BY PRD ROWS UNBOUNDED PRECEDING
    ) QTY
INTO #TMRPRESRT
FROM (
  SELECT PRD
    , SUM(QTY) QTY
  FROM #TMRPRES
  GROUP BY PRD
  ) R
ORDER BY PRD;

-- SELECT *
-- FROM #TMRPRES;
-- SELECT *
-- FROM #TMRPRESRT;
-- RETURN;
-- 使用动态PIVOT将周次转为列
DECLARE @columns NVARCHAR(MAX) = ''
DECLARE @sql NVARCHAR(MAX) = ''

-- 获取所有周次作为列名
SELECT @columns = STRING_AGG(QUOTENAME(PRD), ',')
FROM (
  SELECT DISTINCT PRD
  FROM #TMRPRES
  ) AS Weeks;

-- SELECT @columns;
-- 构建动态PIVOT查询
SET @sql = N'
WITH CTE_DATA
AS (
SELECT VCRREF, -- VCRDES, DOCTYP, 
' + @columns + 
  N'
FROM #TMRPRES AS SourceTable
PIVOT (
    SUM(QTY)
    FOR PRD IN (' + @columns + 
  N')
) AS PivotTable
UNION ALL
SELECT ''9-BAL'' VCRREF, 
' + 
  @columns + N'
FROM #TMRPRESRT AS SourceTable
PIVOT (
    SUM(QTY)
    FOR PRD IN (' + @columns + 
  N')
) AS PivotTable
-- ORDER BY VCRSEQ
)
, CTE_DOC
AS (
  SELECT VCRREF
    , [VCRDES#LOGIN_LAN#] VCRDES
    , TRXSIGN
    , VCRSEQ
    , GESFUN
    , VCRAPPR
  FROM XLINKMRPDOC
  )
SELECT C.VCRDES, C.VCRREF, ' 
  + @columns + 
  ', C.VCRAPPR LINKAPPRROW
FROM CTE_DATA D
LEFT JOIN CTE_DOC C
  ON C.VCRREF = D.VCRREF
ORDER BY C.VCRSEQ
'

-- SELECT @sql
EXEC sp_executesql @sql

DROP TABLE #TMRPRES;

DROP TABLE #TMRPRESRT;</SQLScript>
