  <SQLScript>--LINKDATAMINEOVERVIEW,VERTICAL,60,AUTOREFRESH
DECLARE @GRDCOD VARCHAR(30)='%{0}%';
DECLARE @LOT VARCHAR(30)='%{1}%';
DECLARE @TV VARCHAR(30)='%{2}%';

SELECT 
       S.LOT
      ,S.TV
      ,'--&gt;'  LINKSUB30_客户检测指标
      ,R.GRDNAM 
      ,S.GRDCOD 
      ,S.QAMATDOC
      ,CAST(S.DECARB AS DECIMAL(18,2)) DECARB
      ,CAST(S.HARDNESS AS DECIMAL(18,2)) HARDNESS
      ,CAST(S.GRAINSIZE AS DECIMAL(18,2)) GRAINSIZE
      ,CAST(S.TENSILE AS DECIMAL(18,2))  TENSILE
     -- ,S.SUPCOD
     -- ,S.COILREF
     -- ,S.MATTYP LINKDROPVALIDMATTYP
      ,S.DIA_WID
      ,S.THICK
      ,S.LEN
      ,S.WEIGHT
      ,S.STA
    --  ,S.ITMNO
      ,S.DOCNUM 
      ,S.CREUSR
      ,S.UPDUSR
      ,CONVERT(VARCHAR(16), S.CRETIM, 21) CRETIM
      ,CONVERT(VARCHAR(16), S.UPDTIM, 21) UPDTIM
      ,S.ID                               LINKROWID
FROM   QAMAT S
     LEFT JOIN QAGRADE R
	   ON S.GRDCOD=R.GRDCOD AND R.CUSCOD=''
WHERE  S.GRDCOD+ISNULL(R.GRDNAM,'') LIKE @GRDCOD
       AND S.LOT LIKE @LOT
       AND S.TV LIKE @TV
ORDER  BY S.LOT,S.TV</SQLScript>
  <SQLUpdateScript>--LINKEDITMODE
--LINKSAVEONENTERKEY
UPDATE QAMAT SET
 GRAINSIZE = 0#GRAINSIZE#
,DECARB = 0#DECARB#
,HARDNESS = 0#HARDNESS#
,TENSILE = 0#TENSILE#
--,SUPCOD = N'#SUPCOD#'
--,COILREF = N'#COILREF#'
--,MATTYP = N'#LINKDROPVALIDMATTYP#'
,DIA_WID = 0#DIA_WID#
,THICK = 0#THICK#
,LEN = 0#LEN#
,WEIGHT=0#WEIGHT#
,QAMATDOC='#QAMATDOC#'
,UPDUSR = N'#LOGIN_USER#'
,UPDTIM = GETDATE()
WHERE DOCNUM='#DOCNUM#';</SQLUpdateScript>
