  <SQLScript>SELECT S.DOCNUM+'-'+CAST(S.DOCLIN AS VARCHAR(16)) DOCKEY
,S.DOCNUM  SRCDOC --采购单号
,S.DOCLIN SRCLIN --行号
,S.DOCTYP SRCTYP --单据类型
,CONVERT(VARCHAR(16),H.DOCDAT,23) DOCDAT
,S.FAC	    --工厂
,S.ITMNO	--产品编码
,ITM.ITMNAM  --中文名称
,ITM.ITMNAM1 --越文名称
,S.ITMVER	--产品版本
,ITM.ITMSIZE
,ITM.ITMSPEC
,ITM.TSICOD1            --产品分类
,ITM.IVATTYP
,CONVERT(VARCHAR(16),H.DOCDAT,23) DOCDAT
,H.DOCDES   --描述
,H.BPSNO 
,BPS.BPSNAM
,H.PRJNUM
,H.SITE
,H.REMARK
,VAT.TAXRT
,S.QTY  PRCQTY      --采购数量
,S.UOM       --采购单位
,S.NETPRI    --无税单价
,S.UOMCOE    --换算系数
,S.QTYSTU    --库存数量
,S.STU       --库存单位
,CAST(S.PIVQTY AS REAL) PIVQTY  --已开票数量
,CAST(S.QTY-S.PIVQTY AS REAL) QTY  --剩余开票数量
 FROM PBOLD S
 LEFT JOIN PBOLH H ON H.DOCNUM=S.DOCNUM
 LEFT JOIN ITM ON ITM.ITMNO=S.ITMNO
 LEFT JOIN BPSUP BPS ON BPS.BPSNO=H.BPSNO
 LEFT JOIN VAT ON VAT.IVATTYP=ITM.IVATTYP AND BPS.BVATTYP=VAT.BVATTYP
WHERE S.DOCSTA=2
   AND S.QTY-S.PIVQTY&gt;0
   AND H.SITE= '{0}' AND H.BPSNO='{1}'
   AND S.DOCNUM+S.ITMNO+ITM.ITMNAM+S.ITMVER LIKE '%{2}%'
ORDER BY H.DOCNUM DESC, S.DOCLIN</SQLScript>
