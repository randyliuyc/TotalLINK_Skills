SET
        STAT_0 = 9
       ,USERID_0='#LOGIN_USER#'
       ,LOC_0='#入库库位#'
FROM XWSMKI XWS
WHERE XWS.RPFLG_0&lt;&gt;3
   AND XWS.SERNUM_0='#车架码#'
   AND XWS.STAT_0=1</SQLNew>
