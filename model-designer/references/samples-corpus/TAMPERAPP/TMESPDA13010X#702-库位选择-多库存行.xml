  <SQLScript>DECLARE @ITMNO VARCHAR(30) = '{0}';
DECLARE @ITMVER NVARCHAR(50) = '{1}';  
DECLARE @LOT VARCHAR(30) = '{2}';  
DECLARE @SUBLOT VARCHAR(30) = '{3}';  
DECLARE @STKFAC VARCHAR(30) = '{4}';
DECLARE @UOM NVARCHAR(6) = '{5}';

SELECT  K.LOC LOC
       ,K.WH
       ,K.UOMCOE
       ,'OK' DATACK
FROM   STK K
LEFT JOIN ENTWH W
ON K.WH=W.WH
WHERE  K.ITMNO = @ITMNO
       AND K.ITMVER = @ITMVER
       AND K.LOT = @LOT
       AND K.SUBLOT = @SUBLOT
       AND K.UOM = @UOM
       AND ISNULL(W.WHGRP,'')='STK'
       AND (ISNULL(W.FAC,'')=@STKFAC OR @STKFAC='')</SQLScript>
