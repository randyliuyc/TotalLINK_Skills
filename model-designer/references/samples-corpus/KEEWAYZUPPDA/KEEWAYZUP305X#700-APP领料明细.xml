  <SQLScript>DECLARE @STOFCY VARCHAR(50)='{0}'
DECLARE @X9HNUM VARCHAR(50)='{1}';
DECLARE @ITMREF VARCHAR(50)='{2}';

DECLARE @DESLOC VARCHAR(50);

SELECT @DESLOC=X9HDESLOC_0 FROM XCN09SGH WHERE X9HNUM_0=@X9HNUM

SELECT K.STOCOU_0                                   LINKROWID
      ,CAST(ISNULL(XWS.QTYSTU, K.QTYSTU_0) AS REAL) 数量
      ,K.LOC_0                                      库位
      ,K.LOT_0                                      批次
      ,K.SERNUM_0                                   序列号
      ,XWS.RPNUM                                    移库单号
      ,CONVERT(VARCHAR(16), XWS.CREDATIM, 21)       操作时间
      ,XWS.CREUSR                                   操作人员
      ,CASE
          WHEN ISNULL(XWS.RPFLG, 3) = 3 THEN 'mui-hidden'
          ELSE ''
        END                                         LINKROWIDBTNFLG
     ,CASE WHEN XWS.RPFLG IN(1,2) THEN 'E02'
           WHEN XWS.RPFLG=3 THEN 'H02'
           ELSE '' END ROW_BACKCOLOR
FROM   STOCK K
       INNER JOIN ITMMASTER ITM
               ON K.ITMREF_0 = ITM.ITMREF_0
       RIGHT JOIN (SELECT STOCOU_0        STOCOU
                        ,SUM(QTYSTU_0)   QTYSTU
                        ,MIN(RPFLG_0)    RPFLG
                        ,MAX(CREDATIM_0) CREDATIM
                        ,MAX(CREUSR_0)   CREUSR
                        ,MAX(RPNUM_0)    RPNUM
                  FROM   XWSSCS
                  WHERE  VCRNUM_0 = @X9HNUM
                         AND ITMREF_0 = @ITMREF
                  GROUP  BY STOCOU_0) XWS
              ON XWS.STOCOU = K.STOCOU_0
WHERE  (K.STOFCY_0 = @STOFCY OR K.STOFCY_0 IS NULL)  -- 允许STOCK为空
       AND (K.ITMREF_0 = @ITMREF OR K.ITMREF_0 IS NULL)
       AND (K.LOC_0&lt;&gt;@DESLOC OR K.LOC_0 IS NULL)
       AND (K.STA_0 LIKE 'A%' OR K.STA_0 IS NULL)
ORDER  BY ISNULL(XWS.RPFLG, 3)
          ,ISNULL(K.LOT_0, '')  -- 批次空值排序兜底</SQLScript>
