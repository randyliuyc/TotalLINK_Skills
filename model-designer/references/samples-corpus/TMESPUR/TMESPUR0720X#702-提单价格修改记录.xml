  <SQLScript>SELECT ID
       ,AUDTAB
       ,AUDKEY
       ,AUDEVT
       ,AUDCOL
       ,AUDVAL0
       ,AUDVAL1
       ,S1.NAME + '(' + AUDUSR + ')' AUDUSR
       ,CONVERT(VARCHAR(16),AUDDAT,121) AUDDAT
       ,AUDINF
FROM   DATAAUDIT S
       LEFT JOIN LINK.DBO.SysUser S1
              ON S.AUDUSR = S1.LoginUser
WHERE  AUDTAB = 'BPOLD'
       AND AUDKEY = '{0}' 
ORDER BY AUDDAT</SQLScript>
