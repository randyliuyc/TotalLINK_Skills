  <SQLScript>SELECT TOP 500 S.ITMNO + '-' + Isnull(ITMVER.ITMVER, '') ITMKey
               ,S.ITMNO
               ,T1.OPTDES                                OPTDES1
               ,T2.OPTDES                                OPTDES2
               ,S.ITMNAM --中文描述
               ,S.ITMNAM1 --越南描述 
               ,S.ITMNAM2 --英文描述
               ,Isnull(ITMVER.ITMVER, '')                ITMVER --品名 
               ,'#LINKDATE(0,0,0,yyyy-MM-dd)#'           REQDAT
               ,S.ITMSHO
               ,S.TCLCOD
               ,S.TSICOD1
               ,S.TSICOD2
               ,S.TSICOD3
               ,S.TSICOD4
               ,S.TSICOD5
               ,ITMSITE.SITE
               ,S.SEAKEY
               ,S.ITMSTA
               ,S.STU --库存单位
               ,S.PUU                                    UOM --采购单位
               ,S.SAU
               ,S.PUUCOE                                 UOMCOE --采购单位系数
               ,S.SAUCOE
               ,S.WEU
               ,S.ITMWEI
               ,S.PCU
               ,S.PCUCOE
               ,S.SIZEU
               ,S.SIZELONG
               ,S.SIZEWIDTH
               ,S.SIZEHIGH
               ,S.CBU
               ,S.ITMCUB
               ,S.IVATTYP
               --,(SELECT TOP 1 TAXRT
               --  FROM   VAT
               --  WHERE  IVATTYP = S.IVATTYP
               --         AND BVATTYP = '{1}')             TAXRT
	       ,0{5}  TAXRT
FROM   ITM S
       LEFT JOIN LINKOPT T1
              ON S.TSICOD1 = T1.OPTID
                 AND T1.OPTTYP = 'TSICOD1'
       LEFT JOIN LINKOPT T2
              ON S.TSICOD2 = T2.OPTID
                 AND T2.OPTTYP = 'TSICOD2'
       LEFT JOIN ITMVER
              ON ITMVER.ITMNO = S.ITMNO --品名
       LEFT JOIN ITMSITE
              ON S.ITMNO = ITMSITE.ITMNO --地点
WHERE S.ITMSTA=1   
  AND S.ITMNO LIKE '%{2}%'
  AND ISNULL(ITMVER.ITMVER,'') LIKE '%{3}%'
  AND S.ITMNAM + S.TSICOD1 + S.ITMNAM1 + S.ITMNAM2 LIKE '%{4}%'
ORDER  BY S.ITMNO ASC</SQLScript>
