  <SQLScript>DECLARE @MFGNUM VARCHAR(30)=N'{0}';
DECLARE @ITMREF VARCHAR(30)=N'{1}';
DECLARE @DYMB NVARCHAR(30)=N'{2}';
DECLARE @DYFS NVARCHAR(30)=N'{3}';
SELECT 
 XWS.SERNUM_0 车架码
,XWS.XTXT_0 电池码  
,XWS.XTXT_1 电机码
,XWS.XRMK1_0  控制器型号
,XWS.XRMK2_0  控制器序号
,XWS.XRMK3_0  客户订单号
,XWS.XRMK4_0  备注
,CAST(XWS.QTYPCU_0 AS REAL) 数量
,XWS.LOC_0 库位
,XWS.CUSERID_0 操作人
,CONVERT(VARCHAR(16),XWS.CREDATIM_0,21) 操作时间
,XWS.RPNUM_0 入库单号
,XWS.USERID_0 入库人
,CASE WHEN CONVERT(VARCHAR(16),XWS.RPDATIM_0,21)='1900-01-01'  THEN '' ELSE CONVERT(VARCHAR(16),XWS.RPDATIM_0,21) END 入库时间
,XWS.ROWID LINKROWID
,CASE WHEN XWS.RPNUM_0&lt;&gt;'' THEN 'H02' ELSE '' END LINKAPPRROW
,CAST(XWS.XDCB_0 AS REAL)   汇总数
,@DYMB 打印模板
,@DYFS 打印份数
,'' LINKAPPR车架码 --控制车架码是否可修改，已入库不可修改
,'' LINKAPPR电池码 --控制电池码是否可修改，已入库不可修改
,'' LINKAPPR电机码 --控制电机码是否可修改，已入库不可修改
FROM XWSMKI XWS
INNER JOIN ITMMASTER ITM
ON XWS.ITMREF_0=ITM.ITMREF_0
WHERE XWS.MFGNUM_0=@MFGNUM
  AND XWS.ITMREF_0=@ITMREF
ORDER BY XWS.XDCB_0,XWS.ROWID DESC</SQLScript>
  <SQLUpdateScript>UPDATE XWSMKI SET 
         SERNUM_0='@车架码@'
        ,XTXT_0='@电池码@'
        ,XTXT_1='@电机码@' 
        ,XDCB_0='@汇总数@'
	,XRMK1_0='@控制器型号@'
        ,XRMK2_0='@控制器序号@'
        ,XRMK3_0='@客户订单号@' 
        ,XRMK4_0='@备注@'
WHERE ROWID=0#LINKROWID# AND RPNUM_0=''</SQLUpdateScript>
