  <ModelDesc>检测结果汇总-数字控制</ModelDesc>
  <KeyWords />
  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>--LINKNOGROUP
--LINKNOFILTER
DECLARE @DOCNUM VARCHAR(30) = '{0}'
DECLARE @OPENUM VARCHAR(30) = '{1}'

SELECT L.DOCNUM 
    , CAST(L.NNOR AS DECIMAL(18, 3)) NNOR
    , CAST(L.NMIN AS DECIMAL(18, 3)) NMIN
    , CAST(L.NMAX AS DECIMAL(18, 3)) NMAX
    , CAST(V.VALMIN AS DECIMAL(18, 3)) VALMIN
    , CAST(V.VALAVG AS DECIMAL(18, 3)) VALAVG
    , CAST(V.VALMAX AS DECIMAL(18, 3)) VALMAX
FROM QAINSPH H
INNER JOIN QAINSPL L
    ON L.DOCNUM = H.DOCNUM
LEFT JOIN (
    SELECT MIN(VALMIN) VALMIN
        , AVG(VALAVG) VALAVG
        , MAX(VALMAX) VALMAX
    FROM QAINSPVAL
    WHERE DOCNUM = @DOCNUM
        AND OPENUM = @OPENUM
        AND STA = 1
    ) V
    ON 1 = 1
WHERE L.DOCNUM = @DOCNUM
    AND L.OPENUM = @OPENUM</SQLScript>
