scanAfterAction = function (r) {
    var currWebview = plus.webview.currentWebview();
    var currWebtype = currWebview.functype;
    var currWebid   = currWebview.id;

    var dataCheck = $.trim($("#数据检查").val() || "");

    // edit 页面逻辑
    if (currWebtype === "edit") {
        if (dataCheck) {
            alert(dataCheck);
