  <SQLScript>--LINKREFRESH
--LINKLOADDATAIMMEDIATE
--LINKDATAMINEOVERVIEW,VERTICAL,50
DECLARE @LAN VARCHAR(30) = '#LOGIN_LAN#';
DECLARE @LANX3 VARCHAR(30) = (SELECT #LC.X3ERP#GETLANX3(@LAN));

DECLARE @NEWITM VARCHAR(50)='{0}';
DECLARE @BOMALT VARCHAR(50)=0{1};
DECLARE @BOMTYP VARCHAR(50)=0{2};
DECLARE @BOMALTTYP INT =0{3};
DECLARE @ITMREF VARCHAR(50)='%{4}%';
DECLARE @CPNITMREF VARCHAR(50)='%{5}%';

IF @BOMALTTYP=4 
BEGIN
SELECT TOP 1000 CAST(0 AS BIT ) 选择
       ,ITF.ITMREF_0   物料编码
       ,ISNULL(B.ITMDES,ITM.ITMDES1_0) 物料名称
       ,ITM.STU_0      单位
FROM ITMFACILIT ITF
INNER JOIN ITMMASTER ITM
  ON ITF.ITMREF_0=ITM.ITMREF_0
	 LEFT JOIN (
        SELECT
            B.IDENT1_0 AS ITMREF
          , B.TEXTE_0 AS ITMDES
           FROM ATEXTRA B
      WHERE B.CODFIC_0 = 'ITMMASTER'
        AND B.LANGUE_0 = @LANX3
	AND B.IDENT1_0='ITMDES1_0'
  ) B
        ON B.ITMREF =ITF.ITMREF_0
WHERE ITF.STOFCY_0='ZUPK'
   AND ITF.ITMREF_0 LIKE UPPER(@ITMREF)
ORDER  BY ITF.ITMREF_0
END
ELSE
BEGIN
SELECT TOP 1000 CAST(0 AS BIT ) 选择
               ,D.ITMREF_0   产品编码
               ,ISNULL(B.ITMDES,HI.ITMDES1_0)    产品名称
	       ,D.BOMSEQ_0      物料顺序
               ,D.CPNITMREF_0   物料编码
               ,ISNULL(B1.ITMDES,DI.ITMDES1_0)    物料名称
               ,CAST(D.LIKQTY_0 AS REAL) 数量
               ,D.BOMUOM_0      单位
FROM   BOMD D
       INNER JOIN BOM H
               ON H.ITMREF_0 = D.ITMREF_0
       INNER JOIN ITMMASTER HI
               ON HI.ITMREF_0 = D.ITMREF_0
       INNER JOIN ITMMASTER DI
               ON DI.ITMREF_0 = D.CPNITMREF_0
                  AND H.BOMALTTYP_0 = @BOMALTTYP
                  AND D.ITMREF_0 LIKE @ITMREF
                  AND D.CPNITMREF_0 LIKE @CPNITMREF
	 LEFT JOIN (
      SELECT
            B.IDENT1_0 AS ITMREF
          , B.TEXTE_0 AS ITMDES
      FROM ATEXTRA B
      WHERE B.CODFIC_0 = 'ITMMASTER'
        AND B.LANGUE_0 = @LANX3
	AND B.IDENT1_0='ITMDES1_0'
  ) B
        ON B.ITMREF =D.ITMREF_0
LEFT JOIN (
          SELECT
            B.IDENT1_0 AS ITMREF
          , B.TEXTE_0 AS ITMDES
      FROM ATEXTRA B
      WHERE B.CODFIC_0 = 'ITMMASTER'
        AND B.LANGUE_0 = @LANX3
	AND B.IDENT1_0='ITMDES1_0'
  ) B1
        ON B1.ITMREF = D.CPNITMREF_0
ORDER  BY D.ITMREF_0
          ,D.BOMSEQ_0
END</SQLScript>
