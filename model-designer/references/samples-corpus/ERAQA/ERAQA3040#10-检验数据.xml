  <SQLScript>DECLARE @STRDAT DATE='{0}';
DECLARE @ENDDAT DATE='{1}';
DECLARE @ROUTYP VARCHAR(30)='%{2}%';
DECLARE @MATTYP VARCHAR(30)='%{3}%';
DECLARE @ITMNO VARCHAR(30)='%{4}%';
DECLARE @VCRNUM VARCHAR(30)='%{5}%';

IF OBJECT_ID(N'tempdb..#TSCA') IS NOT NULL
    DROP TABLE #TSCA;

WITH CTE_SCA
AS (
    SELECT S.VALLINID
        , K.SCADES1 + '/' + K.SCADES2 SCADES
    FROM QAINSPVALSCA S
    INNER JOIN QAINSPVAL V
        ON S.VALLINID = V.ID
    INNER JOIN QAINSPL L
        ON L.DOCNUM = V.DOCNUM
            AND L.OPENUM = V.OPENUM
    INNER JOIN (
        SELECT OPESTD
            , SCACOD
            , SCADES1
            , SCADES2
        FROM QAOPESTDSCA
        ) K
        ON K.OPESTD = L.OPESTD
            AND K.SCACOD = S.SCACOD
    )
SELECT VALLINID
    , STRING_AGG(SCADES, ';') SCADES
INTO #TSCA
FROM CTE_SCA
GROUP BY VALLINID

SELECT H.DOCNUM
    , H.DOCDAT
    , ROUTYP.OPTDES ROUTYP
    , D.MATTYP
    , H.ITMNO
    , ITM.ITMDES2_0 RANGE
    , IIF(ITM.ZDIA_MM_0 = 0, CAST(CAST(ITM.ZWIDTH_MM_0 AS DECIMAL(18, 3)) AS VARCHAR(30)) --
        + ' * ' + CAST(CAST(ITM.ZTHICK_MM_0 AS DECIMAL(18, 3)) AS VARCHAR(30)), --
        CAST(CAST(ITM.ZDIA_MM_0 AS DECIMAL(18, 3)) AS VARCHAR(30)) + ' mm') PRODIM
    , H.MFGNUM
    , M.GRDCOD
    , E.GRDNAM
    , H.LOT
    , H.TV
    , H.CUSCOD
    , H.INTSPEC
    , H.DEMANDER
    , H.INSPREA
    , CASE 
        WHEN H.STA = 2
            THEN '√'
        WHEN H.STA = 1
            THEN '×'
        ELSE ''
        END HSTA
    , H.CLOSTA
    , H.CLOUSR
    , CONVERT(VARCHAR(16), H.CLOTIM, 21) CLOTIM
    , L.OPENUM
    , D.OPESTD
    , D.OPEDES1
    , D.OPEDES2
    , D.INSTRUCTION
    , L.OPEUNT
    , L.CTLTYP
    , L.MEAFRQ
    , L.INSTCOD
    , CAST(L.NMAX AS DECIMAL(18, 3)) NMAX
    , CAST(L.NMIN AS DECIMAL(18, 3)) NMIN
    , CAST(L.NNOR AS DECIMAL(18, 3)) NNOR
    , CASE 
        WHEN L.STA = 2
            THEN '√'
        WHEN L.STA = 1
            THEN '×'
        ELSE ''
        END LSTA
    , VL.SPOOL
    , VL.COIL
    , VL.SAMP
    , CAST(VL.N1 AS DECIMAL(18, 3)) N1
    , CAST(VL.N2 AS DECIMAL(18, 3)) N2
    , CAST(VL.N3 AS DECIMAL(18, 3)) N3
    , CAST(VL.N4 AS DECIMAL(18, 3)) N4
    , CAST(VL.N5 AS DECIMAL(18, 3)) N5
    , CAST(VL.N6 AS DECIMAL(18, 3)) N6
    , CAST(VL.N7 AS DECIMAL(18, 3)) N7
    , CAST(VL.N8 AS DECIMAL(18, 3)) N8
    , CAST(VL.VALMIN AS DECIMAL(18, 3)) VALMIN
    , CAST(VL.VALAVG AS DECIMAL(18, 3)) VALAVG
    , CAST(VL.VALMAX AS DECIMAL(18, 3)) VALMAX
    , CASE 
        WHEN L.L1CHECK = 1
            AND VL.L1 = 1
            THEN '√'
        WHEN L.L1CHECK = 1
            AND VL.L1 = 0
            AND VL.STA IS NOT NULL
            THEN '×'
        ELSE ''
        END L1
    , CASE 
        WHEN L.L2CHECK = 1
            AND VL.L2 = 1
            THEN '√'
        WHEN L.L2CHECK = 1
            AND VL.L2 = 0
            THEN '×'
        ELSE ''
        END L2
    , CASE 
        WHEN VL.STA = 1
            THEN '√'
        WHEN VL.STA = 0
            THEN '×'
        ELSE ''
        END STA
    , VL.REMARK
    , NCTYP.OPTDES NCTYP
    , ISNULL(VL.DEFECTS, '') + ISNULL(T.SCADES, '') SCADES
    , VL.CREUSR
    , CONVERT(VARCHAR(16), VL.CRETIM, 21) CRETIM
    , VL.UPDUSR
    , CONVERT(VARCHAR(16), VL.UPDTIM, 21) UPDTIM
FROM QAINSPVAL VL
INNER JOIN QAINSPL L
    ON VL.DOCNUM = L.DOCNUM
        AND VL.OPENUM = L.OPENUM
INNER JOIN QAINSPH H
    ON VL.DOCNUM = H.DOCNUM
INNER JOIN QAOPESTD D
    ON D.OPESTD = L.OPESTD
LEFT JOIN QAOPT ROUTYP
    ON ROUTYP.OPTTYP = 'ROUTYP'
        AND ROUTYP.OPTID = H.ROUTYP
LEFT JOIN QAOPT NCTYP
    ON NCTYP.OPTTYP = 'NCTYP'
        AND NCTYP.OPTID = VL.NCTYP
LEFT JOIN QAMAT M
    ON M.LOT = H.LOT
        AND M.TV = H.TV
LEFT JOIN QAGRADE E
    ON M.GRDCOD = E.GRDCOD
        AND E.CUSCOD = ''
LEFT JOIN #LC.X3DATA#ITMMASTER ITM
    ON ITM.ITMREF_0 #LC.X3COLLATE# = H.ITMNO
LEFT JOIN #TSCA T
    ON T.VALLINID = VL.ID
WHERE H.DOCDAT BETWEEN @STRDAT AND @ENDDAT
    AND H.ROUTYP LIKE @ROUTYP
    AND D.MATTYP LIKE @MATTYP
    AND ISNULL(H.ITMNO, '') LIKE @ITMNO
    AND ISNULL(H.MFGNUM, '') LIKE @VCRNUM
ORDER BY H.DOCDAT DESC
    , H.DOCNUM DESC
    , L.OPENUM
    , VL.VALLIN
    , VL.TRXLIN

IF OBJECT_ID(N'tempdb..#TSCA') IS NOT NULL
    DROP TABLE #TSCA;</SQLScript>
