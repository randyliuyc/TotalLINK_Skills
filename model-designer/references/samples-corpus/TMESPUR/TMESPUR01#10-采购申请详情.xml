  <SQLScript>--LINKAPPMENUHIDE
--LINKMYROWDATA
--LINKDETAILLIST(TMESPUR01,20,{0})
SELECT S.[ID]                                         LINKROWID
       ,S.[DOCNUM]
       ,S.[DOCNUM]                                    id --APP详情页关联明细表关键字
       ,S.[DOCGRP]
       ,DOCGRP.OPTDES                                 DOCGRPDES
       ,S.DOCSTA
       ,DOCSTA.OPTDES                                 DOCSTADE
       ,WFLSTA.OPTDES                                 WFLSTA
       ,[WFRULE]
       ,CONVERT(VARCHAR(10), S.[DOCDAT], 21)          [DOCDAT]
       ,S.[DOCDES]
       ,S.[PRJNUM]
       ,S.[SITE]
       ,SI.[SITENAM]                                  SITEDES
       ,S.FAC
       ,F.FACNAM
       ,S.[DEPT]
       ,D.DEPTNAM                                     DEPTDES
       ,S.[GRP]
       ,G.GRPNAM                                      GRPDES
       ,S.[RESNO]
       ,R.RESNAM                                      RESNODES
       ,S.[REMARK]
       ,S.PRNCNT
       ,S.[CREUSR]
       ,S.[UPDUSR]
       ,CONVERT(VARCHAR(16), S.[CRETIM], 21)          CRETIM
       ,CASE
          WHEN S.UPDTIM IS NULL THEN ''
          ELSE CONVERT(VARCHAR(16), S.UPDTIM, 21)
        END                                           UPDTIM
       ,S.[CLOREA]
       ,Iif(S.[DOCSTA] = '1', '', '1')                SABFLG
       ,Iif(S.[DOCSTA] = '1', '', '1')                DEBFLG
       ,Iif(S.[DOCSTA] = '1', '', '1')                SUBFLG
       ,Iif(S.[DOCSTA] = '3'
            AND S.[UPDUSR] = '#LOGIN_USER#', '', '1') REBFLG
       ,Iif(S.[DOCSTA] IN( '1', '2' ), '', '1')       CLBFLG
       ,Iif(S.[DOCSTA] = '2', '', '1')                PRTFLG
       ,Iif(S.[DOCSTA] = '3'
            AND S.CREUSR = '#LOGIN_USER#', '', '1')   WFLFLG
       ,'{1}'                                         SIGNLISTID
       ,'{2}'                                         TASKID
       ,'TSICOD1'                                     FLDTS1S --勿删，产品统计组1传参
       ,'TSICOD2'                                     FLDTS2S --勿删，产品统计组2传参
       ,'TSICOD3'                                     FLDTS3S --勿删，产品统计组3传参
       ,'TSICOD4'                                     FLDTS4S --勿删，产品统计组4传参
       ,''                                            TCLCODL
       ,''                                            TSICOD1L
       ,''                                            TSICOD2L --这几个空值字段，用于选择跳框的参数，不可删除
       ,''                                            TSICOD3L
       ,''                                            TSICOD4L
       ,''                                            ITMVERL
       ,''                                            ITMSIZEL
       ,''                                            ITMSPECL
       ,''                                            ITML
       ,''                                            PITMNO
       ,''                                            PITMVER
       ,''                                            PLOT
       ,''                                            PMSDETAIL
FROM   [dbo].[PREQUH] S
       LEFT JOIN LINKOPT DOCSTA
              ON DOCSTA.OPTID = S.DOCSTA
                 AND DOCSTA.OPTTYP = 'DOCSTA'
       LEFT JOIN LINKOPT WFLSTA
              ON WFLSTA.OPTID = S.WFLSTA
                 AND WFLSTA.OPTTYP = 'WFLSTA'
       LEFT JOIN [ENTSITE] SI
              ON S.[SITE] = SI.SITE
       LEFT JOIN ENTFAC F
              ON S.FAC = F.FAC
       LEFT JOIN [LINKOPT] DOCGRP
              ON S.DOCGRP = DOCGRP.OPTID
                 AND DOCGRP.OPTTYP = 'DOCGRP'
                 AND DOCGRP.LINKOPTID = 'PRE'
       LEFT JOIN [ENTDEPT] D
              ON S.[DEPT] = D.DEPT
       LEFT JOIN [ENTGRP] G
              ON S.[GRP] = G.GRP
       LEFT JOIN [ENTRES] R
              ON S.[RESNO] = R.RESNO
WHERE  S. [DOCNUM] = '{0}'
UNION ALL
SELECT ''                                   LINKROWID
       ,N'#LINKDOCNUM({0},PRQ)#'            [DOCNUM]
       ,N'#LINKDOCNUM({0},PRQ)#'            [id]
       ,''                                  [DOCGRP]
       ,''                                  [DOCGRPDES]
       ,''                                  DOCSTA
       ,''                                  [DOCSTADE]
       ,''                                  [WFLSTA]
       ,''                                  WFRULE
       ,CONVERT(VARCHAR(10), Getdate(), 21) [DOCDAT]
       ,''                                  [DOCDES]
       ,''                                  [PRJNUM]
       ,N'#LINKUSER(#LOGIN_USER#).DEPT1#'   [SITE]
       ,N'#LINKUSER(#LOGIN_USER#).DEPT1#'   [SITEDES]
       ,''                                  FAC
       ,''                                  FACNAM
       ,N'#LINKUSER(#LOGIN_USER#).DEPT3#'   [DEPT]
       ,''                                  [DEPTDES]
       ,''                                  [GRP]
       ,''                                  [GRPDES]
       ,''                                  [RESNO]
       ,''                                  [RESNODES]
       ,''                                  [REMARK]
       ,0                                   PRNCNT
       ,''                                  [CREUSR]
       ,''                                  [UPDUSR]
       ,''                                  CRETIM
       ,''                                  UPDTIM
       ,''                                  [CLOREA]
       ,''                                  SABFLG
       ,'1'                                 DEBFLG
       ,'1'                                 SUBFLG
       ,'1'                                 REBFLG
       ,'1'                                 CLBFLG
       ,'1'                                 PRTFLG
       ,'1'                                 WFLFLG
       ,''                                  SIGNLISTID
       ,''                                  TASKID
       ,'TSICOD1'                           FLDTS1S --勿删，产品统计组1传参
       ,'TSICOD2'                           FLDTS2S --勿删，产品统计组2传参
       ,'TSICOD3'                           FLDTS3S --勿删，产品统计组3传参
       ,'TSICOD4'                           FLDTS4S --勿删，产品统计组4传参
       ,''                                  TCLCODL
       ,''                                  TSICOD1L
       ,''                                  TSICOD2L --这几个空值字段，用于选择跳框的参数，不可删除
       ,''                                  TSICOD3L
       ,''                                  TSICOD4L
       ,''                                  ITMVERL
       ,''                                  ITMSIZEL
       ,''                                  ITMSPECL
       ,''                                  ITML
       ,''                                  PITMNO
       ,''                                  PITMVER
       ,''                                  PLOT
       ,''                                  PMSDETAIL
WHERE  '' = '{0}'</SQLScript>
  <SQLUpdateScript>--LINKADDNEWROWS
--LINKAUTOREPLACEEMPTYCOLUMNS
MERGE
INTO
[PREQUH] D
		USING (
	SELECT
 N'@DOCNUM@' DOCNUM
,N'@DOCGRP@' DOCGRP
,N'1' DOCSTA
,N'SAVED' WFLSTA
,N'@WFRULE@' WFRULE
,N'@DOCDAT@' DOCDAT
,N'@DOCDES@' DOCDES
,N'@PRJNUM@' PRJNUM
,N'@SITE@' SITE
,N'@FAC@' FAC
,N'@DEPT@' DEPT
,N'@GRP@' GRP
,N'@RESNO@' RESNO
,N'@REMARK@' REMARK
,N'@CLOREA@' CLOREA
, N'#LOGIN_USER#' CREUSR
, GETDATE() CRETIM
	  ) S ON
	(S.[DOCNUM] = D.[DOCNUM])
	WHEN MATCHED THEN
UPDATE
SET 
 DOCNUM = S.DOCNUM
,DOCGRP = S.DOCGRP
,DOCDAT = S.DOCDAT
,DOCDES = S.DOCDES
,PRJNUM = S.PRJNUM
,SITE = S.SITE
,FAC = S.FAC
,DEPT = S.DEPT
,GRP = S.GRP
,RESNO = S.RESNO
,REMARK = S.REMARK
,CLOREA = S.CLOREA
,WFRULE = S.WFRULE
,UPDUSR='#LOGIN_USER#'
,UPDTIM=GETDATE()
WHEN NOT MATCHED THEN
INSERT
(DOCNUM
,DOCGRP
,DOCSTA
,WFLSTA
,DOCDAT
,DOCDES
,PRJNUM
,SITE
,FAC
,DEPT
,GRP
,RESNO
,REMARK
,WFRULE
,CLOREA
,CREUSR
,CRETIM
)
VALUES (
S.DOCNUM
,S.DOCGRP
,S.DOCSTA
,S.WFLSTA
,S.DOCDAT
,S.DOCDES
,S.PRJNUM
,S.SITE
,S.FAC
,S.DEPT
,S.GRP
,S.RESNO
,S.REMARK
,S.WFRULE
,S.CLOREA
,S.CREUSR
,S.CRETIM
);</SQLUpdateScript>
