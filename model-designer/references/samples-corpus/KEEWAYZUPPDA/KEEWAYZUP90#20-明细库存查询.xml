  <FunctionCode />
  <ChartType />
  <SQLScript>DECLARE @LANX3 VARCHAR(30) = '#LINKFUNC.GETLANX3#';
DECLARE @FCY VARCHAR(10)='{0}';
DECLARE @LOC VARCHAR(30)=N'%{1}%';
DECLARE @ITMREF VARCHAR(50)=N'%{2}%';
DECLARE @ITMDES NVARCHAR(100)=N'%{3}%';
DECLARE @PALNUM NVARCHAR(30)=N'%{4}%';
DECLARE @CTRNUM NVARCHAR(30)=N'%{5}%';
DECLARE @SERNUM NVARCHAR(30)=N'%{6}%';

SELECT S.STOFCY_0                    地点
      ,S.ITMREF_0                    产品编码
      --,I.ITMDES1_0                   产品描述1
       ,ISNULL(L1.ITMDES, I.ITMDES1_0) 产品描述1
       ,ISNULL(L2.ITMDES, I.ITMDES2_0) 产品描述2
      ,S.LOC_0                       库位
      ,S.PALNUM_0                    计划号
      ,S.CTRNUM_0                    箱单号
      ,S.SERNUM_0                    序列号
      ,CAST(S.QTYSTU_0 AS REAL)      库存数量
      ,S.PCU_0                       单位
FROM   STOCK S
       INNER JOIN ITMMASTER I
               ON S.ITMREF_0 = I.ITMREF_0
       LEFT JOIN ITMLAN1 L1
              ON L1.ITMREF = I.ITMREF_0
                 AND L1.LANX3 = @LANX3
       LEFT JOIN ITMLAN2 L2
              ON L2.ITMREF = I.ITMREF_0
                 AND L2.LANX3 = @LANX3
WHERE  S.STOFCY_0=@FCY
      AND S.LOC_0 LIKE @LOC
      AND S.ITMREF_0 LIKE @ITMREF
      AND UPPER(I.ITMDES1_0)+UPPER(I.ITMDES2_0) LIKE @ITMDES
      AND S.PALNUM_0 LIKE @PALNUM
      AND S.CTRNUM_0 LIKE @CTRNUM
      AND S.SERNUM_0 LIKE UPPER(@SERNUM)</SQLScript>
