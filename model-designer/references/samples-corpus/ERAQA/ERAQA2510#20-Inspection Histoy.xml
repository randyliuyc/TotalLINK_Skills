  <ModelDesc>Inspection Histoy</ModelDesc>
  <KeyWords />
  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>--LINKNOGROUP
DECLARE @STRDAT DATE='{0}';
DECLARE @ENDDAT DATE='{1}';
DECLARE @DOCNUM VARCHAR(30)='%{2}%';
DECLARE @DEPT VARCHAR(30)='%{3}%';
DECLARE @PCPSTA VARCHAR(30)='%{4}%';
DECLARE @GRADE VARCHAR(30)='%{5}%';

SELECT 
       D.OPEDES1
      ,D.OPEDES2
      ,VL.SPOOL+VL.COIL+VL.SAMP  PJT
      ,CAST(VL.N1 AS DECIMAL(18, 3))       N1
      ,CAST(VL.N2 AS DECIMAL(18, 3))       N2
      ,CAST(VL.N3 AS DECIMAL(18, 3))       N3
      ,CAST(VL.N4 AS DECIMAL(18, 3))       N4
      ,CAST(VL.N5 AS DECIMAL(18, 3))       N5
      ,CAST(VL.N6 AS DECIMAL(18, 3))       N6
      ,CAST(VL.N7 AS DECIMAL(18, 3))       N7
      ,CAST(VL.N8 AS DECIMAL(18, 3))       N8
      ,CAST(VL.VALMIN AS DECIMAL(18, 3))   VALMIN
      ,CAST(VL.VALAVG AS DECIMAL(18, 3))   VALAVG
      ,CAST(VL.VALMAX AS DECIMAL(18, 3))   VALMAX
      ,CASE
          WHEN L.L1CHECK = 1
               AND VL.L1 = 1 THEN '√'
          WHEN L.L1CHECK = 1
               AND VL.L1 = 0
               AND VL.STA IS NOT NULL THEN '×'
          ELSE ''
        END                                L1
      ,CASE
          WHEN L.L2CHECK = 1
               AND VL.L2 = 1 THEN '√'
          WHEN L.L2CHECK = 1
               AND VL.L2 = 0 THEN '×'
          ELSE ''
        END                                L2
      ,VL.REMARK
      ,NCTYP.OPTDES                        NCTYP
      ,L.OPENUM
      ,D.OPESTD
      ,VL.DOCNUM
      ,QH.CLOSTA
      ,VL.CREUSR
      ,CONVERT(VARCHAR(16), VL.CRETIM, 21) CRETIM
      ,VL.UPDUSR
      ,CONVERT(VARCHAR(16), VL.UPDTIM, 21) UPDTIM
FROM   QAINSPVAL VL
       INNER JOIN QAINSPL L
               ON VL.DOCNUM = L.DOCNUM
                  AND VL.OPENUM = L.OPENUM
       INNER JOIN QAINSPREQ H
               ON VL.DOCNUM = H.DOCNUM
	   INNER JOIN QAINSPH QH
               ON VL.DOCNUM = QH.DOCNUM
       INNER JOIN QAOPESTD D
               ON D.OPESTD = L.OPESTD
       LEFT JOIN QAOPT NCTYP
              ON NCTYP .OPTTYP = 'NCTYP'
                 AND NCTYP.OPTID = VL.NCTYP
WHERE  CONVERT(VARCHAR(16),H.CRETIM,23) BETWEEN @STRDAT AND @ENDDAT
       AND H.DOCNUM LIKE @DOCNUM
       AND H.DEPT LIKE @DEPT
       AND H.PCPSTA LIKE @PCPSTA
       AND H.GRADE LIKE @GRADE
ORDER  BY CONVERT(VARCHAR(16),H.CRETIM,23) DESC
          ,H.DOCNUM DESC
          ,L.OPENUM
	  ,VL.VALLIN
          ,VL.TRXLIN</SQLScript>
