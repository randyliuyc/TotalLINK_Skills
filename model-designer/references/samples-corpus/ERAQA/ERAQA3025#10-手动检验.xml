  <SQLScript>--LINKLOADDATAIMMEDIATE
SELECT S.[DOCNUM]
      ,U.ROUCOD ROUCODCK
      ,[DEPT].OPTDES                        DEPT
      ,[PCPSTA].OPTDES                      PCPSTA
      ,S.[DEMANDER]
      ,S.[INSPREA]
      ,S.[GRADE]
      ,S.[SIZE]
      ,S.[LOT]
      ,RQ.PLOPE LINKTEXTPLOPE
      ,S.[CREUSR]
      ,S.[UPDUSR]
      ,CONVERT(VARCHAR(16), S.[CRETIM], 21) CRETIM
      ,CONVERT(VARCHAR(16), S.[UPDTIM], 21) UPDTIM
FROM   [QAINSPREQ] S
       LEFT JOIN QAINSPH H
              ON S.DOCNUM = H.DOCNUM
       LEFT JOIN QAROU U
              ON U.ROUCOD=S.DOCNUM
       LEFT JOIN QAOPT PCPSTA
              ON PCPSTA.OPTTYP = 'PCPSTA'
                 AND PCPSTA.OPTID = S.PCPSTA
       LEFT JOIN QAOPT DEPT
              ON DEPT.OPTTYP = 'DEPT'
                 AND DEPT.OPTID = S.DEPT
      LEFT JOIN (
SELECT DOCNUM
      ,PLOPE = ( STUFF((SELECT ',' + PLOPEDES
                           FROM   QAINSPREQL
                           WHERE  DOCNUM = A.DOCNUM
                           FOR xml path('')), 1, 1, '') )
FROM   QAINSPREQL A
GROUP  BY DOCNUM 
) RQ
ON RQ.DOCNUM=S.DOCNUM
WHERE ISNULL(H.CLOSTA,0)=0
ORDER BY DOCNUM DESC</SQLScript>
