  <ChartType />
  <SQLScript>SELECT R.ITMREF_0 ITMNO
      ,R.ROUDES_0 ROUDES
      ,R.ROUALT_0 ROUALT
      ,O.OPENUM_0 ROUOPE
      ,O.ROODES_0 ROODES
      ,R.BPCNUM_0 CUSCOD
      ,R.INTSPE_0 INTSPE
      ,Q.ROUCOD
      ,'SFC' ROUTYP
FROM   #LC.X3DATA#ROUTING R
       LEFT JOIN (SELECT ROUALT_0
                        ,ITMREF_0
                        ,OPENUM_0
                        ,ROODES_0
                  FROM   #LC.X3DATA#ROUOPE
                  WHERE  STDOPENUM_0  BETWEEN 690 AND 699
                  GROUP  BY ROUALT_0
                            ,ITMREF_0
                            ,OPENUM_0
                            ,ROODES_0) O
              ON R.ITMREF_0 = O.ITMREF_0
                 AND R.ROUALT_0 = O.ROUALT_0
       LEFT JOIN QAROU Q
              ON Q.ROUCOD #LC.X3COLLATE# = CONCAT_WS('-', R.ITMREF_0, R.ROUALT_0, O.OPENUM_0)
ORDER  BY R.ITMREF_0</SQLScript>
