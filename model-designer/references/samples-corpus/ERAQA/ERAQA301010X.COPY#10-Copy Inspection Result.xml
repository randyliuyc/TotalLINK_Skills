  <SQLScript>SELECT TOP 500
       H.DOCNUM CDOCNUM
      ,H.DOCDAT CDOCDAT
      ,H.ITMNO  CITMNO
      ,H.MFGNUM CMFGNUM
      ,H.LOT    CLOT
      ,H.TV     CTV
      ,H.CUSCOD CCUSCOD
      ,H.INTSPEC CINTSPEC
FROM  QAINSPH H 
WHERE H.ROUTYP='SFC'
      AND H.DOCNUM+H.ITMNO+H.CUSCOD+H.INTSPEC LIKE '%{10}%'
ORDER  BY H.DOCDAT DESC
         ,H.DOCNUM DESC</SQLScript>
