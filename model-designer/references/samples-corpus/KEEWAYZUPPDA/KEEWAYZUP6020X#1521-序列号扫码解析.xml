  <ChartType />
  <SQLScript>-- 使用参数化变量
DECLARE @TAG VARCHAR(100) = '{0}';

IF NOT EXISTS (
    SELECT 1 FROM XWSMKI
    WHERE ISNULL(XTXT_2,SERNUM_0) = @TAG
)
  SELECT N'lang:{zh:序列号不存在，请重新扫码:,en:Serial number does not exist, please scan again:,de:Seriennummer existiert nicht, bitte erneut scannen:} ' + @TAG AS 数据检查;
ELSE
    SELECT 
        ITMREF_0 AS 产品编码,
        SERNUM_0 AS 序列号
    FROM XWSMKI
    WHERE  ISNULL(XTXT_2,SERNUM_0)= @TAG</SQLScript>
