editWebs = function () {
    var max = $("#待领数量").val() * 1
    var val = $("#领料数量").val() * 1
    if (val == max) {
        //两者相等直接返回
        showModelData(null);
    } else {
        //重新计算需领数量
        $("#待领数量").val(max - val);
        $("#库位").val("");
        $("#领料数量").val("");
        $("#序列号").val("");
        $("#选择库存").val("");
        //需要手动刷新详情界面
        var con = plus.webview.getWebviewById('contentlist');
        mui.fire(con, 'contentlist_local', {});
    }
}


beforeFunction = function (sta, id) {
    var a = $("#数据检查").val();
    if ((a != "OK") &amp;&amp; (sta == "new" || sta == "autoSave")) {
        alert(a);
        return true;
    }

    if (id == "linkok") {
        // 获取领料数量和待领数量的值
        var 领料数量 = parseFloat($("#领料数量").val());
        var 待领数量 = parseFloat($("#待领数量").val());
        // 获取序列号的值
        var 序列号 = $("#序列号").val().trim();

        // 如果序列号不为空，则领料数量只能为1
        if (序列号 != "" &amp;&amp; 领料数量 != 1) {
            alert("存在序列号，领料数量只能为1");
            $("#领料数量").focus();
            return false;
        }
        // 分别判断
        if (领料数量 &lt;= 0) {
            alert("领料数量必须大于0");
            $("#领料数量").focus();
            return true;
        }

        if (领料数量 &gt; 待领数量) {
            alert("领料数量不能超过待领数量");
            $("#领料数量").focus();
            return true;
        }

    }
    return false;
};


repeatTime = function (id) {
    if (id == "linkpreprocess")
        return 15
    return 1
}

limitTimeAction = function (id) {
    if (id == "linkpreprocess")
        alert("15秒内不可重复点击");
}

//删除后自动刷新
afterFunction = function (id) {
    if (id == "linkquick12")
        reloadModelData()
