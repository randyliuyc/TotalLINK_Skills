  <SQLScript>DECLARE @LOT VARCHAR(30)='{0}';
DECLARE @TV VARCHAR(30)='{1}';
SELECT S.ELECOD
      ,CAST(S.ELEVAL AS DECIMAL(18,3))    ELEVAL
      ,E.ELEUNT
      ,CAST(E.ELEMIN AS DECIMAL(18,3))             ELEMIN
      ,CAST(E.ELEMAX AS DECIMAL(18,3))             ELEMAX
      ,S.CREUSR
      ,CONVERT(VARCHAR(16), S.CRETIM, 21) CRETIM
      ,S.ID                               LINKROWID
      ,CASE WHEN ISNULL(S.ELEVAL,0)&gt;=E.ELEMIN AND ISNULL(S.ELEVAL,0)&lt;=E.ELEMAX THEN ''
       ELSE 'D03' END LINKAPPRROW
FROM  QAMATELE S
   INNER JOIN QAMAT M
   ON S.DOCNUM=M.DOCNUM
   LEFT JOIN QAGRADEELE E
   ON S.ELECOD=E.ELECOD AND E.GRDCOD=M.GRDCOD
WHERE M.LOT=@LOT
  AND M.TV=@TV
ORDER  BY S.ID</SQLScript>
