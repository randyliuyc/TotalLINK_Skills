  <SQLClear>UPDATE S
SET S.YZUPLGCNO_0 = '#物流单号#'
FROM SDELIVERY S
INNER JOIN XWSSDH X ON S.SDHNUM_0 = X.RPNUM_0
WHERE X.STOFCY_0 = 'ZUPK'
AND X.RPNUM_0='#发货单号#'</SQLClear>
