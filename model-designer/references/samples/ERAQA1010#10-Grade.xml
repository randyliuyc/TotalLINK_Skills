  GRDNAM = N'#GRDNAM#'
, DENSITY = N'#DENSITY#'
, DENUNIT = N'#DENUNIT#'
, HDANNEAL = 0#HDANNEAL#
, HDUNIT1 = N'#HDUNIT1#'
, HDDRAWN = '#HDDRAWN#'
, HDUNIT2 = N'#HDUNIT2#'
, TENSILE = 0#TENSILE#
, TENUNIT = N'#TENUNIT#'
, COMMENT = N'#COMMENT#'
, EUSTD = N'#EUSTD#'
, ENSTD = N'#ENSTD#'
, STD1 = N'#STD1#'
, STD2 = N'#STD2#'
, SUPCOD = N'#SUPCOD#'
WHERE ID=0#LINKROWID#</SQLUpdateScript>
