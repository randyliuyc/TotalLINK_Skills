  <SQLScript>SELECT H.[DOCTYP]
       ,H.[DOCNUM]
       ,H.[DOCGRP]
       ,DBO.Optdes('DOCGRP', H.DOCGRP)               DOCGRPDES
       ,H.[DOCSTA]
       ,DBO.Optdes('DOCSTA', H.DOCSTA)               HDOCSTADES
       ,H.[DOCDAT]
       ,H.[DOCDES]
       ,H.[PRJNUM]
       ,H.[SITE]
       ,SI.[SITENAM]
       ,H.[DEPT]
       ,DE.[DEPTNAM]
       ,H.[DESTWH]
       ,WH.[WHNAM]
       ,H.[DESTLOC]
       ,H.[DESTWH] + ' ' + ISNULL(WH.[WHNAM], '') + '-'
        + H.[DESTLOC] + ' ' + ISNULL(LC.LOCDES, '') LOCDES
       ,H.[RESNO]
       ,ISNULL(RE.[RESNAM], H.[RESNO])               [RESNAM]
       ,H.[PRNCNT]
       ,H.[MATPRC]
       ,H.[CLOREA]
       ,H.[REMARK]
       ,S1.NAME + '(' + H.CREUSR + ')'               CREUSR
       ,S2.NAME + '(' + H.UPDUSR + ')'               UPDUSR
       ,CONVERT(VARCHAR(16), H.CRETIM, 21)           CRETIM
       ,CONVERT(VARCHAR(16), H.UPDTIM, 21)           UPDTIM
       ,H.[MFGNUM]
       ,IIF(H.CLOSTA = 1, '是', '否')                  CLOSTA
       ,H.[CLOUSR]
       ,H.[CLOTIM]
       ,Iif(H.[CLOSTA] = 0 , '', '1')                CLOFLG
       ,Iif(H.[DOCSTA] = '1', '', '1')               SABFLG
       ,Iif(H.[DOCSTA] = '1', '', '1')               DEBFLG
       ,Iif(H.[DOCSTA] = '1', '', '1')               SUBFLG
FROM   [MFGPKH] H
       LEFT JOIN ENTSITE SI
              ON SI.SITE = H.SITE
       LEFT JOIN ENTDEPT DE
              ON DE.DEPT = H.DEPT
       LEFT JOIN ENTGRP GR
              ON GR.GRP = H.GRP
       LEFT JOIN ENTRES RE
              ON RE.RESNO = H.RESNO
       LEFT JOIN [ENTWH] WH
              ON WH.WH = H.DESTWH
       LEFT JOIN [STKLOC] LC
              ON LC.WH = H.DESTWH
                 AND LC.LOC = H.DESTLOC
       LEFT JOIN LINKTAM.DBO.SysUser S1
              ON H.CREUSR = S1.LoginUser
       LEFT JOIN LINKTAM.DBO.SysUser S2
              ON H.UPDUSR = S2.LoginUser
WHERE  H.DOCNUM = '{0}'
UNION ALL
SELECT 'MPH'                                [DOCTYP]
       ,'#LINKDOCNUM({0},MPH)#'             [DOCNUM]
       ,'MPM'                               [DOCGRP]
       ,''                                  DOCGRPDES
       ,''                                  [DOCSTA]
       ,''                                  DOCSTADES
       ,'#LINK_TODAY#'                      [DOCDAT]
       ,''                                  [DOCDES]
       ,''                                  [PRJNUM]
       ,'YT'                                [SITE]
       ,'坦伯烟台'                              [SITENAM]
       ,''                                  [DEPT]
       ,''                                  [DEPTNAM]
       ,''                                  [DESTWH]
       ,''                                  [WHNAM]
       ,''                                  [DESTLOC]
       ,''                                  LOCDES
       ,'#LOGIN_USER#'                      [RESNO]
       ,'#LOGIN_NAME#'                      [RESNAM]
       ,''                                  [PRNCNT]
       ,''                                  [MATPRC]
       ,''                                  [CLOREA]
       ,''                                  [REMARK]
       ,''                                  [CREUSR]
       ,''                                  [UPDUSR]
       ,CONVERT(VARCHAR(16), GETDATE(), 21) CRETIM
       ,CONVERT(VARCHAR(16), GETDATE(), 21) UPDTIM
       ,''                                  MFGNUM
       ,''                                  CLOSTA
       ,''                                  CLOUSR
       ,''                                  CLOTIM
       ,'1'                                 CLOFLG
       ,''                                  SABFLG
       ,'1'                                 DEBFLG
       ,'1'                                 SUBFLG
WHERE  '{0}' = ''</SQLScript>
  <SQLUpdateScript>--LINKADDNEWROWS
--LINKAUTOREPLACEEMPTYCOLUMNS
MERGE INTO [MFGPKH] D
USING (SELECT N'MPH'           DOCTYP
              ,N'#DOCNUM#'     DOCNUM
              ,N'#DOCGRP#'     DOCGRP
              ,N'1'            DOCSTA
              ,N'#DOCDAT#'     DOCDAT
              ,N'#DOCDES#'     DOCDES
              ,N'#PRJNUM#'     PRJNUM
              ,N'#SITE#'       SITE
              ,N'#FAC#'        FAC
              ,N'#DEPT#'       DEPT
              ,N'#DESTWH#'     DESTWH
              ,N'#DESTLOC#'    DESTLOC
              ,N'#RESNO#'      RESNO
              ,0#PRNCNT# PRNCNT
              ,N'#MATPRC#'     MATPRC
              ,N'#CLOREA#'     CLOREA
              ,N'#REMARK#'     REMARK
              ,N'#MFGNUM#'     MFGNUM
              ,N'#LOGIN_USER#' CREUSR
              ,Getdate()       CRETIM) S
ON ( S.[DOCNUM] = D.[DOCNUM] )
WHEN MATCHED THEN
  UPDATE SET DOCDAT = S.DOCDAT
             ,DOCDES = S.DOCDES
             ,PRJNUM = S.PRJNUM
             ,SITE = S.SITE
             ,FAC = S.FAC
             ,DEPT = S.DEPT
             ,DESTWH = S.DESTWH
             ,DESTLOC = S.DESTLOC
             ,RESNO = S.RESNO
             ,PRNCNT = S.PRNCNT
             ,MATPRC = S.MATPRC
             ,CLOREA = S.CLOREA
             ,REMARK = S.REMARK
             ,MFGNUM = S.MFGNUM
             ,UPDUSR = '#LOGIN_USER#'
             ,UPDTIM = Getdate()
WHEN NOT MATCHED THEN
  INSERT (DOCTYP
          ,DOCNUM
          ,DOCGRP
          ,DOCSTA
          ,DOCDAT
          ,DOCDES
          ,PRJNUM
          ,SITE
          ,FAC
          ,DEPT
          ,DESTWH
          ,DESTLOC
          ,RESNO
          ,PRNCNT
          ,MATPRC
          ,CLOREA
          ,REMARK
          ,CREUSR
          ,CRETIM
          ,MFGNUM )
  VALUES ( S.DOCTYP
           ,S.DOCNUM
           ,S.DOCGRP
           ,S.DOCSTA
           ,S.DOCDAT
           ,S.DOCDES
           ,S.PRJNUM
           ,S.SITE
           ,S.FAC
           ,S.DEPT
           ,S.DESTWH
           ,S.DESTLOC
           ,S.RESNO
           ,S.PRNCNT
           ,S.MATPRC
           ,S.CLOREA
           ,S.REMARK
           ,S.CREUSR
           ,S.CRETIM
           ,S.MFGNUM );</SQLUpdateScript>
