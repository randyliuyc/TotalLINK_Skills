  <ChartType />
  <SQLScript>--LINKLOADDATAIMMEDIATE
--LINKWINDOWMODE

DECLARE @MFGNUM VARCHAR(30) = '{0}'
DECLARE @VCRTYP INT = 15

SELECT J.ITMREF_0
  , I.ITMDES1_0
  , I.ITMDES2_0
  , J.IPTDAT_0
  , J.SERNUM_0
  , CAST(J.QTYSTU_0 AS INT) QTYSTU_0
  , J.STU_0
FROM STOJOU J
INNER JOIN ITMMASTER I
  ON J.ITMREF_0 = I.ITMREF_0
WHERE VCRNUMORI_0 = @MFGNUM
  AND VCRTYP_0 = @VCRTYP
ORDER BY J.ROWID</SQLScript>
