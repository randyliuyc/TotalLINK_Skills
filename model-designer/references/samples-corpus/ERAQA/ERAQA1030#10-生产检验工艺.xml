  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>DECLARE @ITMNO VARCHAR(30)='%{0}%';
DECLARE @CUSCOD VARCHAR(30)='%{1}%';
DECLARE @ROUDES VARCHAR(30)='%{2}%';

SELECT ISNULL(R.ITMREF_0, Q.ITMNO) ITMNO
    , ISNULL(O.ROODES_0, 'QA Routing') ROODES
    , Q.ROUCOD
    , ISNULL(R.ROUALT_0, Q.ROUALT) ROUALT
    , ISNULL(O.OPENUM_0, Q.ROUOPE) ROUOPE
    , ISNULL(R.BPCNUM_0, Q.CUSCOD) CUSCOD
    , ISNULL(R.INTSPE_0, Q.INTSPEC) INTSPE
    , IIF(R.ROUSTRDAT_0 = '1753-01-01', NULL, R.ROUSTRDAT_0) ROUSTRDAT
    , IIF(R.ROUENDDAT_0 = '1753-01-01', NULL, R.ROUENDDAT_0) ROUENDDAT
FROM #LC.X3DATA#ROUTING R
LEFT JOIN (
    SELECT ROUALT_0
        , ITMREF_0
        , OPENUM_0
        , ROODES_0
    FROM #LC.X3DATA#ROUOPE
    WHERE STDOPENUM_0 BETWEEN 690 AND 699
    GROUP BY ROUALT_0
        , ITMREF_0
        , OPENUM_0
        , ROODES_0
    ) O
    ON R.ITMREF_0 = O.ITMREF_0
        AND R.ROUALT_0 = O.ROUALT_0
-- 2025年1月22日，修改规则，允许工艺路线不存在的QA Routing也可以显示
FULL JOIN QAROU Q
    ON Q.ROUCOD #LC.X3COLLATE# = CONCAT_WS('-', R.ITMREF_0, R.ROUALT_0, O.OPENUM_0)
        AND Q.ROUTYP = 'SFC'
WHERE (
        R.ITMREF_0 LIKE @ITMNO
        AND R.BPCNUM_0 LIKE @CUSCOD
        AND O.ROODES_0 LIKE @ROUDES
        )
    OR (
        R.ITMREF_0 IS NULL
        AND Q.ROUTYP = 'SFC'
        )
ORDER BY R.ITMREF_0</SQLScript>
