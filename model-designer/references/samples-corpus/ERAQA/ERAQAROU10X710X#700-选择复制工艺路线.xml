  <ChartType />
  <SQLScript>DECLARE @P1  VARCHAR(50)='{0}';
DECLARE @T1  VARCHAR(5);
SELECT @T1= ROUTYP  FROM [QAROU] WHERE ROUCOD=@P1
SELECT S.ROUCOD,S.INTSPEC
FROM [QAROU] S
LEFT JOIN  [QAROULIN] N ON S.ROUCOD=N.ROUCOD
WHERE S.ROUTYP=@T1
AND N.ROUCOD IS NOT NULL
GROUP BY S.ROUCOD,S.INTSPEC
ORDER BY S.ROUCOD</SQLScript>
