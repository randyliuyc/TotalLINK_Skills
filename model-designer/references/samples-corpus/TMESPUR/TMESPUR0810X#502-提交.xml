  <SQLScript>--LINKMULTIROWS
DECLARE @BATCHID VARCHAR(50) = '#LINKID_ACTION#';
DECLARE @USER VARCHAR(30) = '#LOGIN_USER#'

UPDATE STKLOTLST WITH (ROWLOCK) 
SET BATCHID = @BATCHID 
WHERE  CREUSR = @USER
       AND SUBSTA &lt;&gt; 3
       AND DOCTYP = 'PRC'
       AND DOCGRP = 'IMP'

UPDATE STKBUS
SET BATCHID = @BATCHID 
WHERE DOCNUM LIKE 'NEWPRCIMP%'
      AND CREUSR = @USER
      AND SUBSTA &lt;&gt; 3
      AND DOCTYP = 'PRC'

SELECT S.DOCNUM DOCNUM1,
      @BATCHID   BATCHID1
FROM  STKBUS S WITH(NOLOCK)
WHERE BATCHID = @BATCHID
GROUP BY S.DOCNUM</SQLScript>
