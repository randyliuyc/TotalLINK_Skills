  <SQLScript>DECLARE @TAG VARCHAR(50)='{0}';

-- 检查标签是否存在
IF NOT EXISTS (SELECT 1
               FROM   MFGHEAD
               WHERE  MFGNUM_0 = @TAG)
  BEGIN
      -- 如果找不到标签，返回错误信息
      SELECT N'该标签内容错误，请检查' AS 数据检查
  END
ELSE
  BEGIN
      -- 如果找到标签，返回正常数据
      SELECT H.MFGFCY_0 AS 地点
            ,H.MFGNUM_0 AS 工单号
            ,''         AS 数据检查
      FROM   MFGHEAD H
      WHERE  H.MFGNUM_0 = @TAG
  END</SQLScript>
