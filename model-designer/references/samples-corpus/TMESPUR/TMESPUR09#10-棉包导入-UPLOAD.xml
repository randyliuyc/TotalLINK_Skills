  <SQLScript>--LINKLOADDATAIMMEDIATE
SELECT TAGNO,
       LOT,
       SUBLOT,
       MIC,
       LEN,
       UNIF,
       STR,
       RD,
       PLUSB,
       RECWT,
       NETREWT,
       SHIPWT,
       NETSHWT,
       TAREWT,
       CONTRACT,
       INVOICE,
       CREUSR,
       FILENAM,
       BATCHID 
FROM   STKLOTLST WITH(NOLOCK)
WHERE  SUBSTA = 1
       AND CREUSR = '#LOGIN_USER#'
       AND TAGTYP = 'CTR'
       AND DOCTYP = 'PRC'
       AND DOCGRP = 'IMP'
       AND BATCHID = 'NEW-PRCIMP-#LOGIN_USER#'</SQLScript>
