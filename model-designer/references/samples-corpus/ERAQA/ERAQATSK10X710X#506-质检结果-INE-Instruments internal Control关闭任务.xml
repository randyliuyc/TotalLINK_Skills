  <SQLClear>DECLARE @DOCNUM VARCHAR(30) = '{0}'
DECLARE @DATE VARCHAR(30) = '#LINKDATE(0,0,0,yyyyMMdd)#'
DECLARE @USER VARCHAR(30) = '#LOGIN_USER#'
DECLARE @DUDAT DATE = '{2}'
DECLARE @TRXDES VARCHAR(100)=N'{4}'
DECLARE @REMARK VARCHAR(100)=N'{7}'
DECLARE @INSTSTA VARCHAR(30)=IIF('{8}' = '', 'Invalid', '{9}')
DECLARE @ITMNO VARCHAR(30)
DECLARE @INTCTLPRD INT;

SELECT @ITMNO = ITMNO
FROM   QAINSPH
WHERE  DOCNUM = @DOCNUM

SELECT @INTCTLPRD = INTCTLPRD
FROM   QAINSTLST
WHERE  INSTCOD = @ITMNO

INSERT INTO [QAINSTTRX] ，
            ([DOCNUM],
             [INSTCOD],
             [TRXTYP],
             [TRXDAT],
             [TRXUSR],
             [TRXDES],
             [RPTREF],
             [COST],
             [INSTSTA],
             [REMARK],
             [CREUSR],
             [CRETIM])
VALUES      ( @DOCNUM--&lt;DOCNUM, varchar(30),&gt;
              ,@ITMNO--&lt;INSTCOD, varchar(30),&gt;
              ,'INE'--&lt;TRXTYP, varchar(30),&gt;
              ,@DATE--&lt;TRXDAT, date,&gt;
              ,@USER--&lt;TRXUSR, varchar(30),&gt;
              ,@TRXDES--&lt;TRXDES, nvarchar(100),&gt;
              ,@DOCNUM--&lt;RPTREF, nvarchar(100),&gt;
              ,0--&lt;COST, decimal(18,6),&gt;
              ,@INSTSTA--&lt;INSTSTA, varchar(30),&gt;
              ,@REMARK--&lt;REMARK, nvarchar(100),&gt;
              ,@USER--&lt;CREUSR, varchar(30),&gt;
              ,GETDATE()--&lt;CRETIM, datetime,&gt;
);

UPDATE QAINSTLST
SET    INTCTLFROM = DATEADD(MONTH, -@INTCTLPRD, @DUDAT),
       INTCTLTO = @DUDAT,
       INSTSTA = @INSTSTA
WHERE  INSTCOD = @ITMNO;

UPDATE QAINSPH
SET    CLOSTA = 1,
       CLOUSR = @USER,
       CLOTIM = GETDATE()
WHERE  DOCNUM = @DOCNUM;</SQLClear>
