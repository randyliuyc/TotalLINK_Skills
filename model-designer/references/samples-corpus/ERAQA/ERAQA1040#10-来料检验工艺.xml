  <SQLScript>DECLARE @ITMNO VARCHAR(30)='%{0}%';
DECLARE @ITMDES VARCHAR(30)='%{1}%';
SELECT ITM.ITMREF_0 ITMNO
      ,ITM.ITMDES1_0 ITMDES
      ,Q.ROUCOD 
      ,ITM.TCLCOD_0
FROM #LC.X3DATA#ITMMASTER ITM
  LEFT JOIN QAROU Q
ON ITM.ITMREF_0 = Q.ROUCOD #LC.X3COLLATE#
WHERE ITM.TCLCOD_0 IN ('RAW','FPP','MFL')AND 
  ITM.ITMREF_0 LIKE @ITMNO
  AND ITM.ITMDES1_0 LIKE @ITMDES
ORDER BY ITM.ITMREF_0</SQLScript>
