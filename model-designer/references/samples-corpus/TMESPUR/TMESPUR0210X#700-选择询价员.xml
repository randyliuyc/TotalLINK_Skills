  <SQLScript>SELECT S.LoginUser-- 用户编码
       ,S.Name -- 用户名
       ,S.Role --角色编码
       ,R.RoleDesc --角色描述
       ,S.Email --邮箱地址
       ,S.Tel --电话号码
       ,S.DINGtalkID --钉钉号
       ,S.WeixinID --微信号
       ,S.PWD --默认密码
       ,S.MANAGER1 --主管
       ,S.UDF001 --分组列表查看
       ,S.DOCGRP --分组列表查看
       ,S.DEPT1 LOADDROPVALIDSITE--地点
       ,S.DEPT2 LOADDROPVALIDFAC--厂区
       ,S.DEPT3 LOADDROPVALIDDEPT--车间
       ,'--&gt;'   LINKSUB10_USERDEPT --多车间维护
       ,S.ACTIVEFLAG --激活
       ,S.PORTALCODE --门户配置
       ,S.LOGINCODE --登录信息
FROM   SysUser S
       LEFT JOIN SysRole R
              ON R.Role = S.Role
WHERE  S.Role IN ( 'NB-CAIGOU', 'SV-PUR', 'SV-PUR-ADMIN' )
   AND S.LoginUser+S.Name LIKE '%{0}%'</SQLScript>
