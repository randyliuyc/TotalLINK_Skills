  <ChartType />
  <SQLScript>--LINKLOADDATAIMMEDIATE
SELECT S.[INSTCOD]  
      ,S.[INSTNAM]
      ,S.[BRAND]
      ,DATEDIFF(dd,GETDATE(),S.[CLBCTLTO]) LIMITDAYS
      ,S.[CLBPRD]  
      ,S.[CLBSTD]
      ,IIF(S.[CLBCTLFROM]='1900-01-01',NULL,S.[CLBCTLFROM]) CLBCTLFROM
      ,IIF(S.[CLBCTLTO]='1900-01-01',NULL,S.[CLBCTLTO]) CLBCTLTO
      ,S.[CLBDAYS]
      ,S.[MODEL]
      ,S.[SERNUM]
      ,S.[LOC]
      ,S.[INSTDES]
      ,S.[INSTRNG]
      ,S.[RESPONS]
      ,S.[MANUSR]
      ,S.[CREDAT]
      ,CASE WHEN DATEDIFF(dd,GETDATE(),S.[CLBCTLTO])&lt;0 THEN 'D04'
            WHEN DATEDIFF(dd,GETDATE(),S.[CLBCTLTO])&lt;=S.[CLBDAYS] THEN 'E04'
            ELSE 'H03' END LINKAPPRROW
FROM [QAINSTLST] S
WHERE S.[CLBPRD]&lt;&gt;0 AND S.[CLBCTLTO]&lt;&gt;'1900-01-01'
ORDER BY DATEDIFF(dd,GETDATE(),S.[CLBCTLTO])</SQLScript>
