  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>SELECT S.ITMREF_0
  , I.TCLCOD_0
  , GERL1.ITMDES ITMDES1_0
  , GERL2.ITMDES ITMDES2_0
  , GERL3.ITMDES ITMDES3_0
  , S.LOCTYP_0
  , S.LOC_0
  , S.LOT_0
  , S.BPSLOT_0
  , CAST(S.QTYSTU_0 AS INT) QTYSTU_0
  , I.STU_0
FROM STOCK S
INNER JOIN ITMMASTER I
  ON I.ITMREF_0 = S.ITMREF_0
LEFT JOIN ITMLAN1 GERL1
  ON GERL1.ITMREF = I.ITMREF_0
    AND GERL1.LANX3 = 'GER'
LEFT JOIN ITMLAN2 GERL2
  ON GERL2.ITMREF = I.ITMREF_0
    AND GERL2.LANX3 = 'GER'
LEFT JOIN ITMLAN3 GERL3
  ON GERL3.ITMREF = I.ITMREF_0
    AND GERL3.LANX3 = 'GER'
WHERE S.STOFCY_0 = 'ZUPK'
  AND I.TCLCOD_0 = 'ZOLL'</SQLScript>
