  <FunctionCode />
  <ChartType />
  <SQLScript>--LINKNOGROUP
DECLARE @GRDCOD VARCHAR(30)='{0}';
DECLARE @CUSCOD VARCHAR(30)='{1}';

SELECT S.ELECOD
      ,CAST(E.ELEMIN AS REAL)             ELEMIN
      ,CAST(E.ELEMAX AS REAL)             ELEMAX
      ,S.ELEUNT
      ,S.CREUSR
      ,S.UPDUSR
      ,CONVERT(VARCHAR(16), S.CRETIM, 21) CRETIM
      ,CONVERT(VARCHAR(16), S.UPDTIM, 21) UPDTIM
      ,E.ID                               LINKROWID
FROM   QAELE S
       LEFT JOIN (SELECT *
                  FROM   QAGRADEELE E
                  WHERE  GRDCOD = @GRDCOD
                         AND CUSCOD = @CUSCOD)E
              ON S.ELECOD = E.ELECOD
ORDER  BY IIF(E.ELECOD IS NULL,9999999,S.ELESEQ)</SQLScript>
  <SQLUpdateScript>--LINKEDITMODE
--LINKSAVEONENTERKEY
UPDATE QAGRADEELE
SET ELEMAX = 0#ELEMAX#
    , ELEMIN = 0#ELEMIN#
    , UPDUSR = '#LOGIN_USER#'
    , UPDTIM = GETDATE()
WHERE ID = 0#LINKROWID#

UPDATE QAGRADE
SET UPDUSR = '#LOGIN_USER#'
    , UPDTIM = GETDATE()
WHERE GRDCOD = '{0}' 
    AND CUSCOD = '{1}'</SQLUpdateScript>
