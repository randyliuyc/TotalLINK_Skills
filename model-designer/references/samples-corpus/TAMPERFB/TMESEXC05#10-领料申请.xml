  <SQLRemove>UPDATE PREQAL
SET    PRQNUM = ''
       ,PRQQTY = A.QTY
       ,PRQQTYSTU = A.QTYSTU
FROM   PREQAL A
       INNER JOIN PREQUL D
               ON D.ITMNO = A.ITMNO
                  AND D.ITMVER = A.ITMVER
                  AND A.PRQNUM = D.DOCNUM
WHERE  D.DOCNUM = '#DOCNUM#'
       AND D.DOCSTA = '1';

DELETE FROM PREQUH
WHERE  DOCNUM = '#DOCNUM#'
       AND DOCSTA = '1';</SQLRemove>
