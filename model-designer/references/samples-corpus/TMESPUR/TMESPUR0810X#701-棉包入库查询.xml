  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>SELECT T.ITMNO
      ,ITM.ITMNAM
      ,ITM.ITMNAM1
      ,T.ITMVER
      ,T.LOT
      ,T.SUBLOT
      ,SUM(T.QTY) QTY
      ,T.UOM
      ,SUM(T.QTYSTU) QTYSTU
      ,T.STU
FROM   STKLOTLST T WITH(NOLOCK)  LEFT JOIN ITM WITH(NOLOCK) ON T.ITMNO=ITM.ITMNO
WHERE  T.SUBSTA = 3
       AND CONVERT(VARCHAR(16), T.CRETIM, 23) BETWEEN '{0}' AND '{1}'
       AND T.LOT LIKE '%{2}%'
       AND T.ITMNO+T.ITMVER+T.LOT+T.SUBLOT+ITM.ITMNAM+ITM.ITMNAM1 LIKE '%{3}%'
       AND DOCTYP='PRC' AND DOCGRP='IMP'
GROUP  BY T.ITMNO
          ,ITM.ITMNAM
	  ,ITM.ITMNAM1
          ,T.ITMVER
          ,T.LOT
          ,T.SUBLOT
          ,T.UOM
          ,T.STU</SQLScript>
