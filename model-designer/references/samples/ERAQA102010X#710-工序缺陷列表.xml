  <SQLScript>DECLARE @OPESTD VARCHAR(30)='{0}';
SELECT S.[SCACOD]
      ,S.[SCADES1]
      ,S.[SCADES2]
      ,S.[CREUSR]
      ,S.[UPDUSR]
      ,CONVERT(VARCHAR(16),S.[CRETIM],21) CRETIM
      ,CONVERT(VARCHAR(16),S.[UPDTIM],21) UPDTIM
      ,S.[ID] LINKROWID
  FROM [QAOPESTDSCA] S
  WHERE S.[OPESTD]=@OPESTD
  ORDER BY SCACOD</SQLScript>
  <SQLUpdateScript>--LINKSAVEONENTERKEY
--LINKEDITMODE
UPDATE [QAOPESTDSCA]
   SET [SCACOD] ='#SCACOD#'-- &lt;SCACOD, varchar(30),&gt;
      ,[SCADES1] ='#SCADES1#'-- &lt;SCADES1, nvarchar(50),&gt;
      ,[SCADES2] ='#SCADES2#' --&lt;SCADES2, nvarchar(50),&gt;
      ,[UPDUSR] ='#LOGIN_USER#' --&lt;UPDUSR, varchar(30),&gt;
      ,[UPDTIM] =GETDATE()-- &lt;UPDTIM, datetime,&gt;
 WHERE ID=0#LINKROWID#</SQLUpdateScript>
