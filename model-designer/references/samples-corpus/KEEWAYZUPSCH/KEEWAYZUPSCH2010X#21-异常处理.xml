  <SQLClear>--LINKREFRESH
DECLARE @SOHNUM VARCHAR(30) = '#销售订单#';

-- 先删除WEBSERVICE不通处于提交中的记录
DELETE FROM XWSPOH
WHERE BATCHID_0 = @SOHNUM
  AND STAT_0 = 2
  AND RPFLG_0 &lt;&gt; 3;

-- 如果PORDERQ表中不存在该销售订单，再删除ERP删除的记录
IF NOT EXISTS (SELECT 1 FROM PORDERQ WHERE XREFSOH_0 = @SOHNUM)
BEGIN
    DELETE FROM XWSPOH
    WHERE BATCHID_0 = @SOHNUM
    -- RANDY, 2026年5月20日，如果未转单，又需要异常处理，可直接删除
    -- 遇到产品未激活，提交失败，RPFLG 仍然是1
    --  AND RPFLG_0 = 3;
END</SQLClear>
