  <SQLScript>SELECT L1.[ID]       LINKROWID
      ,L1.[LINKOPTTYP]
      ,L1.[OPTTYP]
      ,L1.[OPTID]
      ,L1.[OPTDES]
      ,L1.[LINKOPTID]
	  ,L2.[OPTDES]   [OPTDES2]
      ,L1.[REMARK]
      ,L1.[CREUSR]
      ,L1.[UPDUSR]
      ,L1.OPTSEQ
      ,CASE WHEN CONVERT(VARCHAR(10),L1.[CRETIM],21)='1900-01-01' THEN ''
	  ELSE CONVERT(VARCHAR(16),L1.[CRETIM],21) END [CRETIM]
      ,CASE WHEN CONVERT(VARCHAR(10),L1.[UPDTIM],21)='1900-01-01' THEN '' 
	  ELSE CONVERT(VARCHAR(16),L1.[UPDTIM],21) END [UPDTIM]

  FROM [LINKOPT]   L1
  LEFT JOIN  [LINKOPT]   L2  ON L1.[LINKOPTID]=L2.[OPTID]  AND L1.LINKOPTTYP=L2.OPTTYP
  WHERE L1.[OPTTYP]='{0}' AND L1.REMARK = ''
  ORDER BY OPTSEQ ASC</SQLScript>
