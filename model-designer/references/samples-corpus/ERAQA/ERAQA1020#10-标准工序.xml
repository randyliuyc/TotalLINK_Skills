  <SQLScript>--LINKDATAMINEOVERVIEW,VERTICAL,60,AUTOREFRESH
DECLARE @OPESTD VARCHAR(30)='%{0}%';
DECLARE @OPEDES VARCHAR(100)='%{1}%';

SELECT S.OPESTD
      ,S.OPEDES1
      ,S.OPEDES2
      ,S.MATTYP
      ,S.RPTGRP1
      ,S.RPTTTL1
      ,S.RPTGRP2
      ,S.RPTTTL2
      ,S.INSTRUCTION
      ,S.OPEUNT
      ,S.CTLTYP LINKDROPVALIDCTLTYP
      ,S.NTYP   LINKDROPVALIDNTYP
      ,S.MEAFRQ LINKDROPVALIDMEAFRQ
      ,S.INSTCOD
      ,S.INSTCAT LINKDROPVALIDINSTCAT
      ,S.CREUSR
      ,S.UPDUSR
      ,CONVERT(VARCHAR(16), S.CRETIM, 21) CRETIM
      ,CONVERT(VARCHAR(16), S.UPDTIM, 21) UPDTIM
      ,S.ID                               LINKROWID
FROM   QAOPESTD S
WHERE  S.OPESTD LIKE @OPESTD
       AND S.OPEDES1 + S.OPEDES2 LIKE @OPEDES
ORDER  BY S.OPESTD</SQLScript>
  <SQLUpdateScript>--LINKSAVEONENTERKEY
--LINKEDITMODE
UPDATE QAOPESTD SET
  OPEDES1 = N'#OPEDES1#'
, OPEDES2 = N'#OPEDES2#'
, MATTYP=N'#MATTYP#'
, RPTGRP1=N'#RPTGRP1#'
, RPTTTL1=N'#RPTTTL1#'
, RPTGRP2=N'#RPTGRP2#' 
, RPTTTL2=N'#RPTTTL2#'
, INSTRUCTION = N'#INSTRUCTION#'
, OPEUNT = N'#OPEUNT#'
, CTLTYP = N'#LINKDROPVALIDCTLTYP#'
, NTYP=N'#LINKDROPVALIDNTYP#'
, MEAFRQ = N'#LINKDROPVALIDMEAFRQ#'
, INSTCOD=N'#INSTCOD#'
, INSTCAT=N'#LINKDROPVALIDINSTCAT#'
, UPDUSR = N'#LOGIN_USER#'
, UPDTIM = GETDATE()
WHERE ID=0#LINKROWID#</SQLUpdateScript>
