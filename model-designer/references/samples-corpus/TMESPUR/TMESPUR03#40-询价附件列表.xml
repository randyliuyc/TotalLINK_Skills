  <SQLScript>SELECT S.[ID]
       ,S.[FILKEY]
       ,S.[FILGRP]
       ,T.OPTDES                             FILGRPDES
       ,S.[FILTYP]
       ,S.[FILNAM]                           text
       ,S.[FILDES]
       ,S.[FILDIR]
       ,S.[FILURL]                           NAME
       ,S.[FILURL]                           picture
       ,S.[SRCTYP]
       ,S.[SRCDOC]
       ,S.[SRCLIN]
       ,S.[REMARK]
       ,S.[FLG01]
       ,S.[FLG02]
       ,Isnull(U.NAME, S.[CREUSR])           CREUSR
       ,S.[UPDUSR]
       ,CONVERT(VARCHAR(16), S.[CRETIM], 21) CRETIM
       ,S.[UPDTIM]
FROM   [LINKDOCFIL] S
       LEFT JOIN LINKDEV.dbo.SysUser U
              ON S.[CREUSR] = U.LoginUser
       LEFT JOIN LINKOPT T
              ON S.FILGRP = T.OPTID
WHERE  S.SRCDOC IN (SELECT SRCDOC
                    FROM   PORDLIN
                    WHERE  DOCNUM = '{0}'
                    GROUP  BY SRCDOC)
       AND Isnull(S.SRCDOC, '') &lt;&gt; ''
ORDER  BY S.ID</SQLScript>
