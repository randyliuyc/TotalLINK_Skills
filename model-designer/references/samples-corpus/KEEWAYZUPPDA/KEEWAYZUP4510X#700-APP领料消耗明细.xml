  <SQLScript>DECLARE @FCY VARCHAR(10)='{0}';
DECLARE @MFGNUM VARCHAR(30)='{1}';
SELECT XWS.PK_0                                  LINKROWID
      ,CAST(XWS.QTYPCU_0 AS REAL)                数量
      ,XWS.LOC_0                                 库位
      ,XWS.SERNUM_0                              序列号
      ,XWS.RPNUM_0                               追踪单号
      ,CONVERT(VARCHAR(16), XWS.CREDATTIM_0, 21) 操作时间
      ,XWS.USERID_0                              操作人员
      ,CASE
          WHEN XWS.LOC_0 = '' THEN N'库位为空'
          WHEN ITM.SERMGTCOD_0 = 3
               AND XWS.SERNUM_0 = '' THEN N'序列号为空'
          WHEN ITM.SERMGTCOD_0 = 3
               AND XWS.QTYPCU_0 &lt;&gt; 1 THEN N'数量错误'
          ELSE ''
        END                                      AS 数据检查
      ,CASE
          WHEN XWS.RPFLG_0 = 3 THEN 'mui-hidden'
          ELSE ''
        END                                      LINKROWIDBTNFLG
      ,XWS.MFGNUM_0+CAST(XWS.MFGLIN_0 AS VARCHAR)+CAST(XWS.BOMSEQ_0 AS VARCHAR)        pid
FROM   XWSMKM XWS
       INNER JOIN ITMMASTER ITM
               ON XWS.ITMREF_0 = ITM.ITMREF_0
WHERE XWS.MFGFCY_0=@FCY
  AND XWS.MFGNUM_0=@MFGNUM
ORDER  BY XWS.RPFLG_0,XWS.CREDATTIM_0 DESC</SQLScript>
