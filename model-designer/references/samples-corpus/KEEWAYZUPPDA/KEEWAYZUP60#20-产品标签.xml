  <SQLScript>DECLARE @LANX3 VARCHAR(30) = '#LINKFUNC.GETLANX3#';
DECLARE @ITMREF NVARCHAR(100)=N'%{1}%';
DECLARE @ITMDES VARCHAR(30)='%{2}%';
SELECT TOP 500
I.ITMREF_0                           AS 产品编码
,ISNULL(L1.ITMDES, I.ITMDES1_0)      AS 产品描述1
,ISNULL(L2.ITMDES, I.ITMDES2_0)      AS 产品描述2
,I.YMDDES_0                          AS 产品备注 
,I.EANCOD_0 
FROM  ITMMASTER I
       LEFT JOIN ITMLAN1 L1
              ON L1.ITMREF = I.ITMREF_0
                 AND L1.LANX3 = @LANX3
       LEFT JOIN ITMLAN2 L2
              ON L2.ITMREF = I.ITMREF_0
                 AND L2.LANX3 = @LANX3
WHERE   I.ITMREF_0 LIKE UPPER(@ITMREF)
       AND ISNULL(L1.ITMDES, I.ITMDES1_0)
           + ISNULL(L2.ITMDES, I.ITMDES2_0) LIKE @ITMDES</SQLScript>
