  <ChartType />
  <SQLScript>--LINKDATAMINEOVERVIEW,H,50,AUTOREFRESH
SELECT M.XMHNUM_0 计划单号
       ,M.XRMK_0  备注
       ,IIF(ISNULL((SELECT COUNT(*)
                       FROM   XWSSCHRES
                       WHERE  REQCFMFLG_0 = 1
                              AND XMHNUM_0 = M.XMHNUM_0), 0)= 0, N'lang:{zh:选择,en:Select,de:wählen}', '') LINKSUB10_选择
       ,ISNULL(S.SRCLINES, 0) 工单数
       ,'--&gt;' LINKSUB30_计划结果
       ,CONVERT(VARCHAR(16),M.CREDATTIM_0,21) 创建时间
       ,M.CREUSR_0 创建人
       ,M.ROWID LINKROWID 
FROM   XWSSCHSRM M
       LEFT JOIN (SELECT XMHNUM_0
                         ,COUNT(*) SRCLINES
                  FROM   XWSSCHSRC
                  GROUP  BY XMHNUM_0) S
              ON S.XMHNUM_0 = M.XMHNUM_0

WHERE  STOFCY_0 = '{0}' 
    AND CONVERT(VARCHAR(10), CREDATTIM_0, 23) BETWEEN '{1}' AND '{2}' 
ORDER BY M.CREDATTIM_0 DESC</SQLScript>
  <SQLUpdateScript>--LINKEDITMODE
--LINKSAVEONENTERKEY
UPDATE XWSSCHSRM SET XRMK_0=N'@备注@' WHERE XMHNUM_0='#计划单号#';</SQLUpdateScript>
