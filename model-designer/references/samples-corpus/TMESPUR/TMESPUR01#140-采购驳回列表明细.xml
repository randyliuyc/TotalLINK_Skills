  <SQLScript>--获取填报车间的合集
WITH CTE_DEPT
     AS (SELECT ITMNO
	        ,PRQNUM
                ,String_agg(DEPT, '/') AS PRADEPT
         FROM   (SELECT DISTINCT L.PRQNUM
                                ,L.ITMNO
				,H.DEPT
                 FROM PREQAL L
                 INNER JOIN PREQAH H ON L.DOCNUM = H.DOCNUM
                 WHERE ISNULL(L.PRQNUM,'')&lt;&gt;'' ) DP
         GROUP  BY ITMNO,PRQNUM)

SELECT ''                                    GXFLG
       ,S.ID                                 LINKROWID
       ,S.DOCNUM                             DOCNUML--请求填报单号      
       ,S.DOCLIN --行号
       ,SU.NAME+'('+S.PCKUSR+')' PCKUSR
       ,CONVERT(VARCHAR(16), S.PCKTIM, 21)   PCKTIM
       ,S.PCKCOMMENT
       ,S.ITMNO --产品编码
       --,ITM.ITMNOORI
       ,ITM.ITMNAM --产品描述
       ,ITM.ITMNAM1
      -- ,ITM.ITMNAM2
       ,S.ITMVER --产品版本
       ,ITM.TSICOD1 --产品分类
       ,ITM.TSICOD2
       ,ITM.TSICOD3
       ,ITM.TSICOD4
       ,ITM.TSICOD5
       ,ITM.ITMSIZE
       ,ITM.ITMSPEC
       ,CONVERT(VARCHAR, S.REQDAT, 23)       REQDAT --要求日期
       ,S.UOM --采购单位
       ,Cast(S.UOMCOE AS REAL)               UOMCOE --采购单位系数
       ,Cast(S.QTY AS REAL)                  QTY --采购单位数量
       ,S.STU --库存单位
       ,Cast(S.QTYSTU AS REAL)               QTYSTU --库存单位数量
       ,S.REMARK                             LREMARK --备注
       ,S.SRCTYP --来源类型
       ,S.SRCDOC --来源单据
       ,S.SRCLIN --来源行号
       ,DOCSTA.OPTDES                        DOCSTA --单据状态
       ,S.CLOREA                             LCLOREA --关闭原因
       ,H.[DOCGRP]
       ,DOCGRP.OPTDES                        DOCGRPDES
       ,DOCSTA.OPTDES                        DOCSTA
       ,H.[DOCDES]
       ,H.[PRJNUM]
       ,H.[SITE]
       ,SI.[SITENAM]                         SITEDES
       ,H.FAC
       ,F.FACNAM
       ,T.PRADEPT                
       ,H.[DEPT]
       ,D.DEPTNAM                            DEPTDES
       ,H.[GRP]
       ,G.GRPNAM                             GRPDES
       ,H.[RESNO]
       ,R.RESNAM                             RESNODES
       ,H.[REMARK]
       ,S.CREUSR
       ,S.UPDUSR
       ,CONVERT(VARCHAR(16), S.[CRETIM], 21) CRETIM
       ,CONVERT(VARCHAR(16), S.[UPDTIM], 21) UPDTIM
       
FROM   PREQUL S
       LEFT JOIN ITM
              ON ITM.ITMNO = S.ITMNO
       LEFT JOIN PREQUH H
              ON S.DOCNUM = H.DOCNUM
       LEFT JOIN LINKOPT DOCSTA
              ON DOCSTA.OPTID = S.DOCSTA
                 AND DOCSTA.OPTTYP = 'DOCSTA'
       LEFT JOIN [ENTSITE] SI
              ON H.[SITE] = SI.SITE
       LEFT JOIN ENTFAC F
              ON H.FAC = F.FAC
       LEFT JOIN [LINKOPT] DOCGRP
              ON H.DOCGRP = DOCGRP.OPTID
                 AND DOCGRP.OPTTYP = 'DOCGRP'
                 AND DOCGRP.LINKOPTID = 'PRE'
       LEFT JOIN [ENTDEPT] D
              ON H.[DEPT] = D.DEPT
       LEFT JOIN [ENTGRP] G
              ON H.[GRP] = G.GRP
       LEFT JOIN [ENTRES] R
              ON H.[RESNO] = R.RESNO
       LEFT JOIN LINK.DBO.SysUser SU
              ON S.PCKUSR = SU.LoginUser
       LEFT JOIN CTE_DEPT T
              ON T.PRQNUM=S.DOCNUM
             AND T.ITMNO=S.ITMNO
WHERE  Isnull(S.PCKFLG, '') = 1
       AND S.DOCSTA = 2
       AND H.SITE LIKE N'%{0}%'
       AND S.DOCNUM LIKE N'%{1}%'
       AND S.ITMNO + S.ITMVER + ITM.ITMNAM + ITM.ITMNAM1
           + Isnull(ITM.ITMSIZE, '')
           + Isnull(ITM.ITMSPEC, '') LIKE N'%{2}%'
       AND ( H.DEPT = '{3}'
              OR '{3}' = '' )
ORDER  BY S.DOCNUM DESC
          ,S.DOCLIN</SQLScript>
  <SQLUpdateScript>UPDATE PREQUL
SET    PCKFLG = 0
       ,PFBUSR = N'#LOGIN_USER#'
       ,PFBTIM = Getdate()
WHERE  DOCNUM = '#DOCNUML#'
       AND DOCLIN = 0#DOCLIN#
       AND '#GXFLG#' = '1';</SQLUpdateScript>
