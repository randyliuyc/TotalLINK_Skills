  <ChartType />
  <SQLScript>DECLARE @MFGNUM VARCHAR(30)='%{0}%';
DECLARE @ITMNO VARCHAR(30)='%{1}%';
DECLARE @CUSCOD VARCHAR(30)='%{2}%';

SELECT TOP 500 MH.MFGNUM_0 MFGNUM
              ,MI.VCRNUMORI_0 ORIVCR
              ,MO.ROODES_0 ROUDES
              ,MH.ROUNUM_0 ITMNO
              ,MI.BPCNUM_0 CUSCOD
              ,MI.INTSPE_0 INTSPEC
              ,H.DOCNUM
              ,ISNULL(H.CLOSTA,0) INSSTA
              ,CAST(IIF(MH.MFGSTA_0=4,1,0) AS BIT)  MFGSTA
              ,MO.OPENUM_0 ROUOPE
FROM   QAINSPH H
       INNER JOIN #LC.X3DATA#MFGHEAD MH
               ON H.MFGNUM #LC.X3COLLATE#=MH.MFGNUM_0 
       INNER JOIN #LC.X3DATA#MFGOPE MO
               ON H.MFGNUM #LC.X3COLLATE# = MO.MFGNUM_0
                  AND H.ROUOPE #LC.X3COLLATE# = MO.OPENUM_0
       INNER JOIN #LC.X3DATA#MFGITM MI
               ON MI.MFGNUM_0 = MO.MFGNUM_0
                  AND MI.ITMTYP_0 = 1
WHERE  H.ROUTYP = 'SFC'
       AND MH.ROUNUM_0 LIKE @ITMNO
       AND MI.BPCNUM_0 LIKE @CUSCOD
       AND MH.MFGNUM_0 LIKE @MFGNUM
ORDER  BY MH.MFGNUM_0</SQLScript>
