  <SQLClear>--LINKREFRESH
DECLARE @DOCNUM VARCHAR(30)='#LINKDOCNUM.H#';
DECLARE @GRDCOD VARCHAR(30)='{4}';
DECLARE @LOT VARCHAR(30)='{5}';
DECLARE @TV VARCHAR(30)='{6}';

INSERT INTO [QAMAT]
           ([DOCNUM]
           ,[ITMNO]
           ,[LOT]
           ,[TV]
           ,[GRDCOD]
           ,[STA]
           ,[CREUSR]
           ,[UPDUSR]
           ,[CRETIM]
           ,[UPDTIM])
     VALUES
           (@DOCNUM--&lt;DOCNUM, varchar(30),&gt;
           ,''--&lt;ITMNO, varchar(30),&gt;
           ,@LOT--&lt;LOT, varchar(30),&gt;
           ,@TV--&lt;TV, varchar(30),&gt;
           ,@GRDCOD--&lt;GRDCOD, varchar(30),&gt;
           ,'Valid'--&lt;STA, varchar(30),&gt;
           ,'#LOGIN_USER#'--&lt;CREUSR, varchar(30),&gt;
           ,''--&lt;UPDUSR, varchar(30),&gt;
           ,GETDATE()--&lt;CRETIM, datetime,&gt;
           ,''--&lt;UPDTIM, datetime,&gt;
		   )

INSERT INTO [QAMATELE]
            ([DOCNUM],
             [ELECOD],
             [ELESEQ],
             [CREUSR],
             [UPDUSR],
             [CRETIM],
             [UPDTIM])
SELECT @DOCNUM--&lt;DOCNUM, varchar(30),&gt;
      ,ELECOD--&lt;ELECOD, varchar(30),&gt;
      ,ELESEQ
      ,'#LOGIN_USER#'--&lt;CREUSR, varchar(30),&gt;
      ,''--&lt;UPDUSR, varchar(30),&gt;
      ,GETDATE()--&lt;CRETIM, datetime,&gt;
      ,''--&lt;UPDTIM, datetime,&gt;'
FROM   QAGRADEELE
WHERE  GRDCOD = @GRDCOD
   AND CUSCOD=''
ORDER  BY ELESEQ</SQLClear>
