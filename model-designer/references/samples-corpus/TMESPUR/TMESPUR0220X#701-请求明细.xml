  <SQLScript>SELECT CONVERT(VARCHAR(10),L.REQDAT,21) REQDAT
      ,L.QTY 
      ,L.UOM
      ,L.SRCDOC
      ,L.SRCLIN
      ,H.DEPT
      ,ISNULL(D.DEPTNAM,'')    DEPTDES
      ,ISNULL(D.DEPTNAM1,'')   DEPTDES1
      ,ISNULL(D.DEPTNAM2,'')   DEPTDES2
FROM PINQUL L
LEFT JOIN PREQUH H
              ON H.DOCNUM = L.SRCDOC
LEFT JOIN ENTDEPT D
              ON H.DEPT = D.DEPT
WHERE L.DOCNUM='#DOCNUM#' 
      AND L.ITMNO='#ITMNO#'
      AND L.ITMVER='#ITMVER#'
      AND L.SRCDOC+CAST(L.SRCLIN AS VARCHAR)+CAST(L.QTY AS VARCHAR)+L.UOM+CONVERT(VARCHAR(10),L.REQDAT,21) LIKE '%{0}%'</SQLScript>
