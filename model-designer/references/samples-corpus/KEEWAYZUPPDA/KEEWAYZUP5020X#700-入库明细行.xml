  <SQLScript>SELECT 
 XWS.SERNUM_0 车架码
,XWS.XTXT_0 电池码  
,XWS.XTXT_1 电机码
,XWS.LOC_0 库位
,XWS.CUSERID_0 操作人
,CONVERT(VARCHAR(16),XWS.CREDATIM_0,21) 操作时间
,XWS.RPNUM_0 入库单号
,XWS.USERID_0 入库人
,CASE WHEN CONVERT(VARCHAR(16),XWS.RPDATIM_0,21)='1900-01-01'  THEN '' ELSE CONVERT(VARCHAR(16),XWS.RPDATIM_0,21) END 入库时间
,XWS.ROWID LINKROWID
,CASE WHEN XWS.RPNUM_0&lt;&gt;'' THEN 'H02' ELSE '' END LINKAPPRROW
,XWS.MFGNUM_0  pid
FROM XWSMKI XWS
INNER JOIN ITMMASTER ITM
ON XWS.ITMREF_0=ITM.ITMREF_0
WHERE XWS.STAT_0=9
ORDER BY XWS.ROWID DESC</SQLScript>
