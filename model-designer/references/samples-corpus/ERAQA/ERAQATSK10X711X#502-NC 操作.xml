  <SQLClear>--LINKREFRESH
DECLARE @DOCNUM VARCHAR(30) = '{0}'
DECLARE @OPENUM VARCHAR(30) = '{1}'
DECLARE @NCTYP VARCHAR(30) = '{2}'
DECLARE @REMARK NVARCHAR(100) = N'{3}'
DECLARE @VALLIN INT = 0#LINKROWIDVALLIN#
DECLARE @TRXLIN INT = 0#TRXLIN#
DECLARE @USER VARCHAR(30) = '#LOGIN_USER#'

UPDATE QAINSPVAL SET NCTYP=@NCTYP
                   , NCUSR=@USER
                   , NCTIM=GETDATE()
                   , REMARK=REMARK + ' '+ @REMARK
WHERE DOCNUM = @DOCNUM
    AND OPENUM = @OPENUM
    AND VALLIN = @VALLIN
    AND TRXLIN = @TRXLIN;

IF @NCTYP IN('Redo','Retake')
BEGIN
-- 生成重检顺序号
DECLARE @NTRXLIN INT

SELECT @NTRXLIN = MAX(TRXLIN) + 1
FROM QAINSPVAL
WHERE DOCNUM = @DOCNUM
    AND OPENUM = @OPENUM
    AND VALLIN = @VALLIN

INSERT INTO QAINSPVAL (
      [DOCNUM]
    , [OPENUM]
    , [VALLIN]
    , [TRXLIN]
    , [SPOOL]
    , [COIL]
    , [SAMP]
    , [N1]
    , [N2]
    , [N3]
    , [N4]
    , [N5]
    , [N6]
    , [N7]
    , [N8]
    , [CREUSR]
    , [CRETIM]
    )
SELECT [DOCNUM]
    , [OPENUM]
    , [VALLIN]
    , @NTRXLIN TRXLIN
    , [SPOOL]
    , [COIL]
    , [SAMP]
    , [N1]
    , [N2]
    , [N3]
    , [N4]
    , [N5]
    , [N6]
    , [N7]
    , [N8]
    , @USER [CREUSR]
    , getdate() [CRETIM]
FROM QAINSPVAL V
WHERE V.DOCNUM = @DOCNUM
    AND V.OPENUM = @OPENUM
    AND V.VALLIN = @VALLIN
    AND V.TRXLIN = @TRXLIN;
END;

EXECUTE [SP_INSPVAL_NCHECK] 
   @DOCNUM
  ,@OPENUM
  ,@VALLIN
  ,@TRXLIN;</SQLClear>
