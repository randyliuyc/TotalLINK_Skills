  <SQLScript>SELECT S.DOCNUM+CAST(S.DOCLIN AS VARCHAR) DOCKEY
      ,S.DOCNUM SRCDOC
      ,S.DOCTYP SRCTYP
      ,CONVERT(VARCHAR(20), H.DOCDAT, 23)          DOCDAT
      ,H.DOCDES
      ,H.BPSNO
      ,BPS.BPSNAM
      ,S.DOCLIN SRCLIN
      ,S.ITMNO
      ,S.ITMVER
      ,M1.ITMNAM
      ,S.LOC
      ,S.LOT
      ,S.BPSLOT
      ,S.STA
      ,CAST(S.QTY - S.PRTQTY AS REAL)              QTY
      ,CAST(S.QTY AS REAL)                         PRCQTY
      ,CAST(S.PRTQTY AS REAL) PRTQTY
      ,S.UOM
      ,S.REMARK
      ,S.SRCTYP ORITYP
      ,S.SRCDOC ORIDOC
      ,S.SRCLIN ORILIN
FROM   PRECLIN S
       INNER JOIN ITM M1
               ON M1.ITMNO = S.ITMNO
       INNER JOIN PRECEIPT H
               ON S.DOCNUM = H.DOCNUM
       LEFT JOIN BPSUP BPS
              ON BPS.BPSNO = H.BPSNO
WHERE  S.QTY - S.PRTQTY &gt; 0
       AND H.SITE='{0}'
       AND H.BPSNO='{1}'
       AND S.ITMNO + S.ITMVER + M1.ITMNAM+S.DOCNUM+S.SRCDOC LIKE '%{2}%'
ORDER  BY S.DOCNUM
          ,S.DOCLIN DESC</SQLScript>
