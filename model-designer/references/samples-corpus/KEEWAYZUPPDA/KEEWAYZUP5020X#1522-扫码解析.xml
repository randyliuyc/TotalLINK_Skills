  <SQLScript>--更新语句用于处理ERP删除了入库单的情况
DECLARE @SERNUM NVARCHAR(30)=N'{0}';
UPDATE XWSMKI SET RPNUM_0='',RPFLG_0=1,STAT_0=1,RPNOTE_0=''
FROM XWSMKI XWS
LEFT JOIN MFGITMTRK TRK
ON XWS.RPNUM_0=TRK.MFGTRKNUM_0
WHERE XWS.SERNUM_0=@SERNUM  AND TRK.MFGTRKNUM_0 IS NULL AND XWS.STAT_0=2;

SELECT 
 XWS.MFGFCY_0 生产地点
,XWS.MFGNUM_0 工单编号
,XWS.ITMREF_0 产品编码
,ITM.ITMDES1_0 产品名称
,R.ZPLANNUM_0 生产计划号
,XWS.SERNUM_0 车架码
,XWS.XTXT_0   电池码
,XWS.XTXT_1   电机码
--,XWS.LOC_0 入库库位
,CASE WHEN XWS.STAT_0=9 THEN N'该车架码：'+XWS.SERNUM_0+N'已扫描'
  WHEN XWS.RPFLG_0=3 THEN N'该车架码：'+XWS.SERNUM_0+N'已入库'
  WHEN XWS.STAT_0=2 AND RPFLG_0&lt;&gt;3 THEN N'未提交成功' ELSE '' END 数据检查
FROM XWSMKI XWS
INNER JOIN ITMMASTER ITM
ON XWS.ITMREF_0=ITM.ITMREF_0
INNER JOIN MFGITM MFG
ON MFG.MFGNUM_0=XWS.MFGNUM_0
 AND MFG.ITMREF_0=XWS.ITMREF_0
LEFT JOIN SORDER R
ON R.SOHNUM_0=MFG.VCRNUMORI_0
WHERE XWS.SERNUM_0=@SERNUM  AND XWS.RPFLG_0&lt;&gt;3</SQLScript>
