  <SQLScript>--LINKLOADDATAIMMEDIATE
--处理[QAROULINCTL]的数据
SELECT [ROUCOD]
       ,[OPENUM]
       ,CONCAT ([VALTYP], [VALLIN]) CTLNAM
       ,[VALDES]
       ,[VALCTL]
INTO   #QARPRODATA
FROM   [QAROULINCTL]

--转至[VALDES]
SELECT [ROUCOD]
       ,[OPENUM]
       ,[L1]  [L1_DES]
       ,[L2]  [L2_DES]
       ,[N1]  [N1_DES]
       ,[N2]  [N2_DES]
       ,[N3]  [N3_DES]
       ,[N4]  [N4_DES]
       ,[N5]  [N5_DES]
       ,[N6]  [N6_DES]
       ,[N7]  [N7_DES]
       ,[N8]  [N8_DES]
       ,[P1]  [P1_DES]
       ,[P2]  [P2_DES]
       ,[P3]  [P3_DES]
       ,[P4]  [P4_DES]
       ,[P5]  [P5_DES]
INTO   #VALDES_PIVOT
FROM   (SELECT [ROUCOD]
               ,[OPENUM]
               ,CTLNAM
               ,[VALDES]
        FROM   #QARPRODATA) AS SourceTable
       PIVOT(MAX(VALDES)
            FOR CTLNAM IN (
                            [L1]
                           ,[L2]
                           ,[N1]
                           ,[N2]
                           ,[N3]
                           ,[N4]
                           ,[N5]
                           ,[N6]
                           ,[N7]
                           ,[N8]
                           ,[P1]
                           ,[P2]
                           ,[P3]
                           ,[P4]
                           ,[P5])) AS PivotTable;

--转至[VALCTL]
SELECT [ROUCOD]
       ,[OPENUM]
       ,[L1]  [L1_CTL]
       ,[L2]  [L2_CTL]
       ,[N1]  [N1_CTL]
       ,[N2]  [N2_CTL]
       ,[N3]  [N3_CTL]
       ,[N4]  [N4_CTL]
       ,[N5]  [N5_CTL]
       ,[N6]  [N6_CTL]
       ,[N7]  [N7_CTL]
       ,[N8]  [N8_CTL]
       ,[P1]  [P1_CTL]
       ,[P2]  [P2_CTL]
       ,[P3]  [P3_CTL]
       ,[P4]  [P4_CTL]
       ,[P5]  [P5_CTL]
INTO   #VALCTL_PIVOT
FROM   (SELECT [ROUCOD]
               ,[OPENUM]
               ,CTLNAM
               ,[VALCTL]
        FROM   #QARPRODATA) AS SourceTable
       PIVOT(MAX(VALCTL)
            FOR CTLNAM IN ( [L1]
                           ,[L2]
                           ,[N1]
                           ,[N2]
                           ,[N3]
                           ,[N4]
                           ,[N5]
                           ,[N6]
                           ,[N7]
                           ,[N8]
                           ,[P1]
                           ,[P2]
                           ,[P3]
                           ,[P4]
                           ,[P5])) AS PivotTable;

 --实际查询
SELECT U.[ROUCOD]
       ,U.[ITMNO]
       ,U.[ROUALT]
       ,U.[ROUOPE]
       ,U.[CUSCOD]
       ,U.[INTSPEC]
       ,N.[OPENUM]
       ,N.[OPESTD]
       ,N.[OPEGRP]
       ,STD.[OPEDES1]
       ,STD.[OPEDES2]
       ,STD.[INSTRUCTION]
       ,N.[OPEUNT]
       ,N.[CTLTYP]
       ,N.[MEAFRQ]
       ,N.[INSTCAT]
       ,N.[INSTCOD]
       ,CAST(N.[VALNOR] AS decimal(18,3))   [VALNOR]
       ,CAST(N.[VALMIN]	AS decimal(18,3))  [VALMIN]
       ,CAST(N.[VALMAX]	AS decimal(18,3))  [VALMAX]
       ,N.[USERFLG]
       ,N.[DATEFLG]
       ,N.[INSTFLG]
       ,N.[QTYOKFLG]
       ,N.[QTYSCFLG]
       ,N.[REASCFLG]
       ,D.[N1_DES]
       ,C.[N1_CTL]
       ,D.[N2_DES]
       ,C.[N2_CTL]
       ,D.[N3_DES]
       ,C.[N3_CTL]
       ,D.[N4_DES]
       ,C.[N4_CTL]
       ,D.[N5_DES]
       ,C.[N5_CTL]
       ,D.[N6_DES]
       ,C.[N6_CTL]
       ,D.[N7_DES]
       ,C.[N7_CTL]
       ,D.[N8_DES]
       ,C.[N8_CTL]
       ,C.[L1_CTL]
       ,C.[L2_CTL]
       ,D.[P1_DES]
       ,C.[P1_CTL]
       ,D.[P2_DES]
       ,C.[P2_CTL]
       ,D.[P3_DES]
       ,C.[P3_CTL]
       ,D.[P4_DES]
       ,C.[P4_CTL]
       ,D.[P5_DES]
       ,C.[P5_CTL]
       ,U.[CREUSR]
       ,U.[UPDUSR]
       ,CONVERT(VARCHAR(16),U.[CRETIM],21)  [CRETIM]
       ,CONVERT(VARCHAR(16),U.[UPDTIM],21)  [UPDTIM]
FROM   [QAROU] U
       INNER JOIN [QAROULIN] N
              ON U.ROUCOD = N.ROUCOD
       INNER JOIN QAOPESTD STD
       ON N.OPESTD=STD.OPESTD
       INNER JOIN #VALDES_PIVOT D
               ON N.ROUCOD = D.ROUCOD
                  AND N.[OPENUM] = D.[OPENUM]
       INNER JOIN #VALCTL_PIVOT C
               ON N.ROUCOD = C.ROUCOD
                  AND N.[OPENUM] = C.[OPENUM]
WHERE  U.[ROUTYP] = 'SFC'
ORDER BY U.[ROUCOD],D.[OPENUM]


--清除临时表
DROP TABLE #QARPRODATA
DROP TABLE #VALDES_PIVOT;
DROP TABLE #VALCTL_PIVOT;</SQLScript>
