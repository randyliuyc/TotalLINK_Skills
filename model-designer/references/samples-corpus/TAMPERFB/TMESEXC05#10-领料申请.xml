  <SQLUpdateScript>--LINKADDNEWROWS
--LINKAUTOREPLACEEMPTYCOLUMNS
MERGE
INTO
[PREQUH] D
		USING (
	SELECT
 N'@DOCNUM@' DOCNUM
,N'@DOCGRP@' DOCGRP
,N'1' DOCSTA
,N'SAVED' WFLSTA
,N'@WFRULE@' WFRULE
,N'@DOCDAT@' DOCDAT
,N'@DOCDES@' DOCDES
,N'@PRJNUM@' PRJNUM
,N'@SITE@' SITE
,N'@FAC@' FAC
,N'@DEPT@' DEPT
,N'@GRP@' GRP
,N'@RESNO@' RESNO
,N'@REMARK@' REMARK
,N'@CLOREA@' CLOREA
, N'#LOGIN_USER#' CREUSR
, GETDATE() CRETIM
	  ) S ON
	(S.[DOCNUM] = D.[DOCNUM])
	WHEN MATCHED THEN
UPDATE
SET 
 DOCNUM = S.DOCNUM
,DOCGRP = S.DOCGRP
,DOCDAT = S.DOCDAT
,DOCDES = S.DOCDES
,PRJNUM = S.PRJNUM
,SITE = S.SITE
,FAC = S.FAC
,DEPT = S.DEPT
,GRP = S.GRP
,RESNO = S.RESNO
,REMARK = S.REMARK
,CLOREA = S.CLOREA
,WFRULE = S.WFRULE
,UPDUSR='#LOGIN_USER#'
,UPDTIM=GETDATE()
WHEN NOT MATCHED THEN
INSERT
(DOCNUM
,DOCGRP
,DOCSTA
,WFLSTA
,DOCDAT
,DOCDES
,PRJNUM
,SITE
,FAC
,DEPT
,GRP
,RESNO
,REMARK
,WFRULE
,CLOREA
,CREUSR
,CRETIM
)
VALUES (
S.DOCNUM
,S.DOCGRP
,S.DOCSTA
,S.WFLSTA
,S.DOCDAT
,S.DOCDES
,S.PRJNUM
,S.SITE
,S.FAC
,S.DEPT
,S.GRP
,S.RESNO
,S.REMARK
,S.WFRULE
,S.CLOREA
,S.CREUSR
,S.CRETIM
);</SQLUpdateScript>
