  <ModelDesc>关联采购计划</ModelDesc>
  <KeyWords />
  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>--LINKDATAMINEOVERVIEW,,30,AUTOREFRESH
DECLARE @CUSORDREF VARCHAR(30) = '%{0}%';
DECLARE @SOHNUM VARCHAR(30) = '%{1}%';

SELECT S.SOHNUM_0 销售订单
      ,S.CUSORDREF_0 订单参考
      ,CONVERT(VARCHAR(16), S.ORDDAT_0, 23) 订单日期
      ,S.BPCINV_0 发票客户
FROM   SORDER S
       LEFT JOIN (SELECT DISTINCT XREFSOH_0
                  FROM   PORDERQ
                  WHERE  POHFCY_0 = 'ZUPK'
                       AND XREFSOH_0&lt;&gt;'')P
              ON S.SOHNUM_0 = P.XREFSOH_0
WHERE  S.SALFCY_0 = 'ZJKC' --仅是浙江凯驰
       AND S.BPCORD_0 = 'DE01' --订单客户是德国ZUP
    --   AND S.APPFLG_0 IN( 3, 4, 5 )--审核通过的
      AND P.XREFSOH_0 IS NULL --排除已经生成的订单
       AND UPPER(S.CUSORDREF_0) LIKE UPPER(@CUSORDREF)
       AND UPPER(S.SOHNUM_0) LIKE UPPER(@SOHNUM)
ORDER  BY S.SOHNUM_0</SQLScript>
