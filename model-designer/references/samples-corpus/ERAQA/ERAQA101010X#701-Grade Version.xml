  <SQLNew>--LINKADDNEWROWS
DECLARE @GRDCOD VARCHAR(30)='{0}';
DECLARE @CUSCOD VARCHAR(30)='{1}';
INSERT INTO [QAGRADEVER]
           ([GRDCOD]
           ,[CUSCOD]
           ,[VER]
           ,[VERDAT]
           ,[VERBY]
           ,[VERDESC]
           ,[CREUSR]
           ,[UPDUSR]
           ,[CRETIM]
           ,[UPDTIM])
     VALUES
           (
	    @GRDCOD--&lt;GRDCOD, varchar(30),&gt;
           ,@CUSCOD--&lt;CUSCOD, varchar(30),&gt;
           ,'#VER#'--&lt;VER, varchar(30),&gt;
           ,GETDATE()--&lt;VERDAT, date,&gt;
           ,'#LOGIN_USER#'--&lt;VERBY, varchar(30),&gt;
           ,'#LINKTEXTVERDESC#'--&lt;VERDESC, nvarchar(100),&gt;
           ,'#LOGIN_USER#'--&lt;CREUSR, varchar(30),&gt;
           ,''--&lt;UPDUSR, varchar(30),&gt;
           ,GETDATE()--&lt;CRETIM, datetime,&gt;
           ,''--&lt;UPDTIM, datetime,&gt;
	   )</SQLNew>
