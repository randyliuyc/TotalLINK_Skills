  <SQLScript>SELECT S.ITMREF_0  产品编码
	 -- ,LEFT(S.PKORI_0,CHARINDEX('-', S.PKORI_0) - 1)  工单号
      ,LEFT(S.NOTE_3, NULLIF(PATINDEX('%[- ]%', S.NOTE_3), 0) - 1)  工单号
	  ,ISNULL(AX1.TEXTE_0,ITMDES1_0)  产品描述1
	  ,ISNULL(AX2.TEXTE_0,ITMDES2_0)  产品描述2
	  ,ITM.YMDDES_0 产品备注 
	  ,ITM.EANCOD_0  
 	  ,ISNULL(NULLIF(S.NOTE_3, ''), S.ITMREF_0) AS 序列号
FROM   XWSSCS S
INNER JOIN ITMMASTER  ITM
ON ITM.ITMREF_0 = S.ITMREF_0
LEFT JOIN ATEXTRA AX1 ON AX1.IDENT1_0=ITM.ITMREF_0 AND AX1.CODFIC_0='ITMMASTER' AND AX1.ZONE_0='DES1AXX' AND AX1.LANGUE_0='GER'
LEFT JOIN ATEXTRA AX2 ON AX2.IDENT1_0=ITM.ITMREF_0 AND AX2.CODFIC_0='ITMMASTER' AND AX2.ZONE_0='DES2AXX' AND AX2.LANGUE_0='GER'
WHERE '{0}'&lt;&gt; '' AND (S.NOTE_3='{0}' OR  S.PK_0 ='{0}')
ORDER  BY S.CREDATIM_0</SQLScript>
