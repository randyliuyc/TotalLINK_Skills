  <SQLScript>DECLARE @BAT VARCHAR(50) = '{0}'

SELECT YZUPILIN_0
  , YZUPIDAT_0
  , MRNPOSNO_0
  , INVNUM_0
  , IIF(INVDAT_0 = '1900-01-01', NULL, INVDAT_0) INVDAT_0
  , LOT_0
  , KNCODE_0
  , ITMDES_0
  , ITMREF_0
  , CAST(IMPQTY_0 AS INT) IMPQTY_0
  , IIF(FINDAT_0 = '', NULL, FINDAT_0) FINDAT_0
  , CAST(MERGQ_0 AS INT) MERGQ_0
  , ZOLLWERT_0
  , ADRAT_0
  , SPRAT_0
  , ATSNO_0
  , SDHNUM_0
  , SDDLIN_0
  , ROWID LINKROWID
FROM YZUPCUI
WHERE YZUPIBAT_0 = @BAT
ORDER BY YZUPILIN_0</SQLScript>
