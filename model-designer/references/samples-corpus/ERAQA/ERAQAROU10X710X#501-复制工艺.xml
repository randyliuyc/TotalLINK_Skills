  <SQLClear>--LINKREFRESH
DECLARE @ROUCOD VARCHAR(30) = '{0}';
DECLARE @COPYROUCOD VARCHAR(30) = '{1}';

UPDATE [QAROU] SET COPYROU=@COPYROUCOD 
WHERE ROUCOD=@ROUCOD 

DELETE FROM  [QAROULIN]  WHERE [ROUCOD]=@ROUCOD
INSERT INTO [QAROULIN]
           ([ROUCOD]
           ,[OPENUM]
           ,[OPESTD]
           ,[OPEGRP]
           ,[OPEUNT]
           ,[CTLTYP]
           ,[MEAFRQ]
           ,[INSTCAT]
           ,[INSTCOD]
           ,[VALNOR]
           ,[VALMIN]
           ,[VALMAX]
           ,[USERFLG]
           ,[DATEFLG]
           ,[INSTFLG]
           ,[QTYOKFLG]
           ,[QTYSCFLG]
           ,[REASCFLG]
           ,[CREUSR]
           ,[CRETIM]
)
SELECT      @ROUCOD  [ROUCOD]
           ,S.[OPENUM]
           ,S.[OPESTD]
           ,S.[OPEGRP]
           ,S.[OPEUNT]
           ,S.[CTLTYP]
           ,S.[MEAFRQ]
           ,S.[INSTCAT]
           ,S.[INSTCOD]
           ,S.[VALNOR]
           ,S.[VALMIN]
           ,S.[VALMAX]
           ,S.[USERFLG]
           ,S.[DATEFLG]
           ,S.[INSTFLG]
           ,S.[QTYOKFLG]
           ,S.[QTYSCFLG]
           ,S.[REASCFLG]
           ,N'#LOGIN_USER#'  [CREUSR]
           ,GETDATE()        [CRETIM]
FROM  [QAROULIN]  S
WHERE S.[ROUCOD]=@COPYROUCOD

DELETE FROM  [QAROULINCTL]  WHERE [ROUCOD]=@ROUCOD
INSERT INTO [QAROULINCTL]
           ([ROUCOD]
           ,[OPENUM]
           ,[VALTYP]
           ,[VALLIN]
           ,[VALDES]
           ,[VALCTL]
           ,[CREUSR]
           ,[CRETIM])
SELECT      @ROUCOD  [ROUCOD]
           ,[OPENUM]
           ,[VALTYP]
           ,[VALLIN]
           ,[VALDES]
           ,[VALCTL]
           ,N'#LOGIN_USER#'  [CREUSR]
           ,GETDATE()        [CRETIM]
FROM [QAROULINCTL]  S
WHERE S.[ROUCOD]=@COPYROUCOD</SQLClear>
