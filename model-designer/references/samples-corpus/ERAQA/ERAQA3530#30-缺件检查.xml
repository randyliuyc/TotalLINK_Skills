  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>--LINKAPPMENUHIDE
DECLARE @DOCNUM VARCHAR(30)='MFG24100102-65';
DECLARE @OPENUM INT=0140;
DECLARE @INSTCOD VARCHAR(30)='';

DECLARE @ROUCOD VARCHAR(30);

SELECT @ROUCOD = ROUCOD
FROM QAINSPH
WHERE DOCNUM = @DOCNUM;;

UPDATE QAINSPL
SET INSTCOD = @INSTCOD
WHERE DOCNUM = @DOCNUM
    AND OPENUM = @OPENUM;

IF OBJECT_ID(N'tempdb..#TCC') IS NOT NULL
    DROP TABLE #TCC;

WITH CTE_TC
AS (
    SELECT CONCAT (
            'T'
            , VALTYP
            , VALLIN
            ) TC
        , VALDES
    FROM QAROULINCTL
    WHERE ROUCOD = @ROUCOD
        AND OPENUM = @OPENUM
        AND VALTYP IN ('L', 'N')
    
    UNION ALL
    
    SELECT CONCAT (
            'F'
            , VALTYP
            , VALLIN
            ) TC
        , IIF(VALDES = '', 'mui-hidden', '') VALDES
    FROM QAROULINCTL
    WHERE ROUCOD = @ROUCOD
        AND OPENUM = @OPENUM
        AND VALTYP IN ('L', 'N')
    )
SELECT *
INTO #TCC
FROM (
    SELECT *
    FROM CTE_TC
    ) AS SourceTable
PIVOT(MAX(VALDES) FOR TC IN (
            TN1, TN2, TN3, TN4, TN5, TN6, TN7, TN8, TL1, TL2, --
            FN1, FN2, FN3, FN4, FN5, FN6, FN7, FN8, FL1, FL2
            )) AS PivotTable;

SELECT CASE WHEN D.OPEDES2 = '自行车 / 缺件检查' THEN 'lang:{zh:自行车 / 缺件检查,de:Fahrrad / Prüfung auf fehlende Teile}' END  OPEDES2
    , L.MEAFRQ
    , L.CTLTYP
    , L.INSTCOD
    , CASE WHEN S.SPOOL + S.COIL + S.SAMP = '脚蹬' THEN 'lang:{zh:脚蹬,de:Pedal}'
           WHEN S.SPOOL + S.COIL + S.SAMP = '电池' THEN 'lang:{zh:电池,de:Batterie}' 
           WHEN S.SPOOL + S.COIL + S.SAMP = '仪表' THEN 'lang:{zh:仪表,de:Anzeige}' 
           WHEN S.SPOOL + S.COIL + S.SAMP = '充电器' THEN 'lang:{zh:充电器,de:Ladegerät}' 
           WHEN S.SPOOL + S.COIL + S.SAMP = '钥匙' THEN 'lang:{zh:钥匙,de:Schlüssel}' 
           WHEN S.SPOOL + S.COIL + S.SAMP = '说明书' THEN 'lang:{zh:说明书,de:Bedienungsanleitung}' 
           WHEN S.SPOOL + S.COIL + S.SAMP = '车铃' THEN 'lang:{zh:车铃,de:Fahrradklingel}' 
           WHEN S.SPOOL + S.COIL + S.SAMP = '灯具' THEN 'lang:{zh:灯具,de:Beleuchtung}' 
           WHEN S.SPOOL + S.COIL + S.SAMP = '前篮' THEN 'lang:{zh:前篮,de:Vorderkorb}' 
           WHEN S.SPOOL + S.COIL + S.SAMP = '后货架' THEN 'lang:{zh:后货架,de:Gepäckträger hinten}' 
           WHEN S.SPOOL + S.COIL + S.SAMP = '工具包' THEN 'lang:{zh:工具包,de:Werkzeugtasche}' 
           END QAITM
    , CAST(S.N1 AS DECIMAL(18, 3)) N1
    , CAST(S.N2 AS DECIMAL(18, 3)) N2
    , CAST(S.N3 AS DECIMAL(18, 3)) N3
    , CAST(S.N4 AS DECIMAL(18, 3)) N4
    , CAST(S.N5 AS DECIMAL(18, 3)) N5
    , CAST(S.N6 AS DECIMAL(18, 3)) N6
    , CAST(S.N7 AS DECIMAL(18, 3)) N7
    , CAST(S.N8 AS DECIMAL(18, 3)) N8
    , IIF(S.L1=1,'True','False') L1
    , IIF(S.L2=1,'True','False') L2
    , S.REMARK
    , CASE 
        WHEN L.CTLTYP = 'N'
            THEN REPLACE(CONCAT_WS('/', CAST(S.N1 AS DECIMAL(18, 3)), CAST(S.N2 AS DECIMAL(18, 3)), --
                        CAST(S.N3 AS DECIMAL(18, 3)), CAST(S.N4 AS DECIMAL(18, 3)), --
                        CAST(S.N5 AS DECIMAL(18, 3)), CAST(S.N6 AS DECIMAL(18, 3)), --
                        CAST(S.N7 AS DECIMAL(18, 3)), CAST(S.N8 AS DECIMAL(18, 3))), '/0.000', '')
        ELSE (
                IIF(S.L1 = 1, 'OK', 'NOK') + CASE 
                    WHEN L.L2CHECK = 1
                        AND S.L2 = 1
                        THEN '/OK'
                    WHEN L.L2CHECK = 1
                        AND S.L2 = 0
                        THEN '/NOK'
                    ELSE ''
                    END
                )
        END QAVAL
    , S.ID QAID
    , IIF(L.CTLTYP = 'N', '501', '502') QABUT
    , S.DOCNUM
    , S.OPENUM
    , S.VALLIN
    , IIF(L.CTLTYP = 'N', CAST(CAST(L.NMIN AS DECIMAL(18, 3)) AS VARCHAR) + '~' --
        + CAST(CAST(L.NMAX AS DECIMAL(18, 3)) AS VARCHAR), '') MINMAX
    , C.*
    , CASE 
        WHEN S.STA = 1
            THEN 'H03'
        WHEN S.STA = 0
            AND S.N1 + CAST(S.L1 AS INT) &lt;&gt; 0
            THEN 'D03'
        ELSE 'C02'
        END LINKAPPRROW
    ,S.STA
FROM QAINSPVAL S
INNER JOIN QAINSPL L
    ON S.DOCNUM = L.DOCNUM
        AND S.OPENUM = L.OPENUM
INNER JOIN QAINSPH H
    ON H.DOCNUM = S.DOCNUM
INNER JOIN QAOPESTD D
    ON L.OPESTD = D.OPESTD
INNER JOIN #TCC C
    ON 1 = 1
WHERE S.DOCNUM = @DOCNUM
    AND S.OPENUM = @OPENUM

IF OBJECT_ID(N'tempdb..#TCC') IS NOT NULL
    DROP TABLE #TCC;</SQLScript>
