  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>DECLARE @INSTCAT VARCHAR(30)='%{0}%';
DECLARE @INSTCOD VARCHAR(30)='%{1}%';
DECLARE @INSTDES VARCHAR(100)='%{2}%';
DECLARE @BRAND VARCHAR(30)='%{3}%';

SELECT S.[INSTCOD]
      ,S.[INSTCAT]   
      ,S.[INSTNAM]
      ,Q.ROUCOD
      ,S.[BRAND]
      ,S.[INTCTLPRD] 
      ,IIF(S.[INTCTLFROM]='1900-01-01',NULL,S.[INTCTLFROM]) INTCTLFROM
      ,IIF(S.[INTCTLTO]='1900-01-01',NULL,S.[INTCTLTO]) INTCTLTO
      ,S.[INTCTLDAYS]
      ,S.[INTCTLSTD]
      ,S.[CLBPRD]  
      ,S.[CLBSTD]
      ,IIF(S.[CLBCTLFROM]='1900-01-01',NULL,S.[CLBCTLFROM]) CLBCTLFROM
      ,IIF(S.[CLBCTLTO]='1900-01-01',NULL,S.[CLBCTLTO]) CLBCTLTO
      ,S.[CLBDAYS]
      ,S.[INSTSTA] 
      ,S.[MODEL]
      ,S.[SERNUM]
      ,S.[LOC]
      ,S.[INSTDES]
      ,S.[INSTRNG]
      ,S.[RESPONS]
  FROM [QAINSTLST] S
  LEFT JOIN QAROU Q
ON 'INE-'+S.INSTCOD = Q.ROUCOD
WHERE S.INSTCAT LIKE @INSTCAT
  AND S.INSTCOD LIKE @INSTCOD
  AND S.INSTDES LIKE @INSTDES
  AND S.BRAND LIKE @BRAND
ORDER BY S.INSTCOD</SQLScript>
