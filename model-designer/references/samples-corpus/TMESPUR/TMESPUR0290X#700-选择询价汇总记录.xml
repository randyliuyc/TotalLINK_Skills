  <ModelDesc>选择询价汇总记录</ModelDesc>
  <KeyWords />
  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>DECLARE @DOCNUM VARCHAR(30) = '{0}';
DECLARE @BPSNO VARCHAR(30) = '{1}';
DECLARE @ITMDES NVARCHAR(30) = N'%{2}%';

SELECT L.DOCNUM --询价单号
      ,L.DOCLIN --询价行号
      ,L.ITMNO --产品编码
      ,ITM.ITMNAM
      ,ITM.ITMNAM1
      ,ITM.ITMNAM2
      ,ITM.ITMSPEC
      ,ITM.ITMSIZE
      ,L.ITMVER --产品版本
      ,L.UOM --库存单位
      ,L.QTY --采购单位数量
      ,L.STU
      ,L.UOMCOE
      ,L.QTYSTU
      ,CONVERT(VARCHAR(16), L.REQDAT, 23)   REQDAT
      ,L.DOCNUM + CAST(L.DOCLIN AS VARCHAR) LINKROWID
      ,ITM.IVATTYP
      ,BPS.BVATTYP
      ,BPS.CUR
      ,BPS.BPSNO
      ,BPS.BPSNAM
      ,MS.BPSITMNO
      ,MS.BPSITMNAM
      ,(SELECT TOP 1 PRI
         FROM   PRILIST
         WHERE  PRICD1 = L.ITMNO
                AND PRICD2 = @BPSNO
                AND GETDATE() BETWEEN STRDAT AND ENDDAT
         ORDER  BY CRETIM)                  NETPRI
      ,L.REMARK
FROM   PINQUL L
       LEFT JOIN ITM
              ON ITM.ITMNO = L.ITMNO
       LEFT JOIN BPSUP BPS
              ON BPS.BPSNO = @BPSNO
       LEFT JOIN(SELECT DOCNUM
                       ,DOCLIN
                 FROM   PINQUS
                 WHERE  BPSNO = @BPSNO
                 GROUP  BY DOCNUM
                           ,DOCLIN)S
              ON L.DOCNUM = S.DOCNUM
                 AND L.DOCLIN = S.DOCLIN
       LEFT JOIN ITMBPS MS
              ON MS.ITMNO = L.ITMNO
                 AND MS.BPSNO = BPS.BPSNO
WHERE  L.[DOCNUM] = @DOCNUM
       AND ITM.ITMNAM + ITM.ITMNAM1 + ITM.ITMSPEC
           + ITM.ITMSIZE LIKE @ITMDES
       AND S.DOCNUM IS NULL</SQLScript>
