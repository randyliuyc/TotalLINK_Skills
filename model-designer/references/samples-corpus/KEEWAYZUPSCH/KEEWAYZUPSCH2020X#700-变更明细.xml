  <SQLScript>DECLARE @SOHNUM VARCHAR(30) = '{0}';
DECLARE @LANX3 VARCHAR(30) = '#LINKFUNC.GETLANX3#';
-- 获取订单的发货方式
DECLARE @MDL VARCHAR(50);

SELECT TOP 1 @MDL = MDL_0
FROM SORDER
WHERE SOHNUM_0 = @SOHNUM;

WITH CTE_DEITM
AS (
  -- 海关监管产品对照编码，按ZJKC供应商产品编码对照
  SELECT ITMREFBPS_0 ITMREF_0
    , ITMREF_0 ITMREFBPC_0
  FROM ITMBPS
  WHERE BPSNUM_0 = 'ZJKC'
  )
  , SOHData
AS (
  SELECT Q.SOHNUM_0
    , Q.SOPLIN_0
    , Q.SOQSEQ_0
    -- 对照 Goccia 客户产品编码，如果没有则使用原产品编码
    , ISNULL(I.ITMREFBPC_0, Q.ITMREF_0) ITMREF_0
    , Q.QTY_0 AS QTYSTU_0
    , S.BPCINV_0 AS BPRNUM_0
    , Q.EXTDLVDAT_0 AS EXTDAT_0
    , CAST(IIF(Q.SOQSTA_0 = 3
        AND Q.ODLQTY_0 + Q.DLVQTY_0 = 0, 1, 0) AS BIT) SOQCLOSE
    , DATEADD(DAY, CASE @MDL
        WHEN 1
          THEN 50
        WHEN 2
          THEN 60
        WHEN 3
          THEN 10
        WHEN 4
          THEN 5
        WHEN 10
          THEN 30
        END, Q.EXTDLVDAT_0) EXTRCPDAT_0
  FROM SORDERQ Q
  INNER JOIN SORDER S
    ON Q.SOHNUM_0 = S.SOHNUM_0
  INNER JOIN SORDERP P
    ON Q.SOHNUM_0 = P.SOHNUM_0
      AND Q.SOPLIN_0 = P.SOPLIN_0
  LEFT JOIN CTE_DEITM I
    ON I.ITMREF_0 = Q.ITMREF_0
      -- 仅 SKT 的订单需要转换编码
      AND S.SOHTYP_0 = 'SKT'
  WHERE S.SALFCY_0 = 'ZJKC'
    AND S.BPCORD_0 = 'DE01'
    AND P.LINTYP_0 &lt;&gt; 6
    AND Q.SOHNUM_0 = @SOHNUM
  )
  , POHData
AS (
  SELECT Q.XREFSOH_0 AS SOHNUM_0
    , Q.XREFSLIN_0 AS SOPLIN_0
    , Q.XREFSSEQ_0 AS SOQSEQ_0
    , Q.ITMREF_0
    , Q.QTYSTU_0
    , Q.BPSNUM_0 AS BPRNUM_0
    , Q.EXTRCPDAT_0 AS EXTDAT_0
    , CAST(IIF(Q.LINCLEFLG_0 = 2 AND Q.RCPQTYSTU_0 = 0, 1, 0) AS BIT) POQCLOSE
  FROM PORDERQ Q
  WHERE Q.POHFCY_0 = 'ZUPK'
    AND Q.BPSNUM_0 IN ('JXTD', 'BPS00002', 'CN01', 'ZJKC') -- 兼容历史数据，先保留 CN01
    AND Q.XREFSOH_0 = @SOHNUM
  )
SELECT CASE 
    WHEN S.SOHNUM_0 IS NULL
      THEN N'lang:{zh:删除,en:Delete,de:Löschen}'
    WHEN P.SOHNUM_0 IS NULL
      THEN N'lang:{zh:新增,en:New,de:Neu}'
    WHEN ISNULL(S.QTYSTU_0, 0) &lt;&gt; ISNULL(P.QTYSTU_0, 0)
      THEN N'lang:{zh:数量不同,en:Quantity different,de:Menge unterschiedlich}'
    WHEN ISNULL(CONVERT(DATE, S.EXTRCPDAT_0), '1900-01-01') &lt;&gt; ISNULL(CONVERT(DATE, P.EXTDAT_0), 
        '1900-01-01')
      THEN N'lang:{zh:日期不同,en:Date different,de:Datum unterschiedlich}'
    WHEN ISNULL(S.SOQCLOSE, 0) &lt;&gt; ISNULL(P.POQCLOSE, 0)
      THEN N'lang:{zh:状态不同,en:Status different,de:Status unterschiedlich}'
    ELSE N''
    END AS 差异描述
  , S.SOPLIN_0 销售订单行
  , ISNULL(S.ITMREF_0, P.ITMREF_0) AS 产品编码
  , ISNULL(L1.ITMDES, ITM.ITMDES1_0) AS 产品描述1
  , ISNULL(L2.ITMDES, ITM.ITMDES2_0) AS 产品描述2
  , CAST(S.QTYSTU_0 AS REAL) 销售数量
  , CAST(P.QTYSTU_0 AS REAL) 采购数量
  , CONVERT(DATE, S.EXTDAT_0) 销售交期
  , CONVERT(DATE, S.EXTRCPDAT_0) 转采购交期
  , CONVERT(DATE, P.EXTDAT_0) 采购交期
  , S.SOQCLOSE 销售关闭
  , P.POQCLOSE 采购关闭
  , Q.POHNUM_0 采购订单
  , Q.POPLIN_0 采购行
  , CASE 
    WHEN S.SOHNUM_0 IS NULL
      THEN 'D07'
    WHEN P.SOHNUM_0 IS NULL
      THEN 'D05'
    WHEN ISNULL(S.QTYSTU_0, 0) &lt;&gt; ISNULL(P.QTYSTU_0, 0)
      THEN 'D03'
    WHEN ISNULL(CONVERT(DATE, S.EXTRCPDAT_0), '1900-01-01') &lt;&gt; ISNULL(CONVERT(DATE, P.EXTDAT_0), 
        '1900-01-01')
      THEN 'D02'
    WHEN ISNULL(S.SOQCLOSE, 0) &lt;&gt; ISNULL(P.POQCLOSE, 0)
      THEN 'D06'
    ELSE ''
    END AS LINKAPPRROW
FROM SOHData S
FULL JOIN POHData P
  ON S.SOHNUM_0 = P.SOHNUM_0
    AND S.SOPLIN_0 = P.SOPLIN_0
    AND S.SOQSEQ_0 = P.SOQSEQ_0
    AND S.ITMREF_0 = P.ITMREF_0
INNER JOIN ITMMASTER ITM
  ON ISNULL(S.ITMREF_0, P.ITMREF_0) = ITM.ITMREF_0
LEFT JOIN ITMLAN1 L1
  ON L1.ITMREF = ITM.ITMREF_0
    AND L1.LANX3 = @LANX3
LEFT JOIN ITMLAN2 L2
  ON L2.ITMREF = ITM.ITMREF_0
    AND L2.LANX3 = @LANX3
LEFT JOIN PORDERQ Q
  ON ISNULL(S.SOHNUM_0, P.SOHNUM_0) = Q.XREFSOH_0
    AND ISNULL(S.SOPLIN_0, P.SOPLIN_0) = Q.XREFSLIN_0
    AND ISNULL(S.SOQSEQ_0, P.SOQSEQ_0) = Q.XREFSSEQ_0
    AND ISNULL(S.ITMREF_0, P.ITMREF_0) = Q.ITMREF_0
-- WHERE P.SOHNUM_0 IS NULL
--   OR S.SOHNUM_0 IS NULL
--   OR S.ITMREF_0 &lt;&gt; P.ITMREF_0
--   OR ISNULL(S.QTYSTU_0, 0) &lt;&gt; ISNULL(P.QTYSTU_0, 0)
--   OR ISNULL(CONVERT(DATE, S.EXTRCPDAT_0), '1900-01-01') &lt;&gt; ISNULL(CONVERT(DATE, P.EXTDAT_0), '1900-01-01')
ORDER BY ISNULL(S.SOPLIN_0, P.SOPLIN_0);</SQLScript>
