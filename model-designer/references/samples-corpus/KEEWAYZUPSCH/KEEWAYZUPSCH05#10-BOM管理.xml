  <KeyWords />
  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>--LINKDATAMINEOVERVIEW,VERTICAL,50,AUTOREFRESH

DECLARE @FCY VARCHAR(30) = '{0}';
DECLARE @BOMTYP VARCHAR(30) = '{1}';
DECLARE @BOMALT INT=0{2};
DECLARE @ITMREF VARCHAR(30) = '%{3}%';
DECLARE @ITMNAM VARCHAR(30) = '%{4}%';

SELECT CASE
         WHEN XWS.ITMREF_0 IS NOT NULL THEN 'NOK'
         WHEN BOM.ITMREF_0 IS NOT NULL THEN 'OK'
         ELSE ''
       END           BOM
      ,ITF.ITMREF_0  产品编码
      ,ITM.ITMDES1_0 产品描述1
      ,ITM.ITMDES2_0 产品描述2
      ,@BOMALT       LINKROWIDBOMALT
FROM   ITMFACILIT ITF
       INNER JOIN ITMMASTER ITM
               ON ITF.ITMREF_0 = ITM.ITMREF_0
       LEFT JOIN BOM
              ON BOM.ITMREF_0 = ITF.ITMREF_0
                 AND BOM.BOMALT_0 = @BOMALT
                 AND BOM.BOMALTTYP_0 = @BOMTYP
       LEFT JOIN (SELECT ITMREF_0
                  FROM   XWSBOM
                  WHERE  RPFLG_0 &lt;&gt; 3
                  GROUP  BY ITMREF_0)XWS
              ON XWS.ITMREF_0 = ITF.ITMREF_0
WHERE  ITF.STOFCY_0 = @FCY
       AND (ITF.ITMREF_0 LIKE @ITMREF OR @ITMREF='')
       AND (ITM.ITMDES1_0 LIKE @ITMNAM OR @ITMNAM='')
       AND ITF.REOCOD_0 = 3
ORDER  BY ITF.ITMREF_0</SQLScript>
