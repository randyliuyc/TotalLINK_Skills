  <SQLScript>SELECT S.ID                                                                                            LINKROWID
       ,S.DOCNUM
       ,DOCGRP.OPTDES                                                                                  DOCGRP
       ,DOCSTA.OPTDES                                                                                  DOCSTA
       ,WFLSTA.OPTDES                                                                                  WFLSTA
       ,CONVERT(VARCHAR(16), S.DOCDAT, 23)                                                             DOCDAT
       ,S.DOCDES
       ,S.PRJNUM
       ,SI.SITENAM                                                                                     SITE
       ,DE.DEPTNAM                                                                                     DEPT
       ,GR.GRPNAM                                                                                      GRP
       ,RE.RESNAM                                                                                      RESNO
       ,S.REMARK
       ,S.CLOREA
       ,S1.NAME + '(' + S.CREUSR + ')'                                                                 CREUSR
       ,S2.NAME + '(' + S.UPDUSR + ')'                                                                 UPDUSR
       ,CONVERT(VARCHAR(16), S.CRETIM, 21)                                                             CRETIM
       ,Iif(CONVERT(VARCHAR(16), S.UPDTIM, 23) = '1900-01-01', '', CONVERT(VARCHAR(16), S.UPDTIM, 21)) UPDTIM
FROM   PREQUH S
       LEFT JOIN ENTSITE SI
              ON SI.SITE = S.SITE
       LEFT JOIN ENTDEPT DE
              ON DE.DEPT = S.DEPT
       LEFT JOIN ENTGRP GR
              ON GR.GRP = S.GRP
       LEFT JOIN ENTRES RE
              ON RE.RESNO = S.RESNO
       LEFT JOIN LINKOPT DOCGRP
              ON DOCGRP.OPTID = S.DOCGRP
                 AND DOCGRP.OPTTYP = 'DOCGRP'
                 AND DOCGRP.LINKOPTID = 'PRE'
       LEFT JOIN LINKOPT DOCSTA
              ON DOCSTA.OPTID = S.DOCSTA
                 AND DOCSTA.OPTTYP = 'DOCSTA'
       LEFT JOIN LINKOPT WFLSTA
              ON WFLSTA.OPTID = S.WFLSTA
                 AND WFLSTA.OPTTYP = 'WFLSTA'
       LEFT JOIN LINK.DBO.SysUser S1
              ON S.CREUSR = S1.LoginUser
       LEFT JOIN LINK.DBO.SysUser S2
              ON S.UPDUSR = S2.LoginUser
WHERE  S.DOCNUM + S.DOCDES + S.PRJNUM + S.DEPT + S.RESNO LIKE '%{0}%'
       AND S.DOCDAT BETWEEN '{1}' AND '{2}'
       AND S.DOCSTA LIKE '%{3}%'
       AND ( S.DEPT IN(SELECT DEPT
                       FROM   ENTDEPT
                       WHERE  SITE = 'SV'
                              AND ( DEPT = '#LINKUSER(#LOGIN_USER#).DEPT3#'
                                     OR DEPT IN (SELECT DEPT
                                                 FROM   USERDEPT
                                                 WHERE  LoginUser = N'#LOGIN_USER#') ))
              OR ( '#LINKUSER(#LOGIN_USER#).DEPT3#' = ''
                   AND NOT EXISTS (SELECT 1
                                   FROM   USERDEPT
                                   WHERE  LoginUser = N'#LOGIN_USER#') ) )
ORDER  BY S.ID DESC</SQLScript>
