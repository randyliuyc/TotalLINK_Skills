  <SQLScript>{{"type": 3,
"message": "",
"condition": "LINKSCRIPTGET@LINK01:SELECT  
  CASE WHEN '{7}'=''  THEN   N'LINKPREVENT:车架码必填' 
       WHEN CNUM&gt;0 AND  '{7}'&lt;&gt;'' THEN   N'LINKPREVENT:该车架码已存在'
	   WHEN CNUM=0 AND  '{7}'&lt;&gt;'' THEN 
	    CASE   WHEN '{8}'='' AND '{9}'=''  THEN N'LINKCONFIRM:电机码和电池码确认为空吗？'
		       WHEN '{8}'=''  THEN N'LINKCONFIRM:电池码确认为空吗？'
               WHEN '{8}'&lt;&gt;'' AND DCNUM&gt;0 THEN N'LINKPREVENT:该电池码已存在' 
			   WHEN '{9}'=''  THEN N'LINKCONFIRM:电机码确认为空吗？'
			   WHEN '{9}'&lt;&gt;'' AND DJNUM&gt;0 THEN N'LINKPREVENT:该电机码已存在' 
		ELSE ''
		END
  ELSE '1'
  END 
FROM (
SELECT SUM(CNUM) CNUM,SUM(DCNUM) DCNUM,SUM(DJNUM)  DJNUM
FROM (
SELECT COUNT(*) CNUM,0  DCNUM,0  DJNUM  FROM XWSMKI WHERE SERNUM_0='{7}' AND ITMREF_0='{5}'
UNION ALL
SELECT 0 CNUM,COUNT(*) DCNUM,0 DJNUM FROM XWSMKI WHERE XTXT_0='{8}' AND ITMREF_0='{5}'
UNION ALL
SELECT 0 CNUM,0 DCNUM,COUNT(*) DJNUM FROM XWSMKI WHERE XTXT_1='{9}' AND ITMREF_0='{5}'
) A
)  B"
}}</SQLScript>
