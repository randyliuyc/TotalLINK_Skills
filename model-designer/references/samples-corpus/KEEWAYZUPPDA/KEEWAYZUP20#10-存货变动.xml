  <SQLScript>--LINKMYROWDATA
DECLARE @FCY VARCHAR(10)='{0}';
DECLARE @LOC VARCHAR(30)='%{1}%';
DECLARE @NEWLOC VARCHAR(30)='{2}';
DECLARE @ITMREF NVARCHAR(100)=N'%{3}%';
DECLARE @ITMDES VARCHAR(30)='%{4}%';
DECLARE @LANX3 VARCHAR(30) = '#LINKFUNC.GETLANX3#';

DECLARE @YITMORI VARCHAR(30)='%{8}%';

SELECT K.ITMREF_0                                             AS 产品编码
       ,I.YITMORI_0                                           AS 旧产品编码
       ,K.STOFCY_0                                            AS 地点
       ,CAST(SUM(K.QTYSTU_0) AS REAL)                         AS 存货数量
       ,CAST(SUM(K.QTYSTU_0 - ISNULL(XWS.QTYSTU, 0)) AS REAL) AS 剩余数量
       ,CAST(SUM(ISNULL(XWS.QTYSTU, 0)) AS REAL)              AS 未提交数
       ,I.STU_0                                               AS 单位
       ,ISNULL(L1.ITMDES, I.ITMDES1_0)                        AS 产品描述1
       ,ISNULL(L2.ITMDES, I.ITMDES2_0)                        AS 产品描述2
       ,@NEWLOC                                               AS 新库位
       ,CASE
          WHEN SUM(ISNULL(XWS.QTYSTU, 0)) &gt; 0 THEN 'E02'
          WHEN SUM(( K.QTYSTU_0 - ISNULL(XWS.QTYSTU, 0) )) &gt; 0
               AND SUM(( K.QTYSTU_0 - ISNULL(XWS.QTYSTU, 0) )) &lt; SUM(K.QTYSTU_0) THEN 'D02'
          ELSE 'B01'
        END                                                   AS ROW_BACKCOLOR2
       ,CASE
          WHEN SUM(ISNULL(XWS.QTYSTU, 0)) &gt; 0 THEN ''
          ELSE 'mui-hidden'
        END                                                   BTNFLG
		       ,CASE
          WHEN I.LOTMGTCOD_0 &gt; 1  THEN N'lang:{zh:批次号管理,en:Batch Management,de:Chargenverwaltung}'
          ELSE ''
        END                              LOTFLG
	   ,CASE
          WHEN SERMGTCOD_0 &gt;1 THEN N'lang:{zh:序列号管理,en:Serial Number Management,de:Seriennummernverwaltung}'
          ELSE ''
        END                              SERFLG
      ,'{6}'                        打印机编码
FROM   STOCK K
       INNER JOIN ITMMASTER I
               ON K.ITMREF_0 = I.ITMREF_0
       LEFT JOIN ITMLAN1 L1
              ON L1.ITMREF = I.ITMREF_0
                 AND L1.LANX3 = @LANX3
       LEFT JOIN ITMLAN2 L2
              ON L2.ITMREF = I.ITMREF_0
                 AND L2.LANX3 = @LANX3
       LEFT JOIN (SELECT SUM(X.QTYSTU_0) QTYSTU
                         ,STOCOU_0
                  FROM   XWSSCS X
                  WHERE  X.RPFLG_0 &lt;&gt; 3
                         AND X.TRSFAM_0 = 'CHG'
                  GROUP  BY STOCOU_0) XWS
              ON XWS.STOCOU_0 = K.STOCOU_0
WHERE  K.STOFCY_0 = @FCY
       AND K.LOC_0 LIKE @LOC
       AND K.ITMREF_0 LIKE UPPER(@ITMREF)
       AND ISNULL(L1.ITMDES, I.ITMDES1_0)
           + ISNULL(L2.ITMDES, I.ITMDES2_0) LIKE @ITMDES
       AND I.YITMORI_0 LIKE @YITMORI
GROUP  BY K.ITMREF_0
          ,K.STOFCY_0
          ,I.STU_0,I.LOTMGTCOD_0,SERMGTCOD_0
,ISNULL(L1.ITMDES, I.ITMDES1_0)
,ISNULL(L2.ITMDES, I.ITMDES2_0)
,I.YITMORI_0
ORDER  BY ROW_BACKCOLOR2 DESC
          ,K.ITMREF_0</SQLScript>
