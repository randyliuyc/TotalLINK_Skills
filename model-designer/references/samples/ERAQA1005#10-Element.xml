  <SQLScript>SELECT S.ELESEQ
      ,S.ELECOD
      ,S.ELENAM
      ,S.ELEUNT
      ,S.CREUSR
      ,S.UPDUSR
      ,CONVERT(VARCHAR(16), S.CRETIM, 21) CRETIM
      ,CONVERT(VARCHAR(16), S.UPDTIM, 21) UPDTIM
      ,S.ID                               LINKROWID
FROM   QAELE S 
ORDER  BY S.ELESEQ</SQLScript>
