  <SQLScript>DECLARE @ROUCOD VARCHAR(30) = '{0}';
--
WITH CARD_DATA
AS (
    -- 基本信息
    SELECT ISNULL(Q.CUSCOD,'') + ISNULL(T.INSTCAT,'')+'/' + ISNULL(Q.INTSPEC,'')+ISNULL(T.INSTRNG,'')AS TITLE
        , Q.ITMNO+ISNULL('/'+T.INSTNAM,'')AS INFO
        , 0 OPENUM
        , Q.ROUTYP+'/'+FORMAT(Q.CRETIM, 'yy-MM-dd') AS REMARK
        , 0 AS CHECKED
        , 0 AS FIXED
        , 2 AS CARDSIZE
        , '#F27935' AS TITLECOLOR
        , '#76B3E7' AS BORDERCOLOR
        , 1 AS SORT_ORDER
    FROM QAROU Q
	 LEFT JOIN QAINSTLST T
	 ON Q.ITMNO=T.INSTCOD
    WHERE ROUCOD = @ROUCOD
    
    UNION ALL
    
    SELECT CAST(L.OPENUM AS VARCHAR) AS TITLE
        , D.RPTTTL2 AS INFO
        , OPENUM
        , D.RPTGRP2 AS REMARK
        , 0 AS CHECKED
        , 0 AS FIXED
        , 0.5 AS CARDSIZE
        , '#80CBC4' AS TITLECOLOR
        , '#76B3E7' AS BORDERCOLOR
        , 10 + ROW_NUMBER() OVER (
            ORDER BY OPENUM
            ) AS SORT_ORDER
    FROM QAROULIN L
	INNER JOIN QAOPESTD D
	ON L.OPESTD=D.OPESTD
    WHERE ROUCOD = @ROUCOD
    )
-- 最终查询
SELECT OPENUM
    , TITLE
    , INFO
    , REMARK
    , CHECKED
    , FIXED
    , CARDSIZE
    , TITLECOLOR
    , BORDERCOLOR
    , SORT_ORDER
FROM CARD_DATA
ORDER BY SORT_ORDER;</SQLScript>
