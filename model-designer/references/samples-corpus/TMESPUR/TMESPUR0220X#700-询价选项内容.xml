  <SQLScript>SELECT L.DOCNUM + '-'
       + Cast(L.DOCLIN AS VARCHAR(16))     ITMKEY
       ,ITM.ITMNO
       ,ITM.ITMNAM
       ,ITM.ITMNAM1
       ,ITM.ITMNAM2
       ,ITM.ITMSPEC
       ,ITM.ITMSIZE
       ,L.ITMVER --品名
       ,H.SITE --产品地点
       ,H.FAC
       ,H.DEPT --部门
       ,F.FACNAM                           FACDES
       ,H.[DEPT]
       ,D.DEPTNAM                          DEPTDES
       ,ITM.IVATTYP
       ,CONVERT(VARCHAR(16), L.REQDAT, 23) REQDAT
       ,L.STU --库存单位
       ,L.UOM --采购单位
       ,L.UOMCOE --采购单位系数
       ,L.QTY                              SUMQTY --总采购数量
       ,L.QTY - Isnull(PIN.QTY, 0)         QTY --采购数量
       ,Isnull(PIN.QTY, 0)                 PINQTY --已询价数量
       ,L.QTYSTU --库存单位数量
       ,'PRE'                              SRCTYP --来源类型
       ,L.DOCNUM                           SRCDOC--来源单据
       ,L.DOCLIN                           SRCLIN--来源行号
FROM   PREQUL L
       LEFT JOIN ITM
              ON ITM.ITMNO = L.ITMNO --产品 
       LEFT JOIN PREQUH H
              ON H.DOCNUM = L.DOCNUM
       LEFT JOIN [ENTDEPT] D
              ON H.[DEPT] = D.DEPT
       LEFT JOIN ENTFAC F
              ON F.FAC = H.FAC
       LEFT JOIN (SELECT ITMNO
                         ,SRCDOC
                         ,SRCLIN
                         ,Sum(QTY) QTY
                  FROM   PINQUL
                  WHERE  DOCLIN &lt;&gt; 4
                  GROUP  BY ITMNO
                            ,SRCDOC
                            ,SRCLIN) PIN
              ON PIN.ITMNO = L.ITMNO
                 AND PIN.SRCDOC = L .DOCNUM
                 AND PIN.SRCLIN = L.DOCLIN
WHERE  H.DOCSTA = 2
       AND L.DOCSTA = 2
       AND L.QTY - Isnull(PIN.QTY, 0) &gt; 0
       AND H.SITE = '{0}'
       AND L.ITMNO LIKE N'%{1}%' --产品编号
       AND L.ITMVER LIKE N'%{2}%' --品名
       AND ITM.TCLCOD LIKE N'%{3}%' --产品种类
       AND ITM.ITMNAM + ITM.ITMNAM1 + ITM.ITMNAM2 + L.ITMVER
           + L.DOCNUM LIKE N'%{4}%'
--ORDER BY REQDAT DESC</SQLScript>
