  <SQLScript>SELECT S.ID        LINKROWID
       ,S.WH
       ,H.WHNAM
       ,S.LOC
       ,S.LAB
       ,S.LOCDES
       ,S.WH + ' ' + ISNULL(H.WHNAM, '') + '-' + S.LOC + ' '
        + S.LOCDES KEYCNX
FROM   [STKLOC] S
       LEFT JOIN ENTWH H
              ON H.WH = S.WH
WHERE  S.WH + ISNULL(H.WHNAM, '') + S.LOC + S.LOCDES LIKE '%{1}%'
ORDER  BY S.LOC</SQLScript>
