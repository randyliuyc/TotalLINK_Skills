  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>--LINKLOADDATAIMMEDIATE 
--LINKNOGROUP
DECLARE @FCY VARCHAR(30) = '{0}';
DECLARE @ITM VARCHAR(30) = '{1}';
-- DECLARE @FCY VARCHAR(30) = 'ZUPK';
-- DECLARE @ITM VARCHAR(30) = '10203000E001';

SELECT S.ITMREF_0 AS 产品编号
  , CAST(S.QTYSTU_0 AS REAL) AS 数量
  , S.PCU_0 单位
  , A1.TEXTE_0 库位类型描述
  , S.LOC_0 AS 库位
  , S.STA_0 AS 状态
  , S.PALNUM_0 AS 生产计划号
  , S.CTRNUM_0 AS 箱号
  , S.SERNUM_0 AS 序列号
  , S.BPSLOT_0 AS 供应商批次
  , S.LOCTYP_0 AS 库位类型
  , IIF(S.STA_0 LIKE 'R%', 'E03', '') LINKAPPRROW
FROM STOCK S
INNER JOIN ITMMASTER ITM
  ON ITM.ITMREF_0 = S.ITMREF_0
INNER JOIN ITMFACILIT F
  ON F.ITMREF_0 = S.ITMREF_0
    AND F.STOFCY_0 = S.STOFCY_0
LEFT JOIN ATEXTRA A1
  ON A1.IDENT1_0 = S.STOFCY_0
    AND A1.IDENT2_0 = S.LOCTYP_0
    AND A1.CODFIC_0 = 'TABLOCTYP'
    AND A1.LANGUE_0 = 'CHI'
    AND A1.ZONE_0 = 'TYPDESAXX'
WHERE S.STOFCY_0 = @FCY
  AND S.ITMREF_0 = @ITM
-- AND S.STA_0 NOT LIKE 'R%'
ORDER BY S.LOC_0</SQLScript>
