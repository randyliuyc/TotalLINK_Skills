  <SQLScript>SELECT S.ITMNO
     --,ITM.ITMNAM
     --,ITM.ITMNAM1
     --,ITM.ITMNAM2
       ,S.ITMVER
       ,S.CREUSR
       ,IIF(CONVERT(VARCHAR(16),S.CRETIM,23)='1900-01-01','',CONVERT(VARCHAR(16),S.CRETIM,23)) CRETIM
FROM   ITMVER S
LEFT JOIN ITM ON ITM.ITMNO=S.ITMNO
WHERE  S.ITMNO LIKE '%{0}%'
AND S.ITMVER LIKE '%{1}%'
AND --ITM.ITMNAM+ITM.ITMNAM1+ITM.ITMNAM2+
S.CREUSR  LIKE '%{2}%'</SQLScript>
