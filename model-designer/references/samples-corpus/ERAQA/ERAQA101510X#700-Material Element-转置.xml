  <SQLScript>--LINKNOGROUP
--LINKNOFILTER
SELECT [C]
      ,[Si]
      ,[Mn]
      ,[P]
      ,[S]
      ,[Cr]
      ,[Ni]
      ,[Mo]
      ,[W]
      ,[Co]
      ,[V]
      ,[Ti]
      ,[Cu]
      ,[Pb]
      ,[Sn]
      ,[Al]
      ,[Nb]
      ,[N]
      ,[O]
      ,[B]
      ,[Bi]
      ,[Sb]
      ,[H]
FROM   (SELECT DOCNUM
              ,ELECOD
              ,CAST(ELEVAL AS DECIMAL(18,3)) ELEVAL
        FROM   QAMATELE
        WHERE  DOCNUM = '{0}') AS SourceTable
       PIVOT ( MAX(ELEVAL)
             FOR ELECOD IN ( [C],
                             [Si],
                             [Mn],
                             [P],
                             [S],
                             [Cr],
                             [Ni],
                             [Mo],
                             [W],
                             [Co],
                             [V],
                             [Ti],
                             [Cu],
                             [Pb],
                             [Sn],
                             [Al],
                             [Nb],
                             [N],
                             [O],
                             [B],
                             [Bi],
                             [Sb],
                             [H] ) ) AS PivotTable</SQLScript>
