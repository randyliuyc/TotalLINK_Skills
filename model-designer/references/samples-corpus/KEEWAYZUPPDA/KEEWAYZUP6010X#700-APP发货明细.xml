  <FunctionCode />
  <ChartType />
  <SQLScript>DECLARE @FCY VARCHAR(10)='{0}';
DECLARE @SOHNUM VARCHAR(30)='%{1}%';
DECLARE @BPC NVARCHAR(100)=N'%{2}%';
DECLARE @ITM NVARCHAR(100)=N'%{3}%';
SELECT XWS.PK_0                                  LINKROWID
      ,CAST(XWS.QTYPCU_0 AS REAL)                发货数量
      ,XWS.LOC_0                                 发货库位
      ,XWS.SERNUM_0                              序列号
      ,XWS.RPNUM_0                               发货单号
      ,CONVERT(VARCHAR(16), XWS.CREDATTIM_0, 21) 操作时间
      ,XWS.USERID_0                              操作人员
      ,CASE
          WHEN XWS.RPFLG_0 = 3 THEN 'mui-hidden'
          ELSE ''
        END                                      LINKROWIDBTNFLG
      ,XWS.SOHNUM_0
        + CAST(XWS.SOPLIN_0 AS VARCHAR)          pid
FROM   XWSSDH XWS
       INNER JOIN ITMMASTER ITM
               ON XWS.ITMREF_0 = ITM.ITMREF_0
	   LEFT JOIN BPCUSTOMER BPC
              ON XWS.BPCORD_0 = BPC.BPCNUM_0
WHERE 
       XWS.STOFCY_0= @FCY
       AND XWS.SOHNUM_0 LIKE UPPER(@SOHNUM)
       AND BPC.BPCNUM_0 + UPPER(BPC.BPCNAM_0) + UPPER(BPC.BPCSHO_0) LIKE UPPER(@BPC)
       AND ITM.ITMREF_0 + UPPER(ITM.ITMDES1_0)
           + UPPER(ITM.ITMDES2_0) + UPPER(ITM.ITMDES3_0) LIKE UPPER(@ITM) 
ORDER  BY XWS.RPFLG_0
          ,XWS.CREDATTIM_0 DESC</SQLScript>
