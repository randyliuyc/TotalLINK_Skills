  <SQLScript>DECLARE @FCY VARCHAR(5)='{0}'; --ZUPK
DECLARE @MFGNUM VARCHAR(50)='{1}'; --MFGZUPK25110003
SELECT S.PK_0                                   LINKROWID
      ,CAST(S.QTYSTU_0 AS REAL)                 数量
      ,S.LOC_0                                  库位
      ,S.SERNUM_0                               序列号
      ,S.RPNUM_0                                移库单号
      ,CONVERT(VARCHAR(16), S.CREDATTIM_0, 21)  操作时间
      ,S.USERID_0                               操作人员
      ,CASE
          WHEN S.RPFLG_0 = 3 THEN 'mui-hidden'
          ELSE ''
        END                                     LINKROWIDBTNFLG
      ,S.VCRNUM_0 + CAST(S.VCRLIN_0 AS VARCHAR) pid
FROM   XWSSCS S
       INNER JOIN ITMMASTER ITM
               ON S.ITMREF_0 = ITM.ITMREF_0
WHERE  S.STOFCY_0 = @FCY
       AND S.VCRNUM_0 = @MFGNUM
       AND S.TRSFAM_0 = 'MFGT'
ORDER  BY S.RPFLG_0
          ,S.CREDATTIM_0 DESC</SQLScript>
