  <ModelDesc>监管报表-产品汇总</ModelDesc>
  <KeyWords />
  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>--产品汇总信息
DECLARE @STRDAT DATE = '{0}';
DECLARE @ENDDAT DATE = '{1}';

WITH CTE_TRX
AS (
  SELECT L.ZOLLLOT_0
    , L.ITMREF_0
    , CAST(SUM(IIF(L.RECFLAG_0 = 1, L.QTYSTU_0, 0)) AS INT) AS RECQTY_0
    , CAST(SUM(IIF(L.RECFLAG_0 = 0, - L.QTYSTU_0, 0)) AS INT) AS USEQTY_0
  FROM YZUPZOLL L
  WHERE ZOLLSTRDAT_0 &lt;= @STRDAT 
    -- AND ZOLLENDDAT_0 = @ENDDAT
  GROUP BY L.ZOLLLOT_0
    , L.ITMREF_0
  )
SELECT X.ZOLLLOT_0
  , X.ITMREF_0
  , I.ITMDES1_0
  , I.ITMDES2_0
  , I.ITMDES3_0
  , CAST(H.ZOLLPRI_0 AS DECIMAL(18, 4)) AS ZOLLPRI_0
  , X.RECQTY_0
  , X.USEQTY_0
  , X.RECQTY_0 - X.USEQTY_0 AS RMNQTY_0
  , CAST(H.ZOLLPRI_0 * (X.RECQTY_0 - X.USEQTY_0) AS DECIMAL(18, 2)) AS RMNAMT_0
  , CAST(H.ZOLLPRI_0 * (X.RECQTY_0 - X.USEQTY_0) * H.ADRAT_0 AS DECIMAL(18, 2)) AS RMNADAMT_0
  , CAST(H.ZOLLPRI_0 * (X.RECQTY_0 - X.USEQTY_0) * H.SPRAT_0 AS DECIMAL(18, 2)) AS RMNSPAMT_0
  , 'H03' LINKAPPRROW
  , X.ZOLLLOT_0 LINKROWIDL2
  , X.ZOLLLOT_0 + X.ITMREF_0 LINKROWIDL3
FROM CTE_TRX X
INNER JOIN ITMMASTER I
  ON I.ITMREF_0 = X.ITMREF_0
INNER JOIN YZUPZOLLH H
  ON X.ZOLLLOT_0 = H.ZOLLLOT_0
    AND H.ZOLLSTRDAT_0 = @STRDAT
    AND H.ZOLLENDDAT_0 = @ENDDAT;</SQLScript>
