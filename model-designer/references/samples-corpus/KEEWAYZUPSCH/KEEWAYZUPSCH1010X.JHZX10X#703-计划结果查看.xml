  <ModelDesc>计划结果查看</ModelDesc>
  <KeyWords />
  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>DECLARE @FCY VARCHAR(10) = '{0}';
DECLARE @XMH VARCHAR(50) = '{1}';

DECLARE @LANX3 VARCHAR(30) = '#LINKFUNC.GETLANX3#';

WITH CTE_DATA
AS (
  SELECT ITMREF_0
    , STOFCY_0
    , SUM(IIF(VCRREF_0 = N'1-STK', 1, 0) * QTYREF_0) STKQTY --当前库存
    , SUM(IIF(VCRREF_0 = N'2-SAF', - 1, 0) * QTYREF_0) SAFQTY --安全库存
    , SUM(IIF(VCRREF_0 = N'3-ORD', 1, 0) * QTYREF_0) ORDQTY --在途
    , SUM(IIF(VCRREF_0 = N'4-FIM', - 1, 0) * QTYREF_0) FIMQTY --确认需求
    , SUM(IIF(VCRREF_0 = N'4-BOM', - 1, 0) * QTYREF_0) BOMQTY --展开需求
    , SUM(IIF(VCRREF_0 = N'4-REL', - 1, 0) * QTYREF_0) RELQTY --相关需求
    , SUM(IIF(VCRREF_0 = N'4-BAT', - 1, 0) * QTYREF_0) BATQTY --初始需求     
    , SUM(IIF(VCRREF_0 = N'5-ADS'
        AND PLNNOTE_0 = 'ADSCUT', 1, 0) * QTYREF_0) ADSCUTQTY --截止日期前的建议数量     
    , SUM(IIF(VCRREF_0 = N'5-ADS'
        AND PLNNOTE_0 &lt;&gt; 'ADSCUT', 1, 0) * QTYREF_0) ADSOTHQTY --截止日期后的建议数量     
  FROM XWSSCHRES
  WHERE XMHNUM_0 = @XMH
  GROUP BY ITMREF_0
    , STOFCY_0
  )
SELECT X.ITMREF_0 产品编码
  , ISNULL(L1.ITMDES, ITM.ITMDES1_0) AS 产品描述1
  , ISNULL(L2.ITMDES, ITM.ITMDES2_0) AS 产品描述2
  , CAST(X.BATQTY AS DECIMAL(18, 2)) 初始需求
  , CAST(X.RELQTY AS DECIMAL(18, 2)) 相关需求
  , CAST(X.FIMQTY AS DECIMAL(18, 2)) 确认需求
  , CAST(X.SAFQTY AS DECIMAL(18, 2)) 安全库存
  , CAST(X.ORDQTY AS DECIMAL(18, 2)) 在途
  , CAST(X.STKQTY AS DECIMAL(18, 2)) 当前库存
  , CAST(X.ADSCUTQTY AS DECIMAL(18, 2)) 截止日期前建议
  , CAST(X.ADSOTHQTY AS DECIMAL(18, 2)) 后续建议
  , ITM.PUU_0 单位
-- , L250.LANMES_0 建议类型
-- , S.PK_0 LINKROWID
-- , CONVERT(VARCHAR(16), S.CREDATTIM_0, 21) MRP运行时间
-- , IIF(XWS.RPNUM_0 &lt;&gt; '', 'A02', '') LINKAPPRROW
FROM CTE_DATA X
INNER JOIN ITMMASTER ITM
  ON ITM.ITMREF_0 = X.ITMREF_0
LEFT JOIN ITMFACILIT ITF
  ON ITF.ITMREF_0 = X.ITMREF_0
    AND ITF.STOFCY_0 = X.STOFCY_0
-- LEFT JOIN APLSTD L250
--   ON L250.LANCHP_0 = '250'
--     AND L250.LAN_0 = @LANX3
--     AND L250.LANNUM_0 = ITF.REOCOD_0
LEFT JOIN ITMLAN1 L1
  ON L1.ITMREF = ITM.ITMREF_0
    AND L1.LANX3 = @LANX3
LEFT JOIN ITMLAN2 L2
  ON L2.ITMREF = ITM.ITMREF_0
    AND L2.LANX3 = @LANX3
-- WHERE S.XMHNUM_0 = @XMH
--   AND S.VCRREF_0 = N'5-ADS'
-- AND S.PLNNOTE_0 = 'ADSCUT'
ORDER BY X.ITMREF_0;</SQLScript>
