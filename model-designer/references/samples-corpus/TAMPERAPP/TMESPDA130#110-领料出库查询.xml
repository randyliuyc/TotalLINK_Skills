  <SQLScript>DECLARE @SITE VARCHAR(30)=N'%{0}%'--地点	    
DECLARE @STADAT DATE='{1}'--开始日期	
DECLARE @ENDDAT DATE='{2}'--结束日期	
DECLARE @SRCDOC VARCHAR(30)=N'%{3}%'--领料通知单	
DECLARE @ITM VARCHAR(30)=N'%{4}%'--产品信息	
--DECLARE @BATCHID VARCHAR(100)=N'%{5}%'--BATCHID
DECLARE @LOT VARCHAR(30)=N'%{5}%'	

SELECT S.[DOCNUM]
       ,S.[DOCLIN]
       ,S.[DOCTYP]
       ,S.[DOCGRP]
       ,S.[DOCDAT]
       ,S.[SITE]
       ,S.[ITMNO]
       ,S.[ITMVER]
       ,ITM.ITMNAM + ITM.ITMNAM1 + ITM.ITMNAM2 ITMNAM
       ,S.[FAC]
       ,S.[WH]
       ,S.[LOC]
       ,S.[LOT]
       ,S.[SUBLOT]
       ,S.[STA]
       ,S.[STU]
       ,CAST(S.[QTYSTU]  AS decimal(18,2))  [QTYSTU]
       ,S.[UOM]
       ,S.[UOMCOE]
       ,CAST(S.[QTY]  AS decimal(18,2))  [QTY]  
       ,S.[ITMVER1]
       ,S.[FAC1]
       ,S.[WH1]
       ,S.[LOC1]
       ,S.[LOT1]
       ,S.[SUBLOT1]
       ,S.[STA1]
       ,S.[CTRNUM]
       ,S.[CTRQTY]
       ,S.[REMARK]
       ,S.[SUBSTA]
       ,S.[SUBTIM]
       ,S.[SUBRET]
       ,S.[PK]
       ,S.[XWSPK]
       ,S.[BATCHID]
       ,S.[SRCTYP]
       ,S.[SRCDOC]
       ,S.[SRCLIN]
       ,S.[SRCSEQ]
       ,S.[ORITYP]
       ,S.[ORIDOC]
       ,S.[ORILIN]
       ,S.[ORISEQ]
       ,S.[DOCSTA]
       ,S.[CLOREA]
       ,S.[CREUSR]
       ,S.[UPDUSR]
       ,CONVERT(VARCHAR(19), S.[CRETIM], 21)   CRETIM
       ,CONVERT(VARCHAR(19), S.[UPDTIM], 21)   UPDTIM
       ,S.DOCNUM + Cast(S.DOCLIN AS CHAR)      id --关键字
	  ,CASE
          WHEN S.SUBSTA &lt; 3 THEN 'E03'
          ELSE 'H03'
        END                               ROW_BACKCOLOR
	  ,CASE
          WHEN S.SUBSTA &lt; 3 THEN 'E02'
          ELSE 'H02'
        END                               ROW_BACKCOLOR1
FROM   [STKCHG] S
       LEFT JOIN ITM
              ON S.ITMNO = ITM.ITMNO
WHERE  S.SITE LIKE @SITE
       AND ( S.DOCDAT BETWEEN @STADAT AND @ENDDAT
              OR @STADAT = '' )
       AND S.SRCDOC LIKE @SRCDOC
       AND S.ITMNO + S.ITMVER + ITM.ITMNAM LIKE @ITM
	   AND S.LOT  LIKE @LOT
       --AND Isnull(S.BATCHID, '') LIKE @BATCHID
       AND S.DOCTYP = 'CHG'
       AND S.DOCGRP = 'MPM'
       --AND S.SUBSTA &lt;&gt; 1
ORDER  BY S.DOCNUM DESC
          ,S.DOCLIN</SQLScript>
