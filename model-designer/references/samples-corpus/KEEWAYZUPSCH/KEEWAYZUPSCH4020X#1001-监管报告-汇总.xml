  <SQLScript>--汇总信息
DECLARE @TITLE NVARCHAR(100) = 'Zweirad Union E-Mobility GmbH';
DECLARE @STRDAT DATE = '{0}';
DECLARE @ENDDAT DATE = '{1}';

SELECT @TITLE AS TITLE
  , MAX(ZOLLSTRDAT_0) AS STRDAT
  , MAX(ZOLLENDDAT_0) AS ENDDAT
  , CAST(SUM(ZOLLQTY_0) AS INT) ZOLLQTY_0
  , CAST(SUM(ZOLLAMT_0) AS DECIMAL(18, 2)) ZOLLAMT_0
  , CAST(SUM(RECQTY_0) AS INT) RECQTY_0
  , CAST(SUM(- USEQTY_0) AS INT) USEQTY_0
  , CAST(SUM(RMNQTY_0) AS INT) RMNQTY_0
  , CAST(SUM(RMNAMT_0) AS DECIMAL(18, 2)) RMNAMT_0
  , CAST(SUM(RMNADAMT_0) AS DECIMAL(18, 2)) RMNADAMT_0
  , CAST(SUM(RMNSPAMT_0) AS DECIMAL(18, 2)) RMNSPAMT_0
  , 'H07' LINKAPPRROW
  , 1 LINKROWIDL1
FROM YZUPZOLLH
WHERE ZOLLSTRDAT_0 = @STRDAT 
  AND ZOLLENDDAT_0 = @ENDDAT</SQLScript>
