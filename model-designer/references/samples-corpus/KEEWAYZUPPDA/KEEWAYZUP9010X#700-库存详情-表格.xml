  <SQLScript>SELECT CAST(S.QTYSTU_0 AS REAL)      数量
      ,S.LOC_0                       库位
      ,S.LOT_0                       批次
      ,S.STA_0                       状态
      ,S.SERNUM_0                    序列号
      ,S.STOFLD1_0                   电池序列号
      ,S.STOFLD2_0                   电机序列号
FROM   STOCK S
       INNER JOIN ITMMASTER I
               ON S.ITMREF_0 = I.ITMREF_0
WHERE S.STOFCY_0='{0}'
   AND S.ITMREF_0='{1}'
ORDER BY S.LOC_0,S.LOT_0,S.SERNUM_0</SQLScript>
