  <SQLScript>DECLARE @KEYWORDS NVARCHAR(100) = N'%{0}%';

SELECT U.DMCODE TOOL_CODE
  , U.DMNUM TOOL_NUM
  , S.SearchDesc TOOL_NAME
  , U.SCRIPT TOOL_TYPE
  , U.DMUSAGE TOOL_DESC
FROM SYSDMUSAGE U
INNER JOIN SYSSEARCH S
  ON U.DMCODE = S.SearchCode
    AND U.DMNUM = S.SearchNum
WHERE (
    S.SearchDesc LIKE @KEYWORDS
    OR U.DMUSAGE LIKE @KEYWORDS
    )
  OR @KEYWORDS = ''</SQLScript>
