  <FunctionCode />
  <ChartType />
  <SQLScript>DECLARE @ITMNO VARCHAR(30)='%{0}%';
DECLARE @LOT VARCHAR(30)='%{1}%';
DECLARE @TV VARCHAR(30)='%{2}%';
DECLARE @VCRNUM VARCHAR(30)='%{3}%';

SELECT S.ITMREF_0                              ITMNO
      ,ITM.ZGRADENO_0                          GRADENO
      ,LOT_0                                   LOT
      ,LEFT(SLO_0, 4)                          TV
      ,H.DOCNUM
      ,COUNT(*)                                QTY
      ,CAST(SUM(S.QTYSTU_0) AS DECIMAL(18, 2)) QTYSTU
      ,S.PCU_0
      ,S.BPRNUM_0                              BPSNUM
      ,S.STOFCY_0
      ,S.VCRNUM_0   VCRNUM 
      ,S.CREDAT_0   CREDAT     
      ,U.ROUCOD ROUCODCK
FROM   #LC.X3DATA#STOJOU S
       INNER JOIN #LC.X3DATA#ITMMASTER ITM
               ON S.ITMREF_0 = ITM.ITMREF_0
       LEFT JOIN QAINSPH H
              ON H.LOT = S.LOT_0 #LC.X3COLLATE#
                 AND H.TV = LEFT(SLO_0, 4) #LC.X3COLLATE#
                 AND H.MFGNUM=S.VCRNUM_0 #LC.X3COLLATE#
       LEFT JOIN QAROU U
              ON U.ROUCOD =S.ITMREF_0 #LC.X3COLLATE#
WHERE  S.VCRTYP_0 = 6
       AND S.CREDAT_0 &gt;= '2024-07-01'
       AND ISNULL(H.CLOSTA,0)=0
       --AND ITM.TCLCOD_0 = 'RAW'
       AND S.ITMREF_0 LIKE @ITMNO
       AND S.LOT_0 LIKE @LOT
       AND LEFT(SLO_0, 4) LIKE @TV
       AND S.VCRNUM_0 LIKE @VCRNUM
GROUP  BY S.ITMREF_0
          ,ITM.ZGRADENO_0
          ,LOT_0
          ,LEFT(SLO_0, 4)
          ,H.DOCNUM
          ,S.PCU_0
          ,S.BPRNUM_0
	  ,S.VCRNUM_0
          ,S.CREDAT_0 
          ,U.ROUCOD
          ,S.STOFCY_0</SQLScript>
