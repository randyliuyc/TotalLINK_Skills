  <ChartType />
  <SQLScript>--LINKLOADDATAIMMEDIATE 
--LINKNOGROUP
DECLARE @LANX3 VARCHAR(30) = '#LINKFUNC.GETLANX3#';
DECLARE @FCY VARCHAR(30) = '{0}';
DECLARE @XMH VARCHAR(30) = '{1}';
DECLARE @ITM VARCHAR(30) = '{2}';
-- DECLARE @FCY VARCHAR(30) = 'ZUPK';
-- DECLARE @XMH VARCHAR(30) = 'ZUPK260100006';
-- DECLARE @ITM VARCHAR(30) = '10203000E001';

WITH CTE_DOC 
AS (
  SELECT VCRREF
    , [VCRDES#LOGIN_LAN#] VCRDES
    , TRXSIGN
    , VCRSEQ
    , GESFUN
    , VCRAPPR
  FROM XLINKMRPDOC
  )
  , CTE_DOCABB
AS (
  SELECT VCRREF
    , [VCRDES#LOGIN_LAN#] VCRDES
    , TRXSIGN
    , VCRSEQ
    , GESFUN
    , VCRAPPR
  FROM XLINKMRPDOC
  )
SELECT XWS.ITMREF_0 产品编码
  , XWS.VCRREF_0 + '/' + XWS.ABBFIL_0 类型
  , D.VCRDES
  , XWS.VCRNUM_0 单据号
  , XWS.VCRLIN_0 单据行号
  , XWS.BPSNUM_0 商业伙伴
  , BPR.BPRNAM_0 商业伙伴名称
  , CONVERT(VARCHAR(20), XWS.STRDAT_0, 23) 开始日期
  , CONVERT(VARCHAR(20), XWS.ENDDAT_0, 23) 结束日期
  , CONVERT(VARCHAR(20), XWS.CALDAT_0, 23) 排序日期
  , CAST(XWS.QTY_0 AS DECIMAL(18, 2)) 数量
  , CAST(XWS.QTYRT_0 AS DECIMAL(18, 2)) 累计数量
  , CAST(XWS.QTYREF_0 AS DECIMAL(18, 2)) 参考数量
  , XWS.LEVEL_0 计算层级
  , ISNULL(R.ITMREF_0, MI.ITMREF_0) 来源产品
  , ISNULL(L1.ITMDES, ITM.ITMDES1_0) MIITMDES1
  , ISNULL(L2.ITMDES, ITM.ITMDES2_0) MIITMDES2
  , ABB.GESFUN LINKROWIDVCRTYP
  , D.VCRAPPR LINKAPPRROW
  , XWS.ROWID LINKROWID
FROM XWSSCHRES XWS
LEFT JOIN CTE_DOC D
  ON D.VCRREF = XWS.VCRREF_0
LEFT JOIN CTE_DOCABB ABB
  ON ABB.VCRREF = XWS.ABBFIL_0
LEFT JOIN XWSSCHRES R
  ON R.PK_0 = XWS.PKORI_0
LEFT JOIN BPARTNER BPR
  ON BPR.BPRNUM_0 = XWS.BPSNUM_0
LEFT JOIN MFGITM MI
  ON MI.MFGNUM_0 = XWS.VCRNUM_0
    AND XWS.ABBFIL_0 = 'MFM'
    AND MI.ITMTYP_0 = 1
LEFT JOIN ITMMASTER ITM
  ON ITM.ITMREF_0 = ISNULL(R.ITMREF_0, MI.ITMREF_0)
LEFT JOIN ITMLAN1 L1
  ON L1.ITMREF = ISNULL(R.ITMREF_0, MI.ITMREF_0)
    AND L1.LANX3 = @LANX3
LEFT JOIN ITMLAN2 L2
  ON L2.ITMREF = MI.ITMREF_0
    AND L2.LANX3 = @LANX3
WHERE XWS.XMHNUM_0 = @XMH
  AND XWS.STOFCY_0 = @FCY
  AND XWS.ITMREF_0 = @ITM
ORDER BY XWS.ITMREF_0
  , XWS.CALDAT_0
  , XWS.VCRREF_0
  , XWS.VCRNUM_0
  , XWS.VCRLIN_0
  , XWS.ROWID;</SQLScript>
