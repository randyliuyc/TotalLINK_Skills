  <SQLScript>--LINKMYROWDATA
--LINKDETAILLIST(KEEWAYZUP3010X,700,{0},{1})
DECLARE @LANX3 VARCHAR(30) = '#LINKFUNC.GETLANX3#';
DECLARE @FCY VARCHAR(5)='{0}'; --ZUPK
DECLARE @MFGNUM VARCHAR(50)='{1}'; --MFGZUPK25110003
DECLARE @ITMREF VARCHAR(30)=N'%{2}%';
DECLARE @ITMDES VARCHAR(30)=N'%{3}%';

SELECT ''            AS 地点
       ,''           AS 工单号
       ,''           AS 物料行
       ,''           AS 产品编码
       ,''           AS 产品描述1
       ,''           AS 产品描述2
       ,''           AS 需求数量
       ,''           AS 已领数量
       ,''           AS 未提交数
       ,''           AS 剩余数量
       ,''           AS 单位
       ,''           AS id
       ,''           AS 目标库位
       ,''           AS ROW_BACKCOLOR2
       ,''           AS 领料状态
       ,''           LINKROWIDHIDH
       ,'mui-hidden' LINKROWIDHIDL
       ,0            AS SORT_ORDER -- 添加排序字段
       ,''           AS SORT_BOMSEQ -- 添加物料行排序字段
UNION ALL
SELECT M.MFGFCY_0                                   AS 地点
       ,M.MFGNUM_0                                  AS 工单号
       ,M.BOMSEQ_0                                  AS 物料行
       ,M.ITMREF_0                                  AS 产品编码
       ,ISNULL(L1.ITMDES, ITM.ITMDES1_0)            AS 产品描述1
       ,ISNULL(L2.ITMDES, ITM.ITMDES2_0)            AS 产品描述2
       ,Cast(M.RETQTY_0 AS REAL)                    AS 需求数量
       ,Cast(Isnull(X.YQTY, 0) AS REAL)             AS 已领数量
       ,Cast(Isnull(X.XQTY, 0) AS REAL)             AS 未提交数
       ,Cast(M.RETQTY_0 - Isnull(X.QTY, 0) AS REAL) AS 剩余数量
       ,I.STU_0                                     AS 单位
       ,M.MFGNUM_0 + Cast(M.BOMSEQ_0 AS VARCHAR)    id
       ,M.LOC_0                                     AS 目标库位
       ,CASE
          WHEN Isnull(X.XQTY, 0) &gt; 0 THEN 'E02'
          WHEN M.RETQTY_0 - Isnull(X.YQTY, 0) &gt; 0
               AND Isnull(X.QTY, 0) &gt; 0 THEN N'A02'
          WHEN M.RETQTY_0 - Isnull(X.YQTY, 0) &lt;= 0 THEN 'H02'
          ELSE 'B01'
        END                                         AS ROW_BACKCOLOR2
       ,CASE
          WHEN Isnull(X.QTY, 0) = 0 THEN N'lang:{zh:未领料,en:No,de:Ausstehend}'
          WHEN M.RETQTY_0 - Isnull(X.YQTY, 0) &gt; 0
               AND Isnull(X.QTY, 0) &gt; 0 THEN N'lang:{zh:部分领料,en:Part,de:Teilweise}'
          WHEN M.RETQTY_0 - Isnull(X.QTY, 0) = 0 THEN N'lang:{zh:全部领料,en:Full,de:Abgeschlossen}'
        END                                         AS 领料状态
       ,'mui-hidden'                                LINKROWIDHIDH
       ,''                                          LINKROWIDHIDL
       ,1                                           AS SORT_ORDER -- 添加排序字段
       ,M.BOMSEQ_0                                  AS SORT_BOMSEQ -- 添加物料行排序字段
FROM   MFGMAT M
       INNER JOIN ITMMASTER ITM
               ON M.ITMREF_0 = ITM.ITMREF_0
       LEFT JOIN ITMLAN1 L1
              ON L1.ITMREF = ITM.ITMREF_0
                 AND L1.LANX3 = @LANX3
       LEFT JOIN ITMLAN2 L2
              ON L2.ITMREF = ITM.ITMREF_0
                 AND L2.LANX3 = @LANX3
       LEFT JOIN (SELECT Sum(Iif(RPFLG_0 = 3, QTYSTU_0, 0))   YQTY
                         ,Sum(Iif(RPFLG_0 &lt;&gt; 3, QTYSTU_0, 0)) XQTY
                         ,Sum(QTYSTU_0)                       QTY
                         ,VCRNUM_0
                         ,VCRLIN_0
                  FROM   XWSSCS
                  WHERE  TRSFAM_0 = 'MFGT'
                         AND VCRNUM_0 = @MFGNUM
                  GROUP  BY VCRNUM_0
                            ,VCRLIN_0) X
              ON X.VCRNUM_0 = M.MFGNUM_0
                 AND X.VCRLIN_0 = M.BOMSEQ_0
WHERE  M.MFGFCY_0 = @FCY
       AND M.MFGNUM_0 = @MFGNUM
       AND M.ITMREF_0 LIKE Upper(@ITMREF)
       AND Upper(ISNULL(L1.ITMDES, ITM.ITMDES1_0)+ISNULL(L2.ITMDES, ITM.ITMDES2_0)) LIKE Upper(@ITMDES)
ORDER  BY SORT_ORDER
          ,SORT_BOMSEQ</SQLScript>
  <SQLUpdateScript>--LINKREFRESH
INSERT INTO XWSSCS  
            (MACHINEID_0,
             USERID_0,
             CUSERID_0,
             VCRTYP_0,
             PK_0,
             BATCHID_0,
             PKORI_0,
             CREDATIM_0,
             STAT_0,
             SUBDATIM_0,
             RPFLG_0,
             RPNUM_0,
             RPLIN_0,
             RPNOTE_0,
             RPDATE_0,
             RPDATIM_0,
             VCRNUM_0,
             VCRLIN_0,
             STOFCY_0,
             IPTDAT_0,
             VCRDES_0,
             PJT_0,
             TRSFAM_0,
             ITMREF_0,
             STU_0,
             QTYSTU_0,
             LOT_0,
             SLO_0,
             SERNUM_0,
             STOCOU_0,
             STA_0,
             STA_1,
             LOCTYP_0,
             LOCTYP_1,
             LOC_0,
             LOC_1,
             PALNUM_0,
             PALNUM_1,
             CTRNUM_0,
             CTRNUM_1,
             NOTE_0,
             NOTE_1,
             NOTE_2,
             NOTE_3,
             NOTE_4,
             BPRNUM_0,
             CREDATTIM_0,
             UPDDATTIM_0,
             AUUID_0,
             CREUSR_0,
             UPDUSR_0,
             WRH_0,
             STOFLD1_0,
             STOFLD2_0)
SELECT '#LOGIN_ID#'            MACHINEID_0
      ,'#LOGIN_USER#'          USERID_0
      ,'#LOGIN_USER#'          CUSERID_0
      ,29                      VCRTYP_0
      ,NEWID()                 PK_0
      ,''                      BATCHID_0
      ,''                    PKORI_0
      ,GETDATE()               CREDATIM_0
      ,1                       STAT_0
      ,'1999-01-01'            SUBDATIM_0
      ,1                       RPFLG_0
      ,''                      RPNUM_0
      ,0                       RPLIN_0
      ,''                      RPNOTE_0
      ,'1999-01-01'            RPDATE_0
      ,'1999-01-01'            RPDATIM_0
      ,'#工单号#'              VCRNUM_0
      ,0#物料行#               VCRLIN_0
      ,STOFCY_0                STOFCY_0
      ,GETDATE()               IPTDAT_0
      ,N'移库领料'             VCRDES_0
      ,''                      PJT_0
      ,'MFGT'                   TRSFAM_0
      ,ITMREF_0                ITMREF_0
      ,PCU_0                   STU_0
      ,0#领料数量#             QTYSTU_0
      ,LOT_0                   LOT_0
      ,SLO_0                   SLO_0
      ,SERNUM_0                SERNUM_0
      ,STOCOU_0                STOCOU_0
      ,STA_0                   STA_0
      ,STA_0                   STA_1
      ,''                      LOCTYP_0
      ,''                      LOCTYP_1
      ,LOC_0                   LOC_0
      ,N'#目标库位#'           LOC_1
      ,PALNUM_0                PALNUM_0
      ,PALNUM_0                PALNUM_1       
      ,CTRNUM_0                CTRNUM_0
      ,CTRNUM_0                CTRNUM_1
      ,''                      NOTE_0
      ,''                      NOTE_1
      ,''                      NOTE_2
      ,''                      NOTE_3
      ,''                      NOTE_4
      ,''                      BPRNUM_0
      ,GETDATE()               CREDATTIM_0
      ,''                      UPDDATTIM_0
      ,NEWID()                 AUUID_0
      ,LEFT('#LOGIN_USER#', 5) CREUSR_0
      ,''                      UPDUSR_0
      ,(SELECT WRH_0
         FROM   STOLOC
         WHERE  LOC_0 = '#库位#'
                AND STOFCY_0 = '#地点#')
      ,STOFLD1_0
      ,STOFLD2_0
FROM   STOCK
WHERE STOCOU_0=0#STOCOU# AND STOCOU_0 NOT IN (SELECT STOCOU_0 FROM XWSSCS WHERE RPFLG_0&lt;&gt;3 AND TRSFAM_0='MFGT' AND STOCOU_0=0#STOCOU#)</SQLUpdateScript>
