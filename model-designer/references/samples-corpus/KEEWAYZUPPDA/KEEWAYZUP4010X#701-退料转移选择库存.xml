  <ModelNum>701</ModelNum>
  <ModelDesc>退料转移选择库存</ModelDesc>
  <KeyWords />
  <DataMineCode />
  <FunctionCode />
  <ChartType />
  <SQLScript>DECLARE @FCY VARCHAR(30)='{0}';
DECLARE @ITMREF VARCHAR(30)='{1}';
DECLARE @LOC VARCHAR(30)='{2}';

SELECT N'lang:{zh:库位,en:Location,de:Lagerplatz}:' + K.LOC_0 
       + N'&lt;br&gt;lang:{zh:可用数量,en:Available Qty,de:Verfügbare Menge}:'
       + Cast(Cast(K.QTYSTU_0-Isnull(XWS.QTY, 0)-CUMALLQTY_0 AS REAL) AS VARCHAR)
	   + N'&lt;br&gt;lang:{zh:库存异常数量,en:Inventory Anomaly Qty,de:Bestandsabweichung}:'
	   + CAST(CAST(K.CUMWIPQTY_0 AS REAL) AS VARCHAR)
       + N'&lt;br&gt;lang:{zh:序列号,en:Serial No.,de:Seriennr.}:' + K.SERNUM_0      
	   + N'&lt;br&gt;lang:{zh:批次,en:Lot,de:Lieferantencharge}:' + K.LOT_0 选择  
       ,K.LOC_0                   库位
       ,K.SERNUM_0                序列号
       ,CASE
          WHEN K.QTYSTU_0 - Isnull(XWS.QTY, 0) - CUMALLQTY_0 &lt;= 0 THEN N'lang:{zh:可用库存不足,en:Insufficient Available Stock,de:Unzureichender verfügbarer Bestand}'
          ELSE 'OK'
        END                       AS 数据检查
       ,K.PALNUM_0                AS 生产计划号
       ,K.STOCOU_0                STOCOU
       ,Cast(Cast(K.QTYSTU_0-Isnull(XWS.QTY, 0)-CUMALLQTY_0 AS REAL) AS VARCHAR) AS 退料数量
FROM   STOCK K
       LEFT JOIN (SELECT STOCOU_0
                         ,Sum(QTYSTU_0) QTY
                  FROM   XWSSCS
                  WHERE  RPFLG_0 &lt;&gt; 3
                  GROUP  BY STOCOU_0
                            ,SERNUM_0)XWS
              ON XWS.STOCOU_0 = K.STOCOU_0
WHERE  K.STOFCY_0 = @FCY
       AND K.ITMREF_0 = @ITMREF
       AND K.LOC_0 = @LOC
-- AND K.QTYSTU_0 - ISNULL(XWS.QTY,0) &gt; 0</SQLScript>
