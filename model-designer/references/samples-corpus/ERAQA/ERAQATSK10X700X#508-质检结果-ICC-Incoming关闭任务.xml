  <SQLScript>#LINKSCRIPTGET@DATAQA:
SELECT CASE WHEN STA=0 THEN N'LINKPREVENT:The quality inspection is not completed and cannot be confirmed.
质检未完成，不可确认'
            WHEN ISNULL(CLOSTA,0)=1 THEN N'LINKPREVENT:The quality inspection has been completed.
已完成质检'
           WHEN STA=2 AND ISNULL(CLOSTA,0)=0 THEN N'LINKCONFIRM:The quality inspection status is 【Passed】,Confirm completion?
质检状态为【合格】，确认完成吗？'
           WHEN STA=1 AND ISNULL(CLOSTA,0)=0 THEN N'LINKCONFIRM:Quality inspection status is 【Failed】,Confirm completion?
		   质检状态为【不合格】，确认完成吗？'
END
FROM QAINSPH WHERE DOCNUM='{0}'
#</SQLScript>
