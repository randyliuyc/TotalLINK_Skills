  <SQLScript>SELECT S.DOCNUM
      ,DOCGRP.OPTDES                        DOCGRP
      ,DOCSTA.OPTDES                        DOCSTA
      ,CONVERT(VARCHAR(16), S.DOCDAT, 23)   DOCDAT
      ,S.BPSNO
      ,BPS.BPSNAM
      ,S.PRJNUM
      ,S.SITE
      ,S.REMARK
      ,S.DOCLIN
      ,S.ITMNO
      ,ITM.ITMNAM
      ,ITM.ITMNAM1
      ,ITM.ITMNAM2
      ,S.ITMVER
      ,CAST(S.QTYSTU AS REAL)               QTYSTU
      ,S.STU
      ,CAST(S.QTY AS REAL)                  QTY
      ,S.UOM
      ,S.UOMCOE
      ,S.REMARK                             LREMARK
      ,S.PRJNUM                             LPRJNUM
      ,SUBSTA.OPTDES                        SUBSTA
      ,CONVERT(VARCHAR(16), S.[SUBTIM], 21) SUBTIM
      ,S.BATCHID
      ,S.SRCTYP
      ,S.SRCDOC
      ,S.SRCLIN
      ,S.CREUSR
      ,S.UPDUSR
      ,CONVERT(VARCHAR(16), S.CRETIM, 21)   CRETIM
      ,CONVERT(VARCHAR(16), S.UPDTIM, 21)   UPDTIM
FROM   PRETLIN S
       INNER JOIN ITM
               ON ITM.ITMNO = S.ITMNO
       LEFT JOIN BPSUP BPS
              ON BPS.BPSNO = S.BPSNO
       LEFT JOIN LINKOPT DOCSTA
              ON DOCSTA.OPTID = S.DOCSTA
                 AND DOCSTA.OPTTYP = 'DOCSTA'
       LEFT JOIN LINKOPT SUBSTA
              ON SUBSTA.OPTID = S.SUBSTA
                 AND SUBSTA.OPTTYP = 'SUBSTA'
       LEFT JOIN LINKOPT DOCGRP
              ON DOCGRP.OPTID = S.DOCGRP
                 AND DOCGRP.OPTTYP = 'DOCGRP'
WHERE  S.SITE LIKE '%{0}%'
       AND S.DOCNUM LIKE '%{1}%'
       AND S.ITMNO + ITM.ITMNAM LIKE '%{2}%'
       AND S.DOCDAT BETWEEN '{3}' AND '{4}'
       AND ITM.TCLCOD LIKE '%{5}%'
ORDER  BY S.DOCNUM DESC
          ,S.DOCLIN</SQLScript>
