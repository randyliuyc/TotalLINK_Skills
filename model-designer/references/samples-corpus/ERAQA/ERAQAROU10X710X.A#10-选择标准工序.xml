  <SQLScript>--LINKREFRESH
--LINKLOADDATAIMMEDIATE
DECLARE @ROUCOD VARCHAR(30) = '{0}';
SELECT CAST(IIF(UL.OPENUM IS NULL,0,1) AS BIT) GXFLG
      ,S.OPESTD
      ,S.MATTYP
      ,S.OPEDES1
      ,S.OPEDES2
      ,S.INSTRUCTION
      ,S.OPEUNT
      ,S.CTLTYP
      ,S.MEAFRQ
      ,S.INSTCOD
      ,S.INSTCAT
      ,S.CREUSR
      ,S.UPDUSR
      ,CONVERT(VARCHAR(16), S.CRETIM, 21) CRETIM
      ,CONVERT(VARCHAR(16), S.UPDTIM, 21) UPDTIM
      ,S.ID                               LINKROWID
      ,UL.OPENUM
FROM   QAOPESTD S
     LEFT JOIN QAROULIN UL
	 ON S.OPESTD=UL.OPESTD
	 AND UL.ROUCOD=@ROUCOD
ORDER  BY IIF(UL.OPENUM IS NULL,'9999999',UL.OPENUM) ,S.OPESTD</SQLScript>
  <SQLUpdateScript>--LINKSAVEONENTERKEY
--LINKEDITMODE
DECLARE @ROUCOD VARCHAR(30) = '{0}';
DECLARE @OPENUM INT = ''

SELECT @OPENUM=ISNULL(MAX(CAST(OPENUM AS INT)),0)+10
FROM QAROULIN WHERE ROUCOD=@ROUCOD

INSERT INTO [QAROULIN]
           ([ROUCOD]
           ,[OPENUM]
           ,[OPESTD]
           ,[OPEGRP]
           ,[OPEUNT]
           ,[CTLTYP]
           ,[MEAFRQ]
           ,[INSTCAT]
           ,[INSTCOD]
           ,[VALNOR]
           ,[VALMIN]
           ,[VALMAX]
           ,[USERFLG]
           ,[DATEFLG]
           ,[INSTFLG]
           ,[QTYOKFLG]
           ,[QTYSCFLG]
           ,[REASCFLG]
           ,[CREUSR]
           ,[UPDUSR]
           ,[CRETIM]
           ,[UPDTIM])
      SELECT
            @ROUCOD--&lt;ROUCOD, varchar(30),&gt;
           ,@OPENUM--&lt;OPENUM, varchar(30),&gt;
           ,S.OPESTD--&lt;OPESTD, varchar(30),&gt;
           ,1--&lt;OPEGRP, varchar(30),&gt;
           ,S.OPEUNT--&lt;OPEUNT, varchar(30),&gt;
           ,S.CTLTYP--&lt;CTLTYP, varchar(30),&gt;
           ,S.MEAFRQ--&lt;MEAFRQ, varchar(30),&gt;
           ,S.INSTCAT--&lt;INSTCAT, varchar(30),&gt;
           ,S.INSTCOD--&lt;INSTCOD, varchar(30),&gt;
           ,0--&lt;VALNOR, decimal(18,6),&gt;
           ,0--&lt;VALMIN, decimal(18,6),&gt;
           ,0--&lt;VALMAX, decimal(18,6),&gt;
           ,1--&lt;USERFLG, bit,&gt;
           ,1--&lt;DATEFLG, bit,&gt;
           ,1--&lt;INSTFLG, bit,&gt;
           ,1--&lt;QTYOKFLG, bit,&gt;
           ,1--&lt;QTYSCFLG, bit,&gt;
           ,1--&lt;REASCFLG, bit,&gt;
           ,'#LOGIN_USER#'--&lt;CREUSR, varchar(30),&gt;
           ,''--&lt;UPDUSR, varchar(30),&gt;
           ,GETDATE()--&lt;CRETIM, datetime,&gt;
           ,''--&lt;UPDTIM, datetime,&gt;
    FROM QAOPESTD S
        LEFT JOIN QAROULIN UL
       ON UL.ROUCOD=@ROUCOD
        AND UL.OPENUM=@OPENUM
	WHERE S.OPESTD='#OPESTD#' 
            AND UL.OPENUM IS NULL
			AND '#GXFLG#'='True'

INSERT INTO [QAROULINCTL]
           ([ROUCOD]
           ,[OPENUM]
           ,[VALTYP]
           ,[VALLIN]
           ,[VALDES]
           ,[VALCTL]
           ,[CREUSR]
           ,[UPDUSR]
           ,[CRETIM]
           ,[UPDTIM])
    SELECT 
           @ROUCOD --&lt;ROUCOD, varchar(30),&gt;
           ,@OPENUM--&lt;OPENUM, varchar(30),&gt;
           ,S.VALTYP--&lt;VALTYP, varchar(30),&gt;
           ,S.VALLIN--&lt;VALLIN, int,&gt;
           ,S.VALDES--&lt;VALDES, nvarchar(100),&gt;
           ,S.VALCTL--&lt;VALCTL, varchar(1),&gt;
           ,'#LOGIN_USER#'--&lt;CREUSR, varchar(30),&gt;
           ,''--&lt;UPDUSR, varchar(30),&gt;
           ,GETDATE()--&lt;CRETIM, datetime,&gt;
           ,''--&lt;UPDTIM, datetime,&gt;
      FROM QAOPESTDCTL S
         LEFT JOIN QAROULINCTL UL
         ON UL.ROUCOD=@ROUCOD
        AND UL.OPENUM=@OPENUM
      WHERE S.OPESTD='#OPESTD#' 
	       AND UL.OPENUM IS NULL
	  	   AND '#GXFLG#'='True';

DELETE FROM QAROULIN WHERE ROUCOD=@ROUCOD AND OPENUM='#OPENUM#' AND '#GXFLG#'='False';

DELETE FROM QAROULINCTL WHERE ROUCOD=@ROUCOD AND OPENUM='#OPENUM#' AND '#GXFLG#'='False';</SQLUpdateScript>
